CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
EMBEDDED_CONTENT_CONTAINS_SWIFT = YES
EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/AppAuth" "${PODS_CONFIGURATION_BUILD_DIR}/BRPickerView" "${PODS_CONFIGURATION_BUILD_DIR}/Bolts" "${PODS_CONFIGURATION_BUILD_DIR}/GTMAppAuth" "${PODS_CONFIGURATION_BUILD_DIR}/GTMSessionFetcher" "${PODS_CONFIGURATION_BUILD_DIR}/GoogleSignIn" "${PODS_CONFIGURATION_BUILD_DIR}/MBProgressHUD" "${PODS_CONFIGURATION_BUILD_DIR}/SDAutoLayout" "${PODS_CONFIGURATION_BUILD_DIR}/TikTokOpenAuthSDK" "${PODS_CONFIGURATION_BUILD_DIR}/TikTokOpenSDKCore" "${PODS_CONFIGURATION_BUILD_DIR}/TikTokOpenShareSDK" "${PODS_CONFIGURATION_BUILD_DIR}/Toast" "${PODS_ROOT}/FBAEMKit/XCFrameworks" "${PODS_ROOT}/FBSDKCoreKit/XCFrameworks" "${PODS_ROOT}/FBSDKCoreKit_Basics/XCFrameworks" "${PODS_ROOT}/FBSDKLoginKit/XCFrameworks" "${PODS_ROOT}/FBSDKShareKit/XCFrameworks" "${PODS_ROOT}/RXAuthLoginKit" "${PODS_ROOT}/RXAuthSDK_official" "${PODS_ROOT}/RXFacebookSDK" "${PODS_ROOT}/RXGoogleSDK" "${PODS_ROOT}/RXInstagramSDK" "${PODS_ROOT}/RXLanguageKit" "${PODS_ROOT}/RXLineSDK" "${PODS_ROOT}/RXLineSDK_official" "${PODS_ROOT}/RXOSUIKit" "${PODS_ROOT}/RXPublicToolKit" "${PODS_ROOT}/RXPushSDK" "${PODS_ROOT}/RXRedditSDK" "${PODS_ROOT}/RXSDK_Pure" "${PODS_ROOT}/RXSnapChatSDK" "${PODS_ROOT}/RXTikTokSDK" "${PODS_ROOT}/RXUIKit" "${PODS_ROOT}/RXWXSDK" "${PODS_ROOT}/RXZaloSDK" "${PODS_ROOT}/SnapSDK" "${PODS_ROOT}/ZaloSDK/ZaloSDK/Frameworks" "${PODS_XCFRAMEWORKS_BUILD_DIR}/FBAEMKit" "${PODS_XCFRAMEWORKS_BUILD_DIR}/FBSDKCoreKit" "${PODS_XCFRAMEWORKS_BUILD_DIR}/FBSDKCoreKit_Basics" "${PODS_XCFRAMEWORKS_BUILD_DIR}/FBSDKLoginKit" "${PODS_XCFRAMEWORKS_BUILD_DIR}/FBSDKShareKit" "${PODS_XCFRAMEWORKS_BUILD_DIR}/SnapSDK/SCSDKCoreKit" "${PODS_XCFRAMEWORKS_BUILD_DIR}/SnapSDK/SCSDKCreativeKit" "${PODS_XCFRAMEWORKS_BUILD_DIR}/SnapSDK/SCSDKLoginKit" "${PODS_XCFRAMEWORKS_BUILD_DIR}/ZaloSDK/Core" "${PODS_XCFRAMEWORKS_BUILD_DIR}/ZaloSDK/Main"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/AppAuth/AppAuth.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/BRPickerView/BRPickerView.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Bolts/Bolts.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/GTMAppAuth/GTMAppAuth.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/GTMSessionFetcher/GTMSessionFetcher.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/GoogleSignIn/GoogleSignIn.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/MBProgressHUD/MBProgressHUD.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SDAutoLayout/SDAutoLayout.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/TikTokOpenAuthSDK/TikTokOpenAuthSDK.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/TikTokOpenSDKCore/TikTokOpenSDKCore.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/TikTokOpenShareSDK/TikTokOpenShareSDK.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Toast/Toast.framework/Headers" "${PODS_ROOT}/Headers/Public" "${PODS_ROOT}/Headers/Public/WechatOpenSDK"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/WechatOpenSDK/OpenSDK2.0.4" "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_LDFLAGS = $(inherited) -ObjC -l"WechatOpenSDK" -l"c++" -l"c++abi" -l"sqlite3" -l"sqlite3.0" -l"z" -framework "ATAuthSDK" -framework "AdSupport" -framework "AppAuth" -framework "AuthenticationServices" -framework "BRPickerView" -framework "Bolts" -framework "CoreGraphics" -framework "CoreTelephony" -framework "CoreText" -framework "FBAEMKit" -framework "FBSDKCoreKit" -framework "FBSDKCoreKit_Basics" -framework "FBSDKLoginKit" -framework "FBSDKShareKit" -framework "Foundation" -framework "GTMAppAuth" -framework "GTMSessionFetcher" -framework "GoogleSignIn" -framework "LineSDK" -framework "LocalAuthentication" -framework "MBProgressHUD" -framework "Network" -framework "QuartzCore" -framework "RXAuthLoginKit" -framework "RXFacebookSDK" -framework "RXGoogleSDK" -framework "RXInstagramSDK" -framework "RXLanguageKit" -framework "RXLineSDK" -framework "RXPublicToolKit" -framework "RXPushSDK" -framework "RXRedditSDK" -framework "RXSDK_Pure" -framework "RXSnapChatSDK" -framework "RXTikTokSDK" -framework "RXUIKit" -framework "RXUIKit_OS" -framework "RXWXSDK" -framework "RXZaloSDK" -framework "SCSDKCoreKit" -framework "SCSDKCreativeKit" -framework "SCSDKLoginKit" -framework "SDAutoLayout" -framework "SafariServices" -framework "Security" -framework "TikTokOpenAuthSDK" -framework "TikTokOpenSDKCore" -framework "TikTokOpenShareSDK" -framework "Toast" -framework "UIKit" -framework "WebKit" -framework "YTXMonitor" -framework "YTXOperators" -framework "ZaloSDK" -framework "ZaloSDKCoreKit" -framework "iAd" -weak_framework "AuthenticationServices"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/AppAuth" "-F${PODS_CONFIGURATION_BUILD_DIR}/BRPickerView" "-F${PODS_CONFIGURATION_BUILD_DIR}/Bolts" "-F${PODS_CONFIGURATION_BUILD_DIR}/FBAEMKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/FBSDKCoreKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/FBSDKCoreKit_Basics" "-F${PODS_CONFIGURATION_BUILD_DIR}/FBSDKLoginKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/FBSDKShareKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/GTMAppAuth" "-F${PODS_CONFIGURATION_BUILD_DIR}/GTMSessionFetcher" "-F${PODS_CONFIGURATION_BUILD_DIR}/GoogleSignIn" "-F${PODS_CONFIGURATION_BUILD_DIR}/MBProgressHUD" "-F${PODS_CONFIGURATION_BUILD_DIR}/RXAuthLoginKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/RXAuthSDK_official" "-F${PODS_CONFIGURATION_BUILD_DIR}/RXFacebookSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/RXGoogleSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/RXInstagramSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/RXLanguageKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/RXLineSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/RXLineSDK_official" "-F${PODS_CONFIGURATION_BUILD_DIR}/RXOSUIKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/RXPublicToolKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/RXPushSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/RXRedditSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/RXSDK_Pure" "-F${PODS_CONFIGURATION_BUILD_DIR}/RXSnapChatSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/RXTikTokSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/RXUIKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/RXWXSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/RXZaloSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/SDAutoLayout" "-F${PODS_CONFIGURATION_BUILD_DIR}/SnapSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/TikTokOpenAuthSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/TikTokOpenSDKCore" "-F${PODS_CONFIGURATION_BUILD_DIR}/TikTokOpenShareSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/Toast" "-F${PODS_CONFIGURATION_BUILD_DIR}/WechatOpenSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/ZaloSDK"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
