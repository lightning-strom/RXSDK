CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/TikTokOpenAuthSDK" "${PODS_CONFIGURATION_BUILD_DIR}/TikTokOpenSDKCore" "${PODS_CONFIGURATION_BUILD_DIR}/TikTokOpenShareSDK" "${PODS_ROOT}/RXLanguageKit" "${PODS_ROOT}/TikTokOpenSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/TikTokOpenSDK"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/TikTokOpenAuthSDK/TikTokOpenAuthSDK.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/TikTokOpenSDKCore/TikTokOpenSDKCore.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/TikTokOpenShareSDK/TikTokOpenShareSDK.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks' '@executable_path/../../Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_LDFLAGS = $(inherited) -ObjC -framework "CoreGraphics" -framework "Foundation" -framework "Photos" -framework "RXLanguageKit" -framework "Security" -framework "TikTokOpenAuthSDK" -framework "TikTokOpenSDK" -framework "TikTokOpenSDKCore" -framework "TikTokOpenShareSDK" -framework "UIKit" -framework "WebKit"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/RXLanguageKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/TikTokOpenAuthSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/TikTokOpenSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/TikTokOpenSDKCore" "-F${PODS_CONFIGURATION_BUILD_DIR}/TikTokOpenShareSDK"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
