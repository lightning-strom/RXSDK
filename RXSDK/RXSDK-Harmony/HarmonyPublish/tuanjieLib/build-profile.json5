{
  "apiType": "stageMode",
  "buildOption": {
    "nativeLib": {
      "debugSymbol": {
        "strip": false
      }
    },
    "sourceOption": {
      "workers": []
    },
    "arkOptions": {
      "runtimeOnly": {
        "packages": [
          "hmssdk"
        ],
        "sources": [
          "./src/main/ets/HMSMessageBind.ets",
          "./src/main/ets/RXInterface.ets",
          "./src/main/ets/RXWebViewComponent.ets",
          "./src/main/ets/RXWebViewControl.ts",
          "./src/main/ets/RXWebViewJsBridge.ets",
          "./src/main/ets/RXWebViewLayout.ets",
          "./src/main/ets/RXWebViewMainThreadWorker.ets",
          "./src/main/ets/webview/WebviewControl.ets"
        ]
      }
    }
  },
  "targets": [
    {
      "name": "default"
    }
  ]
}