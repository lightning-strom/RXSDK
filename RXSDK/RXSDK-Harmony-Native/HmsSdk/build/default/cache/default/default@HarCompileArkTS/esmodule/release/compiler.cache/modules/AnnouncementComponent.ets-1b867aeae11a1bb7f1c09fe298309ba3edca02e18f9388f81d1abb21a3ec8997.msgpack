                });
            }
        }, If);
        If.pop();
        Column.pop();
        Scroll.pop();
        Row.pop();
        Column.pop();
    }
    getRichText() {
        return meta + (this.content || this.announcementList[this.selectIndex]?.content)?.replace(regex, (_match, numberPart, unit) => {
            const unitToUse = unit || 'px';
            let newSize = Number(numberPart) * display.getDefaultDisplaySync().densityPixels;
            // let newSize =numberPart
            return `font-size: ${newSize}${unitToUse}`;
        });
    }
    rerender() {
        this.updateDirtyElements();
    }
}
