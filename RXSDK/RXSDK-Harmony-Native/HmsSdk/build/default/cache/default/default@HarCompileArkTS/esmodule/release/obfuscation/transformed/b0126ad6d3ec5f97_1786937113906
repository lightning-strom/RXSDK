c function (...args: any[]) {\n            const timeoutPromise = new Promise((_, reject) => {\n                setTimeout(async () => {\n                    if (callback) {\n                        await Promise.resolve(callback(propertyKey, ms));\n                    }\n                    reject(new Error(`${propertyKey} timeout after ${ms}ms`));\n                }, ms);\n            });\n            return Promise.race([\n                originalMethod.apply(this, args),\n                timeoutPromise\n            ]);\n        };\n        return descriptor;\n    };\n};\n",
