          target[key] = srcVal;
        }
      });
    });

    return target;
  }


  parse<T = any>(text: string): T {
    try {
      const result = JSON.parse(text);
      return result as T
    } catch {
      return text as T
    }
  }

  safeStringify(obj) {
    try {
      // å¤„ç†å¾ªçŽ¯å¼•ç”¨
      const seen = new WeakSet();
