    "content": "/**\n * ShareMediaType 定义\n * 用于表示分享的媒体类型\n */\nexport type ShareMediaType = 'link' // 分享链接\n | 'image' // 分享图片\n | 'landing' // 分享图片并增加二维码\n | 'a2m' // App 分享至小游戏\n | 'card' // 小程序卡片\n | 'text' // 分享文本\n | 'text_image' // 图文分享\n | 'video' // 视频分享\n | 'music' // 音乐分享\n | 'atlas'; // 多图分享\n/**\n * ShareMediaType 常量定义\n */\nexport enum ShareMediaTypes {\n    WEBPAGE = \"link\",\n    IMAGE = \"image\",\n    LANDING = \"landing\",\n    A2M = \"a2m\",\n    CARD = \"card\",\n    TEXT = \"text\",\n    TEXT_IMAGE = \"text_image\",\n    VIDEO = \"video\",\n    MUSIC = \"music\",\n    ATLAS = \"atlas\"\n}\nexport type ShareMediaTypesKey = keyof typeof ShareMediaTypes;\nexport type ShareMediaTypesValue = typeof ShareMediaTypes[ShareMediaTypesKey];\n",
