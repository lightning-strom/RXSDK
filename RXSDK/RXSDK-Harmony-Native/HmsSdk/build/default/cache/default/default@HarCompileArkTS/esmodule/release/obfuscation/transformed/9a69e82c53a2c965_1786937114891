    "content": "import { RXError, RXErrorCode } from \"@normalized:N&&&hmssdk/src/main/ets/types/Index&4.0.0\";\nimport type { ShareParams } from \"@normalized:N&&&hmssdk/src/main/ets/types/Index&4.0.0\";\nimport type { IShareTarget } from \"../share/ISharableTarget\";\nimport type common from \"@ohos:app.ability.common\";\nimport type { Context } from \"@ohos:abilityAccessCtrl\";\nimport { ShareObject } from \"@normalized:N&&&hmssdk/src/main/ets/share/ShareObject&4.0.0\";\nimport { WXApi } from \"@normalized:N&&&hmssdk/src/main/ets/wx/WXApi&4.0.0\";\nimport { Logger } from \"@normalized:N&&&hmssdk/src/main/ets/utils/Logger&4.0.0\";\nexport default class WXShare implements IShareTarget {\n    async doShare(params: ShareParams, context?: Context): Promise<void> {\n        try {\n            const resp = await WXApi.getInstance(params.wx_appid).share(new ShareObject(params), context as common.UIAbilityContext);\n            if (resp.errCode === 0) {\n                console.log(\"Share successful\");\n            }\n            else {\n                Logger.e(`Share failed with error code: ${resp.errCode}`);\n                throw new RXError(`Share failed with error code: ${resp.errCode}`, RXErrorCode.SHARE_PARAMS_ERROR, resp.errCode, resp.errStr);\n            }\n        }\n        catch (e) {\n            if (e instanceof Error) {\n                throw e;\n            }\n            else {\n                throw new RXError(`wx share error code: ${e}`, RXErrorCode.SHARE_PARAMS_ERROR);\n            }\n        }\n    }\n}\n",
