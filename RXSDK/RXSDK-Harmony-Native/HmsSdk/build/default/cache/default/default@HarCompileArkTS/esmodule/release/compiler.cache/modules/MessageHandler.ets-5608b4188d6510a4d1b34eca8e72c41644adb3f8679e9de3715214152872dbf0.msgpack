export class MessageProcessor {
    constructor(name) {
        this.m_builtinModules = {};
        this.m_customModules = undefined;
        this.m_customHandlers = undefined;
        this.name = name;
    }
    processMessage(msg, builtinMsg = true) {
        const tokens = msg.funcName.split(".");
        let mod = undefined;
        if (builtinMsg) {
            mod = this.m_builtinModules[tokens[0]];
        }
        else if (!!this.m_customModules) {
            mod = this.m_customModules[tokens[0]];
        }
        if (!mod) {
            Logger.error('%{public}s', "No module with name=" + tokens[0]);
            // tuanjie.nativeInvokeJSResult(false, msg.userData, "No module with name=" + tokens[0]);
            return;
        }
        const func = mod[tokens[1]];
        if (!func) {
            Logger.error('%{public}s', "No funcname with name=" + msg.funcName);
            // tuanjie.nativeInvokeJSResult(false, msg.userData, "No funcname with name=" + msg.funcName);
            return;
        }
        let argsArr = msg.args;
        if (msg.timeoutMs >= 0) { // async
            this.InvokeAsync(mod, func, argsArr, msg);
        }
        else { // data.timeoutMs < 0, sync
            this.InvokeSync(mod, func, argsArr, msg);
        }
    }
    async processCustomMessage(msg) {
        if (!!msg.modulePath) {
            const moduleName = msg.funcName.split(".")[0]; // extract module name from funcName
            await this.loadModule(moduleName, msg.modulePath);
        }
        this.processMessage(msg, false);
    }
    processHandler(msg) {
        if (!this.m_customHandlers) {
            return;
        }
        try {
            let func = this.m_customHandlers[msg.funcName];
            if (!!func) {
                let args = msg.args;
                func(...args);
            }
            else {
                Logger.warn("No callback with name=%{public}s", msg.funcName);
            }
        }
        catch (err) {
            Logger.error('Error occurred while calling callback=%{public}s, err=%{public}s', msg.funcName, err);
        }
    }
    InvokeAsync(mod, func, argsArr, msg) {
        let timeout = new Promise((_, reject) => {
            setTimeout(() => {
                reject(new Error("Async call timeout"));
            }, msg.timeoutMs);
        });
        let succ = func.apply(mod, argsArr);
        Promise.race([succ, timeout]).then((result) => {
            if (!!msg.callbackFuncName) { // remote, post result back
                POST_MESSAGE({ 'type': kCustomHandler, 'funcName': msg.callbackFuncName, 'args': result });
            }
            else { // local
                // tuanjie.nativeInvokeJSResult(true, msg.userData, result);
            }
        }).catch((err) => {
            let errMsg = JSON.stringify(err) ?? "unknown error";
            errMsg = "Error calling " + msg.funcName + "err=" + errMsg;
            Logger.error('%{public}s', errMsg);
            // if (!msg.callbackFuncName)
            // tuanjie.nativeInvokeJSResult(false, msg.userData, err);
        });
    }
    InvokeSync(mod, func, argsArr, msg) {
        try {
            let result = func.apply(mod, argsArr);
            if (!!msg.callbackFuncName) { // remote, post result back
                Logger.info('Call user extra module function : ' + msg.callbackFuncName + ' success');
                POST_MESSAGE({ 'type': kCustomHandler, 'funcName': msg.callbackFuncName, 'args': result });
            }
            else {
                // tuanjie.nativeInvokeJSResult(true, msg.userData, result);
            }
        }
        catch (err) {
            let errMsg = JSON.stringify(err) ?? "unknown error";
            errMsg = "Error calling " + msg.funcName + "err=" + errMsg;
            Logger.error('%{public}s', errMsg);
            // if (!msg.callbackFuncName)
            // tuanjie.nativeInvokeJSResult(false, msg.userData, errMsg);
        }
    }
    registerBuiltinModule(module) {
        let name = module.name || module.constructor.name;
        const curModule = this.m_builtinModules[name];
        if (!!curModule) {
            Logger.error('Duplicated message=%{public}s handler', name);
            return false;
        }
        this.m_builtinModules[name] = module;
        return true;
    }
    unregisterBuiltinModule(module) {
        let name = module.name || module.constructor.name;
        const curModule = this.m_builtinModules[name];
        if (!!curModule) {
            this.m_builtinModules.deleteKey(name);
        }
    }
    registerModule(handler) {
        if (!this.m_customModules) {
            this.m_customModules = {};
        }
        let name = handler.name || handler.constructor.name;
        const curHandler = this.m_customModules[name];
        if (!!curHandler) {
            Logger.error('Duplicated message=%{public}s handler', name);
            return false;
        }
        this.m_customModules[name] = handler;
        return true;
    }
    unregisterModule(name) {
        if (!!this.m_customModules) {
            const handler = this.m_customModules[name];
            if (!!handler) {
                this.m_customModules.deleteKey(name);
            }
        }
    }
    async loadModule(moduleName, modulePath) {
        if (!this.m_customModules) {
            this.m_customModules = {};
        }
        const mod = this.m_customModules[moduleName];
        if (!!mod) {
            Logger.info(`Message=${moduleName} handler/module already exists.`);
        }
        const self = this;
        await import(modulePath).then((mod) => {
            Logger.info(`Load module ${moduleName} Successfully.`);
            if (!!self.m_customModules)
                self.m_customModules[moduleName] = mod[moduleName];
        }).catch((reason) => {
            Logger.error(`Failed to load user extra module=${moduleName}`);
        });
    }
    unloadModule(moduleName) {
        this.unregisterModule(moduleName);
    }
    registerHandler(name, callback) {
        if (!this.m_customHandlers) {
            this.m_customHandlers = {};
        }
        this.m_customHandlers[name] = callback;
    }
    unregisterHandler(name) {
        if (!!this.m_customHandlers) {
            const handler = this.m_customHandlers[name];
            if (!!handler) {
                this.m_customHandlers.deleteKey(name);
            }
        }
    }
}
