import display from "@ohos.display";
import { HeaderComponent } from './HeaderComponent';
import webview from "@ohos.web.webview";
import SDKConfig from '../sdk/SDKConfig';
import { Logger } from '../utils/Logger';
import Devices from '../utils/Devices';
import Passport from '../base/Passport';
import JSON from "@ohos.util.json";
import { JsHandlerType } from '../types/Index';
import { WebViewDialog } from './WebViewDialog';
import Objects from '../utils/Objects';
import UIApiImpl from './UIApiImpl';
import photoAccessHelper from "@ohos.file.photoAccessHelper";
import app from '../utils/App';
import UserActionTracer from '../base/UserActionTracer';
import { RXRequest } from '../net/RXRequest';
// @CustomDialog
export class WebViewComponent extends ViewPU {
    constructor(parent, params, __localStorage, elmtId = -1, paramsLambda = undefined, extraInfo) {
        super(parent, __localStorage, elmtId, extraInfo);
        if (typeof paramsLambda === "function") {
            this.paramsGenerator_ = paramsLambda;
        }
        this.__title = new SynchedPropertyObjectOneWayPU(params.title, this, "title");
        this.__url = new ObservedPropertySimplePU('', this, "url");
        this.__naviBarVisible = new ObservedPropertySimplePU(true, this, "naviBarVisible");
        this.__closeVisible = new ObservedPropertySimplePU(true, this, "closeVisible");
        this.__backVisible = new ObservedPropertySimplePU(false, this, "backVisible");
        this.__divVisible = new ObservedPropertySimplePU(true, this, "divVisible");
        this.__orientation = new ObservedPropertySimplePU(1, this, "orientation");
        this.__isLoading = new ObservedPropertySimplePU(true, this, "isLoading");
        this.__horizontalPadding = new ObservedPropertySimplePU(0, this, "horizontalPadding");
        this.webParams = {};
        this.webController = new webview.WebviewController();
        this.onCloseClick = undefined;
        this.onJavaScriptCallback = undefined;
        this.webFunc = {
            openWebView: (url) => {
                Logger.i('openWebView ' + url);
                WebViewDialog.getInstance(this.getUIContext(), url).setWebParams(this.webParams).setOnJavaScriptCallback(this.onJavaScriptCallback).show();
            },
            openSystemWebView: (url) => {
                Logger.i('openSystemWebView ' + url);
                app.startBrowser(url);
            },
            openIIFAAAuth: (json) => {
                Logger.i('openIIFAAAuth ' + json);
                this.startIIFAAAuth(json);
            },
            minimized: (json) => {
                Logger.i('minimized' + json);
            },
            closeWebView: (json) => {
                Logger.i('closeWebView' + json);
                this.close();
            },
            trackUserAction: (json) => {
                Logger.i('trackUserAction' + json);
                UserActionTracer.trackUserAction(JSON.parse(json));
            },
            reportUserLog: (json) => {
                Logger.i('reportUserLog' + json);
            },
            setTitle: (json) => {
                Logger.i('setTitle:' + json);
                this.title = json;
            },
            invokeNativeCallback: (json) => {
                Logger.i('invokeNativeCallback:' + json);
                this.invokeHandler(json);
                this.close();
            },
            setNaviBarVisible: (visible) => {
                Logger.i('setNaviBarVisible:' + visible);
                this.naviBarVisible = Boolean(visible);
                // if (!this.closeVisible) {
                //   this.backVisible = visible
                // }
            },
            doClose: (json) => {
                Logger.i('doClose:' + json);
                this.close();
            },
            getInitParams: () => {
                try {
                    let cfg = SDKConfig;
                    let api_params = {
                        cpid: cfg.cpId,
                        productid: cfg.productId,
                        channelid: cfg.channelId,
                        platformid: Devices.platformId,
                        version: cfg.VERSION,
                        devicecode: Devices.deviceCode,
                        language: cfg.lang,
                        tzoffset: Devices.timeOffset,
                        domain: cfg.domain,
                        country_code: cfg.country
                    };
                    let params = {
                        api_params: JSON.stringify(api_params),
                        login_data: Passport.isLoggedIn ? JSON.stringify(Passport.loginData) : "",
                        init_data: JSON.stringify(cfg.initConfig ?? {}),
                        device: JSON.stringify({
                            "orientation": this.orientation % 2 == 0 ? 2 : 1,
                            "hasSafeZone": 1,
                            "naviBarHeight": 36,
                            "isPad": 0, // æ˜¯å¦æ˜¯pad 0ä¸æ˜¯pad 1æ˜¯pad
                        }),
                        passwordStrength: JSON.stringify(SDKConfig.passwordStrength || {}),
                        setSyncInfoEnable: SDKConfig.syncInfoEnable,
                        request_headers: JSON.stringify(RXRequest.getHeader(undefined, true, SDKConfig.encipher)),
                    };
                    params = Objects.assign(params, this.webParams);
                    Logger.debug("getInitParams:" + JSON.stringify(params));
                    return JSON.stringify(params);
                }
                catch (e) {
                    Logger.e(e);
                    return "{}";
                }
            },
            openChatService: (json) => {
                Logger.i('openChatService:' + json);
                try {
                    UIApiImpl.showChatServicesUI(this.getUIContext(), json ? JSON.parse(json) : {})?.setOnJavaScriptCallback(this.onJavaScriptCallback);
                }
                catch (e) {
                    Logger.e(e);
                }
            },
            resetpwdSuccess: (json) => {
                Logger.i('resetpwdSuccess' + json);
                try {
                    let js = JSON.parse(json || "{}");
                    js.type = JsHandlerType.reset_password;
                    this.jsHandler.reset_password(js);
                }
                catch (e) {
                    Logger.e(e);
                }
            },
            refreshAccessToken: (json) => {
                Logger.i('refreshAccessToken' + json);
                try {
                    Passport.refreshAccessToken((ret) => {
                        if (ret?.code == 0) {
                            this.webController.runJavaScript(this.jsRefreshAccessTokenFunc(JSON.stringify(ret)));
                        }
                    });
                }
                catch (e) {
                    Logger.e(e);
                }
            },
            setCloseVisible: (json) => {
                Logger.i('setCloseVisible ï¼š' + json);
                this.closeVisible = Boolean(json);
            },
            setBackVisible: (json) => {
                Logger.i('setBackVisible' + json);
                this.backVisible = Boolean(json);
            }
        };
        this.jsHandler = {
            bindPhone: (dat) => {
                if (dat.ext) {
                    Passport.loginData?.bindPhone(dat.ext);
                }
            },
            bindEmail: (dat) => {
                if (dat.ext) {
                    Passport.loginData?.bindEmail(dat.ext);
                }
            },
            real_auth: (dat) => {
                if (dat.code === 0 && dat.data) {
                    Passport.loginData?.setRealName(dat.data);
                    this.onJavaScriptCallback?.(dat);
                }
            },
            deregister: (dat) => {
                if (dat.code === 0) {
                    Passport.loginData?.setDeregister(true);
                    this.onJavaScriptCallback?.(dat);
                }
            },
            underegister: (dat) => {
                Passport.loginData?.setDeregister(false);
            },
            reset_password: (dat) => {
                this.onJavaScriptCallback?.(dat);
            },
            close_webview: (dat) => {
                this.onJavaScriptCallback?.(dat);
            },
            logBackIn: (dat) => {
                this.onJavaScriptCallback?.(dat);
            },
            callback: (dat) => {
                this.onJavaScriptCallback?.(dat);
            }
        };
        this.setInitiallyProvidedValue(params);
        this.declareWatch("naviBarVisible", this.onNavVisibleChanged);
        this.finalizeConstruction();
    }
    setInitiallyProvidedValue(params) {
        if (params.title === undefined) {
            this.__title.set({ "id": -1, "type": 20000, params: ['app.media.rx_logo'], "bundleName": __BUNDLE_NAME__, "moduleName": __MODULE_NAME__ });
        }
        if (params.url !== undefined) {
            this.url = params.url;
        }
        if (params.naviBarVisible !== undefined) {
            this.naviBarVisible = params.naviBarVisible;
        }
        if (params.closeVisible !== undefined) {
            this.closeVisible = params.closeVisible;
        }
        if (params.backVisible !== undefined) {
            this.backVisible = params.backVisible;
        }
        if (params.divVisible !== undefined) {
            this.divVisible = params.divVisible;
        }
        if (params.orientation !== undefined) {
            this.orientation = params.orientation;
        }
        if (params.isLoading !== undefined) {
            this.isLoading = params.isLoading;
        }
        if (params.horizontalPadding !== undefined) {
            this.horizontalPadding = params.horizontalPadding;
        }
        if (params.webParams !== undefined) {
            this.webParams = params.webParams;
        }
        if (params.webController !== undefined) {
            this.webController = params.webController;
        }
        if (params.onCloseClick !== undefined) {
            this.onCloseClick = params.onCloseClick;
        }
        if (params.onJavaScriptCallback !== undefined) {
            this.onJavaScriptCallback = params.onJavaScriptCallback;
        }
        if (params.webFunc !== undefined) {
            this.webFunc = params.webFunc;
        }
        if (params.jsHandler !== undefined) {
            this.jsHandler = params.jsHandler;
        }
    }
    updateStateVars(params) {
        this.__title.reset(params.title);
    }
    purgeVariableDependenciesOnElmtId(rmElmtId) {
        this.__title.purgeDependencyOnElmtId(rmElmtId);
        this.__url.purgeDependencyOnElmtId(rmElmtId);
        this.__naviBarVisible.purgeDependencyOnElmtId(rmElmtId);
        this.__closeVisible.purgeDependencyOnElmtId(rmElmtId);
        this.__backVisible.purgeDependencyOnElmtId(rmElmtId);
        this.__divVisible.purgeDependencyOnElmtId(rmElmtId);
        this.__orientation.purgeDependencyOnElmtId(rmElmtId);
        this.__isLoading.purgeDependencyOnElmtId(rmElmtId);
        this.__horizontalPadding.purgeDependencyOnElmtId(rmElmtId);
    }
    aboutToBeDeleted() {
        this.__title.aboutToBeDeleted();
        this.__url.aboutToBeDeleted();
        this.__naviBarVisible.aboutToBeDeleted();
        this.__closeVisible.aboutToBeDeleted();
        this.__backVisible.aboutToBeDeleted();
        this.__divVisible.aboutToBeDeleted();
        this.__orientation.aboutToBeDeleted();
        this.__isLoading.aboutToBeDeleted();
        this.__horizontalPadding.aboutToBeDeleted();
        SubscriberManager.Get().delete(this.id__());
        this.aboutToBeDeletedInternal();
    }
    get title() {
        return this.__title.get();
    }
    set title(newValue) {
        this.__title.set(newValue);
    }
    get url() {
        return this.__url.get();
    }
    set url(newValue) {
        this.__url.set(newValue);
    }
    get naviBarVisible() {
        return this.__naviBarVisible.get();
    }
    set naviBarVisible(newValue) {
        this.__naviBarVisible.set(newValue);
    }
    get closeVisible() {
        return this.__closeVisible.get();
    }
    set closeVisible(newValue) {
        this.__closeVisible.set(newValue);
    }
    get backVisible() {
        return this.__backVisible.get();
    }
    set backVisible(newValue) {
        this.__backVisible.set(newValue);
    }
    get divVisible() {
        return this.__divVisible.get();
    }
    set divVisible(newValue) {
        this.__divVisible.set(newValue);
    }
    get orientation() {
        return this.__orientation.get();
    }
    set orientation(newValue) {
        this.__orientation.set(newValue);
    }
    get isLoading() {
        return this.__isLoading.get();
    }
    set isLoading(newValue) {
        this.__isLoading.set(newValue);
    }
    get horizontalPadding() {
        return this.__horizontalPadding.get();
    }
    set horizontalPadding(newValue) {
        this.__horizontalPadding.set(newValue);
    }
    invokeHandler(data) {
        try {
            const obj = JSON.parse(data || "{}");
            switch (obj.type) {
                case JsHandlerType.binding_phone:
                case JsHandlerType.change_phone:
                    this.jsHandler.bindPhone(obj);
                    break;
                case JsHandlerType.binding_email:
                case JsHandlerType.change_email:
                    this.jsHandler.bindEmail(obj);
                    break;
                case JsHandlerType.real_auth:
                    this.jsHandler.real_auth(obj);
                    break;
                case JsHandlerType.deregister:
                    this.jsHandler.deregister(obj);
                    break;
                case JsHandlerType.underegister:
                    this.jsHandler.underegister(obj);
                    break;
                case JsHandlerType.reset_password:
                    this.jsHandler.reset_password(obj);
                    break;
                case JsHandlerType.close_webview:
                    this.jsHandler.close_webview(obj);
                    break;
                case JsHandlerType.callback:
                    this.jsHandler.callback(obj);
                case JsHandlerType.logBackIn:
                    this.jsHandler.logBackIn(obj);
                    break;
            }
        }
        catch (e) {
            Logger.e(e);
        }
    }
    async startIIFAAAuth(json) {
        try {
            let params = JSON.parse(json || "{}");
            let appName = params.app_name || app.name || app.bundleName;
            let scheme = params.scheme || SDKConfig.realAuthIifaaScheme;
            let redirectResp = await Passport.getIifaaRedirectURL(appName, scheme);
            let redirectUrl = redirectResp.data?.redirect_url || redirectResp.data?.redirectUrl || redirectResp.data?.url;
            if (redirectResp.code != 0 || !redirectUrl) {
                this.getUIContext().getPromptAction().showToast(redirectResp);
                this.sendIIFAAResultToJs(redirectResp);
                return;
            }
            let started = await app.tryStartBrowser(redirectUrl);
            if (!started) {
                Passport.clearIifaaAutoValidateCallback();
                let failResp = { code: -1, msg: "å®žåè®¤è¯å¤±è´¥", message: "å®žåè®¤è¯å¤±è´¥" };
                this.getUIContext().getPromptAction().showToast({ message: failResp.msg });
                this.sendIIFAAResultToJs(failResp);
                return;
            }
            this.registerIIFAAAutoValidate();
        }
        catch (e) {
            Logger.e("openIIFAAAuth error:" + JSON.stringify(e));
            let failResp = { code: -1, msg: JSON.stringify(e), message: JSON.stringify(e) };
            this.getUIContext().getPromptAction().showToast({ message: failResp.msg });
            this.sendIIFAAResultToJs(failResp);
        }
    }
    registerIIFAAAutoValidate() {
        Passport.setIifaaAutoValidateCallbackWithSource("deregister", (resp) => {
            Passport.clearIifaaAutoValidateCallback();
            this.sendIIFAAResultToJs(resp);
        });
    }
    sendIIFAAResultToJs(result) {
        let resultString = result ? JSON.stringify(result) : "";
        this.webController.runJavaScript(this.jsIIFAAResultFunc(resultString), (ret) => {
            Logger.i("iifaaResult result:" + ret);
        });
    }
    jsIIFAAResultFunc(result) {
        return `(function() { return window.iifaaResult!=undefined ? iifaaResult(${JSON.stringify(result)}):undefined; })();`;
    }
    jsRefreshAccessTokenFunc(str) {
        let code = `
      (function() { return window.refreshAccessToken!=undefined ? refreshAccessToken('${str}'):undefined; })();
    `;
        return code;
    }
    injectionCode() {
        let code = `
  window.globalInitParams = ${this.webFunc.getInitParams()};
  console.log("globalInitParams = " + JSON.stringify(globalInitParams));
  console.log("jsæ³¨å…¥æˆåŠŸ")
  // console.log("window.JsBridge = " + JSON.stringify(Object.keys(window.JsBridge)));
  // console.log("window.JsBridge.getInitParams() = " + JSON.stringify(window.JsBridge.getInitParams()));
 `;
        return code;
    }
    onNavVisibleChanged(propName) {
        Logger.i('onNavVisibleChanged:' + propName);
