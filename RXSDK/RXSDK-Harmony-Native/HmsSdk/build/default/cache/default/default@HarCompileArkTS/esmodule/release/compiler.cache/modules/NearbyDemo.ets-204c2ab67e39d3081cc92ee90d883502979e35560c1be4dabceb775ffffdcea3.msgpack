@Extend(Button)
function btnStyle() {
  // .constraintSize({ minHeight: 40 })
  .width(140)
  .type(ButtonType.Normal)
  .labelStyle({
    maxLines: 2
  })
  .fontColor("#FF007DFF")
  .backgroundColor("#0D000000")
