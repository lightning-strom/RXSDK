          .width(92)
          .height(30)
          .borderRadius(4)
          .fontSize(14)
          .fontWeight(500)
          .fontColor(Color.White)
          .enabled(this.mailObj.not_received_count > 0)
          .backgroundColor(this.mailObj.not_received_count > 0 ? $r('app.color.col_20c0b3') : "#D9D9D9")
          .onClick((e) => {
