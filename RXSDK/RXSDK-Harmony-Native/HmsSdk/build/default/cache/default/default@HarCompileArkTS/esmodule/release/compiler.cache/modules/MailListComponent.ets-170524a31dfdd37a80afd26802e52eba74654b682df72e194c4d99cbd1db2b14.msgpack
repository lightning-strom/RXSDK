@Preview
@ComponentV2
  // @CustomDialog
export struct MailListComponent {
  @Param mailObj: Mail = {
    all_count: 0,
    not_received_count: 0,
    not_read_count: 0,
    list: []
  }
  // @Param mailList: MailItem[] = []
  @Param title: ResourceStr = "é‚®ä»¶";
