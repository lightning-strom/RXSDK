  }

  close(event: ClickEvent) {
    // this?.controller?.close()
    this.onCloseClick?.(event);
  }

  build() {

    Column() {
      HeaderComponent({
        title: this.title, onClose: (e) => {
          this.close(e)
        }
      , backVisible: false
      }).margin({ top: 4 })

      List() {
        ForEach(this.mailObj.list, (item: MailItem, index: number) => {
          ListItem() {
            Row() {
              Image(item.status === 3 ? $r('app.media.ic_mail_close') : $r('app.media.ic_mail_open'))
                .width(22)
                .margin({ left: 10, right: 10 })
                .objectFit(ImageFit.Contain)
                .autoResize(true)
              Text(item.title)
                .fontColor(item.status == 3 ? "#444444" : "#616161")
                .fontWeight(item.status == 3 ? FontWeight.Medium : FontWeight.Normal)
                .fontSize(14)
                .layoutWeight(1)
                .maxLines(1)
              Blank()
              Text(item.send_at)
                .fontColor(item.status == 3 ? "#444444" : "#616161")
                .fontWeight(item.status == 3 ? FontWeight.Medium : FontWeight.Normal)
                .maxLines(1)
                .fontSize(12)
                .margin({ left: 5, right: 20 })
            }.height(36)
            .alignItems(VerticalAlign.Center)
          }
          .onClick(() => {
            this.selectIndex = index
            this.onMailClick?.(item)
          })
        })
      }
      .height(-1)
      .width(-1)
      .friction(0.7)
      .padding(8)
      .margin({ left: 10, right: 10, bottom: 10 })
      .backgroundColor(" #F4F4F4")
      .borderRadius(4)
      .layoutWeight(1)
      .scrollBar(BarState.Off)

      Row() {
        Image(this.mailObj.not_received_count > 0 ? $r('app.media.ic_mail_disable_delete') : $r('app.media.ic_mail_enable_delete'))
          .width(30)
          .margin({ right: 10 })
          .objectFit(ImageFit.Contain)
          .autoResize(true)
        Text("è¶…è¿‡ä¸€å‘¨çš„é‚®ä»¶è‡ªåŠ¨åˆ é™¤").fontSize(12).fontColor("#797979").maxLines(1).layoutWeight(1)
        Blank() //.layoutWeight(1)
