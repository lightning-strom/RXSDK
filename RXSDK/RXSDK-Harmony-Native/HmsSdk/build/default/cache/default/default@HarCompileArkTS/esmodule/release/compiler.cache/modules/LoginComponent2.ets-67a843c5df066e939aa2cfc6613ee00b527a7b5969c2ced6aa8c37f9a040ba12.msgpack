    pickCaptchaMode(account) {
        let methods = this.loginMethods ?? [];
        let hasCaptcha = methods.some((c) => c.method == LoginMethod.CaptchaCode);
        let hasUserName = methods.some((c) => c.method == LoginMethod.UserName);
        if (hasCaptcha != hasUserName) {
            return hasCaptcha;
        }
        return account ? isCaptchaAccount(account) : this.isCaptcha;
    }
