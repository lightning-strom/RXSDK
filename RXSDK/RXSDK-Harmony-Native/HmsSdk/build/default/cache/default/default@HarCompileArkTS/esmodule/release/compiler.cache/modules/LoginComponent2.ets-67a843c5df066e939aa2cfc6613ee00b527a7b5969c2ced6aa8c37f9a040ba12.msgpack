  Body() {
    Column() {
      TextInput({ text: $$this.userName, placeholder: this.isCaptcha ? "è¯·è¾“å…¥æ‚¨çš„æ‰‹æœºå·" : "è¯·è¾“å…¥æ‚¨çš„è´¦å·" })
