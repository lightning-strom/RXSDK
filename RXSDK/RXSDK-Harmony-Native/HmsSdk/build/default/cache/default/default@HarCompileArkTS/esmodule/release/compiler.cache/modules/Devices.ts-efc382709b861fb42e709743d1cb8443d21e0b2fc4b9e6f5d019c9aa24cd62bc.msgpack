                await this._preferences.flush();
            }
            let loginCount = this.getLoginCount();
            Logger.i(`App launched: ${this._launchCount},logined: ${loginCount}`);
            this.isInit = true;
        }
        catch (e) {
            Logger.e(e);
        }
