            ["openid", this.loginData.openid]
        ]);
        // { method: this.loginData.method, openid: this.loginData.openid }
        return RXRequest.post(PassportPath.USER_INFO, params, null, callback);
    }
    async syncInfo(params, callback) {
        return RXRequest.post(PassportPath.SYNC_APP_INFO, params, null, callback);
    }
    async bindAccount(params, callback) {
        return RXRequest.post(PassportPath.BIND_ACCOUNT, params, null, callback);
