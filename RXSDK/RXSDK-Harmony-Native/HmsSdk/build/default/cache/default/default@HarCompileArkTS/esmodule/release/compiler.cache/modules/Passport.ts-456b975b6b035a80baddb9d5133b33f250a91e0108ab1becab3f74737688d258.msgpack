            Passport.instance = this;
        }
        return Passport.instance;
    }
    getPromoDisplayKEY(callback, autoRefresh) {
        return CDKeyProvider.getInstance().getPromoDisplayKEY(callback, autoRefresh);
    }
    exchangePromoCDKEY(cdKey, callback) {
        return CDKeyProvider.getInstance().exchangePromoCDKEY(cdKey, callback);
    }
    async initAsync(context) {
        this._data = await PlayerData.load(context);
    }
    updateData(data) {
        if (this._data && this._data?.openid === data?.openid) {
            this._data.update(data);
        }
        else {
            this._data = PlayerData.create(data);
        }
    }
    get loginData() {
        return this._data;
    }
    get token() {
        return this._data?.token;
    }
    get realAuthReward() {
        return this._data?.realAuthReward;
    }
    updateToken(data) {
        if (data) {
            this._data?.update({ token: data });
        }
    }
    isDeRegistering(data) {
        data ??= this.loginData;
        return ((data?.flag ?? 0) & FlagMask.Deregister) > 0;
    }
    isRealName(data) {
        data ??= this.loginData;
        return ((data?.attr ?? 0) & AttrMask.RealName) > 0;
    }
    isNewUser(flag) {
        flag ??= this.loginData?.flag;
        return ((flag ?? 0) & FlagMask.NewUser) > 0;
    }
    get isLoggedIn() {
        if (this.loginData) {
            return this.loginData?.openid ? true : false;
        }
        else {
            return false;
        }
    }
    get openid() {
        return this.loginData?.openid;
    }
    get cpUserId() {
        return this.loginData?.cp_user_id;
    }
    get refreshToken() {
        if (this.loginData && this.loginData.token) {
            return this.loginData?.token?.refresh;
        }
        else {
            return "";
        }
    }
    get accessToken() {
        if (this.loginData && this.loginData.token) {
            return this.loginData?.token?.access;
        }
        else {
            return "";
        }
    }
    async checkAccessToken() {
        if (!this.isLoggedIn) {
            let msg = "error not login,please login first.";
            Logger.e(msg);
            return Promise.reject(RXUtil.getRXResult(RXErrorCode.NOT_LOGIN_ERROR, msg));
        }
        try {
            if (!this._data?.isExpired()) {
                return Promise.resolve({ code: 0 });
            }
            // å°è¯•åˆ·æ–°è®¿é—®ä»¤ç‰Œ
            const resp = await this.refreshAccessToken();
            if (resp.code !== 0) {
                throw resp;
            }
            else {
                return resp;
            }
        }
        catch (error) {
            error.code ??= RXErrorCode.TOKEN_ERROR;
            error.msg ??= error.message;
            Logger.e(error);
            // let rejectObj = {
            //   code: -1,
            //   ...error,
            //   msg: error.msg,
            //   message: error.message
            // }
            throw error;
            // return Promise.reject(error);
        }
    }
    async refreshAccessToken(callback) {
        return RXRequest.post(PassportPath.REFRESH_TOKEN, {}, { "ruixue-refreshtoken": this.refreshToken }, callback).then(resp => {
            if (resp.code === 0 && resp.data) {
                this.updateToken(resp.data);
            }
            return resp;
        });
    }
    async searchBindingAccounts(callback) {
        let params = new Map();
        return RXRequest.post(PassportPath.ACCOUNT_BOUND_QUERY, params, null, callback);
    }
    async deregisterCancel(callback) {
        let params = new Map();
        return RXRequest.post(PassportPath.USER_DEREGISTER_CANCEL, params, null, callback).then(resp => {
            if (resp.code == 0) {
                this.loginData?.setDeregister(false);
            }
            return resp;
        });
    }
    async deregister(idcard, realname, cpdata, callback) {
        let params = new Map([
            ["idcard", idcard],
            ["realname", realname],
            ["cpdata", cpdata]
        ]);
        return RXRequest.post(PassportPath.USER_DEREGISTER, params, null, callback).then(resp => {
            if (resp.code == 0) {
                this.loginData?.setDeregister(true);
            }
            return resp;
        });
    }
    async unBindEmail(email, captcha_code, callback) {
        let params = new Map([
            ["email", email],
            ["captcha_code", captcha_code]
        ]);
        // { email, captcha_code }
        return RXRequest.post(PassportPath.UNBIND_EMAIL, params, null, callback);
    }
    async bindEmail(email, password, captcha_code, migrate_args, callback) {
        let params = new Map([
            ["email", email],
            ["password", password],
            ["captcha_code", captcha_code],
            ["migrate_args", migrate_args]
        ]);
        // { email, password, captcha_code, migrate_args }
        return RXRequest.post(PassportPath.BIND_EMAIL, params, null, callback);
    }
    async unBindPhone(phone, captcha_code, callback) {
        let params = new Map([
            ["phone", phone],
            ["captcha_code", captcha_code]
        ]);
        // { phone, captcha_code }
        return RXRequest.post(PassportPath.UNBIND_PHONE, params, null, callback);
    }
    async changePhone(newphone, newphone_captcha, oldphone_captcha, migrate_args, callback) {
        let params = new Map([
            ["newphone", newphone],
            ["newphone_captcha", newphone_captcha],
            ["oldphone_captcha", oldphone_captcha],
            ["migrate_args", migrate_args]
        ]);
        // { newphone, newphone_captcha, oldphone_captcha, migrate_args }
        return RXRequest.post(PassportPath.CHANGE_PHONE, params, null, callback);
    }
    async bindPhone(phone, password, captcha_code, migrate_args, callback) {
        let params = new Map([
            ["phone", phone],
            ["password", password],
            ["captcha_code", captcha_code],
            ["migrate_args", migrate_args]
        ]);
        // { phone, password, captcha_code, migrate_args }
        return RXRequest.post(PassportPath.BIND_PHONE, params, null, callback);
    }
    async updateUserInfo(params, callback) {
        return RXRequest.post(PassportPath.UPDATE_USER, params, null, callback).then((resp) => {
            if (resp.code == 0) {
                let d = { ...params };
                d.avatar = params.avatarUrl || d.avatar;
                delete d["avatarUrl"];
                this.loginData?.update(d);
