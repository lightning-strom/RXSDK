    "content": "import { RXErrorCode } from \"@normalized:N&&&hmssdk/src/main/ets/types/Index&4.0.0\";\nimport type { CaptchaType, PayParams, Purpose, RXConfig, RXLoginConfig, UserCenterConfig } from \"@normalized:N&&&hmssdk/src/main/ets/types/Index&4.0.0\";\nimport { Singleton } from \"@normalized:N&&&hmssdk/src/main/ets/types/Types&4.0.0\";\nimport { RXApi, RXUtil } from \"@normalized:N&&&hmssdk/src/main/ets/sdk/RXIndex&4.0.0\";\nexport interface IRXApiBridge {\n    Login(conf: RXLoginConfig, uiContext: UIContext): Promise<string>;\n    Init(conf: RXConfig, uiContext: UIContext): Promise<string>;\n    Logout(): Promise<string>;\n    Pay(params: PayParams): Promise<string>;\n    SendCaptcha(uiContext: UIContext, type: CaptchaType, target: string, purpose: Purpose, tencentCaptcha?: Record<string, object>): Promise<string>;\n    ShowUserPrivacyPolicyUI(uiContext: UIContext, content: string, title: string): Promise<string>;\n    ShowCaptchaVerifyUI(uiContext: UIContext, appid: string): Promise<string>;\n    ShowFeedbackUI(uiContext: UIContext, config?: string[]): Promise<string>;\n    ShowLoginUI(uiContext: UIContext, config: RXLoginConfig): Promise<string>;\n    ShowUserCenterUI(uiContext: UIContext, config?: UserCenterConfig): Promise<string>;\n}\nexport class RXApiBridge extends Singleton<RXApiBridge> {\n    static async Init(conf: RXConfig, uiContext: UIContext): Promise<string> {\n        try {\n            let ret = await RXApi.getInstance().init(conf, uiContext);\n            return JSON.stringify(ret);\n        }\n        catch (e) {\n            e.code ??= RXErrorCode.INIT_ERROR;\n            return RXUtil.stringifyError(e);\n        }\n    }\n    static async Login(conf: RXLoginConfig, uiContext: UIContext): Promise<string> {\n        try {\n            let ret = await RXApi.getInstance().unionLogin(conf, uiContext);\n            return JSON.stringify(ret);\n        }\n        catch (e) {\n            return RXUtil.stringifyError(e);\n        }\n    }\n    static async Logout(): Promise<string> {\n        try {\n            const ret = await RXApi.getInstance().logout();\n            return JSON.stringify(ret);\n        }\n        catch (e) {\n            return RXUtil.stringifyError(e);\n        }\n    }\n    static async Pay(params: PayParams): Promise<string> {\n        try {\n            const ret = await RXApi.getInstance().pay(params);\n            return JSON.stringify(ret);\n        }\n        catch (e) {\n            return RXUtil.stringifyError(e);\n        }\n    }\n    static async SendCaptcha(uiContext: UIContext, type: CaptchaType, target: string, purpose: Purpose, tencentCaptcha?: Record<string, object>): Promise<string> {\n        try {\n            const ret = await RXApi.getInstance().sendCaptcha(uiContext, {\n                purpose: purpose,\n                tencent_captcha: tencentCaptcha,\n                type: type,\n                target: target\n            });\n            return JSON.stringify(ret);\n        }\n        catch (e) {\n            return RXUtil.stringifyError(e);\n        }\n    }\n    async ShowUserPrivacyPolicyUI(uiContext: UIContext, content: string, title: string): Promise<string> {\n        try {\n            const dialog = RXApi.getInstance().showUserPrivacyPolicyUI(uiContext, content, title);\n            return JSON.stringify(dialog);\n        }\n        catch (e) {\n            return RXUtil.stringifyError(e);\n        }\n    }\n    async ShowCaptchaVerifyUI(uiContext: UIContext, appid: string): Promise<string> {\n        try {\n            const dialog = await RXApi.getInstance().showCaptchaVerifyUI(uiContext, appid);\n            return JSON.stringify(dialog);\n        }\n        catch (e) {\n            return RXUtil.stringifyError(e);\n        }\n    }\n    async ShowFeedbackUI(uiContext: UIContext, config?: string[]): Promise<string> {\n        try {\n            const dialog = await RXApi.getInstance().showFeedbackUI(uiContext, config);\n            return JSON.stringify(dialog);\n        }\n        catch (e) {\n            return RXUtil.stringifyError(e);\n        }\n    }\n    async ShowLoginUI(uiContext: UIContext, config: RXLoginConfig): Promise<string> {\n        try {\n            const dialog = await RXApi.getInstance().showLoginUI(uiContext, config);\n            return JSON.stringify(dialog);\n        }\n        catch (e) {\n            return RXUtil.stringifyError(e);\n        }\n    }\n    async ShowUserCenterUI(uiContext: UIContext, config?: UserCenterConfig): Promise<string> {\n        try {\n            const dialog = await RXApi.getInstance().showUserCenterUI(uiContext, config);\n            return JSON.stringify(dialog);\n        }\n        catch (e) {\n            return RXUtil.stringifyError(e);\n        }\n    }\n}\n",
