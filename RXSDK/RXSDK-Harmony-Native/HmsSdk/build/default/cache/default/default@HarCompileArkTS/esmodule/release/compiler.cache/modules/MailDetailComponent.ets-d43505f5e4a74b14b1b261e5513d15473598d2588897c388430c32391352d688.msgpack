        }
        .backgroundColor("#F4F4F4")
        .borderRadius(10)
        .layoutWeight(1)
        .alignItems(HorizontalAlign.Center)
        .padding(10)
        .margin({
          left: 15,
          right: 15,
          bottom: 13
        })

