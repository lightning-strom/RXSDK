  // private controller: CustomDialogController


  aboutToAppear(): void {
    if (this.mailContent.content) {
      setTimeout(() => {
        try {
          this.controller.loadData(this.mailContent.content, "text/html", "UTF-8")
        } catch (e) {
          Logger.e(e)
        }
      })
    }
