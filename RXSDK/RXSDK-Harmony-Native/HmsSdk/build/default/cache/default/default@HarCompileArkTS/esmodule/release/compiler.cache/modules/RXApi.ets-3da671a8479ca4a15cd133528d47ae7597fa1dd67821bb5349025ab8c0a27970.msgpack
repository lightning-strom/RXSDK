                }
            }
            else {
                this.setPrivacyAgree();
            }
            return this.rxapi.init(conf, uiContext);
        }
        catch (e) {
            let ret = RXUtil.formatResult(e, RXErrorCode.INIT_ERROR);
            Logger.e(ret);
            return ret;
        }
    }
