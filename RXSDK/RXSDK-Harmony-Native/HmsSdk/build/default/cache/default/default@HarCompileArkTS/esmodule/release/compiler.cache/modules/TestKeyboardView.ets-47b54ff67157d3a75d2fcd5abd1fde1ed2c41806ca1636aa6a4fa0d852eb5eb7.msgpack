            this.controller.stopEditing();
            this.controller1.stopEditing();
            // this.getUIContext().getFocusController().clearFocus();
          })
      }
    }
    .onClick(() => {
      this.controller.stopEditing();
      this.controller1.stopEditing();
      // this.getUIContext().getFocusController().clearFocus();
    })
    .focusOnTouch(true)
    .width("100%")
    .height("100%")
    .padding(24)
  }
}
