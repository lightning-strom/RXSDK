  connectNotify = "connectNotify",
  /** å‘çŽ°äº‹ä»¶ï¼šå‘é€ç«¯æ‰§è¡Œé™„è¿‘è®¾å¤‡å‘çŽ°æ“ä½œæ—¶è§¦å‘ */
