                NearbyLog.info("NearbyTransferServiceæœªåˆå§‹åŒ–ï¼Œæ­£åœ¨åˆå§‹åŒ–ã€‚ã€‚ã€‚");
                await this.create(this.uiContext);
            }
            return new Promise((resolve) => {
                gameNearbyTransfer.off("discovery");
                gameNearbyTransfer.on("discovery", (device) => {
                    NearbyLog.info("å‘çŽ°è®¾å¤‡:", (device));
