  code: number;

  /** äº‹ä»¶æè¿°ä¿¡æ¯ï¼šé”™è¯¯æ—¶ä¸ºé”™è¯¯æç¤ºï¼ŒæˆåŠŸæ—¶å¯ä¸ºç©º */
  message?: string;
