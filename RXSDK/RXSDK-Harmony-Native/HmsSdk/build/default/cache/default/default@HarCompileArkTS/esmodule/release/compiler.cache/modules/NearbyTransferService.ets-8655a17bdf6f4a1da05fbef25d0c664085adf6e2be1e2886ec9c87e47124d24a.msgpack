    async bindNearbyGame(deviceInfo, event) {
        try {
            if (!this._isNearbyServiceInitted) {
                // åŠ¡å¿…ä¿è¯åˆå§‹åŒ–ä¸ŽåŽç»­çš„ publish çš„æ¬¡åºï¼Œcreate åŒæ­¥ç»“æŸåŽæ‰å¯ä»¥å‘å¸ƒæœåŠ¡
