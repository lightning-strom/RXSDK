                    event?.(ea);
                    resolve(this._toCallback(ea));
                }).then(() => {
                    NearbyLog.info("æ­£åœ¨å‘çŽ°è®¾å¤‡...");
                });
            });
        }
        catch (e) {
            event?.(e);
            return this._toCallback(e);
        }
    }
