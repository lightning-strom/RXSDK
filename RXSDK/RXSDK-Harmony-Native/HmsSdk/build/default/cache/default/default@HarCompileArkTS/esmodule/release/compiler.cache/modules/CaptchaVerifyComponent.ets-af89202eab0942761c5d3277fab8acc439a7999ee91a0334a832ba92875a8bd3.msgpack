import display from "@ohos.display";
import webview from "@ohos.web.webview";
import { Logger } from '../utils/Logger';
import JSON from "@ohos.util.json";
import photoAccessHelper from "@ohos.file.photoAccessHelper";
// @CustomDialog
export class CaptchaVerifyComponent extends ViewPU {
    constructor(parent, params, __localStorage, elmtId = -1, paramsLambda = undefined, extraInfo) {
        super(parent, __localStorage, elmtId, extraInfo);
        if (typeof paramsLambda === "function") {
            this.paramsGenerator_ = paramsLambda;
        }
        this.__title = new SynchedPropertyObjectOneWayPU(params.title, this, "title");
        this.__url = new ObservedPropertySimplePU('', this, "url");
        this.__naviBarVisible = new ObservedPropertySimplePU(true, this, "naviBarVisible");
        this.__closeVisible = new ObservedPropertySimplePU(true, this, "closeVisible");
        this.__backVisible = new ObservedPropertySimplePU(false, this, "backVisible");
        this.__divVisible = new ObservedPropertySimplePU(true, this, "divVisible");
        this.__orientation = new ObservedPropertySimplePU(1, this, "orientation");
        this.__isLoading = new ObservedPropertySimplePU(true, this, "isLoading");
        this.__horizontalPadding = new ObservedPropertySimplePU(0, this, "horizontalPadding");
        this.webParams = {};
        this.webController = new webview.WebviewController();
        this.onCloseClick = undefined;
        this.onSliderCaptchaCallback = undefined;
        this.webFunc = {
            //{"code":0,"randstr":"@iwe","ticket":"tr03guffDNDKNnwa5cAG3HBj4HydiSLhEj8LCZWBSmLdEPWfi3aZjd0yb3cAvECVYDqt1dMlyZsi5zEywbf1pqbAGI83q5kRtwfauIe7bvdYP3bfXxLpYZBZv9N_X2wmGyD49ouwini6sXw*"}
            sliderCaptcha: (ret) => {
                Logger.i('sliderCaptcha ' + ret);
                this.invokeHandler(ret);
            },
            invokeNativeCallback: (json) => {
                Logger.i('invokeNativeCallback:' + json);
                this.invokeHandler(json);
            },
            doClose: (json) => {
                Logger.i('doClose:' + json);
                this.close();
            },
            onPageStarted: (json) => {
                Logger.i('onPageStarted:' + json);
            },
            onPageFinished: (json) => {
                Logger.i('onPageFinished:' + json);
            }
        };
        this.setInitiallyProvidedValue(params);
        this.finalizeConstruction();
    }
    setInitiallyProvidedValue(params) {
        if (params.title === undefined) {
            this.__title.set({ "id": -1, "type": 20000, params: ['app.media.rx_logo'], "bundleName": __BUNDLE_NAME__, "moduleName": __MODULE_NAME__ });
        }
        if (params.url !== undefined) {
            this.url = params.url;
        }
        if (params.naviBarVisible !== undefined) {
            this.naviBarVisible = params.naviBarVisible;
        }
        if (params.closeVisible !== undefined) {
            this.closeVisible = params.closeVisible;
        }
        if (params.backVisible !== undefined) {
            this.backVisible = params.backVisible;
        }
        if (params.divVisible !== undefined) {
            this.divVisible = params.divVisible;
        }
        if (params.orientation !== undefined) {
            this.orientation = params.orientation;
        }
        if (params.isLoading !== undefined) {
            this.isLoading = params.isLoading;
        }
        if (params.horizontalPadding !== undefined) {
            this.horizontalPadding = params.horizontalPadding;
        }
        if (params.webParams !== undefined) {
            this.webParams = params.webParams;
        }
        if (params.webController !== undefined) {
            this.webController = params.webController;
        }
        if (params.onCloseClick !== undefined) {
            this.onCloseClick = params.onCloseClick;
        }
        if (params.onSliderCaptchaCallback !== undefined) {
            this.onSliderCaptchaCallback = params.onSliderCaptchaCallback;
        }
        if (params.webFunc !== undefined) {
            this.webFunc = params.webFunc;
        }
    }
    updateStateVars(params) {
        this.__title.reset(params.title);
    }
    purgeVariableDependenciesOnElmtId(rmElmtId) {
        this.__title.purgeDependencyOnElmtId(rmElmtId);
        this.__url.purgeDependencyOnElmtId(rmElmtId);
        this.__naviBarVisible.purgeDependencyOnElmtId(rmElmtId);
        this.__closeVisible.purgeDependencyOnElmtId(rmElmtId);
        this.__backVisible.purgeDependencyOnElmtId(rmElmtId);
        this.__divVisible.purgeDependencyOnElmtId(rmElmtId);
        this.__orientation.purgeDependencyOnElmtId(rmElmtId);
        this.__isLoading.purgeDependencyOnElmtId(rmElmtId);
        this.__horizontalPadding.purgeDependencyOnElmtId(rmElmtId);
    }
    aboutToBeDeleted() {
        this.__title.aboutToBeDeleted();
        this.__url.aboutToBeDeleted();
        this.__naviBarVisible.aboutToBeDeleted();
        this.__closeVisible.aboutToBeDeleted();
        this.__backVisible.aboutToBeDeleted();
        this.__divVisible.aboutToBeDeleted();
        this.__orientation.aboutToBeDeleted();
        this.__isLoading.aboutToBeDeleted();
        this.__horizontalPadding.aboutToBeDeleted();
        SubscriberManager.Get().delete(this.id__());
        this.aboutToBeDeletedInternal();
    }
    get title() {
        return this.__title.get();
    }
    set title(newValue) {
        this.__title.set(newValue);
    }
    get url() {
        return this.__url.get();
    }
    set url(newValue) {
        this.__url.set(newValue);
    }
    get naviBarVisible() {
        return this.__naviBarVisible.get();
    }
    set naviBarVisible(newValue) {
        this.__naviBarVisible.set(newValue);
    }
    get closeVisible() {
        return this.__closeVisible.get();
    }
    set closeVisible(newValue) {
        this.__closeVisible.set(newValue);
    }
    get backVisible() {
        return this.__backVisible.get();
    }
    set backVisible(newValue) {
        this.__backVisible.set(newValue);
    }
    get divVisible() {
        return this.__divVisible.get();
    }
    set divVisible(newValue) {
        this.__divVisible.set(newValue);
    }
    get orientation() {
        return this.__orientation.get();
    }
    set orientation(newValue) {
        this.__orientation.set(newValue);
    }
    get isLoading() {
        return this.__isLoading.get();
    }
    set isLoading(newValue) {
        this.__isLoading.set(newValue);
    }
    get horizontalPadding() {
        return this.__horizontalPadding.get();
    }
    set horizontalPadding(newValue) {
        this.__horizontalPadding.set(newValue);
    }
    invokeHandler(data) {
        try {
            const obj = JSON.parse(data || "{}");
            if (obj.code >= 0) {
                this.onSliderCaptchaCallback?.(obj);
            }
            else {
                this.close();
            }
        }
        catch (e) {
            Logger.e(e);
            this.close();
        }
    }
    aboutToAppear() {
        // this.windowWidth = display.getDefaultDisplaySync().width;
        // this.windowHeight = display.getDefaultDisplaySync().height;
        Logger.i("setWebDebuggingAccess :" + Logger.logEnable);
        Logger.i("display :" + JSON.stringify(display.getDefaultDisplaySync()));
        webview.WebviewController.setWebDebuggingAccess(Logger.logEnable);
        this.orientation = display.getDefaultDisplaySync().orientation;
    }
    close() {
        // this?.controller?.close()
        this.onCloseClick?.();
    }
    initialRender() {
        this.observeComponentCreation2((elmtId, isInitialRender) => {
            RelativeContainer.create();
        }, RelativeContainer);
        // Stack({ alignContent: Alignment.Center }) {
        this.WebView.bind(this)();
        this.observeComponentCreation2((elmtId, isInitialRender) => {
            LoadingProgress.create();
            LoadingProgress.color('#20c0b3');
            LoadingProgress.enableLoading(this.isLoading);
            LoadingProgress.visibility(this.isLoading ? Visibility.Visible : Visibility.None);
            LoadingProgress.width(90);
            LoadingProgress.height(90);
            LoadingProgress.alignRules({
                center: { anchor: "__container__", align: VerticalAlign.Center },
                middle: { anchor: "__container__", align: HorizontalAlign.Center }
            });
        }, LoadingProgress);
        RelativeContainer.pop();
    }
    WebView(parent = null) {
        this.observeComponentCreation2((elmtId, isInitialRender) => {
            Web.create({ src: this.url, controller: this.webController });
            Web.domStorageAccess(true);
            Web.imageAccess(true);
            Web.onlineImageAccess(true);
            Web.javaScriptAccess(true);
            Web.onSizeChange((oldValue, newValue) => {
                Logger.info(`Ace: on size change, oldValue is ${JSON.stringify(oldValue)} value is ${JSON.stringify(newValue)}`);
            });
            Web.javaScriptProxy({
                object: this.webFunc,
                name: "JsBridge",
                methodList: Object.keys(this.webFunc),
                controller: this.webController,
            });
            Web.onShowFileSelector((event) => {
                try {
                    let PhotoSelectOptions = new photoAccessHelper.PhotoSelectOptions();
                    PhotoSelectOptions.MIMEType = photoAccessHelper.PhotoViewMIMETypes.IMAGE_TYPE;
                    PhotoSelectOptions.maxSelectNumber = 1;
                    let photoPicker = new photoAccessHelper.PhotoViewPicker();
                    photoPicker.select(PhotoSelectOptions).then((photoSelectResult) => {
                        console.info('PhotoViewPicker.select successfully, PhotoSelectResult uri: ' + JSON.stringify(photoSelectResult));
                        let fileList = photoSelectResult.photoUris;
                        if (event) {
                            event.result.handleFileList(fileList);
                        }
                    }).catch((err) => {
                        console.error(`PhotoViewPicker.select failed with err: ${err.code}, ${err.message}`);
                    });
                    return true;
                }
                catch (error) {
                    let err = error;
                    console.error(`PhotoViewPicker failed with err: ${err.code}, ${err.message}`);
                    return false;
                }
            });
            Web.onPageBegin((e) => {
                Logger.i("onPageBegin:" + JSON.stringify(e));
                // this.webController.runJavaScript(new RXJavaScriptProxy().injectionCode())
                this.isLoading = true;
            });
            Web.onPageEnd(e => {
                this.isLoading = false;
                Logger.i("onPageEnd:" + JSON.stringify(e));
                // try {
                //   this.webController.loadUrl("javascript:" + this.removeDesc)
                // } catch (error) {
                //   Logger.i(`loadUrl removeDesc fail: ${JSON.stringify(error)}`)
                // }
            });
            Web.onConsole((event) => {
                console.log(event?.message.getMessage() + ':' + JSON.stringify(event?.message.getSourceId));
                return false;
            });
            Web.backgroundColor(Color.Transparent);
        }, Web);
    }
    rerender() {
        this.updateDirtyElements();
    }
}
//# sourceMappingURL=CaptchaVerifyComponent.js.mapÂ–Ùr/Users/chenhan/Desktop/Git/RXSDK/RXSDK-Harmony-Native/HmsSdk/build/default/generated/profile/default/ModuleInfo.tsÙj␀hvigor_ignore__Applications_DevEco-Studio.app_Contents_sdk_default_openharmony_ets_api_@ohos.display.d.tsÙn␀hvigor_ignore__Applications_DevEco-Studio.app_Contents_sdk_default_openharmony_ets_api_@ohos.web.webview.d.tsÙY/Users/chenhan/Desktop/Git/RXSDK/RXSDK-Harmony-Native/HmsSdk/src/main/ets/utils/Logger.tsÙl␀hvigor_ignore__Applications_DevEco-Studio.app_Contents_sdk_default_openharmony_ets_api_@ohos.util.json.d.tsÙy␀hvigor_ignore__Applications_DevEco-Studio.app_Contents_sdk_default_openharmony_ets_api_@ohos.file.photoAccessHelper.d.tsÙj/Users/chenhan/Desktop/Git/RXSDK/RXSDK-Harmony-Native/HmsSdk/src/main/ets/pages/CaptchaVerifyComponent.etsÔrB›ªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo°belongModulePath¬shouldEmitJs¯hostModulesInfo¦hmssdkÃÂÙ</Users/chenhan/Desktop/Git/RXSDK/RXSDK-Harmony-Native/HmsSdkÙ5/Users/chenhan/Desktop/Git/RXSDK/RXSDK-Harmony-Native¦hmssdk¥4.0.0Ô␀␀Ù</Users/chenhan/Desktop/Git/RXSDK/RXSDK-Harmony-Native/HmsSdkÃ‘ÔrC’²hostDependencyName®hostModuleName¸./CaptchaVerifyComponent¦hmssdkÃÚ.import { display } from '@kit.ArkUI';

import { webview } from '@kit.ArkWeb';
import SDKConfig from '../sdk/SDKConfig';
import { Logger } from '../utils/Logger';

import { JSON } from '@kit.ArkTS';
import { JsHandlerType, JsObject } from '../types/Index';

import { BusinessError } from '@kit.BasicServicesKit';
import { photoAccessHelper } from '@kit.MediaLibraryKit';


export interface WebFuncs {
  sliderCaptcha: (ret: string) => void
  invokeNativeCallback: (json: string) => void
  doClose: (json: string) => void
  onPageStarted: (json: string) => void
  onPageFinished: (json: string) => void

}

/**
 * Login page component.
 */
@Preview
@Component
  // @CustomDialog
export struct CaptchaVerifyComponent {
  @Prop title: ResourceStr = $r('app.media.rx_logo');
  @State url: string = '';
  @State naviBarVisible: boolean = true;
  @State closeVisible: boolean = true;
  @State backVisible: boolean = false;
  @State divVisible: boolean = true;
  @State orientation: display.Orientation = 1;
  @State isLoading: boolean = true
  @State horizontalPadding: number = 0
  webParams: Record<string, string> = {}
  // private controller: CustomDialogController
  private webController: webview.WebviewController = new webview.WebviewController();
  onCloseClick?: (event?: ClickEvent) => void;
  onSliderCaptchaCallback?: (data: JsObject) => void;
  webFunc: WebFuncs = {
    //{"code":0,"randstr":"@iwe","ticket":"tr03guffDNDKNnwa5cAG3HBj4HydiSLhEj8LCZWBSmLdEPWfi3aZjd0yb3cAvECVYDqt1dMlyZsi5zEywbf1pqbAGI83q5kRtwfauIe7bvdYP3bfXxLpYZBZv9N_X2wmGyD49ouwini6sXw*"}
    sliderCaptcha: (ret: string) => {
      Logger.i('sliderCaptcha ' + ret);
      this.invokeHandler(ret);
    },

    invokeNativeCallback: (json: string) => {
      Logger.i('invokeNativeCallback:' + json);
      this.invokeHandler(json);
    },

    doClose: (json: string) => {
      Logger.i('doClose:' + json);
      this.close();
    },
    onPageStarted: (json: string): void => {
      Logger.i('onPageStarted:' + json);

    },
    onPageFinished: (json: string): void => {
      Logger.i('onPageFinished:' + json);
    }
  }

  invokeHandler(data: string): void {
    try {
      const obj = JSON.parse(data || "{}") as JsObject;
      if (obj.code >= 0) {
        this.onSliderCaptchaCallback?.(obj)
      } else {
        this.close()
      }
    } catch (e) {
      Logger.e(e)
      this.close()
    }
  }

  aboutToAppear() {
    // this.windowWidth = display.getDefaultDisplaySync().width;
    // this.windowHeight = display.getDefaultDisplaySync().height;
    Logger.i("setWebDebuggingAccess :" + Logger.logEnable)
    Logger.i("display :" + JSON.stringify(display.getDefaultDisplaySync()))

    webview.WebviewController.setWebDebuggingAccess(Logger.logEnable);
    this.orientation = display.getDefaultDisplaySync().orientation
  }

  close() {
    // this?.controller?.close()
    this.onCloseClick?.()
  }

  build() {
    RelativeContainer() {
      // Stack({ alignContent: Alignment.Center }) {
      this.WebView()
      LoadingProgress()
        .color('#20c0b3')
        .enableLoading(this.isLoading)
        .visibility(this.isLoading ? Visibility.Visible : Visibility.None)// .offset({ top: LengthMetrics.vp(this.naviBarVisible ? -60 : 0) })
        .width(90)
        .height(90)
        .alignRules({
          center: { anchor: "__container__", align: VerticalAlign.Center },
          middle: { anchor: "__container__", align: HorizontalAlign.Center }
        })
    }

  }

  @Builder
  WebView() {
    Web({ src: this.url, controller: this.webController })
      .domStorageAccess(true)
      .imageAccess(true)
      .onlineImageAccess(true)
      .javaScriptAccess(true)
      .onSizeChange((oldValue: SizeOptions, newValue: SizeOptions) => {
        Logger.info(`Ace: on size change, oldValue is ${JSON.stringify(oldValue)} value is ${JSON.stringify(newValue)}`)
      })
      .javaScriptProxy({
        object: this.webFunc,
        name: "JsBridge",
        methodList: Object.keys(this.webFunc),
        controller: this.webController,
      })// .onInterceptRequest((event) => {
        //   let url = '';
        //   if (event) {
        //     url = event.request.getRequestUrl();
        //     let userAgent = this.webController.getUserAgent();
        //     Logger.i("ua:" + JSON.stringify(userAgent));
        //   }
        //   // Logger.i(JSON.stringify(event.request.getRequestHeader()))
        //   // if (url === this.imgRequestUrl) {
        //   //   return this.responseweb;
        //   // }
        //   return null;
        // })
      .onShowFileSelector((event) => {
        try {
          let PhotoSelectOptions = new photoAccessHelper.PhotoSelectOptions();
          PhotoSelectOptions.MIMEType = photoAccessHelper.PhotoViewMIMETypes.IMAGE_TYPE;
          PhotoSelectOptions.maxSelectNumber = 1;
          let photoPicker = new photoAccessHelper.PhotoViewPicker();
          photoPicker.select(PhotoSelectOptions).then((photoSelectResult: photoAccessHelper.PhotoSelectResult) => {
            console.info('PhotoViewPicker.select successfully, PhotoSelectResult uri: ' + JSON.stringify(photoSelectResult));
            let fileList: Array<string> = photoSelectResult.photoUris;
            if (event) {
              event.result.handleFileList(fileList);
            }
          }).catch((err: BusinessError) => {
            console.error(`PhotoViewPicker.select failed with err: ${err.code}, ${err.message}`);
          });
          return true;
        } catch (error) {
          let err: BusinessError = error as BusinessError;
          console.error(`PhotoViewPicker failed with err: ${err.code}, ${err.message}`);
          return false;
        }
      })
      .onPageBegin((e) => {
        Logger.i("onPageBegin:" + JSON.stringify(e));
        // this.webController.runJavaScript(new RXJavaScriptProxy().injectionCode())
        this.isLoading = true;
      })
      .onPageEnd(e => {
        this.isLoading = false;
        Logger.i("onPageEnd:" + JSON.stringify(e));
        // try {
        //   this.webController.loadUrl("javascript:" + this.removeDesc)
        // } catch (error) {
        //   Logger.i(`loadUrl removeDesc fail: ${JSON.stringify(error)}`)
        // }
      })
      .onConsole((event) => {
        console.log(event?.message.getMessage() + ':' + JSON.stringify(event?.message.getSourceId));
        return false;
      })
      .backgroundColor(Color.Transparent)
  }
}

