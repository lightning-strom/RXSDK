{
  "platform": "minigame",
  "version": "v1",
  "entries": [
    {
      "id": "minigame-init-error-2001",
      "scenes": [
        "init"
      ],
      "codes": [
        "2001"
      ],
      "keywords": [
        "初始化错误，或未初始化",
        "init error",
        "not initialized"
      ],
      "summary": "小游戏 SDK 尚未初始化完成，或初始化配置缺失",
      "causes": [
        "在 new RxSdk / 初始化完成前就调用了登录、支付、广告等接口",
        "productId、channelId、cpid、baseUrlList 缺失或配置错误",
        "小游戏环境脚本加载失败，导致初始化链路未走通"
      ],
      "solutions": [
        "确保先完成 SDK 初始化，再调用其他业务接口",
        "逐项核对 productId、channelId、cpid、baseUrlList 配置",
        "如果是 H5 渠道，继续检查外部脚本加载和运行环境初始化日志"
      ],
      "relatedDocs": [
        "RXSDK-JS/src/config/const.ts",
        "RXSDK-Doc/common/specs/error_codes.md"
      ],
      "priority": 95
    },
    {
      "id": "minigame-login-deny-3001",
      "scenes": [
        "login"
      ],
      "codes": [
        "3001",
        "3002"
      ],
      "keywords": [
        "登录拒绝",
        "登录失败",
        "login deny",
        "login fail",
        "用户拒绝授权"
      ],
      "summary": "小游戏登录授权被拒绝或登录流程失败",
      "causes": [
        "用户拒绝了平台授权或登录流程被中断",
        "平台登录接口返回失败，原始错误被包装为统一错误码",
        "调用方没有区分 3001 授权拒绝和 3002 登录失败"
      ],
      "solutions": [
        "先区分是用户主动拒绝还是平台接口异常",
        "打印原始平台错误对象并保留 thirdcode/thirdmsg 信息",
        "如果是渠道差异问题，继续查看对应 index.*.ts 的平台实现"
      ],
      "relatedDocs": [
        "RXSDK-JS/src/config/const.ts",
        "RXSDK-JS/src/index.wegame.ts",
        "RXSDK-JS/src/index.qq.ts"
      ],
      "priority": 78
    },
    {
      "id": "minigame-pay-params-4000",
      "scenes": [
        "pay"
      ],
      "codes": [
        "4000"
      ],
      "keywords": [
        "支付参数错误",
        "pay params error",
        "参数错误"
      ],
      "summary": "小游戏支付参数不完整或字段格式不符合要求",
      "causes": [
        "商品信息、金额、透传参数等关键字段缺失",
        "调用支付接口前没有拿到必需的订单信息",
        "平台渠道对参数格式有额外要求，但业务侧未适配"
      ],
      "solutions": [
        "检查下单参数是否完整，尤其是商品标识、订单号和金额",
        "对照对应渠道实现确认是否还需要额外字段",
        "在发起支付前打印完整参数，避免只看到统一错误码"
      ],
      "relatedDocs": [
        "RXSDK-JS/src/config/const.ts",
        "RXSDK-JS/src/index.wegame.ts"
      ],
      "priority": 85
    },
    {
      "id": "minigame-pay-cancel-4001",
      "scenes": [
        "pay"
      ],
      "codes": [
        "4001"
      ],
      "keywords": [
        "支付取消",
        "cancel pay",
        "用户取消支付"
      ],
      "summary": "小游戏支付被用户取消",
      "causes": [
        "用户在平台支付面板中主动取消",
        "业务侧把取消路径误认为支付异常",
        "渠道返回取消状态，但日志没有区分处理"
      ],
      "solutions": [
        "将 4001 作为取消场景处理，不要直接归类为支付失败",
        "如需继续定位，请补充原始平台错误对象和订单号",
        "把取消、失败、成功三类支付结果分别埋点"
      ],
      "relatedDocs": [
        "RXSDK-JS/src/config/const.ts",
        "RXSDK-JS/src/index.h5_uc.ts",
        "RXSDK-JS/src/index.h5_vivo.ts"
      ],
      "priority": 72
    },
    {
      "id": "minigame-location-auth-deny-6021",
      "scenes": [
        "permission"
      ],
      "codes": [
        "6021",
        "6020"
      ],
      "keywords": [
        "定位失败",
        "定位授权拒绝",
        "location fail",
        "location auth deny"
      ],
      "summary": "小游戏定位失败或定位权限被拒绝",
      "causes": [
        "用户拒绝了定位授权，平台无法返回地理位置",
        "设备定位服务关闭，或渠道环境不支持定位能力",
        "业务侧没有区分“权限拒绝”和“定位失败”"
      ],
      "solutions": [
        "先区分是 6021 权限拒绝还是 6020 定位失败",
        "引导用户重新授权或在系统设置中开启定位",
        "确认当前小游戏平台和运行环境是否支持定位接口"
      ],
      "relatedDocs": [
        "RXSDK-JS/src/config/const.ts",
        "RXSDK-JS/src/index.qq.ts"
      ],
      "priority": 82
    },
    {
      "id": "minigame-ad-load-timeout-10000",
      "scenes": [
        "ad"
      ],
      "codes": [
        "10000",
        "1000000"
      ],
      "keywords": [
        "广告加载超时",
        "adloadtimeout",
        "广告单元无效",
        "无合适的广告"
      ],
      "summary": "小游戏广告加载失败、超时或广告位配置异常",
      "causes": [
        "广告位配置错误，广告单元无效或被关闭",
        "当前流量无可用广告，平台返回无填充",
        "广告加载耗时过长，命中了 SDK 超时逻辑"
      ],
      "solutions": [
        "检查广告位 ID、广告单元状态和平台审核状态",
        "对照 errCode 查看是否属于无广告、广告位无效或平台内部错误",
        "对广告加载设置兜底 UI，不要把超时直接等同于 SDK 崩溃"
      ],
      "relatedDocs": [
        "RXSDK-JS/src/config/const.ts",
        "RXSDK-JS/src/index.qq.ts",
        "RXSDK-JS/src/index.h5_vivo.ts"
      ],
      "priority": 84
    },
