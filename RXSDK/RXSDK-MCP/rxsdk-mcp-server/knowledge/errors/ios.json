    {
      "id": "ios-wechat-login-callback-intercepted",
      "scenes": [
        "login"
      ],
      "keywords": [
        "微信登录授权成功返回后没有登录成功回调",
        "微信授权成功返回但没有登录成功回调",
        "微信登录授权成功无回调",
        "微信登录没有成功回调",
        "onOpenURL 被拦截",
        "onOpenURL 被重写"
      ],
      "matchMode": "keyword_only",
      "summary": "iOS 微信授权返回后没有登录成功回调，onOpenURL 可能被拦截或重写",
      "causes": [
        "正常情况下 SDK 内部会自动监听 onOpenURL；当前项目重写或拦截了 onOpenURL，导致 SDK 无法收到微信授权回跳"
      ],
      "solutions": [
        "在系统方法 - (BOOL)application:(UIApplication *)app openURL:(NSURL *)url options:(NSDictionary<UIApplicationOpenURLOptionsKey,id> *)options 中添加：\n// 正常情况 SDK 内部会自动监听 onOpenURL，由于当前项目的 onOpenURL 被拦截或重写导致无法监听，需要手动处理\n[[RXSDK sharedSDK] application:app openURL:url options:options];"
      ],
      "relatedDocs": [
        "RXSDK-iOS/RXSDKCode/RXSDK/Common/RXPrivateService.m",
        "RXSDK-Unity/Packages/com.ruixue.unitysdk.weixin/Plugins/IOS/RuiXueIOSBridgeWeiXin.mm"
      ],
      "priority": 100
    },
