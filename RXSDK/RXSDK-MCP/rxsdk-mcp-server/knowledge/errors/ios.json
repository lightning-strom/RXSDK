    {
      "id": "ios-network-timeout-1131",
      "scenes": [
        "network"
      ],
      "codes": [
        "1131",
        "-1001"
      ],
      "keywords": [
        "请求超时",
        "连接超时",
        "超时错误",
        "timeout"
      ],
      "summary": "iOS 网络请求超时",
      "causes": [
        "请求超时时间内没有建立连接或没有收到完整响应",
        "当前网络环境不稳定，弱网或切网导致请求超时",
        "接口响应慢，超出了 SDK 允许的超时时间"
      ],
      "solutions": [
        "同时记录原始 NSError.code 和 SDK 侧 code，确认是否是系统超时映射而来",
        "检查 baseUrlList 对应域名是否稳定、是否存在 DNS 或代理问题",
        "如只在特定接口出现，继续联合服务端查看 trace_id 与接口耗时"
      ],
      "relatedDocs": [
        "RXSDK-iOS/RXSDKCode/RXSDK/Utils（常用工具）/Tool（工具）/RXErrorTool.h",
        "RXSDK-iOS/RXSDKCode/RXSDK/Utils（常用工具）/Tool（工具）/RXErrorTool.m",
        "RXSDK-Doc/ios/api/callback.md"
      ],
      "priority": 90
