# 瑞雪 SDK Android 自动化接入步骤
# Generated by ruixue-sdk-mcp

platform: android
version: "{{.Version}}"
channel: "{{.Channel}}"
gradle_type: "{{.GradleType}}"

# AI Agent 执行指南
agent_guide: |
  请按以下步骤执行 Android SDK 接入：
  1. 检测项目使用的是 Groovy DSL 还是 Kotlin DSL
  2. 在 settings.gradle 或项目级 build.gradle 中添加 Maven 仓库
  3. 在 app/build.gradle 中添加 SDK 依赖
  4. 配置 Java 版本和 Jetifier
  5. 执行 Gradle Sync 同步依赖
  
  注意事项：
  - 所有文件修改需要用户确认
  - 根据 Gradle 版本不同，仓库配置位置可能不同
  - 新版 Gradle 使用 settings.gradle 的 dependencyResolutionManagement
  - 旧版 Gradle 使用 build.gradle 的 allprojects

# 给用户的提示信息
user_message: |
  即将为您的 Android 项目接入瑞雪 SDK {{.Version}}（渠道：{{.Channel}}）。
  接入过程需要执行以下操作：
  1. 配置 Maven 仓库地址
  2. 添加 SDK 依赖
  3. 配置 Java 版本和 Jetifier
  4. 同步 Gradle 项目
  
  请确保您的项目可以正常编译后再开始接入。

# 执行步骤
steps:
  - id: detect_gradle_type
    type: check_file
    description: 检测 Gradle DSL 类型
    target: "{{.WorkspacePath}}/settings.gradle.kts"
    required: true
    onSuccess: use_kts
    onFailure: use_groovy
    note: 判断项目使用 Kotlin DSL (.kts) 还是 Groovy DSL

  - id: use_kts
    type: user_input
    description: 检测到 Kotlin DSL 项目
    content: 项目使用 Kotlin DSL (settings.gradle.kts)
    required: false
    onSuccess: check_settings_gradle_kts

  - id: use_groovy
    type: check_file
    description: 确认 Groovy DSL 项目
    target: "{{.WorkspacePath}}/settings.gradle"
    required: true
    onSuccess: check_settings_gradle
    onFailure: no_gradle_found
    note: 检查 settings.gradle 是否存在

  - id: no_gradle_found
    type: user_input
    description: 未找到 Gradle 配置文件
    content: |
      未在项目根目录找到 settings.gradle 或 settings.gradle.kts。
      请确保：
      1. 当前目录是 Android 项目根目录
      2. 项目是标准的 Gradle 项目结构
    required: false
    note: 提示用户检查项目结构

  # ========== Groovy DSL 配置流程 ==========
  
  - id: check_settings_gradle
    type: check_file
    description: 检查 settings.gradle 是否有 dependencyResolutionManagement
    target: "{{.WorkspacePath}}/settings.gradle"
    condition: 文件内容包含 dependencyResolutionManagement
    required: true
    onSuccess: edit_settings_gradle_new
    onFailure: check_root_build_gradle
    note: 新版 Gradle 使用 dependencyResolutionManagement

  - id: edit_settings_gradle_new
    type: edit_file
    description: 在 settings.gradle 添加 Maven 仓库（新版 Gradle）
    target: "{{.WorkspacePath}}/settings.gradle"
    insertAfter: "repositories\\s*\\{"
    content: |
        // ========== 瑞雪 SDK Maven 仓库 ==========
        maven {
            url 'http://60.205.123.114:8081/repository/maven-releases/'
            allowInsecureProtocol = true
        }
        maven {
            credentials {
                username '600685104fb2132a19e09a29'
                password '2IfrbLKz50J1'
            }
            url 'https://packages.aliyun.com/maven/repository/2168735-release-Zcdy1x/'
        }
        // ========== 瑞雪 SDK Maven 仓库 END ==========
    required: true
    onSuccess: edit_app_build_gradle
    note: 在 dependencyResolutionManagement.repositories 中添加

  - id: check_root_build_gradle
    type: check_file
    description: 检查项目级 build.gradle 是否有 allprojects
    target: "{{.WorkspacePath}}/build.gradle"
    condition: 文件内容包含 allprojects
    required: true
    onSuccess: edit_root_build_gradle
    onFailure: create_root_build_gradle_config
    note: 旧版 Gradle 使用 allprojects.repositories

  - id: edit_root_build_gradle
    type: edit_file
    description: 在 build.gradle 添加 Maven 仓库（旧版 Gradle）
    target: "{{.WorkspacePath}}/build.gradle"
    insertAfter: "allprojects\\s*\\{[^}]*repositories\\s*\\{"
    content: |
        // ========== 瑞雪 SDK Maven 仓库 ==========
        maven {
            url 'http://60.205.123.114:8081/repository/maven-releases/'
            allowInsecureProtocol = true
        }
        maven {
            credentials {
                username '600685104fb2132a19e09a29'
                password '2IfrbLKz50J1'
            }
            url 'https://packages.aliyun.com/maven/repository/2168735-release-Zcdy1x/'
        }
        // ========== 瑞雪 SDK Maven 仓库 END ==========
    required: true
    onSuccess: edit_app_build_gradle
    note: 在 allprojects.repositories 中添加

  - id: create_root_build_gradle_config
    type: user_input
    description: 需要手动配置仓库
    content: |
      无法自动检测仓库配置位置，请手动在以下位置之一添加 Maven 仓库：
      
      1. settings.gradle 的 dependencyResolutionManagement.repositories
      2. build.gradle 的 allprojects.repositories
      
      Maven 仓库配置：
      maven {
          url 'http://60.205.123.114:8081/repository/maven-releases/'
          allowInsecureProtocol = true
      }
    required: false
    onSuccess: edit_app_build_gradle

  # ========== Kotlin DSL 配置流程 ==========
  
  - id: check_settings_gradle_kts
    type: edit_file
    description: 在 settings.gradle.kts 添加 Maven 仓库
    target: "{{.WorkspacePath}}/settings.gradle.kts"
    insertAfter: "repositories\\s*\\{"
    content: |
        // ========== 瑞雪 SDK Maven 仓库 ==========
        maven {
            url = uri("http://60.205.123.114:8081/repository/maven-releases/")
            isAllowInsecureProtocol = true
        }
        maven {
            credentials {
                username = "600685104fb2132a19e09a29"
                password = "2IfrbLKz50J1"
            }
            url = uri("https://packages.aliyun.com/maven/repository/2168735-release-Zcdy1x/")
        }
        // ========== 瑞雪 SDK Maven 仓库 END ==========
    required: true
    onSuccess: edit_app_build_gradle_kts
    note: Kotlin DSL 语法

  # ========== App 模块依赖配置 ==========
  
  - id: edit_app_build_gradle
    type: edit_file
    description: 在 app/build.gradle 添加 SDK 依赖
    target: "{{.WorkspacePath}}/app/build.gradle"
    insertAfter: "dependencies\\s*\\{"
    content: |
        // ========== 瑞雪 SDK 依赖 ==========
        implementation 'com.ruixue:{{.Channel}}:{{.Version}}'
        // ========== 瑞雪 SDK 依赖 END ==========
    required: true
    onSuccess: check_java_version
    note: 添加 SDK 依赖到 app 模块

  - id: edit_app_build_gradle_kts
    type: edit_file
    description: 在 app/build.gradle.kts 添加 SDK 依赖
    target: "{{.WorkspacePath}}/app/build.gradle.kts"
    insertAfter: "dependencies\\s*\\{"
    content: |
        // ========== 瑞雪 SDK 依赖 ==========
        implementation("com.ruixue:{{.Channel}}:{{.Version}}")
        // ========== 瑞雪 SDK 依赖 END ==========
    required: true
    onSuccess: check_java_version_kts
    note: 添加 SDK 依赖到 app 模块（Kotlin DSL）

  # ========== Java 版本配置 ==========
  
  - id: check_java_version
    type: check_file
    description: 检查是否已配置 Java 1.8
    target: "{{.WorkspacePath}}/app/build.gradle"
    condition: 文件内容包含 JavaVersion.VERSION_1_8
    required: false
    onSuccess: check_gradle_properties
    onFailure: add_java_version
    note: SDK 需要 Java 1.8 或更高版本

  - id: add_java_version
    type: edit_file
    description: 添加 Java 版本配置
    target: "{{.WorkspacePath}}/app/build.gradle"
    insertAfter: "android\\s*\\{"
    content: |
        compileOptions {
            sourceCompatibility JavaVersion.VERSION_1_8
            targetCompatibility JavaVersion.VERSION_1_8
        }
    required: true
    onSuccess: check_gradle_properties
    note: 在 android 块中添加 compileOptions

  - id: check_java_version_kts
    type: check_file
    description: 检查是否已配置 Java 1.8（Kotlin DSL）
    target: "{{.WorkspacePath}}/app/build.gradle.kts"
    condition: 文件内容包含 JavaVersion.VERSION_1_8
    required: false
    onSuccess: check_gradle_properties
    onFailure: add_java_version_kts
    note: SDK 需要 Java 1.8 或更高版本

  - id: add_java_version_kts
    type: edit_file
    description: 添加 Java 版本配置（Kotlin DSL）
    target: "{{.WorkspacePath}}/app/build.gradle.kts"
    insertAfter: "android\\s*\\{"
    content: |
        compileOptions {
            sourceCompatibility = JavaVersion.VERSION_1_8
            targetCompatibility = JavaVersion.VERSION_1_8
        }
    required: true
    onSuccess: check_gradle_properties
    note: 在 android 块中添加 compileOptions

  # ========== Gradle Properties 配置 ==========
  
  - id: check_gradle_properties
    type: check_file
    description: 检查 gradle.properties 是否已配置 Jetifier
    target: "{{.WorkspacePath}}/gradle.properties"
    condition: 文件内容包含 android.enableJetifier=true
    required: false
    onSuccess: sync_gradle
    onFailure: add_jetifier
    note: Jetifier 用于 Support Library 到 AndroidX 的迁移

  - id: add_jetifier
    type: edit_file
    description: 启用 Jetifier
    target: "{{.WorkspacePath}}/gradle.properties"
    insertAfter: "$"
    content: |
      
      # ========== 瑞雪 SDK 配置 ==========
      android.useAndroidX=true
      android.enableJetifier=true
      # ========== 瑞雪 SDK 配置 END ==========
    required: true
    onSuccess: sync_gradle
    note: 在文件末尾添加 Jetifier 配置

  # ========== 同步 Gradle ==========
  
  - id: sync_gradle
    type: run_command
    description: 同步 Gradle 项目
    target: ./gradlew --refresh-dependencies
    workingDir: "{{.WorkspacePath}}"
    required: false
    onSuccess: setup_complete
    onFailure: sync_gradle_fallback
    note: 下载依赖并验证配置

  - id: sync_gradle_fallback
    type: user_input
    description: Gradle 同步失败
    content: |
      Gradle 同步失败，请尝试以下方法：
      1. 在 Android Studio 中点击 "Sync Project with Gradle Files"
      2. 检查网络连接是否正常
      3. 查看 Build 输出确认错误原因
      
      常见问题：
      - 如果提示找不到依赖，检查 Maven 仓库配置是否正确
      - 如果提示版本冲突，尝试更新其他依赖版本
    required: false
    onSuccess: setup_complete

  - id: setup_complete
    type: user_input
    description: SDK 依赖配置完成
    content: |
      瑞雪 SDK 依赖已成功配置！
      
      后续步骤：
      1. 在 Application 类中配置 SDK 初始化
      2. 在主 Activity 中调用初始化方法
      3. 配置 ProGuard 混淆规则（如开启混淆）
      
      提示：
      - 执行 android_init 可获取 SDK 初始化代码示例
      - 执行 android_login 可获取登录功能代码
    required: false
    note: 依赖配置完成后的提示信息

