# ==================== 登录弹窗 UI ====================
showLoginUI:
  method_name: "RXSdkUI.getInstance().showLoginUI"
  description: 显示登录弹窗 UI（国内版）
  parameters:
    - name: activity
      type: Activity
      required: true
      description: 当前 Activity
    - name: loginUIConfig
      type: RXLoginUIModel
      required: true
      description: 登录 UI 配置
    - name: callback
      type: RXRequestCallback
      required: true
      description: 登录回调
  code: |
    // ========== 瑞雪 SDK 登录弹窗 UI ==========
    // 注意：需要添加 UI 模块依赖 implementation 'com.ruixue:rxsdk_base_ui:${version}'
    
    import com.ruixue.openapi.RXSdkUI;
    import com.ruixue.openapi.RXLoginUIModel;
    import com.ruixue.RXRequestCallback;
    
    // 构造登录 UI 配置
    RXLoginUIModel loginUIConfig = new RXLoginUIModel();
    loginUIConfig.setLoginMode(1);  // 登录模式，类型 int
    // loginUIConfig.setMethod(loginMethod);  // 可选，登录方式列表
    // loginUIConfig.setLoginOpenid(openid);  // 可选，自动登录的 openid
    
    // 显示登录弹窗
    RXSdkUI.getInstance().showLoginUI(activity, loginUIConfig, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                JSONObject data = jsonObject.optJSONObject("data");
                if (data != null) {
                    String openid = data.optString("openid");
                    String token = data.optString("token");
                    Log.d("RXSDK", "登录成功: openid=" + openid);
                }
                // TODO: 处理登录成功逻辑
            } else {
                String msg = jsonObject.optString("msg");
                Log.e("RXSDK", "登录失败: " + msg);
                // TODO: 处理登录失败逻辑
            }
        }
    });

# RXLoginUIModel 配置参数
login_ui_config:
  class_name: RXLoginUIModel
  description: 登录 UI 配置对象
  fields:
    - name: loginMode
      type: int
      required: false
      setter: setLoginMode
      description: 登录模式
    - name: method
      type: List<String>
      required: false
      setter: setMethod
      description: 登录方式列表
    - name: loginOpenid
      type: String
      required: false
      setter: setLoginOpenid
      description: 自动登录的 openid
    - name: privacies
      type: Map<String, String>
      required: false
      setter: setPrivacies
      description: 隐私协议配置

# 导入语句
imports:
  - "import android.app.Activity;"
  - "import android.util.Log;"
  - "import com.ruixue.openapi.RXSdkUI;"
  - "import com.ruixue.openapi.RXLoginUIModel;"
  - "import com.ruixue.RXRequestCallback;"
  - "import org.json.JSONObject;"

# 依赖检查
dependency_check:
  ui_module:
    required: true
    artifact: "com.ruixue:rxsdk_base_ui"
    description: 登录 UI 需要添加此依赖

# AI 行为指南
check_guide: |
  插入登录 UI 代码前必须执行以下检查:
  1. 读取项目的 app/build.gradle 或 build.gradle.kts 文件
  2. 搜索是否存在 'com.ruixue:rxsdk_base_ui' 依赖
  3. 如果不存在该依赖:
     - 【必须】自动添加依赖到 app/build.gradle，无需询问用户
     - 依赖格式: implementation 'com.ruixue:rxsdk_base_ui:${version}'
     - 版本号与项目中其他 rxsdk 依赖保持一致
  4. 添加完依赖后，继续插入登录 UI 代码
  
  ⚠️ 重要：UI 模块依赖是必须的，不要询问用户，直接添加！

