# 瑞雪 SDK Android Adjust 组件接入规范
# Generated by MCP
# 包含：初始化、会话跟踪、事件/收入、归因/深链、会话参数、防作弊签名

# ==================== 占位符说明 ====================
placeholder_note:
  description: "@test 是占位符，接入时必须替换为真实业务参数。"

# ==================== 概述 ====================
overview:
  description: Adjust Android 组件封装，提供广告归因、事件跟踪、收入跟踪、深度链接、会话参数和防作弊签名接入说明。
  keywords:
    - Adjust
    - Attribution
    - DeepLink
    - AdRevenue
  note: |
    1. 海外渠道引用 com.ruixue:rxsdk_adjust:${version}
    2. 为增加归因准确性，需要先调用 RuiXueSdk.setInitParams，再初始化 Adjust
    3. 测试环境使用 RxAdjustConfig.ENVIRONMENT_SANDBOX，发布前切换为 ENVIRONMENT_PRODUCTION
    4. API 14+ 建议在 Application 中注册 ActivityLifecycleCallbacks 做会话跟踪

# ==================== 接入前检查 ====================
preflight_check:
  required:
    - app/build.gradle 或 app/build.gradle.kts 已添加 com.ruixue:rxsdk_adjust:${version}
    - AndroidManifest.xml 已声明 INTERNET、ACCESS_NETWORK_STATE 权限
    - 非 Google Play 商店分发时建议声明 ACCESS_WIFI_STATE 权限
    - 初始化前已准备 appToken、environment，并在瑞雪 setInitParams 后初始化 Adjust
  failure_action: "缺少 rxsdk_adjust 依赖、权限或初始化代码时，先补齐基础接入，再插入 Adjust 业务代码。"

# ==================== Gradle 依赖 ====================
dependency:
  artifact: "com.ruixue:rxsdk_adjust:${version}"
  groovy: |
    dependencies {
        implementation 'com.ruixue:rxsdk_adjust:${version}'
    }

# ==================== AndroidManifest 权限 ====================
manifest_permissions: |
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <!-- 非 Google Play 商店分发时建议添加 -->
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>

  <!-- 支持 INSTALL_REFERRER intent 的应用商店可添加 -->
  <receiver
      android:name="com.adjust.sdk.AdjustReferrerReceiver"
      android:permission="android.permission.INSTALL_PACKAGES"
      android:exported="true">
      <intent-filter>
          <action android:name="com.android.vending.INSTALL_REFERRER" />
      </intent-filter>
  </receiver>

# ==================== 初始化 ====================
init:
  method_name: "AdjustSdkWrapper.getInstance().init"
  description: 初始化 Adjust，建议在 Application.onCreate 中执行
  imports:
    - "import android.app.Application;"
    - "import com.ruixue.RuiXueSdk;"
    - "import com.ruixue.sdk.adjust.AdjustSdkWrapper;"
    - "import com.ruixue.sdk.adjust.config.RxAdjustConfig;"
    - "import com.ruixue.sdk.adjust.config.RxLogLevel;"
  code: |
    public class GlobalApplication extends Application {
        @Override
        public void onCreate() {
            super.onCreate();

            // 为了增加 Adjust 归因准确性，先设置瑞雪初始化参数，再初始化 Adjust
            RuiXueSdk.setInitParams("@test", "@test", "@test", "@test");

            String environment = RxAdjustConfig.ENVIRONMENT_PRODUCTION;
            RxAdjustConfig config = new RxAdjustConfig(this, "@test", environment);
            config.setLogLevel(RxLogLevel.WARN);
            AdjustSdkWrapper.getInstance().init(this, config);

            registerActivityLifecycleCallbacks(new AdjustLifecycleCallbacks());
        }
    }

# ==================== 会话跟踪 ====================
session_tracking:
  description: API 14+ 推荐通过 ActivityLifecycleCallbacks 自动转发 onResume/onPause
  code: |
    private static final class AdjustLifecycleCallbacks implements Application.ActivityLifecycleCallbacks {
        @Override
        public void onActivityResumed(@NonNull Activity activity) {
            AdjustSdkWrapper.getInstance().onResume(activity);
        }

        @Override
        public void onActivityPaused(@NonNull Activity activity) {
            AdjustSdkWrapper.getInstance().onPause(activity);
        }

        @Override public void onActivityCreated(@NonNull Activity activity, Bundle savedInstanceState) {}
        @Override public void onActivityStarted(@NonNull Activity activity) {}
        @Override public void onActivityStopped(@NonNull Activity activity) {}
        @Override public void onActivitySaveInstanceState(@NonNull Activity activity, @NonNull Bundle outState) {}
        @Override public void onActivityDestroyed(@NonNull Activity activity) {}
    }

# ==================== 事件跟踪 ====================
event_tracking:
  method_name: "AdjustSdkWrapper.getInstance().trackEvent"
  imports:
    - "import com.ruixue.sdk.adjust.config.RxAdjustEvent;"
  code: |
    RxAdjustEvent event = new RxAdjustEvent("@test");
    event.setRevenue(0.01, "@test");
    event.setOrderId("@test");
    event.setCallbackId("@test");
    event.addCallbackParameter("@test", "@test");
    event.addPartnerParameter("@test", "@test");
    AdjustSdkWrapper.getInstance().trackEvent(event);

# ==================== 回调与归因 ====================
callbacks_and_attribution:
  config_callbacks:
    - "setOnRxAttributionChangedListener"
    - "setOnRxEventTrackingSucceededListener"
    - "setOnRxEventTrackingFailedListener"
    - "setOnRxSessionTrackingSucceededListener"
    - "setOnRxSessionTrackingFailedListener"
    - "setOnRxDeeplinkResponseListener"
  code: |
    config.setNeedsCost(true);
    config.setOnRxAttributionChangedListener(attribution -> {
        Log.d("Adjust", "Attribution: " + attribution);
    });
    config.setOnRxDeeplinkResponseListener(deeplink -> {
        Log.d("Adjust", "Deferred deeplink: " + deeplink);
        return true;
    });
  get_attribution: |
    RxAdjustAttribution attribution = AdjustSdkWrapper.getInstance().getAttribution();

# ==================== 深度链接 ====================
deep_link:
  manifest: |
    <activity android:name=".MainActivity">
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="adjustExample" />
        </intent-filter>
    </activity>
  code: |
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        Uri uri = AdjustSdkWrapper.getInstance().getData(getIntent());
        if (uri != null) {
            AdjustSdkWrapper.getInstance().appWillOpenUrl(uri, getApplicationContext());
        }
    }

    @Override
    protected void onNewIntent(Intent intent) {
        super.onNewIntent(intent);
        Uri uri = AdjustSdkWrapper.getInstance().getData(intent);
        if (uri != null) {
            AdjustSdkWrapper.getInstance().appWillOpenUrl(uri, getApplicationContext());
        }
    }

    AdjustSdkWrapper.getInstance().resolveLink(uri.toString(), new String[]{"@test"}, getApplicationContext());

# ==================== 会话参数 ====================
session_parameters:
  code: |
    AdjustSdkWrapper.getInstance().addSessionCallbackParameter("@test", "@test");
    AdjustSdkWrapper.getInstance().removeSessionCallbackParameter("@test");
    AdjustSdkWrapper.getInstance().resetSessionCallbackParameters();

    AdjustSdkWrapper.getInstance().addSessionPartnerParameter("@test", "@test");
    AdjustSdkWrapper.getInstance().removeSessionPartnerParameter("@test");
    AdjustSdkWrapper.getInstance().resetSessionPartnerParameters();

    config.setDelayStart(5.5);
    AdjustSdkWrapper.getInstance().sendFirstPackages();

# ==================== 防作弊签名库 ====================
signature_library:
  dependency: "implementation 'com.adjust.signature:adjust-android-signature:x.x.x'"
  note: "签名库无需改变 Adjust SDK 调用方式；需在 Adjust suite 配置所有调试/正式证书 SHA-1 指纹。"

# ==================== 注意事项 ====================
notes:
  - title: 初始化顺序
    content: 为提高归因准确性，先调用 RuiXueSdk.setInitParams，再初始化 Adjust。
  - title: 环境切换
    content: 测试使用 RxAdjustConfig.ENVIRONMENT_SANDBOX，提交商店前切换为 ENVIRONMENT_PRODUCTION。
  - title: 生命周期
    content: API 14+ 使用 ActivityLifecycleCallbacks 统一转发 onResume/onPause。
  - title: 文档范围
    content: 当前 MCP 仅接入 Adjust 文档中出现的 Android 接口；SDK 内部存在但文档未列出的接口不在本模板中生成。
  - title: 防作弊签名
    content: 如接入 adjust-android-signature，需要在 Adjust suite 配置所有证书指纹并用 release 包测试。
