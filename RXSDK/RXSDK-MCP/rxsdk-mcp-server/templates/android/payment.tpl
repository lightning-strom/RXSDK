# 星驿/星轶 App 支付（DyPay）
code_xingyi_app: |
  // ========== 瑞雪 SDK 星驿/星轶 App 支付（hq_type=xy）==========
  // 【版本】自 Android SDK 4.0.14 起支持；请使用 ≥4.0.14
  // 依赖: implementation 'com.ruixue:rxsdk_xingyi:4.0.14'（或与宿主对齐的 ≥4.0.14）
  // 宿主白名单需包含 RX_PLUGIN_PAY_XINGYI
  // 服务端在 ext.appPayData 下发 DyPay 字段；客户端原样透传，不做字段映射

  /**
   * 星驿 App 原生支付
   * @param activity 当前 Activity
   * @param goodsTag 瑞雪后台计费点名称
   * @param tradeNo CP 订单号
   */
  private void doXingYiAppPay(Activity activity, String goodsTag, String tradeNo) {
      Map<String, Object> payParams = new HashMap<>();
      payParams.put("hq_type", "xy");              // 统一支付类型（后台 type 也是 xy）
      payParams.put("goods_tag", goodsTag);
      payParams.put("trade_no", tradeNo);
      // 不要传 ext.is_h5，或显式 is_h5=0，才会走 App（DyPay）分支
      // Map<String, Object> ext = new HashMap<>();
      // ext.put("is_h5", 0);
      // payParams.put("ext", ext);

      RXSDK.getInstance().pay(activity, payParams, new RXRequestCallback() {
          @Override
          public void onResponse(JSONObject jsonObject) {
              int code = jsonObject.optInt("code", -1);
              if (code == 0) {
                  Log.d("RXSDK", "星驿 App 支付回调成功；发货以服务端通知/查单为准");
              } else {
                  Log.e("RXSDK", "星驿 App 支付失败: code=" + code
                          + ", msg=" + jsonObject.optString("msg")
                          + ", thirdcode=" + jsonObject.opt("thirdcode")
                          + ", thirdmsg=" + jsonObject.opt("thirdmsg"));
              }
          }
      });
  }

# 星驿/星轶 H5 支付（WebView）
code_xingyi_h5: |
  // ========== 瑞雪 SDK 星驿/星轶 H5 支付（hq_type=xy + ext.is_h5=1）==========
  // 【版本】自 Android SDK 4.0.14 起支持；请使用 ≥4.0.14
  // 依赖: implementation 'com.ruixue:rxsdk_h5pay:4.0.14'（或与宿主对齐的 ≥4.0.14）
  //       （App 场景建议同时保留 com.ruixue:rxsdk_xingyi:≥4.0.14）
  // H5 URL 由下单结果解析：plug_url / ext.h5PayData.payUrl / ext.url / url / ext.h5 / h5
  // 回跳：ruixue://pay/success|failure|cancel

  /**
   * 星驿 H5 支付
   * @param activity 当前 Activity
   * @param goodsTag 瑞雪后台计费点名称
   * @param tradeNo CP 订单号
   */
  private void doXingYiH5Pay(Activity activity, String goodsTag, String tradeNo) {
      Map<String, Object> ext = new HashMap<>();
      ext.put("is_h5", 1);                         // 关键：走 XingYiH5 / rxsdk_h5pay
      // ext.put("openBrowser", true);             // 可选：系统浏览器打开

      Map<String, Object> payParams = new HashMap<>();
      payParams.put("hq_type", "xy");              // 新接入统一用 xy（勿新建业务侧写 xyh5）
      payParams.put("goods_tag", goodsTag);
      payParams.put("trade_no", tradeNo);
      payParams.put("ext", ext);

      RXSDK.getInstance().pay(activity, payParams, new RXRequestCallback() {
          @Override
          public void onResponse(JSONObject jsonObject) {
              int code = jsonObject.optInt("code", -1);
              if (code == 0) {
                  Log.d("RXSDK", "星驿 H5 支付成功；发货以服务端回调为准");
              } else {
                  Log.e("RXSDK", "星驿 H5 支付失败: code=" + code
                          + ", msg=" + jsonObject.optString("msg"));
              }
          }
      });
  }

# 支付宝支付代码
code_alipay: |
  // ========== 瑞雪 SDK 支付宝支付 ==========
  /**
   * 支付宝支付
   * @param activity 当前 Activity
   * @param goodsTag 瑞雪后台计费点名称
   * @param tradeNo CP 订单号
   */
  private void doAlipay(Activity activity, String goodsTag, String tradeNo) {
      String payType = "alipay";
      
      HQParams.GameInfo gameInfo = new HQParams.GameInfo();
      gameInfo.setCpGameCharacterId(角色ID);  // 角色 ID 类型 String
      gameInfo.setCpGameAreaId(区服ID);        // 区服 ID 类型 String

      Map<String, Object> payParams = new HashMap<>();
      payParams.put("hq_type", payType);
      payParams.put("goods_tag", goodsTag);
      payParams.put("trade_no", tradeNo);
      payParams.put("game_info", gameInfo.toMap());
      payParams.put("indulge_auth", 1);

      RXSDK.getInstance().pay(activity, payParams, new RXRequestCallback() {
          @Override
          public void onResponse(JSONObject jsonObject) {
              int code = jsonObject.optInt("code", -1);
              if (code == 0) {
                  Log.d("RXSDK", "支付宝支付成功");
                  // TODO: 处理支付成功逻辑
              } else {
                  String msg = jsonObject.optString("msg");
                  Log.e("RXSDK", "支付宝支付失败: " + msg);
              }
          }
      });
  }

# 查询订单状态
tradeQuery:
  method_name: "RXSDK.getInstance().tradeQuery"
  description: 查询订单状态
  parameters:
    - name: orderNo
      type: String
      required: true
      description: 瑞雪订单号
    - name: callback
      type: RXRequestCallback
      required: true
      description: 查询结果回调
  code: |
    // ========== 瑞雪 SDK 查询订单状态 ==========
    String orderNo = "RX_ORDER_NO";  // 必填，瑞雪订单号，类型 String

    RXSDK.getInstance().tradeQuery(orderNo, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                JSONObject data = jsonObject.optJSONObject("data");
                Log.d("RXSDK", "订单查询成功: " + data);
            } else {
                Log.e("RXSDK", "订单查询失败: " + jsonObject.optString("msg"));
            }
        }
    });

# 检查指南 (给 AI 的指令)
check_guide:
  - 检查是否存在 RXSDK.getInstance().pay 方法调用
  - 验证参数数量是否为 3 个 (Activity, Map<String, Object>, RXRequestCallback)
  - 验证 payParams 是否设置了必填字段 (hq_type, goods_tag, trade_no)
  - 验证回调是否实现了 onResponse(JSONObject) 方法
  - 如果使用微信支付，检查是否有依赖 'com.ruixue:rxsdk_weixin_withpay'
  - 如果使用星驿/星轶（hq_type=xy 或关键词含星驿/星轶/xingyi）：
      - 工程瑞雪 SDK / 支付插件版本须 ≥ 4.0.14
      - App：依赖 rxsdk_xingyi，且未错误地固定 is_h5=1
      - H5：ext.is_h5=1，依赖 rxsdk_h5pay；可同时保留 rxsdk_xingyi
      - 新代码勿再写 hq_type=xyh5（旧值仅兼容）
  - 如果参数缺失或类型不匹配，提示修复建议

