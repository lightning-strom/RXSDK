# 瑞雪 SDK 支付功能
# Generated by MCP

# ==================== RuStore 接入前强制检查 ====================
preflight_check:
  rustore:
    min_android_sdk: "4.0.11"
    required_dependency: "com.ruixue:rxsdk_rustore:4.0.11"
    required_init:
      - "RXSDK.initialize"
      - "RXSdkInitConfig"
    auto_upgrade:
      - 传入 workspacePath 时，MCP 会检查 Gradle 中 com.ruixue:* 依赖版本
      - 低于 4.0.11 时会自动升级到 4.0.11
      - 未找到 build.gradle、rxsdk_rustore 依赖或初始化代码时，返回 preflight.missing 和 nextSteps
    failure_action: "先执行 android feature=setup channel=rxsdk_rustore version=4.0.11 或 android feature=dependency channel=rxsdk_rustore version=4.0.11，再接入 hq_type=rupay 支付代码。"

# 方法签名规范 (用于代码检查)
signature:
  method_name: "RXSDK.getInstance().pay"
  parameters:
    - name: activity
      type: Activity
      required: true
      description: 当前 Activity (应用上下文)
    - name: payParams
      type: Map<String, Object>
      required: true
      description: 支付参数
    - name: callback
      type: RXRequestCallback
      required: true
      description: 支付回调

# 支付类型
pay_types:
  - name: wechat
    value: "wechat"
    description: 微信支付
    required_dependency: "com.ruixue:rxsdk_weixin_withpay:${version}"
  - name: alipay
    value: "alipay"
    description: 支付宝支付
    required_dependency: "com.ruixue:rxsdk_alipay:${version}"
  - name: xy
    value: "xy"
    aliases: ["星驿", "星轶", "xingyi"]
    description: 星驿/星轶支付（统一 hq_type=xy；App 走 DyPay，H5 走 is_h5=1）
    min_sdk_version: "4.0.14"
    required_dependency_app: "com.ruixue:rxsdk_xingyi:${version}"
    required_dependency_h5: "com.ruixue:rxsdk_h5pay:${version}"
    notes: |
      - 【版本】Android SDK ≥ 4.0.14 起正式支持；低于此版本勿接入星驿/星轶支付
      - 推荐依赖版本：implementation 'com.ruixue:rxsdk_xingyi:4.0.14'（或与宿主对齐的 ≥4.0.14）
      - 后台支付方式 type 统一为 xy（勿再新建独立 xyh5）
      - App：不传 ext.is_h5 或 is_h5=0 → rxsdk_xingyi / DyPay；需宿主白名单含 RX_PLUGIN_PAY_XINGYI
      - H5：ext.is_h5=1 → rxsdk_h5pay / XingYiH5；需同时集成 rxsdk_h5pay（RX_PLUGIN_HQ）
      - 兼容旧参：hq_type=xyh5 会归一化为 xy + is_h5=1
      - H5 URL 优先级：plug_url / ext.h5PayData.payUrl / ext.url / url / ext.h5 / h5
      - 回跳：ruixue://pay/success|failure|cancel
  - name: rustore
    value: "rustore"
    description: RuStore 支付（海外）
    min_android_sdk: "4.0.11"
    required_dependency: "com.ruixue:rxsdk_rustore:4.0.11"
  - name: apkpure
    value: "apkpure"
    description: Apkpure/VGamePop 支付（海外）
  - name: ogood
    value: "ogood"
    description: Ogood 支付（海外）

# 支付参数规范
pay_params:
  type: Map<String, Object>
  fields:
    - name: hq_type
      type: String
      required: true
      description: 支付类型 (wechat/alipay/xy/rustore/apkpure/ogood；星驿/星轶用 xy)
    - name: goods_tag
      type: String
      required: true
      description: 瑞雪后台计费点名称
    - name: trade_no
      type: String
      required: true
      description: CP 订单号
    - name: transmit_args
      type: String
      required: false
      description: CP 透传参数
    - name: ext
      type: Map<String, Object>
      required: false
      description: 扩展参数
    - name: game_info
      type: Map<String, Object>
      required: false
      description: 游戏信息 (角色ID、区服ID)
    - name: indulge_auth
      type: int
      required: false
      description: 是否进行防沉迷验证 (0 不验证、1 验证，自运营默认 1，三方渠道默认 0)
    - name: custom_ext
      type: Map<String, Object>
      required: false
      description: 自定义透传参数
    - name: bigdata_report
      type: Map<String, Object>
      required: false
      description: 商业化窗口支付参数 (用于大数据上报)

# GameInfo 参数规范
game_info:
  class_name: HQParams.GameInfo
  fields:
    - name: cpGameCharacterId
      type: String
      required: false
      setter: setCpGameCharacterId
      description: 角色 ID
    - name: cpGameAreaId
      type: String
      required: false
      setter: setCpGameAreaId
      description: 区服 ID

# 回调接口规范
callback_interface:
  name: RXRequestCallback
  methods:
    - name: onResponse
      parameters:
        - name: jsonObject
          type: JSONObject
      description: 支付响应回调，code=0 表示成功

# 依赖检查
dependency_check:
  wechat:
    required: true
    artifact: "com.ruixue:rxsdk_weixin_withpay"
    check_file: "app/build.gradle"
    description: 微信支付必须添加此依赖
  rustore:
    required: true
    artifact: "com.ruixue:rxsdk_rustore"
    min_version: "4.0.11"
    check_file: "app/build.gradle"
    description: RuStore 支付必须添加 rxsdk_rustore 4.0.11 或更高版本
  xy_app:
    required: true
    artifact: "com.ruixue:rxsdk_xingyi"
    check_file: "app/build.gradle"
    description: 星驿/星轶 App 支付必须添加此依赖，且宿主 getSupportPluginNames 含 RX_PLUGIN_PAY_XINGYI
  xy_h5:
    required: true
    artifact: "com.ruixue:rxsdk_h5pay"
    check_file: "app/build.gradle"
    description: 星驿/星轶 H5 支付必须添加此依赖（与 App 插件可并存）

# AI 行为指南
check_guide: |
  插入支付代码前按支付类型执行依赖检查:
  【微信支付】
  1. 读取 app/build.gradle 或 build.gradle.kts
  2. 搜索 'com.ruixue:rxsdk_weixin_withpay'；缺失则自动添加（版本对齐其他 rxsdk）
  【星驿/星轶支付（hq_type=xy）】
  0. 确认工程瑞雪 SDK 版本 ≥ 4.0.14（低于此版本不支持星驿/星轶，须先升级宿主与支付插件至 4.0.14+）
  1. App 支付：确保 implementation 'com.ruixue:rxsdk_xingyi:${version}'（version≥4.0.14）
  2. H5 支付（ext.is_h5=1）：同时确保 implementation 'com.ruixue:rxsdk_h5pay:${version}'（version≥4.0.14）
  3. 推荐两行依赖同时添加（可并存）；勿使用已废弃的独立 hq_type=xyh5 作为新接入写法
  4. 提醒：依赖进包后仍需宿主白名单包含 RX_PLUGIN_PAY_XINGYI / RX_PLUGIN_HQ，否则插件不加载
  5. 添加完依赖后，继续插入支付代码

  ⚠️ 微信支付、星驿依赖缺失时直接补齐，不要只口头提醒。

  插入 RuStore 支付代码（hq_type="rupay"）前必须执行以下检查:
  1. 读取项目的 app/build.gradle 或 build.gradle.kts 文件
  2. 搜索是否存在 'com.ruixue:rxsdk_rustore' 依赖
  3. 确认 rxsdk_rustore 版本 >= 4.0.11
  4. 如果版本低于 4.0.11，必须自动升级到 4.0.11
  5. 如果缺少 rxsdk_rustore 依赖，先接入 android feature=dependency channel=rxsdk_rustore version=4.0.11
  6. 添加完依赖后，继续插入 hq_type="rupay" 支付代码

