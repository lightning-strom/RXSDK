      // businessGiftPayMap.put("purchase_medium", "购买礼包介质");
      // businessGiftPayMap.put("price", 100);
      // businessGiftPayMap.put("billing_point", "礼包计费点");
      //
      // businessPayMap.put("gift_package", businessGiftPayMap);
      // payParams.put("bigdata_report", businessPayMap);

      // 【可选】构造大数据透传参数
      // Map<String, Object> bigdataExt = new HashMap<>();
      // bigdataExt.put("event_name", "user_pay");
      // bigdataExt.put("event_value", "wechat");
