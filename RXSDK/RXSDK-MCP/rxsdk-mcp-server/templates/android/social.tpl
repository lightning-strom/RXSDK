# 瑞雪 SDK 社交关系功能
# Generated by MCP
# 包含：添加关系、删除关系、更新备注、判断关系、获取关系列表

# ==================== 设置用户自定义信息 ====================
userSetCustom:
  method_name: "RXSDK.getInstance().userSetCustom"
  description: 设置用户自定义信息
  parameters:
    - name: custom
      type: String
      required: true
      description: 自定义信息（JSON 字符串）
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 设置用户自定义信息 ==========
    String custom = "{\"level\":50,\"vip\":3,\"title\":\"王者\"}";  // 自定义信息（JSON 字符串），类型 String

    RXSDK.getInstance().userSetCustom(custom, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                Log.d("RXSDK", "自定义信息设置成功");
            } else {
                Log.e("RXSDK", "设置失败: " + jsonObject.optString("msg"));
            }
        }
    });

# ==================== 添加自定义关系 ====================
relationAdd:
  method_name: "RXSDK.getInstance().relationAdd"
  description: 添加自定义关系
  parameters:
    - name: target
      type: String
      required: true
      description: 对方 OpenID
    - name: types
      type: Map<String, Object>
      required: true
      description: 关系类型 Map
    - name: targetRemarks
      type: String
      required: false
      description: 备注信息
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 添加自定义关系 ==========
    String targetOpenId = "target_user_openid";  // 必填，对方 OpenID，类型 String
    String relationType = "follow";               // 关系类型: follow/block/mute 等，类型 String
    String remarks = "好友A";                     // 可选，备注，类型 String

    Map<String, Object> types = new HashMap<>();
    types.put(relationType, true);

    RXSDK.getInstance().relationAdd(targetOpenId, types, remarks, null, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                Log.d("RXSDK", "关系添加成功");
            } else {
                Log.e("RXSDK", "关系添加失败: " + jsonObject.optString("msg"));
            }
        }
    });

