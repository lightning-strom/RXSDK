# ==================== 判断是否存在关系 ====================
hasRelation:
  method_name: "RXSDK.getInstance().hasRelation"
  description: 判断两用户是否存在某自定义关系
  parameters:
    - name: target
      type: String
      required: true
      description: 对方 OpenID
    - name: type
      type: String
      required: true
      description: 关系类型
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 判断是否存在关系 ==========
    String targetOpenId = "target_user_openid";  // 必填，对方 OpenID，类型 String
    String relationType = "follow";               // 必填，关系类型，类型 String

    RXSDK.getInstance().hasRelation(targetOpenId, relationType, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                JSONObject data = jsonObject.optJSONObject("data");
                boolean hasRelation = data != null && data.optBoolean("has_relation", false);
                Log.d("RXSDK", "是否存在关系: " + hasRelation);
                // TODO: 根据结果更新 UI
            } else {
                Log.e("RXSDK", "查询失败: " + jsonObject.optString("msg"));
            }
        }
    });

# ==================== 获取关系列表 ====================
relationList:
  method_name: "RXSDK.getInstance().relationList"
  description: 获取自定义关系列表
  parameters:
    - name: type
      type: String
      required: true
      description: 关系类型
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 获取关系列表 ==========
    String relationType = "follow";  // 必填，关系类型，类型 String

    RXSDK.getInstance().relationList(relationType, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                JSONArray list = jsonObject.optJSONArray("data");
                Log.d("RXSDK", "关系列表: " + list);

                if (list != null) {
                    for (int i = 0; i < list.length(); i++) {
                        JSONObject item = list.optJSONObject(i);
                        String openid = item.optString("openid");
                        String nickname = item.optString("nickname");
                        String remarks = item.optString("remarks");
                        Log.d("RXSDK", "用户: " + nickname + ", 备注: " + remarks);
                    }
                }
                // TODO: 更新关系列表 UI
            } else {
                Log.e("RXSDK", "获取列表失败: " + jsonObject.optString("msg"));
            }
        }
    });

