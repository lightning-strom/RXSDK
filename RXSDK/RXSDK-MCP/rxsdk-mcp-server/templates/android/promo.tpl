# ==================== 获取达人游戏内显示福利码 ====================
getPromoDisplayKEY:
  method_name: "RXSDK.getInstance().getPromoDisplayKEY"
  description: 获取达人游戏内显示福利码
  parameters:
    - name: authRefresh
      type: boolean
      required: true
      description: 是否自动刷新
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 获取达人福利码 ==========
    boolean authRefresh = true;  // true: 如果过期自动刷新，false: 直接返回当前值，类型 boolean

    RXSDK.getInstance().getPromoDisplayKEY(authRefresh, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                JSONObject data = jsonObject.optJSONObject("data");
                if (data != null) {
                    String promoKey = data.optString("promo_key");
                    long expireTime = data.optLong("expire_time");
                    boolean isPromoUser = data.optBoolean("is_promo_user", false);

                    if (isPromoUser) {
                        Log.d("RXSDK", "达人福利码: " + promoKey);
                        // TODO: 在游戏内显示福利码
                    } else {
                        Log.d("RXSDK", "当前用户不是达人");
                    }
                }
            } else {
                Log.e("RXSDK", "获取福利码失败: " + jsonObject.optString("msg"));
            }
        }
    });

# ==================== 兑换达人福利码 ====================
exchangePromoCDKEY:
  method_name: "RXSDK.getInstance().exchangePromoCDKEY"
  description: 兑换达人福利码
  parameters:
    - name: cdKey
      type: String
      required: true
      description: 福利码
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 兑换达人福利码 ==========
    String cdKey = "PROMO123456";  // 必填，福利码，类型 String

    RXSDK.getInstance().exchangePromoCDKEY(cdKey, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                JSONObject data = jsonObject.optJSONObject("data");
                if (data != null) {
                    // 兑换成功，获取奖励信息
                    JSONArray rewards = data.optJSONArray("rewards");
                    Log.d("RXSDK", "福利码兑换成功，奖励: " + rewards);
                    // TODO: 显示奖励弹窗
                }
            } else {
                String msg = jsonObject.optString("msg");
                Log.e("RXSDK", "福利码兑换失败: " + msg);
                // 常见错误：福利码无效、已被使用、已过期
            }
        }
    });

