# ==================== 判断是否为好友 ====================
isFriend:
  method_name: "RXSDK.getInstance().isFriend"
  description: 判断两用户是否为好友
  parameters:
    - name: target
      type: String
      required: true
      description: 对方 OpenID
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 判断是否为好友 ==========
    String targetOpenId = "target_user_openid";  // 必填，对方 OpenID，类型 String

    RXSDK.getInstance().isFriend(targetOpenId, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                JSONObject data = jsonObject.optJSONObject("data");
                boolean isFriend = data != null && data.optBoolean("is_friend", false);
                Log.d("RXSDK", "是否为好友: " + isFriend);
                // TODO: 根据结果更新 UI（如显示"添加好友"或"发送消息"按钮）
            } else {
                Log.e("RXSDK", "查询失败: " + jsonObject.optString("msg"));
            }
        }
    });

# ==================== 获取好友列表 ====================
relationFriends:
  method_name: "RXSDK.getInstance().relationFriends"
  description: 获取好友列表
  parameters:
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 获取好友列表 ==========
    RXSDK.getInstance().relationFriends(new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                JSONArray friends = jsonObject.optJSONArray("data");
                Log.d("RXSDK", "好友列表: " + friends);

                // 解析好友列表
                if (friends != null) {
                    for (int i = 0; i < friends.length(); i++) {
                        JSONObject friend = friends.optJSONObject(i);
                        String openid = friend.optString("openid");
                        String nickname = friend.optString("nickname");
                        String avatar = friend.optString("avatar");
                        String remarks = friend.optString("remarks");
                        Log.d("RXSDK", "好友: " + nickname + " (" + remarks + ")");
                    }
                }
                // TODO: 更新好友列表 UI
            } else {
                Log.e("RXSDK", "获取好友列表失败: " + jsonObject.optString("msg"));
            }
        }
    });

