# 瑞雪 SDK 好友管理功能
# Generated by MCP
# 包含：添加好友、删除好友、更新好友备注、判断是否好友、获取好友列表

# ==================== 添加好友 ====================
addFriends:
  method_name: "RXSDK.getInstance().addFriends"
  description: 添加好友
  parameters:
    - name: target
      type: String
      required: true
      description: 对方 OpenID
    - name: targetRemarks
      type: String
      required: false
      description: 用户给对方设置的备注
    - name: userRemarks
      type: String
      required: false
      description: 对方给用户设置的备注
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 添加好友 ==========
    String targetOpenId = "target_user_openid";  // 必填，对方 OpenID，类型 String
    String remarks = "我的好友";                  // 可选，备注，类型 String

    RXSDK.getInstance().addFriends(targetOpenId, remarks, null, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                Log.d("RXSDK", "好友添加成功");
                // TODO: 更新好友列表 UI
            } else {
                String msg = jsonObject.optString("msg");
                Log.e("RXSDK", "好友添加失败: " + msg);
                // 常见错误：对方已是好友、对方不存在
            }
        }
    });

