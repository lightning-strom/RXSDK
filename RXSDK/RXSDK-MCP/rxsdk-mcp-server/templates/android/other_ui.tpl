# ==================== 展示公告 UI ====================
showAnnounceView:
  method_name: "RXSdkUI.getInstance().showAnnounceView"
  description: 展示公告 UI
  parameters:
    - name: context
      type: Context
      required: true
      description: Context
    - name: limit
      type: int
      required: true
      description: 读取条数（limit > 0）
    - name: linkCallback
      type: NoticeCallback
      required: true
      description: 回调
  code: |
    // ========== 瑞雪 SDK 展示公告 UI ==========
    
    import com.ruixue.openapi.RXSdkUI;
    import com.ruixue.view.notice.NoticeCallback;
    
    int limit = 10;  // 读取公告条数
    
    RXSdkUI.getInstance().showAnnounceView(context, limit, new NoticeCallback() {
        @Override
        public void onLink(String link) {
            Log.d("RXSDK", "用户点击链接: " + link);
            // TODO: 处理链接跳转
        }
        
        @Override
        public void hasAnnounceUI(boolean isHas) {
            if (isHas) {
                Log.d("RXSDK", "有公告展示");
            } else {
                Log.d("RXSDK", "没有公告");
            }
        }
    });

