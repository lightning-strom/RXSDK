# ==================== 邮件中心 ====================
showMailCenter:
  method_name: "RXSdkUI.getInstance().showMailCenter"
  description: 展示邮件中心
  parameters:
    - name: activity
      type: Activity
      required: true
      description: 当前 Activity
    - name: userId
      type: String
      required: true
      description: 游戏用户 ID
  code: |
    // ========== 瑞雪 SDK 展示邮件中心 ==========
    
    import com.ruixue.openapi.RXSdkUI;
    
    String userId = "demo_user_001";  // 游戏用户 ID
    
    RXSdkUI.getInstance().showMailCenter(activity, userId).show();

# ==================== 绑定手机 UI ====================
bindPhoneUI:
  method_name: "RXSdkUI.getInstance().bindPhoneUI"
  description: 绑定手机 UI（H5 页面）
  parameters:
    - name: activity
      type: Activity
      required: true
      description: 当前 Activity
    - name: callback
      type: RXUICallback
      required: true
      description: 回调函数
  code: |
    // ========== 瑞雪 SDK 绑定手机 UI ==========
    
    import com.ruixue.openapi.RXSdkUI;
    import com.ruixue.callback.RXUICallback;
    
    RXSdkUI.getInstance().bindPhoneUI(activity, new RXUICallback() {
        @Override
        public void onSuccess(JSONObject data) {
            Log.d("RXSDK", "绑定手机成功: " + data);
        }
        
        @Override
        public void onFailed(JSONObject cause) {
            Log.e("RXSDK", "绑定手机失败或取消");
        }
        
        @Override
        public void onError(RXException e) {
            Log.e("RXSDK", "绑定手机错误: " + e.getMessage());
        }
    }).show();

