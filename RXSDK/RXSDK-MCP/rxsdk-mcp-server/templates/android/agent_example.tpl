# 瑞雪 SDK Android 接入指南
# Generated by MCP

name: ruixue-sdk-android-integration
version: "{{.Version}}"
default_channel: "{{.Channel}}"

# 接入步骤
steps:
  - id: 1
    name: 添加依赖
    description: 配置 Gradle 依赖
    mcp_tool: android_add_dependency
    parameters:
      channel: "根据目标应用商店选择"
      version: "{{.Version}}"
      gradleType: "groovy 或 kts"
    output: 添加到项目的 build.gradle 文件

  - id: 2
    name: 配置 Application
    description: 选择一种方式配置 Application
    options:
      - name: 直接继承 (推荐)
        code: |
          import com.ruixue.openapi.RXApplication;
          public class GameApplication extends RXApplication {
              @Override
              public void onCreate() {
                  super.onCreate();
              }
          }
      - name: 间接调用
        code: |
          import com.ruixue.openapi.RXSDK;
          public class GameApplication extends Application {
              @Override
              public void onCreate() {
                  super.onCreate();
                  RXSDK.onApplicationCreate(this);
              }
              @Override
              protected void attachBaseContext(Context base) {
                  super.attachBaseContext(base);
                  RXSDK.attachBaseContext(base);
              }
          }
      - name: 使用默认 Application
        manifest: |
          <application android:name="com.ruixue.openapi.RXApplication">
          </application>

  - id: 3
    name: 配置 Activity 生命周期
    description: 根据主 Activity 的继承类型自动选择方式
    mcp_tool: android_init
    behavior: |
      AI 行为指南:
      1. 【查找主 Activity】
         a. 读取项目的 AndroidManifest.xml 文件
         b. 搜索包含以下标签的 Activity:
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
         c. 获取该 Activity 的 android:name 属性值 (如 ".MainActivity" 或完整类名)
      
      2. 【定位 Activity 源文件】
         a. 根据 Activity 名称找到对应的 Java/Kotlin 文件
         b. 如果是相对路径 (如 ".MainActivity")，则拼接 package 名
         c. 在 src/main/java 或 src/main/kotlin 目录下查找
      
      3. 【检查继承关系】
         a. 读取 Activity 文件，查找 class 声明行
         b. 检查是否继承 AppCompatActivity 或 FragmentActivity 或实现 LifecycleOwner
            示例: "class MainActivity extends AppCompatActivity"
            示例: "class MainActivity : AppCompatActivity()"
      
      4. 【根据继承类型添加代码】
         如果继承 AppCompatActivity/FragmentActivity/实现 LifecycleOwner:
           - 在 onCreate 方法中添加: RXSDK.trackingLifecycle(this);
           - 添加导入: import com.ruixue.openapi.RXSDK;
         
         如果继承原生 Activity 或其他:
           - 在 onCreate 中添加: RXSDK.onCreate(this);
           - 在 onStart 中添加: RXSDK.onStart(this);
           - 在 onRestart 中添加: RXSDK.onRestart(this);
           - 在 onResume 中添加: RXSDK.onResume(this);
           - 在 onPause 中添加: RXSDK.onPause(this);
           - 在 onStop 中添加: RXSDK.onStop(this);
           - 如需要，在 onNewIntent 中添加: RXSDK.onNewIntent(this, intent);
           - 如需要，在 onActivityResult 中添加: RXSDK.onActivityResult(this, requestCode, resultCode, data);
           - 如需要，在 onConfigurationChanged 中添加: RXSDK.onConfigurationChanged(this, newConfig);
           - 添加导入: import com.ruixue.openapi.RXSDK;
    
    options:
      - name: 自动监听 (推荐，适用于 AppCompatActivity/FragmentActivity)
        condition: "Activity 继承 AppCompatActivity 或 FragmentActivity 或实现 LifecycleOwner"
        code: |
          import com.ruixue.openapi.RXSDK;
          
          @Override
          protected void onCreate(Bundle savedInstanceState) {
              super.onCreate(savedInstanceState);
              // 自动监听生命周期 (仅需这一行)
              RXSDK.trackingLifecycle(this);
          }
      - name: 手动调用 (适用于原生 Activity)
        condition: "Activity 继承 android.app.Activity"
        code: |
          import com.ruixue.openapi.RXSDK;
          
          @Override
          protected void onCreate(Bundle savedInstanceState) {
              super.onCreate(savedInstanceState);
              RXSDK.onCreate(this);
          }
          
          @Override
          protected void onStart() {
              super.onStart();
              RXSDK.onStart(this);
          }
          
          @Override
          protected void onRestart() {
              super.onRestart();
              RXSDK.onRestart(this);
          }
          
          @Override
          protected void onResume() {
              super.onResume();
              RXSDK.onResume(this);
          }
          
          @Override
          protected void onPause() {
              super.onPause();
              RXSDK.onPause(this);
          }
          
          @Override
          protected void onStop() {
              super.onStop();
              RXSDK.onStop(this);
          }

  - id: 4
    name: SDK 初始化
    description: 在主 Activity 的 onCreate 中调用
    mcp_tool: android_init
    code: |
      RXSdkInitConfig config = new RXSdkInitConfig(
          cpid,              // CP ID
          productId,         // 产品 ID
          channelId,         // 渠道 ID
          baseUrlList,       // 域名列表
          new RXRequestCallback() {
              @Override
              public void onResponse(JSONObject response) {
                  int code = response.optInt("code", -1);
                  if (code == 0) {
                      // 初始化成功，data 可能为空
                  } else {
                      // 初始化失败，读取 msg
                      String msg = response.optString("msg");
                  }
              }
          }
      );
      config.setAutoInitThird(true);
      config.setUsePrivacy(true);
      RXSDK.initialize(this, config);

  - id: 5
    name: 隐私协议配置
    optional: true
    description: 在主 Activity 的 onCreate 中调用
    code: |
      RXSDK.getInstance().setPrivacyAgree(context, new PrivacyCallback() {
          @Override
          public void onPrivacyAgree(boolean userClick) {
              // 用户同意后初始化第三方 SDK
          }
      });

  - id: 6
    name: UI 登录功能
    optional: true
    description: 使用 SDK 内置登录界面，推荐大多数场景使用
    mcp_tool: android_login
    method: "RXSdkUI.getInstance().showLoginUI"
    behavior: |
      AI 行为指南:
      1. 检查当前文件是否存在 showLoginUI 调用
      2. 如果不存在: 在光标位置插入样板代码
      3. 如果存在: 检查参数 (Activity, RXLoginUIModel, RXRequestCallback)
      4. 验证回调实现: onResponse(JSONObject)

  - id: 8
    name: API 登录功能
    optional: true
    description: 直接 API 调用，无 UI 界面，适合自定义登录界面场景
    mcp_tool: android_login_api
    method: "RXSDK.getInstance().login"
    login_types:
      - USERNAME: 账号密码登录
      - CAPTCHACODE: 验证码登录
      - GUEST: 游客登录
      - GOOGLE: Google 登录
    behavior: |
      AI 行为指南:
      1. 检查当前文件是否存在 RXSDK.getInstance().login 调用
      2. 如果不存在: 根据 loginType 插入对应样板代码
      3. 如果存在: 检查 LoginParams 参数是否正确
      4. 验证 loginType 为有效的 LoginType 常量
      5. 验证回调实现: onResponse(JSONObject)

  - id: 9
    name: 支付功能
    optional: true
    description: 实现应用内支付
    mcp_tool: android_payment
    behavior: |
      AI 行为指南:
      1. 询问用户需要哪种支付类型 (wechat/alipay/xy 星驿·星轶 App 或 H5)
      2. 【微信支付前置检查】如果是微信支付:
         a. 读取 app/build.gradle 或 build.gradle.kts 文件
         b. 搜索是否存在 'com.ruixue:rxsdk_weixin_withpay' 依赖
         c. 如果不存在: 警告用户并询问是否添加依赖
         d. 如果存在: 继续下一步
      2b. 【星驿/星轶前置检查】如果是 xy：
         a. 确认 version ≥ 4.0.14（星驿支付自 4.0.14 起支持，低于此版本先升级）
         b. App：检查/添加 com.ruixue:rxsdk_xingyi；样板用 code_xingyi_app
         c. H5：检查/添加 com.ruixue:rxsdk_h5pay，且 payParams.ext.is_h5=1；样板用 code_xingyi_h5
         d. 推荐两依赖同引；新接入统一 hq_type=xy
      3. 检查当前文件是否存在 RXSDK.getInstance().pay 调用
      4. 如果不存在: 在光标位置插入样板代码
      5. 如果存在: 检查参数 (Activity, Map<String, Object> payParams, RXRequestCallback)
      6. 验证 payParams 必填字段: hq_type, goods_tag, trade_no
      7. 验证回调实现: onResponse(JSONObject)

# 可用 MCP 工具
mcp_tools:
  - name: android_add_dependency
    description: 生成 Gradle 依赖配置
    required: true
  - name: android_init
    description: 生成初始化代码片段
    required: true
  - name: android_login
    description: UI 登录代码 (使用 SDK 内置界面，智能插入/检查)
