# 接入检查清单
checklist:
  - Gradle 依赖配置完成
  - Application 配置完成
  - Activity 生命周期配置完成 (检查主 Activity 继承类型，选择 trackingLifecycle 或手动调用)
  - SDK 初始化代码添加
  - ProGuard 规则配置 (如开启混淆)
  - 登录功能实现 (可选)
  - 支付功能实现 (可选)
  - 运行测试验证

# Activity 生命周期检测指南
lifecycle_detection:
  description: |
    AI 在接入瑞雪 SDK 时，必须自动检测主 Activity 的继承类型并选择正确的生命周期配置方式
  steps:
    1_find_main_activity:
      action: 读取 AndroidManifest.xml
      search: |
        <activity ...>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
      extract: android:name 属性值
    
    2_locate_source_file:
      action: 根据 Activity 名称定位源文件
      note: |
        - 如果是 ".MainActivity" 形式，需要拼接 package 名
        - 在 src/main/java 或 src/main/kotlin 下查找
    
    3_check_inheritance:
      action: 读取 Activity 源文件，检查 class 声明
      patterns:
        appcompat_java: "extends AppCompatActivity"
        appcompat_kotlin: ": AppCompatActivity()"
        fragment_java: "extends FragmentActivity"
        fragment_kotlin: ": FragmentActivity()"
        native_java: "extends Activity"
        native_kotlin: ": Activity()"
    
    4_apply_lifecycle_code:
      if_appcompat_or_fragment:
        code: "RXSDK.trackingLifecycle(this);"
        location: "onCreate 方法中，setContentView 之后"
      if_native_activity:
        methods:
          - "onCreate: RXSDK.onCreate(this);"
          - "onStart: RXSDK.onStart(this);"
          - "onRestart: RXSDK.onRestart(this);"
          - "onResume: RXSDK.onResume(this);"
          - "onPause: RXSDK.onPause(this);"
          - "onStop: RXSDK.onStop(this);"

# 智能插入功能说明
smart_insert:
  description: |
    android_login、android_login_api 和 android_payment 工具支持智能插入/检查功能:
    - 检查当前文件是否已存在对应代码
    - 如果不存在: 在光标位置插入样板代码
    - 如果存在: 校验参数数量和类型是否正确
    - 参数正确则不做操作，参数错误则提示修复建议
  usage:
    - 用户说"添加登录代码" -> 调用 android_login (UI 方式)
    - 用户说"添加 API 登录" -> 调用 android_login_api (非 UI 方式)
    - 用户说"添加账号密码登录" -> 调用 android_login_api(loginType=USERNAME)
    - 用户说"添加游客登录" -> 调用 android_login_api(loginType=GUEST)
    - 用户说"检查支付代码" -> 调用 android_payment(checkOnly=true)
  login_tools_comparison:
    android_login:
      method: RXSdkUI.getInstance().showLoginUI
      ui: SDK 内置登录界面
      use_case: 推荐大多数场景
    android_login_api:
      method: RXSDK.getInstance().login
      ui: 无 UI，需自定义
      use_case: 自定义登录界面场景
