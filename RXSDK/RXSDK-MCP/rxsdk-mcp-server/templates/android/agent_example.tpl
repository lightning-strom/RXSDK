  - name: android_login_api
    description: API 登录代码 (无 UI，自定义界面场景，智能插入/检查)
    required: false
    smart_insert: true
    method: RXSDK.getInstance().login
    login_types: [USERNAME, CAPTCHACODE, GUEST, GOOGLE]
  - name: android_payment
    description: 支付代码 (智能插入/检查)
    required: false
    smart_insert: true

