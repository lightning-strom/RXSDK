# 瑞雪 SDK 反馈功能
# Generated by MCP
# 包含：获取反馈类型、创建反馈、满意度评价、客服消息

# ==================== 获取反馈类型列表 ====================
getFeedbackKindList:
  method_name: "RXSDK.getInstance().getFeedbackKindList"
  description: 获取反馈类型列表
  parameters:
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 获取反馈类型 ==========
    RXSDK.getInstance().getFeedbackKindList(new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                JSONArray list = jsonObject.optJSONArray("data");
                Log.d("RXSDK", "反馈类型列表: " + list);

                if (list != null) {
                    for (int i = 0; i < list.length(); i++) {
                        JSONObject item = list.optJSONObject(i);
                        String kindId = item.optString("kind_id");
                        String kindName = item.optString("kind_name");
                        Log.d("RXSDK", "反馈类型: " + kindId + " - " + kindName);
                    }
                }
                // TODO: 更新 UI 显示反馈类型列表
            } else {
                Log.e("RXSDK", "获取失败: " + jsonObject.optString("msg"));
            }
        }
    });

# ==================== 创建反馈 ====================
createFeedback:
  method_name: "RXSDK.getInstance().createFeedback"
  description: 创建反馈
  parameters:
    - name: map
      type: Map<String, Object>
      required: true
      description: 反馈参数
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 创建反馈 ==========
    String kindId = "bug_report";          // 必填，反馈类型 ID（从 getFeedbackKindList 获取），类型 String
    String content = "游戏闪退问题描述";    // 必填，反馈内容，类型 String
    String contact = "13800138000";         // 可选，联系方式，类型 String

    Map<String, Object> params = new HashMap<>();
    params.put("kind_id", kindId);
    params.put("content", content);
    params.put("contact", contact);
    // params.put("images", imageUrls);     // 可选，图片 URL 列表
    // params.put("device_info", deviceInfo); // 可选，设备信息

    RXSDK.getInstance().createFeedback(params, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                Log.d("RXSDK", "反馈提交成功");
                // TODO: 提示用户反馈已提交
            } else {
                Log.e("RXSDK", "反馈提交失败: " + jsonObject.optString("msg"));
            }
        }
    });

