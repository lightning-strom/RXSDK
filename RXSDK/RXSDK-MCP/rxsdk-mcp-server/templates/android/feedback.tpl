# ==================== 获取客服未读消息数量 ====================
getServiceChatUnreadCount:
  method_name: "RXSDK.getInstance().getServiceChatUnreadCount"
  description: 获取客服未读消息数量
  parameters:
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 获取客服未读消息 ==========
    RXSDK.getInstance().getServiceChatUnreadCount(new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                JSONObject data = jsonObject.optJSONObject("data");
                int unreadCount = data != null ? data.optInt("unread_count", 0) : 0;
                Log.d("RXSDK", "未读消息数量: " + unreadCount);
                // TODO: 更新 UI 显示未读消息数量角标
            } else {
                Log.e("RXSDK", "获取失败: " + jsonObject.optString("msg"));
            }
        }
    });

