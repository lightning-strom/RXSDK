# 瑞雪 SDK 银联综合支付（Android）
# Generated by MCP

overview:
  feature: unifypay
  supported_platform: Android
  dependency: "com.ruixue:rxsdk_unifypay:4.0.17"
  minimum_android_sdk: "4.0.17"
  minimum_min_sdk: 22
  payment_type: "aums"
  direct_api: "UPPaySdkWrapper.getInstance().doPay"

example_java: |
  import android.app.Activity;
  import android.content.Intent;
  import android.util.Log;

  import androidx.annotation.NonNull;
  import androidx.annotation.Nullable;

  import com.ruixue.RXJSONCallback;
  import com.ruixue.plugin.unifypay.UPPaySdkWrapper;

  import org.json.JSONObject;

  import java.util.HashMap;
  import java.util.Map;

  Map<String, Object> ext = new HashMap<>();
  ext.put("hq_type", "uac");
  ext.put("supportBank", "CCB");
  ext.put("invokeType", "APP");

  Map<String, Object> payParams = new HashMap<>();
  payParams.put("hq_type", "aums");
  payParams.put("goods_tag", "YOUR_GOODS_TAG");
  payParams.put("trade_no", "YOUR_TRADE_NO");
  payParams.put("ext", ext);

  boolean handled = UPPaySdkWrapper.getInstance().doPay(
      activity,
      payParams,
      new RXJSONCallback() {
          @Override
          public void onSuccess(@Nullable JSONObject data) {
              Log.d("UPPay", "银联支付成功: " + data);
          }

          @Override
          public void onFailed(@NonNull JSONObject error) {
              Log.e("UPPay", "银联支付失败: " + error);
          }
      }
  );

  if (!handled) {
      Log.e("UPPay", "银联插件未处理支付请求，请检查外层 hq_type 是否为 aums");
  }

lifecycle_java: |
  @Override
  protected void onNewIntent(Intent intent) {
      super.onNewIntent(intent);
      UPPaySdkWrapper.getInstance().onNewIntent(this, intent);
  }

  @Override
  protected void onActivityResult(int requestCode, int resultCode, Intent data) {
      super.onActivityResult(requestCode, resultCode, data);
      UPPaySdkWrapper.getInstance().onActivityResult(this, requestCode, resultCode, data);
  }

parameters:
  - "外层 payParams.hq_type 固定为 aums，否则 doPay 返回 false。"
  - "ext.hq_type 为银联子支付类型；UAC 场景使用 uac。"
  - "supportBank 按业务配置银行代码，示例 CCB。"
  - "invokeType=APP 表示拉起 App 支付。"
  - "goods_tag 与 trade_no 必须替换为真实计费点和 CP 订单号。"

requirements:
  - "调用前必须完成 RXSDK.initialize / RXSdkInitConfig 基础初始化。"
  - "Gradle 必须集成当前已验证的 com.ruixue:rxsdk_unifypay >= 4.0.17，并与宿主瑞雪 SDK 版本对齐。"
  - "Android minSdkVersion 必须不低于 22。"
  - "宿主 Activity 必须转发 onNewIntent 和 onActivityResult 给 UPPaySdkWrapper。"
  - "支付结果与发货以服务端通知或查单为准。"
