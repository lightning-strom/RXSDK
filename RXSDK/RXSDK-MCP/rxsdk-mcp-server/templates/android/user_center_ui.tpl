# 瑞雪 SDK 用户中心 UI 功能
# Generated by MCP
# 包含：用户中心、帮助中心、客服

# ==================== 用户中心弹窗 ====================
userCenterUI:
  method_name: "RXSdkUI.getInstance().userCenterUI"
  description: 用户中心界面
  parameters:
    - name: activity
      type: Activity
      required: true
      description: 当前 Activity
    - name: rxUserCenterConfig
      type: RXUserCenterConfig
      required: true
      description: 用户中心配置
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调函数
  code: |
    // ========== 瑞雪 SDK 用户中心弹窗 ==========
    // 注意：需要添加 UI 模块依赖 implementation 'com.ruixue:rxsdk_base_ui:${version}'
    
    import com.ruixue.openapi.RXSdkUI;
    import com.ruixue.openapi.RXUserCenterConfig;
    import com.ruixue.RXRequestCallback;
    import org.json.JSONObject;
    import java.util.HashMap;
    import java.util.Map;
    
    // 配置用户中心显示的按钮
    Map<String, Object> ucMap = new HashMap<>();
    ucMap.put("btns", new String[]{
        "real_name",           // 实名认证
        "privacy_policy",      // 隐私政策
        "acount_cancel",       // 账号注销
        "phone_management",    // 手机管理
        "change_pwd"           // 修改密码
    });
    
    // 创建用户中心配置
    RXUserCenterConfig rxUserCenterConfig = new RXUserCenterConfig();
    rxUserCenterConfig.setTransmit_args("透传参数");           // 透传数据，使用 jsonString 形式
    rxUserCenterConfig.setGame_user_id(1000);                  // 用户的游戏 ID
    rxUserCenterConfig.setNickname("用户昵称");                // 用户昵称
    rxUserCenterConfig.setHead_img_url("用户头像URL");         // 用户头像 URL
    rxUserCenterConfig.setQueue_name("default");               // 在瑞雪客服系统设置的接入点名称，不填写默认为 default
    rxUserCenterConfig.setConfigParams(ucMap);                 // 用户中心按钮配置
    // rxUserCenterConfig.setLightTheme(true);                 // 是否使用浅色主题，默认 false
    // rxUserCenterConfig.setSyncInfoEnable(false);            // 是否展示同步信息按钮，默认 false
    
    RXSdkUI.getInstance().userCenterUI(activity, rxUserCenterConfig, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                // 处理成功逻辑
                JSONObject data = jsonObject.optJSONObject("data");
                if (data != null) {
                    String type = data.optString("type");
                    // type 可能的值：
                    // - "real_name": 实名认证
                    // - "logout": 退出登录
                    // - "cancel_account": 注销账号
                    Log.d("RXSDK", "用户中心操作类型: " + type);
                }
            } else {
                String msg = jsonObject.optString("msg");
                Log.e("RXSDK", "用户中心操作失败: " + msg);
                // TODO: 根据错误码处理失败逻辑
            }
        }
    }).show();

