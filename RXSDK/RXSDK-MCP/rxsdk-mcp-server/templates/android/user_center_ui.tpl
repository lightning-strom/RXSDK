# RXUserCenterConfig 配置参数
user_center_config:
  class_name: RXUserCenterConfig
  import_path: com.ruixue.openapi.RXUserCenterConfig
  description: 用户中心/帮助中心/客服配置对象
  fields:
    - name: transmit_args
      type: String
      setter: setTransmit_args
      description: 透传数据，使用 jsonString 形式
    - name: game_user_id
      type: Object
      setter: setGame_user_id
      description: 用户的游戏 ID，不传则在瑞雪后台账号注销页面不显示游戏侧的用户 ID
    - name: nickname
      type: String
      setter: setNickname
      description: 用户昵称
    - name: head_img_url
      type: String
      setter: setHead_img_url
      description: 用户头像 URL
    - name: queue_name
      type: String
      setter: setQueue_name
      description: 在瑞雪客服系统设置的接入点名称，不填写默认为 default
    - name: lightTheme
      type: boolean
      setter: setLightTheme
      description: 是否使用浅色主题，默认 false
    - name: syncInfoEnable
      type: boolean
      setter: setSyncInfoEnable
      description: 是否展示同步信息按钮，用于同步三方信息，默认 false
    - name: configParams
      type: Map<String, Object>
      setter: setConfigParams
      description: 用户中心按钮配置

# 用户中心按钮配置
user_center_btns:
  - name: real_name
