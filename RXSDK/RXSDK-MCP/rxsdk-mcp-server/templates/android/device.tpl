# ==================== 媒体平台自定义行为上报 ====================
addAttribution:
  method_name: "RXSDK.getInstance().addAttribution"
  description: 媒体平台自定义行为上报
  parameters:
    - name: params
      type: Map<String, Object>
      required: true
      description: 上报数据
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 媒体平台自定义行为上报 ==========
    Map<String, Object> params = new HashMap<>();
    params.put("event_type", "custom_event");
    params.put("event_value", "some_value");

    RXSDK.getInstance().addAttribution(params, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                Log.d("RXSDK", "归因上报成功");
            } else {
                String msg = jsonObject.optString("msg");
                Log.e("RXSDK", "归因上报失败: " + msg);
            }
        }
    });

