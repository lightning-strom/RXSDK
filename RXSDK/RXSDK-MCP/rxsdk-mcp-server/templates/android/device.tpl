# ==================== 创建自定义请求 ====================
createRequest:
  method_name: "RXSDK.getInstance().createRequest"
  description: 创建自定义接口请求
  parameters:
    - name: api
      type: String
      required: true
      description: 接口路径
    - name: bodyMap
      type: Map<String, Object>
      required: true
      description: 接口参数
  return_type: IRXRequest
  code: |
    // ========== 瑞雪 SDK 创建自定义请求 ==========
    String api = "/api/custom/endpoint";  // 必填，接口路径，类型 String
    Map<String, Object> bodyMap = new HashMap<>();
    bodyMap.put("param1", "value1");
    bodyMap.put("param2", 123);

    IRXRequest request = RXSDK.getInstance().createRequest(api, bodyMap);

    // 发起异步请求（避免主线程阻塞）
    request.postAsync(new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                JSONObject data = jsonObject.optJSONObject("data");
                Log.d("RXSDK", "自定义请求成功: " + data);
            } else {
                String msg = jsonObject.optString("msg");
                Log.e("RXSDK", "自定义请求失败: " + msg);
            }
        }
    });

