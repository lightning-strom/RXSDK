# 瑞雪 SDK 账号注销功能
# Generated by MCP
# 包含：申请注销账号、撤销注销申请

# ==================== 申请注销账号 ====================
deregister:
  method_name: "RXSDK.getInstance().deregister"
  description: 申请注销账号
  parameters:
    - name: deregisterConfig
      type: RXDeregisterConfig
      required: true
      description: 注销配置
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 申请注销账号 ==========
    // 注意：注销有冷静期，期间可以撤销
    
    RXDeregisterConfig config = new RXDeregisterConfig();
    config.setIdCard("xxxxxx");       // 必填，身份证号码，类型 String
    config.setRealName("张三");        // 必填，真实姓名，类型 String
    // config.setCpData("custom_data");  // 可选，CP 自定义数据，类型 String
    // config.setThirdParams(thirdParams);  // 可选，三方渠道透传数据，类型 Map<String, Object>

    RXSDK.getInstance().deregister(config, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                Log.d("RXSDK", "注销申请已提交");
                // 获取冷静期截止时间
                JSONObject data = jsonObject.optJSONObject("data");
                if (data != null) {
                    String cancelDeadline = data.optString("cancel_deadline");
                    Log.d("RXSDK", "冷静期截止: " + cancelDeadline);
                }
                // TODO: 提示用户冷静期内可以撤销注销
            } else {
                String msg = jsonObject.optString("msg");
                Log.e("RXSDK", "注销申请失败: " + msg);
            }
        }
    });

# ==================== 撤销注销申请 ====================
deregisterCancel:
  method_name: "RXSDK.getInstance().deregisterCancel"
  description: 撤销注销申请
  parameters:
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 撤销注销申请 ==========
    // 在冷静期内可以撤销注销申请

    RXSDK.getInstance().deregisterCancel(new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                Log.d("RXSDK", "注销申请已撤销");
                // TODO: 提示用户账号已恢复正常
            } else {
                String msg = jsonObject.optString("msg");
                Log.e("RXSDK", "撤销注销失败: " + msg);
                // 可能的错误：已超过冷静期
            }
        }
    });

# RXDeregisterConfig 参数规范
deregister_config:
  class_name: RXDeregisterConfig
  description: 注销配置对象（POJO 类，使用 setter 方法）
  fields:
    - name: idcard
      type: String
      required: true
      setter: setIdCard
      description: 身份证号码
    - name: realname
      type: String
      required: true
      setter: setRealName
      description: 真实姓名
    - name: cpdata
      type: String
      required: false
      setter: setCpData
      description: CP 自定义数据
    - name: thirdParams
      type: Map<String, Object>
      required: false
      setter: setThirdParams
      description: 三方渠道透传数据

# 注销流程说明
deregister_flow:
  steps:
    - 用户发起注销申请
    - 系统提交注销申请，进入冷静期（默认15天）
    - 冷静期内用户可以撤销注销申请
    - 冷静期结束后，账号将被永久删除

# 导入语句
imports:
  - "import android.util.Log;"
  - "import com.ruixue.openapi.RXSDK;"
  - "import com.ruixue.openapi.RXDeregisterConfig;"
  - "import com.ruixue.RXRequestCallback;"
  - "import org.json.JSONObject;"

