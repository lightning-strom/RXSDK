              } else {
                  // 登录失败
                  String msg = jsonObject.optString("msg");
                  Log.e("RXSDK", "登录失败: code=" + code + ", msg=" + msg);
                  
                  // TODO: 根据错误码处理失败逻辑
              }
          }
      });
  }

