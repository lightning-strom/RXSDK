      // rxLoginUIModel.setGuestTitle("快速开始");            // 游客登录显示名
      // rxLoginUIModel.setShowClose(true);                  // 显示关闭按钮
      // rxLoginUIModel.setQuickButtonBarVisible(true);      // 显示底部快速登录按钮

      // 【可选】验证码登录新用户设置密码
      // rxLoginUIModel.setFirstNeedSetPassword(false);

      // 【可选】实名认证配置
      // rxLoginUIModel.setNeedRealAuth(true);               // 强制实名认证
      // rxLoginUIModel.setCanCloseRealAuth(false);          // 实名认证不可关闭

      // 【可选】隐私协议配置
      // rxLoginUIModel.setPrivacyOne("用户协议", "https://your-domain.com/terms");
      // rxLoginUIModel.setPrivacyTwo("隐私协议", "https://your-domain.com/privacy");

      // 【可选】自定义透传参数
      // Map<String, Object> customExt = new HashMap<>();
      // customExt.put("event_name", "user_login");
      // rxLoginUIModel.setCustomExt(customExt);

      // 显示登录 UI
      RXSdkUI.getInstance().showLoginUI(activity, rxLoginUIModel, new RXRequestCallback() {
          @Override
          public void onResponse(JSONObject jsonObject) {
              int code = jsonObject.optInt("code", -1);
              if (code == 0) {
                  // 登录成功
                  Log.d("RXSDK", "登录成功: " + jsonObject.toString());
                  
                  // TODO: 处理登录成功逻辑
