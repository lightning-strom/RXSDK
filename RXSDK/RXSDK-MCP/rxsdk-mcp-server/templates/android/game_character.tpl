# ==================== 查询角色列表 ====================
searchGameCharacterListInfo:
  method_name: "RXSDK.getInstance().searchGameCharacterListInfo"
  description: 查询账号下角色信息列表
  parameters:
    - name: cpUserId
      type: String
      required: true
      description: CP 用户 ID
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 查询角色列表 ==========
    String cpUserId = "cp_user_12345";  // 必填，CP 用户 ID，类型 String

    RXSDK.getInstance().searchGameCharacterListInfo(cpUserId, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                JSONArray list = jsonObject.optJSONArray("data");
                Log.d("RXSDK", "角色列表: " + list);

                if (list != null) {
                    for (int i = 0; i < list.length(); i++) {
                        JSONObject character = list.optJSONObject(i);
                        String charId = character.optString("character_id");
                        String charName = character.optString("character_name");
                        String charLevel = character.optString("character_level");
                        String areaId = character.optString("area_id");
                        Log.d("RXSDK", "角色: " + charName + " Lv." + charLevel + " [" + areaId + "]");
                    }
                }
                // TODO: 更新角色列表 UI
            } else {
                Log.e("RXSDK", "查询失败: " + jsonObject.optString("msg"));
            }
        }
    });

