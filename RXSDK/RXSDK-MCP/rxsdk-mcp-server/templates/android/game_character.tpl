  method_name: "RXSDK.getInstance().searchGameCharacterInfo"
  description: 查询具体角色信息
  parameters:
    - name: cpUserId
      type: String
      required: true
      description: CP 用户 ID
    - name: areaId
      type: String
      required: true
      description: 区服 ID
    - name: characterId
      type: String
      required: true
      description: 角色 ID
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 查询角色详情 ==========
    String cpUserId = "cp_user_12345";   // 必填，CP 用户 ID，类型 String
    String areaId = "server_001";        // 必填，区服 ID，类型 String
    String characterId = "char_001";     // 必填，角色 ID，类型 String

    RXSDK.getInstance().searchGameCharacterInfo(cpUserId, areaId, characterId,
            new RXRequestCallback() {
                @Override
                public void onResponse(JSONObject jsonObject) {
                    int code = jsonObject.optInt("code", -1);
                    if (code == 0) {
                        JSONObject data = jsonObject.optJSONObject("data");
                        if (data != null) {
                            String name = data.optString("character_name");
                            String level = data.optString("character_level");
                            String profession = data.optString("character_profession");
                            String vipLevel = data.optString("character_vip_level");
                            Log.d("RXSDK", "角色: " + name + " Lv." + level
                                    + " 职业: " + profession + " VIP: " + vipLevel);
                        }
                    } else {
                        Log.e("RXSDK", "查询失败: " + jsonObject.optString("msg"));
                    }
                }
            }
    );

