# LoginParams 参数规范
login_params:
  class_name: LoginParams
  description: 登录参数对象
  builder_class: LoginParams.Builder
  fields:
    - name: loginType
      type: String
      required: true
      setter: setLoginType
      description: 登录类型 (LoginType.USERNAME/CAPTCHACODE/GUEST/GOOGLE/WECHAT 等)
    - name: username
      type: String
      required: false
      setter: setUsername
      description: 用户名/手机号，账号密码登录和验证码登录时必填
    - name: password
      type: String
      required: false
      setter: setPassword
      description: 密码，仅账号密码登录时必填
    - name: captchaCode
      type: String
      required: false
      setter: setCaptchaCode
      description: 验证码，仅验证码登录时必填
    - name: loginOpenid
      type: String
      required: false
      setter: setLoginOpenid
      description: 上次登录返回的 login_openid，用于二次无感登录
    - name: method
      type: String
      required: false
      setter: setMethod
      description: 上次使用的登录方法
    - name: customExt
      type: Map<String, Object>
      required: false
      setter: setCustomExt
      description: 自定义透传参数

# RegisterParams 参数规范（POJO 类，使用 setter 方法）
register_params:
  class_name: RegisterParams
  description: 注册参数对象（普通 POJO，无 Builder）
  fields:
    - name: username
      type: String
      required: true
