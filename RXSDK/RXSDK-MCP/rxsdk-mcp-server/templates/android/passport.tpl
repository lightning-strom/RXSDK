# ==================== 获取指定用户信息 ====================
getUserInfoByField:
  method_name: "RXSDK.getInstance().getUserInfoByField"
  api: "/v1/passport/user/info_by_field"
  request_method: "POST"
  min_version:
    android: "4.0.9"
  description: 按指定字段获取用户注册信息、登录信息、本次请求信息、防沉迷信息或账号凭证信息
  prompt_guidance: |
    当用户提出“获取用户信息、查询用户资料、查询实名信息、查询绑定信息、查询登录方式、查询防沉迷信息”等需求时，优先使用 getUserInfoByField。
    根据用户问题组合字段，不要固定只查默认字段：
    - 用户实名信息：使用 user 分组，字段通常为 real_auth_id、real_auth_name、real_auth_id_card、real_auth_time、real_auth_ip、real_auth_device_code、age、birthday、sex。
    - 用户基础资料：使用 user 分组，字段通常为 openid、cp_user_id、nickname、avatar、phone、email、flag、regtime。
    - 用户绑定信息 / 用户绑定的登录方式 / 查询用户绑定了哪些账号 / 接入瑞雪查询用户绑定信息：使用 account 分组；如果只问“绑定的登录方式”，参数必须是 account: ["method"]。
    - 当前登录凭证信息：使用 current_account 分组，字段通常为 method、username、user_id、add_time。
    - 上次登录信息：使用 login 分组，字段通常为 method、login_time、last_login_time、devicecode、login_ip。
    - 本次请求环境：使用 current 分组，字段通常为 product_id、channel_id、devicecode、ip、os、os_version。
    - 防沉迷信息：使用 aas 分组，字段通常为 limit、aas、flag、suitable_age、trip。
    - 用户可能要求任意组合，例如“实名信息 + 绑定登录方式”：传 user 的实名字段，同时传 account: ["method"]。
  parameters:
    - name: params
      type: Map<String, Object>
      required: true
      description: 请求参数 map；user/login/current/aas/current_account/account 至少传一个字段分组，openid 与 cp_user_id 用于服务端签名调用时定位用户
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口，成功时返回指定字段信息
  code: |
    // ========== 瑞雪 SDK 获取指定用户信息 ==========
    Map<String, Object> params = new HashMap<>();
    params.put("user", Arrays.asList("openid", "cp_user_id", "nickname", "avatar", "phone", "email", "real_auth_name"));
    params.put("login", Arrays.asList("product_id", "channel_id", "login_time", "last_login_time", "method"));
    params.put("current", Arrays.asList("product_id", "channel_id", "devicecode", "ip", "os", "os_version"));
    params.put("aas", Arrays.asList("flag", "limit", "aas", "suitable_age", "trip"));
    params.put("current_account", Arrays.asList("user_id", "method", "username", "add_time"));
    params.put("account", Arrays.asList("user_id", "method", "username", "add_time"));
    // Accesstoken 调用时无需传 openid/cp_user_id；服务端签名调用时二选一
    // params.put("openid", "rxuxxxx");
    // params.put("cp_user_id", "10001");

    RXSDK.getInstance().getUserInfoByField(params, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                JSONObject data = jsonObject.optJSONObject("data");
                if (data != null) {
                    JSONObject user = data.optJSONObject("user");
                    JSONObject login = data.optJSONObject("login");
                    JSONObject current = data.optJSONObject("current");
                    JSONObject aas = data.optJSONObject("aas");
                    JSONObject currentAccount = data.optJSONObject("current_account");
                    JSONArray accounts = data.optJSONArray("account");

                    Log.d("RXSDK", "指定用户信息: user=" + user
                            + ", login=" + login
                            + ", current=" + current
                            + ", aas=" + aas
                            + ", currentAccount=" + currentAccount
                            + ", accounts=" + accounts);
                }
            } else {
                Log.e("RXSDK", "获取指定用户信息失败: " + jsonObject.optString("msg"));
            }
        }
    });

  supported_fields:
    user: [openid, cp_user_id, product_id, channel_id, custom, source, promoter, devicecode, subchannelid, platformid, attr, nickname, avatar, regtime, regip, birthday, age, sex, user_state, phone, email, flag, topinviter_platformid, topinviter_openid, topinviter_subchannelid, inviter_level, inviter_subchannelid, inviter_openid, inviter_platformid, realauthid, realauth_time, real_auth_id, real_auth_name, real_auth_id_card, real_auth_time, real_auth_ip, real_auth_device_code]
    login: [devicecode, product_id, channel_id, login_ip, login_time, last_login_time, method]
    current: [product_id, channel_id, devicecode, ip, os, os_version]
    aas: [flag, limit, aas, suitable_age, trip]
    account: [user_id, add_time, product_id, channel_id, username, method, devicecode]
  examples:
    real_auth_and_bound_methods:
      description: 获取用户实名信息和用户绑定的登录方式信息
      code: |
        Map<String, Object> params = new HashMap<>();
        params.put("user", Arrays.asList("real_auth_id", "real_auth_name", "real_auth_id_card", "real_auth_time", "age", "sex"));
        params.put("account", Arrays.asList("method"));
    bound_login_methods_only:
      description: 接入瑞雪查询用户绑定信息 / 查询用户绑定的登录方式
      code: |
        Map<String, Object> params = new HashMap<>();
        params.put("account", Arrays.asList("method"));
    profile_and_current_request:
      description: 获取用户基础资料和本次请求环境
      code: |
        Map<String, Object> params = new HashMap<>();
        params.put("user", Arrays.asList("openid", "nickname", "avatar", "phone", "email"));
        params.put("current", Arrays.asList("ip", "os", "os_version"));

