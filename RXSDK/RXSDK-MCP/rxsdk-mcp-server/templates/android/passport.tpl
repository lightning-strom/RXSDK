# ==================== 接入前强制检查 ====================
preflight_check:
  must_do_before_insert_code: true
  description: 在生成 getUserInfoByField 业务代码前，必须先确认宿主工程已完成瑞雪 SDK 基础接入和版本要求。
  checks:
    - name: "检查 Maven 仓库配置"
      target: "settings.gradle / build.gradle"
      required:
        - "已配置瑞雪 Maven 仓库"
      failure_action: "如果未配置仓库，先引导执行 android feature=setup version=4.0.9 或 android feature=dependency version=4.0.9。"
    - name: "检查 Gradle SDK 依赖"
      target: "app/build.gradle / app/build.gradle.kts"
      required:
        - "存在 com.ruixue:* 依赖"
        - "依赖版本 >= 4.0.9"
      failure_action: "如果缺少瑞雪 SDK 依赖或版本低于 4.0.9，先添加/升级到 4.0.9，再执行 Gradle Sync。"
    - name: "检查 SDK 初始化代码"
      target: "Application / Activity / 初始化管理类"
      required:
        - "存在 RXSdkInitConfig 配置"
        - "存在 RXSDK.initialize(...) 调用"
        - "cpid / productId / channelId / baseUrlList 已配置"
        - "AndroidManifest.xml 注册了正确 Application"
      failure_action: "如果未初始化，不要只插入 getUserInfoByField 调用；先生成并接入 android feature=init 初始化代码。"
    - name: "检查调用时机"
      required:
        - "必须在 SDK 初始化成功后调用"
        - "AccessToken 调用场景需要用户已登录"
      failure_action: "若调用位置早于初始化或登录成功回调，先调整调用链。"
  agent_rule: |
    当用户要求“接入瑞雪查询用户绑定信息 / 查询绑定登录方式 / 获取实名信息”等 passport 能力时，
    先执行上述基础接入和版本检查；未满足时先补基础配置或升级依赖，再插入业务接口代码。

# ==================== 用户登录 (Activity + LoginParams) ====================
login_with_activity:
  method_name: "RXSDK.getInstance().login"
  description: 用户登录（带 Activity 参数）
  parameters:
    - name: activity
      type: Activity
      required: false
      description: 当前 Activity（可选，某些登录方式需要）
    - name: params
      type: LoginParams
      required: true
      description: 登录参数对象
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口，成功时返回登录信息，失败时返回错误码和错误信息，回调在主线程执行
  code: |
    // ========== 瑞雪 SDK 用户登录 (Activity + LoginParams) ==========
    Activity activity = this;  // 当前 Activity，类型 Activity

    // 构造登录参数
    LoginParams params = new LoginParams.Builder()
            .setLoginType(LoginType.USERNAME)     // 必填，登录类型
            .setUsername("user@example.com")      // 账号密码登录时必填
            .setPassword("password123")           // 账号密码登录时必填
            // 【可选】二次无感登录配置
            // .setLoginOpenid(RXSDK.getInstance().getOpenId())
            .build();

    // 调用登录接口
    RXSDK.getInstance().login(activity, params, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                JSONObject data = jsonObject.optJSONObject("data");
                String openid = data.optString("openid");
                String token = data.optString("token");
                Log.d("RXSDK", "登录成功: openid=" + openid);
                // TODO: 处理登录成功逻辑，进入游戏
            } else {
                String msg = jsonObject.optString("msg");
                Log.e("RXSDK", "登录失败: code=" + code + ", msg=" + msg);
            }
        }
    });

