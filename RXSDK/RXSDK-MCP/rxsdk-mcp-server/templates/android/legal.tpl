# ==================== 法务条款接口 ====================
legalTerms:
  method_name: "RXSDK.getInstance().legalTerms"
  description: 法务条款接口
  parameters:
    - name: keys
      type: String
      required: true
      description: 条款 key，多个用逗号分隔
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 法务条款 ==========
    // 常用 key: user_agreement(用户协议), privacy_policy(隐私政策), third_party_sdk(第三方SDK信息)
    String keys = "user_agreement,privacy_policy";  // 必填，条款 key，类型 String

    RXSDK.getInstance().legalTerms(keys, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                JSONObject data = jsonObject.optJSONObject("data");
                if (data != null) {
                    // 用户协议
                    JSONObject userAgreement = data.optJSONObject("user_agreement");
                    if (userAgreement != null) {
                        String title = userAgreement.optString("title");
                        String url = userAgreement.optString("url");
                        Log.d("RXSDK", "用户协议: " + title + " - " + url);
                    }

                    // 隐私政策
                    JSONObject privacyPolicy = data.optJSONObject("privacy_policy");
                    if (privacyPolicy != null) {
                        String title = privacyPolicy.optString("title");
                        String url = privacyPolicy.optString("url");
                        Log.d("RXSDK", "隐私政策: " + title + " - " + url);
                    }
                }
                // TODO: 用 WebView 显示法务条款
            } else {
                Log.e("RXSDK", "获取法务条款失败: " + jsonObject.optString("msg"));
            }
        }
    });

# 常用法务条款 key
legal_term_keys:
  - name: user_agreement
