# ==================== 法务接口（带参数） ====================
legal:
  method_name: "RXSDK.getInstance().legal"
  description: 法务接口
  parameters:
    - name: hashMap
      type: Map<String, Object>
      required: true
      description: 参数
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 法务接口 ==========
    Map<String, Object> params = new HashMap<>();
    params.put("type", "privacy");  // 类型
    params.put("region", "CN");     // 地区

    RXSDK.getInstance().legal(params, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                JSONObject data = jsonObject.optJSONObject("data");
                if (data != null) {
                    String content = data.optString("content");
                    String url = data.optString("url");
                    Log.d("RXSDK", "法务内容 URL: " + url);
                    // TODO: 显示法务内容
                }
            } else {
                Log.e("RXSDK", "获取法务信息失败: " + jsonObject.optString("msg"));
            }
        }
    });

