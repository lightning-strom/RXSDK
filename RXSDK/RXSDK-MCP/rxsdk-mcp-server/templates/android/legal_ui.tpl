# ==================== 隐私政策弹窗 ====================
userPrivacyPolicy:
  method_name: "RXSdkUI.getInstance().userPrivacyPolicy"
  description: 用户协议和隐私政策弹窗
  parameters:
    - name: activity
      type: Context
      required: true
      description: 当前 Context
    - name: title
      type: String
      required: true
      description: 弹窗标题
    - name: content
      type: String
      required: true
      description: 协议内容（HTML 格式）
    - name: callback
      type: RXJSONCallback
      required: true
      description: 点击回调
  code: |
    // ========== 瑞雪 SDK 隐私政策弹窗 ==========
    
    import com.ruixue.openapi.RXSdkUI;
    import com.ruixue.RXJSONCallback;
    
    String title = "用户协议和隐私政策";
    String content = "<p>请仔细阅读以下协议...</p>";  // HTML 格式内容
    
    RXSdkUI.getInstance().userPrivacyPolicy(activity, title, content, new RXJSONCallback() {
        @Override
        public void onSuccess(JSONObject data) {
            // 用户点击同意
            Log.d("RXSDK", "用户同意协议");
        }
        
        @Override
        public void onFailed(JSONObject cause) {
            // 用户点击拒绝
            Log.d("RXSDK", "用户拒绝协议");
        }
        
        @Override
        public void onError(RXException e) {
            Log.e("RXSDK", "协议弹窗错误: " + e.getMessage());
        }
    }).show();

