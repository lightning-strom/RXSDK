# ==================== 协议视图 ====================
protocolView:
  method_name: "RXSdkUI.getInstance().protocolView"
  description: 协议视图（全屏展示）
  parameters:
    - name: activity
      type: Activity
      required: true
      description: 当前 Activity
    - name: key
      type: String
      required: true
      description: 默认展示的条款 key
    - name: keyList
      type: List<String>
      required: true
      description: 要展示的协议列表
  code: |
    // ========== 瑞雪 SDK 协议视图 ==========
    
    import com.ruixue.openapi.RXSdkUI;
    import java.util.Arrays;
    import java.util.List;
    
    // 要展示的协议 key 列表
    List<String> keyList = Arrays.asList("00001", "00002");  // 服务协议、隐私政策
    String defaultKey = "00001";  // 默认展示服务协议
    
    RXSdkUI.getInstance().protocolView(activity, defaultKey, keyList).show();

