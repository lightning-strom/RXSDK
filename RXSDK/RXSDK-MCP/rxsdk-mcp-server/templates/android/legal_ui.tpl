# 依赖检查
dependency_check:
  ui_module:
    required: true
    artifact: "com.ruixue:rxsdk_base_ui"
    description: 法务 UI 需要添加此依赖

# AI 行为指南
check_guide: |
  插入法务 UI 代码前必须执行以下检查:
  1. 读取项目的 app/build.gradle 文件
  2. 搜索是否存在 'com.ruixue:rxsdk_base_ui' 依赖
  3. 如果不存在该依赖:
     - 【必须】自动添加依赖到 app/build.gradle，无需询问用户
  4. 添加完依赖后，继续插入法务 UI 代码

