# ==================== 找回密码弹窗 ====================
findPassWordUI:
  method_name: "RXSdkUI.getInstance().findPassWordUI"
  description: 找回密码（忘记密码）UI
  parameters:
    - name: activity
      type: Activity
      required: true
      description: 当前 Activity
    - name: map
      type: Map<String, Object>
      required: false
      description: 配置参数
    - name: callback
      type: RXUICallback
      required: true
      description: 回调函数
  map_params:
    - name: username
      type: String
      required: false
      description: 默认填充的账号
    - name: account_type
      type: int
      required: false
      description: 账号类型提示（1-通用提示，2-手机号提示，3-邮箱提示，默认 2）
    - name: password_hint
      type: String
      required: false
      description: 输入密码提示文本
  code: |
    // ========== 瑞雪 SDK 找回密码弹窗 ==========
    // 注意：需要添加 UI 模块依赖 implementation 'com.ruixue:rxsdk_base_ui:${version}'
    
    import com.ruixue.openapi.RXSdkUI;
    import com.ruixue.callback.RXUICallback;
    
    Map<String, Object> params = new HashMap<>();
    params.put("username", "xxxxxx");      // 默认填充的账号（可选）
    params.put("account_type", 2);         // 账号类型：1-通用，2-手机号，3-邮箱
    params.put("password_hint", "请输入新密码");  // 密码输入提示（可选）
    
    RXSdkUI.getInstance().findPassWordUI(activity, params, new RXUICallback() {
        @Override
        public void onSuccess(JSONObject data) {
            Log.d("RXSDK", "找回密码成功: " + data);
            // TODO: 处理找回密码成功逻辑
        }
        
        @Override
        public void onFailed(JSONObject cause) {
            Log.e("RXSDK", "找回密码失败: " + cause);
            // TODO: 处理找回密码失败逻辑
        }
        
        @Override
        public void onError(RXException e) {
            Log.e("RXSDK", "找回密码错误: " + e.getMessage());
        }
    }).show();

# ==================== 修改密码弹窗 ====================
changePwdUI:
  method_name: "RXSdkUI.getInstance().changePwdUI"
  description: 修改密码 UI
  parameters:
    - name: activity
      type: Activity
      required: true
      description: 当前 Activity
    - name: isPasswordSet
      type: boolean
      required: true
      description: 是否已设置密码（用于区分"设置密码"和"修改密码"场景）
    - name: callback
      type: RXJSONCallback
      required: true
      description: 回调函数
  code: |
    // ========== 瑞雪 SDK 修改密码弹窗 ==========
    
    import com.ruixue.openapi.RXSdkUI;
    import com.ruixue.RXJSONCallback;
    
    // isPasswordSet: true 表示已设置密码（修改密码），false 表示未设置密码（设置密码）
    boolean isPasswordSet = true;
    
    RXSdkUI.getInstance().changePwdUI(activity, isPasswordSet, new RXJSONCallback() {
        @Override
        public void onSuccess(JSONObject data) {
            Log.d("RXSDK", "密码设置成功");
            // TODO: 处理密码设置成功逻辑
        }
        
        @Override
        public void onFailed(JSONObject cause) {
            Log.e("RXSDK", "密码设置失败");
            // TODO: 处理密码设置失败逻辑
        }
        
        @Override
        public void onError(RXException e) {
            Log.e("RXSDK", "错误: " + e.getMessage());
        }
    }).show();

