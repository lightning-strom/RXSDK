# 瑞雪 SDK 密码管理功能
# Generated by MCP
# 包含：修改密码、重置密码

# ==================== 修改密码 ====================
changePassword:
  method_name: "RXSDK.getInstance().changePassword"
  description: 修改密码（需要知道旧密码）
  parameters:
    - name: oldPassword
      type: String
      required: true
      description: 旧密码
    - name: newPassword
      type: String
      required: true
      description: 新密码
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 修改密码 ==========
    String oldPassword = "old_password";   // 必填，旧密码，类型 String
    String newPassword = "new_password";   // 必填，新密码（建议6-20位），类型 String

    RXSDK.getInstance().changePassword(oldPassword, newPassword, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                Log.d("RXSDK", "密码修改成功");
                // TODO: 提示用户密码已修改，建议重新登录
            } else {
                String msg = jsonObject.optString("msg");
                Log.e("RXSDK", "密码修改失败: " + msg);
                // 常见错误：旧密码错误
            }
        }
    });

# ==================== 重置密码 ====================
resetPassword:
  method_name: "RXSDK.getInstance().resetPassword"
  description: 重置密码（通过验证码）
  parameters:
    - name: username
      type: String
      required: true
      description: 手机号
    - name: password
      type: String
      required: true
      description: 新密码
    - name: captchaCode
      type: String
      required: true
      description: 验证码
    - name: migrateArgs
      type: Object
      required: false
      description: 迁移参数（可选）
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 重置密码 ==========
    // 前置条件：需要先调用 sendCaptcha 发送验证码
    String phone = "13800138000";        // 必填，手机号，类型 String
    String newPassword = "new_password"; // 必填，新密码，类型 String
    String captchaCode = "123456";       // 必填，短信验证码，类型 String

    RXSDK.getInstance().resetPassword(phone, newPassword, captchaCode, null, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                Log.d("RXSDK", "密码重置成功");
                // TODO: 提示用户密码已重置，跳转到登录页面
            } else {
                String msg = jsonObject.optString("msg");
                Log.e("RXSDK", "密码重置失败: " + msg);
                // 常见错误：验证码错误、验证码过期
            }
        }
    });

# 密码规则说明
password_rules:
  - 长度: 6-20 位
  - 可选: 必须包含字母和数字
  - 可选: 必须包含特殊字符

# 导入语句
imports:
  - "import android.util.Log;"
  - "import com.ruixue.openapi.RXSDK;"
  - "import com.ruixue.openapi.CaptchaType;"
  - "import com.ruixue.RXRequestCallback;"
  - "import org.json.JSONObject;"

