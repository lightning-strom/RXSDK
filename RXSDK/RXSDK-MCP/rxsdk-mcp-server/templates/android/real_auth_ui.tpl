limitUI:
  method_name: "RXSdkUI.getInstance().limitUI"
  description: 限制提示界面（与防沉迷弹窗功能相同）
  parameters:
    - name: activity
      type: Activity
      required: true
      description: 当前 Activity
    - name: titleStr
      type: String
      required: true
      description: 弹窗标题
    - name: contextStr
      type: String
      required: true
      description: 弹窗内容
    - name: buttonTxt
      type: String
      required: true
      description: 按钮文本
    - name: callback
      type: RXJSONCallback
      required: true
      description: 回调函数
  code: |
    // ========== 瑞雪 SDK 限制提示弹窗 ==========
    
    RXSdkUI.getInstance().limitUI(activity, "提示", "游戏时间已到限制", "确认", callback).show();

# 导入语句
imports:
  - "import android.app.Activity;"
  - "import android.util.Log;"
  - "import com.ruixue.openapi.RXSdkUI;"
  - "import com.ruixue.RXJSONCallback;"
  - "import com.ruixue.error.RXException;"
  - "import org.json.JSONObject;"

# 依赖检查
dependency_check:
  ui_module:
    required: true
    artifact: "com.ruixue:rxsdk_base_ui"
    description: 实名/防沉迷 UI 需要添加此依赖

# AI 行为指南
check_guide: |
  插入实名/防沉迷 UI 代码前必须执行以下检查:
  1. 读取项目的 app/build.gradle 文件
  2. 搜索是否存在 'com.ruixue:rxsdk_base_ui' 依赖
  3. 如果不存在该依赖:
     - 【必须】自动添加依赖到 app/build.gradle，无需询问用户
  4. IIFAA 配置确认只返回文档地址：https://doc.ruixueyun.com/main/#/view?path=ba910252-aff4-440d-8f78-31f25d19c271，不解析文档内容
  5. 添加完依赖后，继续插入代码
