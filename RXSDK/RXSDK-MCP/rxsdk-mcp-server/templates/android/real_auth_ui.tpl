# 瑞雪 SDK 实名认证/防沉迷 UI 功能
# Generated by MCP
# 包含：实名认证弹窗、防沉迷弹窗
#
# 版本要求:
# - 支付宝 IIFAA 实名 UI 需要 Android SDK 4.0.14 及以上
# - 如果当前 SDK 版本过低，MCP/Agent 应自动修改 Gradle 中 com.ruixue:* 依赖版本到 4.0.14 或更高

iifaa_config_notice:
  message: "请按照文档确认配置"
  document_url: "https://doc.ruixueyun.com/main/#/view?path=ba910252-aff4-440d-8f78-31f25d19c271"
  response_rule: "用户询问 IIFAA 配置文档时，只返回 document_url，不解析文档内容。"

# ==================== 实名认证弹窗 ====================
realAuthUI:
  method_name: "RXSdkUI.getInstance().realAuthUI"
  description: 实名认证界面
  parameters:
    - name: activity
      type: Activity
      required: true
      description: 当前 Activity
    - name: cancelable
      type: boolean
      required: true
      description: 是否可取消关闭
    - name: callback
      type: RXJSONCallback
      required: true
      description: 回调函数
  code: |
    // ========== 瑞雪 SDK 实名认证弹窗 ==========
    // 注意：需要添加 UI 模块依赖 implementation 'com.ruixue:rxsdk_base_ui:${version}'
    
    import com.ruixue.openapi.RXSdkUI;
    import com.ruixue.RXJSONCallback;
    
    boolean cancelable = false;  // 是否可关闭，false 表示强制实名
    
    RXSdkUI.getInstance().realAuthUI(activity, cancelable, new RXJSONCallback() {
        @Override
        public void onSuccess(JSONObject data) {
            Log.d("RXSDK", "实名认证成功: " + data);
            // TODO: 处理实名认证成功逻辑
        }
        
        @Override
        public void onFailed(JSONObject cause) {
            Log.e("RXSDK", "实名认证失败: " + cause);
            // TODO: 处理实名认证失败逻辑
        }
        
        @Override
        public void onError(RXException e) {
            Log.e("RXSDK", "实名认证错误: " + e.getMessage());
        }
    }).show();

# ==================== 实名认证 H5 弹窗 ====================
realAuthH5UI:
  method_name: "RXSdkUI.getInstance().realAuthH5UI"
  description: 实名认证 H5 界面（适用于不同地区）
  parameters:
    - name: activity
      type: Activity
      required: true
      description: 当前 Activity
    - name: region
      type: String
      required: true
      description: 地区代码（如 VN 越南）
    - name: cancelable
      type: boolean
      required: true
      description: 是否可取消关闭
    - name: callback
      type: RXJSONCallback
      required: true
      description: 回调函数
  code: |
    // ========== 瑞雪 SDK 实名认证 H5 弹窗 ==========
    // 不同地区展示不同样式的实名认证 UI
    
    import com.ruixue.openapi.RXSdkUI;
    
    String region = "CN";  // 地区代码，如 CN、VN 等
    boolean cancelable = false;
    
    RXSdkUI.getInstance().realAuthH5UI(activity, region, cancelable, new RXJSONCallback() {
        @Override
        public void onSuccess(JSONObject data) {
            Log.d("RXSDK", "实名认证成功");
        }
        
        @Override
        public void onFailed(JSONObject cause) {
            Log.e("RXSDK", "实名认证失败");
        }
        
        @Override
        public void onError(RXException e) {
            Log.e("RXSDK", "实名认证错误");
        }
    }).show();

# ==================== 防沉迷弹窗 ====================
antiAdditionView:
  method_name: "RXSdkUI.getInstance().antiAdditionView"
  description: 防沉迷提示弹窗
  parameters:
    - name: activity
      type: Activity
      required: true
      description: 当前 Activity
    - name: titleStr
      type: String
      required: true
      description: 弹窗标题
    - name: contextStr
      type: String
      required: true
      description: 弹窗内容
    - name: buttonTxt
      type: String
      required: true
      description: 按钮文本
    - name: callback
      type: RXJSONCallback
      required: true
      description: 回调函数
  code: |
    // ========== 瑞雪 SDK 防沉迷弹窗 ==========
    
    import com.ruixue.openapi.RXSdkUI;
    
    String title = "防沉迷提示";
    String content = "根据国家最新法规规定，未进行实名认证的用户不能体验任何游戏内容。当前账号游戏累计时间已超过限制，请合理安排游戏时间。";
    String buttonText = "退出游戏";
    
    RXSdkUI.getInstance().antiAdditionView(activity, title, content, buttonText, new RXJSONCallback() {
        @Override
        public void onSuccess(JSONObject data) {
            Log.d("RXSDK", "防沉迷弹窗点击确认");
            // TODO: 处理点击确认逻辑，如退出游戏
        }
        
        @Override
        public void onFailed(JSONObject cause) {
            Log.d("RXSDK", "防沉迷弹窗关闭");
        }
        
        @Override
        public void onError(RXException e) {
            Log.e("RXSDK", "错误: " + e.getMessage());
        }
    }).show();

