# 瑞雪 SDK LBS 定位功能
# Generated by MCP
# 包含：上报/更新坐标、获取附近用户、删除坐标

# ==================== 上报/更新经纬度坐标 ====================
lbsUpdate:
  method_name: "RXSDK.getInstance().lbsUpdate"
  description: 上报/更新经纬度坐标
  parameters:
    - name: types
      type: String[]
      required: true
      description: 类型数组，用于分类（如 "game", "social" 等）
    - name: longitude
      type: float
      required: true
      description: 经度
    - name: latitude
      type: float
      required: true
      description: 纬度
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 上报位置 ==========
    // 前置条件：需要先申请定位权限（ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION）
    String[] types = new String[]{"game"};  // 必填，类型数组，类型 String[]
    float longitude = 116.403963f;          // 必填，经度（示例：北京天安门），类型 float
    float latitude = 39.915119f;            // 必填，纬度，类型 float

    RXSDK.getInstance().lbsUpdate(types, longitude, latitude, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                Log.d("RXSDK", "位置上报成功");
            } else {
                Log.e("RXSDK", "位置上报失败: " + jsonObject.optString("msg"));
            }
        }
    });

# ==================== 获取附近用户 ====================
lbsRadius:
  method_name: "RXSDK.getInstance().lbsRadius"
  description: 获取指定半径内的其他用户信息
  parameters:
    - name: types
      type: String
      required: true
      description: 类型
    - name: longitude
      type: float
      required: true
      description: 经度
    - name: latitude
      type: float
      required: true
      description: 纬度
    - name: radius
      type: float
      required: true
      description: 半径（单位：米）
    - name: count
      type: int
      required: true
      description: 返回数量
    - name: page
      type: int
      required: true
      description: 页码
    - name: pageSize
      type: int
      required: true
      description: 每页大小
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 获取附近用户 ==========
    String types = "game";           // 必填，类型，类型 String
    float longitude = 116.403963f;   // 必填，经度，类型 float
    float latitude = 39.915119f;     // 必填，纬度，类型 float
    float radius = 1000f;            // 必填，半径（米），这里是 1 公里，类型 float
    int count = 20;                  // 返回数量，类型 int
    int page = 1;                    // 页码，类型 int
    int pageSize = 20;               // 每页大小，类型 int

    RXSDK.getInstance().lbsRadius(types, longitude, latitude, radius, count, page, pageSize,
            new RXRequestCallback() {
                @Override
                public void onResponse(JSONObject jsonObject) {
                    int code = jsonObject.optInt("code", -1);
                    if (code == 0) {
                        JSONArray users = jsonObject.optJSONArray("data");
                        Log.d("RXSDK", "附近用户: " + users);

                        // 解析用户列表
                        if (users != null) {
                            for (int i = 0; i < users.length(); i++) {
                                JSONObject user = users.optJSONObject(i);
                                String openid = user.optString("openid");
                                String nickname = user.optString("nickname");
                                double distance = user.optDouble("distance");  // 距离（米）
                                Log.d("RXSDK", nickname + " 距离: " + distance + "米");
                            }
                        }
                        // TODO: 更新附近玩家 UI
                    } else {
                        Log.e("RXSDK", "获取失败: " + jsonObject.optString("msg"));
                    }
                }
            }
    );

# ==================== 删除坐标 ====================
lbsDelete:
  method_name: "RXSDK.getInstance().lbsDelete"
  description: 删除经纬度坐标
  parameters:
    - name: types
      type: String[]
      required: true
      description: 类型数组
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 删除位置 ==========
    // 退出游戏或不想显示位置时调用
    String[] types = new String[]{"game"};  // 必填，类型数组，类型 String[]

    RXSDK.getInstance().lbsDelete(types, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                Log.d("RXSDK", "位置删除成功");
            } else {
                Log.e("RXSDK", "位置删除失败: " + jsonObject.optString("msg"));
            }
        }
    });

# 权限要求
permissions:
  - android.permission.ACCESS_FINE_LOCATION
  - android.permission.ACCESS_COARSE_LOCATION

# 导入语句
imports:
  - "import android.util.Log;"
  - "import com.ruixue.openapi.RXSDK;"
  - "import com.ruixue.RXRequestCallback;"
  - "import org.json.JSONArray;"
  - "import org.json.JSONObject;"

