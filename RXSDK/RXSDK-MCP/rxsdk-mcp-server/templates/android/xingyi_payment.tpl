# 瑞雪 SDK 星驿支付（Android）
# Generated by MCP

overview:
  feature: xingyi_payment
  minimum_android_sdk: "4.0.14"
  payment_type: "xy"
  modes:
    app:
      dependency: "com.ruixue:rxsdk_xingyi:4.0.14"
    h5:
      dependency: "com.ruixue:rxsdk_h5pay:4.0.14"
  initialization:
    required:
      - RXSDK.initialize
      - RXSdkInitConfig

app_example_java: |
  Map<String, Object> params = new HashMap<>();
  params.put("hq_type", "xy");
  params.put("goods_tag", "YOUR_GOODS_TAG");
  params.put("trade_no", "YOUR_TRADE_NO");
  RXSDK.getInstance().pay(activity, params, callback);

h5_example_java: |
  Map<String, Object> ext = new HashMap<>();
  ext.put("is_h5", 1); // 必须是 int，不要传字符串或 boolean

  Map<String, Object> params = new HashMap<>();
  params.put("hq_type", "xy");
  params.put("goods_tag", "YOUR_GOODS_TAG");
  params.put("trade_no", "YOUR_TRADE_NO");
  params.put("ext", ext);
  RXSDK.getInstance().pay(activity, params, callback);

notes:
  - paymentMode=app 仅要求 rxsdk_xingyi。
  - paymentMode=h5 仅要求 rxsdk_h5pay。
  - paymentMode=both（默认）同时要求两项依赖。
  - 所有相关 com.ruixue:* 固定版本必须不低于 4.0.14。
