# ==================== 获取公告列表 ====================
getAnnouncement:
  method_name: "RXSDK.getInstance().getAnnouncement"
  description: 获取公告列表
  parameters:
    - name: limit
      type: int
      required: true
      description: 获取条数，范围 1-100
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  code: |
    // ========== 瑞雪 SDK 获取公告列表 ==========
    int limit = 10;  // 必填，获取条数（1-100），类型 int

    RXSDK.getInstance().getAnnouncement(limit, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                JSONArray list = jsonObject.optJSONArray("data");
                Log.d("RXSDK", "获取公告成功，共 " + (list != null ? list.length() : 0) + " 条");
                // TODO: 展示公告列表
            } else {
                String msg = jsonObject.optString("msg");
                Log.e("RXSDK", "获取公告失败: " + msg);
            }
        }
    });

