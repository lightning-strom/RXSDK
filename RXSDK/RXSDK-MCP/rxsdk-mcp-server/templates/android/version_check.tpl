# ==================== 版本检查 v2 ====================
updateGameVersionV2:
  method_name: "RXSDK.getInstance().updateGameVersion"
  description: 瑞雪版本检查 v2，统一检查模块版本
  parameters:
    - name: body
      type: Map<String, Object>
      required: true
      description: 请求体，包含 modules 和 type
    - name: callback
      type: RXRequestCallback
      required: true
      description: 回调接口
  body_schema:
    modules:
      type: List<Map<String, Object>>
      required: true
      item_fields:
        module_tag: "String，必填，模块标识"
        category_tag: "String，必填，分类标识"
        clientversion: "Number，必填，客户端当前版本；0 表示首次接入或当前无相关版本"
        checkversion: "Number，必填，优先检查版本；不指定时传 0"
    type:
      type: String
      required: false
      description: 脚本类型，如 js / lua / u3d
  response_schema:
    code: "Number，接口状态码；0 表示请求正常，非 0 表示请求失败"
    data:
      type: Object
      description: 业务数据
      fields:
        modules:
          type: Array<ModuleResponse>
          description: 模块检查结果数组
          item_fields:
            module_tag: "String，模块标识"
            category_tag: "String，分类标识"
            version: "Number，最新版本；大于 0 表示有新版本，0 表示无最新版本"
            uri: "String，版本包下载地址"
  response_example: |
    {
      "data": {
        "modules": [
          {
            "module_tag": "dsa",
            "category_tag": "dass",
            "uri": "https://rxfile-test.ruixueyun.com/release/pkg/25031110GjPuOV0TkITessHcdWpgyWn3Tb3T2U.zip",
            "version": 88
          },
          {
            "module_tag": "_nNNN",
            "category_tag": "default",
            "uri": "https://rxfile-test.ruixueyun.com/release/pkg/25031110jCFrdMrEvsqRMDnMEC7vMoJO7EinKp.zip",
            "version": 99
          }
        ]
      },
      "code": 0
    }
  code: |
    // ========== 瑞雪 SDK 版本检查 v2 ==========
    List<Map<String, Object>> modules = new ArrayList<>();
    Map<String, Object> moduleDsa = new HashMap<>();
    moduleDsa.put("module_tag", "@test");      // 必填：替换为实际模块标识
    moduleDsa.put("category_tag", "@test");    // 必填：替换为实际分类标识
    moduleDsa.put("clientversion", 0);         // 必填：0 表示首次接入或当前无相关版本
    moduleDsa.put("checkversion", 0);          // 必填：不指定优先检查版本时传 0
    modules.add(moduleDsa);

    Map<String, Object> moduleNNNN = new HashMap<>();
    moduleNNNN.put("module_tag", "@test");
    moduleNNNN.put("category_tag", "@test");
    moduleNNNN.put("clientversion", 0);
    moduleNNNN.put("checkversion", 0);
    modules.add(moduleNNNN);

    Map<String, Object> body = new HashMap<>();
    body.put("modules", modules);
    body.put("type", "u3d");          // 可选：脚本类型，根据项目实际填写

    RXSDK.getInstance().updateGameVersion(body, new RXRequestCallback() {
        @Override
        public void onResponse(JSONObject jsonObject) {
            int code = jsonObject.optInt("code", -1);
            if (code == 0) {
                Log.d("RXSDK", "版本检查 v2 成功: " + jsonObject);
                // TODO: 解析 data，按服务端返回处理模块更新
            } else {
                Log.e("RXSDK", "版本检查 v2 失败: " + jsonObject.optString("msg"));
            }
        }

        @Override
        public void onError(RXException e) {
            Log.e("RXSDK", "版本检查 v2 请求失败: " + e.getMessage(), e);
        }
    });

