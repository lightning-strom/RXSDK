# 瑞雪 SDK Unity v2 推送
# Generated by MCP

# ==================== 初始化推送 ====================
init:
  method: "RXSDK.PushInit()"
  method_with_params: "RXSDK.PushInit(string productId, string channelId, string cpid, List<string> urls)"
  code: |
    using RuiXue;

    // 方式一：使用 SDK 初始化参数
    RXSDK.PushInit();

    // 方式二：自定义参数
    RXSDK.PushInit("product_id", "channel_id", "cpid",
        new List<string> { "https://push.ruixueyun.com" });

# ==================== 注册推送服务 ====================
register_token:
  method: "RXSDK.PushRegisterToken()"
  description: "建议瑞雪登录成功后调用，不切换账号不用重复调用"
  code: |
    // 登录成功后注册推送
    RXSDK.PushRegisterToken();

# ==================== 反注册推送服务 ====================
unregister_token:
  method: "RXSDK.PushUnRegisterToken()"
  description: "建议在登出账号时调用"
  code: |
    // 登出时反注册
    RXSDK.PushUnRegisterToken();

# ==================== 获取推送 Token ====================
get_device_token:
  method: "RXSDK.PushGetDeviceToken()"
  code: |
    string token = RXSDK.PushGetDeviceToken();
    Debug.Log("推送 Token: " + token);

# ==================== 查询推送支持 ====================
is_support:
  method: "RXSDK.PushIsSupport()"
  code: |
    bool supported = RXSDK.PushIsSupport();
    Debug.Log("是否支持推送: " + supported);

# ==================== 推送别名 ====================
alias:
  bind:
    method: "RXSDK.PushBindAlias(string alias)"
    code: |
      RXSDK.PushBindAlias("player_001");

  unbind:
    method: "RXSDK.PushUnBindAlias(string alias)"
    code: |
      RXSDK.PushUnBindAlias("player_001");

# ==================== 获取厂商平台 ====================
get_brand:
  method: "RXSDK.PushGetBrandName()"
  code: |
    string brand = RXSDK.PushGetBrandName();
    Debug.Log("推送厂商: " + brand);

# ==================== 导入语句 ====================
imports:
  - "using System.Collections.Generic;"
  - "using RuiXue;"
