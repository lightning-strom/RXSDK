# 瑞雪 SDK Unity v2 设备信息与配置
# Generated by MCP

# ==================== 获取设备码 ====================
get_device_code:
  method: "RXSDK.GetDeviceCode(SdkCallback callback)"
  code: |
    using RuiXue;

    RXSDK.GetDeviceCode(result =>
    {
        if (result.IsSuccess) Debug.Log("设备码: " + result.Data);
    });

# ==================== 配置类 API ====================
config_apis:
  set_log:
    method: "RXSDK.SetLogEnable(bool enabled)"
    code: |
      RXSDK.SetLogEnable(true);  // 开启日志

  set_language:
    method: "RXSDK.SetLanguage(string language)"
    code: |
      RXSDK.SetLanguage("zh-Hans");    // 简体中文
      RXSDK.SetLanguage("en");         // 英文

  set_sub_channel:
    method: "RXSDK.SetSubChannelId(string subChannelId)"
    code: |
      RXSDK.SetSubChannelId("sub_channel_001");

  set_area:
    method: "RXSDK.SetArea(string area)"
    code: |
      RXSDK.SetArea("CN");

  set_screen_capture:
    method: "RXSDK.SetScreenCaptureDisable(bool disable)"
    code: |
      RXSDK.SetScreenCaptureDisable(true);  // 禁止截屏

  set_password_strength:
    method: "RXSDK.SetPasswordStrength(RXPasswordStrength type)"
    code: |
      RXSDK.SetPasswordStrength(RXPasswordStrength.Strong);

  set_pwd_pattern:
    method: "RXSDK.SetPwdPattern(string pattern)"
    code: |
      RXSDK.SetPwdPattern(@"^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d]{8,}$");

  config_error_msg:
    method: "RXSDK.ConfigErrorMsg(Dictionary<string, object> errorMsgMap)"
    code: |
      var errorMsgMap = new Dictionary<string, object>
      {
          { "10001", new Dictionary<string, string>
              {
                  { "zh-Hans", "自定义错误信息" },
                  { "en", "Custom error message" }
              }
          }
      };
      RXSDK.ConfigErrorMsg(errorMsgMap);

  disable_sensitive_info:
    method: "RXSDK.DisableReadSensitiveInfo(bool disabled)"
    code: |
      RXSDK.DisableReadSensitiveInfo(true);  // 关闭敏感信息采集

# ==================== 状态查询 ====================
status_apis:
  login_openid_expire:
    method: "RXSDK.LoginOpenidExpireInvalid()"
    code: |
      bool expired = RXSDK.LoginOpenidExpireInvalid();
      Debug.Log("login_openid 是否失效: " + expired);

  is_agreed_privacy:
    method: "RXSDK.IsAgreedPrivacy()"
    code: |
      bool agreed = RXSDK.IsAgreedPrivacy();

# ==================== 网络请求 ====================
create_request:
  method: "RXSDK.CreateRequest(string url, Dictionary<string, string> header, Dictionary<string, string> body, HttpMethod method, bool needLogin, SdkCallback callback)"
  code: |
    var header = new Dictionary<string, string>
    {
        { "Content-Type", "application/json" }
    };
    var body = new Dictionary<string, string>
    {
        { "key", "value" }
    };

    RXSDK.CreateRequest(
        "https://api.example.com/custom",
        header,
        body,
        HttpMethod.POST,
        true,   // needLogin: 是否需要登录态
        result =>
        {
            if (result.IsSuccess) Debug.Log("请求成功: " + result.Data);
        }
    );

# ==================== 跳转应用商店 ====================
jump_to_app_store:
  method: "RXSDK.JumpToAppStore()"
  code: |
    bool success = RXSDK.JumpToAppStore();
    Debug.Log("跳转应用商店: " + success);

# ==================== 退出应用 ====================
exit_app:
  method: "RXSDK.ExitApp(ExitCallback callback)"
  code: |
    RXSDK.ExitApp((handled, response) =>
    {
        if (handled)
        {
            Debug.Log("退出回调: " + response);
        }
        else
        {
            Application.Quit();
        }
    });

# ==================== 导入语句 ====================
imports:
  - "using System.Collections.Generic;"
  - "using RuiXue;"
