# 瑞雪 SDK Unity v2 法务
# Generated by MCP

# ==================== 获取法务配置 ====================
get_legal:
  method: "RXSDK.GetLegal(SdkCallback callback)"
  async: "RXSDK.GetLegalAsync()"
  code: |
    using RuiXue;

    // 获取法务配置
    RXSDK.GetLegal(result =>
    {
        if (result.IsSuccess)
        {
            Debug.Log("法务配置: " + result.Data);
            // result.Data 中包含 user_agreement, privacy_policy 等
        }
        else
        {
            Debug.LogError("获取法务配置失败: " + result.Error);
        }
    });

    // async 方式
    // var result = await RXSDK.GetLegalAsync();

# ==================== 隐私协议 ====================
privacy:
  method: "RXSDK.SetPrivacyAgree(PrivacyCallback callback)"
  code: |
    // 通知 SDK 用户已同意隐私协议
    RXSDK.SetPrivacyAgree(agreed =>
    {
        if (agreed)
        {
            Debug.Log("用户已同意隐私协议");
            // 在此之后初始化第三方 SDK
        }
    });

  check:
    method: "RXSDK.IsAgreedPrivacy()"
    code: |
      // 判断用户是否已同意隐私
      bool agreed = RXSDK.IsAgreedPrivacy();
      Debug.Log("是否已同意隐私: " + agreed);

# ==================== 导入语句 ====================
imports:
  - "using RuiXue;"
