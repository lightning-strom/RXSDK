# 瑞雪 SDK Unity v2 反馈/客服
# Generated by MCP

# ==================== 获取反馈类型 ====================
get_feedback_kind_list:
  method: "RXSDK.GetFeedbackKindList(SdkCallback callback)"
  code: |
    using RuiXue;

    RXSDK.GetFeedbackKindList(result =>
    {
        if (result.IsSuccess) Debug.Log("反馈类型列表: " + result.Data);
        else Debug.LogError("获取反馈类型失败: " + result.Error);
    });

# ==================== 创建反馈 ====================
create_feedback:
  method: "RXSDK.CreateFeedback(Dictionary<string, object> dic, SdkCallback callback)"
  code: |
    var feedbackData = new Dictionary<string, object>
    {
        { "content", "游戏出现闪退问题" },
        { "kind_id", 1 },
        { "contact", "user@example.com" }
    };

    RXSDK.CreateFeedback(feedbackData, result =>
    {
        if (result.IsSuccess) Debug.Log("反馈创建成功");
        else Debug.LogError("反馈创建失败: " + result.Error);
    });

# ==================== 满意度评价 ====================
satisfaction_evaluation:
  method: "RXSDK.SatisfactionEvaluation(Dictionary<string, object> dic, SdkCallback callback)"
  code: |
    var evalData = new Dictionary<string, object>
    {
        { "score", 5 },
        { "feedback_id", 12345 }
    };

    RXSDK.SatisfactionEvaluation(evalData, result =>
    {
        if (result.IsSuccess) Debug.Log("评价成功");
    });

# ==================== 上报反馈日志 ====================
report_feedback_log:
  method: "RXSDK.ReportFeedbackLog(byte[] data, SdkCallback callback)"
  code: |
    byte[] logData = System.Text.Encoding.UTF8.GetBytes("日志内容");
    RXSDK.ReportFeedbackLog(logData, result =>
    {
        if (result.IsSuccess) Debug.Log("日志上报成功");
    });

# ==================== 帮助中心 ====================
helper_center:
  method: "RXSDK.HelperCenterUI(Dictionary<string, object> dic, SdkCallback callback)"
  code: |
    // 展示帮助中心
    RXSDK.HelperCenterUI(new Dictionary<string, object>(), result =>
    {
        Debug.Log("帮助中心回调");
    });

# ==================== 客服会话 ====================
chat_service:
