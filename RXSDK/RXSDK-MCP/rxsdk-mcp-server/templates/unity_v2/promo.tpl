# ==================== 获取达人福利码 ====================
get_promo_display_key:
  method: "RXSDK.GetPromoDisplayKEY(bool authRefresh, SdkCallback callback)"
  code: |
    using RuiXue;

    RXSDK.GetPromoDisplayKEY(true, result =>
    {
        if (result.IsSuccess)
        {
            Debug.Log("福利码: " + result.Data);
        }
        else
        {
            Debug.LogError("获取福利码失败: " + result.Error);
        }
    });

# ==================== 兑换福利码 ====================
exchange_promo_cdkey:
  method: "RXSDK.ExchangePromoCDKEY(string cdKey, SdkCallback callback)"
  code: |
    RXSDK.ExchangePromoCDKEY("CDKEY12345", result =>
    {
        if (result.IsSuccess)
        {
            Debug.Log("兑换成功: " + result.Data);
        }
        else
        {
            Debug.LogError("兑换失败: " + result.Error);
        }
    });

# ==================== 导入语句 ====================
imports:
