# 瑞雪 SDK Unity v2 公告/邮件
# Generated by MCP

# ==================== 获取公告 ====================
get_announcement:
  method: "RXSDK.GetAnnouncement(int limit, SdkCallback callback)"
  code: |
    using RuiXue;

    RXSDK.GetAnnouncement(10, result =>
    {
        if (result.IsSuccess) Debug.Log("公告列表: " + result.Data);
        else Debug.LogError("获取公告失败: " + result.Error);
    });

# ==================== 获取邮件列表 ====================
get_email_list:
  method: "RXSDK.GetEmailList(string userId, SdkCallback callback)"
  code: |
    RXSDK.GetEmailList("user_id", result =>
    {
        if (result.IsSuccess) Debug.Log("邮件列表: " + result.Data);
    });

# ==================== 获取邮件详情 ====================
get_email_detail:
  method: "RXSDK.GetEmailDetail(string userId, int mailId, SdkCallback callback)"
  code: |
    RXSDK.GetEmailDetail("user_id", 12345, result =>
    {
        if (result.IsSuccess) Debug.Log("邮件详情: " + result.Data);
    });

# ==================== 获取附件/领取道具 ====================
get_email_award:
  method: "RXSDK.GetEmailAward(string userId, int type, int mailId, SdkCallback callback)"
  code: |
    RXSDK.GetEmailAward("user_id", 1, 12345, result =>
    {
        if (result.IsSuccess) Debug.Log("领取道具成功: " + result.Data);
    });

# ==================== 删除邮件 ====================
delete_email:
  method: "RXSDK.DeleteEmail(string userId, int type, int mailId, SdkCallback callback)"
  code: |
    RXSDK.DeleteEmail("user_id", 1, 12345, result =>
    {
        if (result.IsSuccess) Debug.Log("删除邮件成功");
    });

# ==================== 导入语句 ====================
imports:
  - "using RuiXue;"
