# ==================== 样板代码 ====================
code: |
  // ========== 瑞雪 SDK Unity v2 初始化 ==========
  using System.Collections.Generic;
  using UnityEngine;
  using RuiXue;

  public class GameManager : MonoBehaviour
  {
      void Start()
      {
          InitSDK();
      }

      private void InitSDK()
      {
          var config = new RXSdkInitConfig
          {
              cpId = "your_cpid",
              productId = "your_product_id",
              channelId = "your_channel_id",
              baseUrlList = new List<string>
              {
                  "https://api1.ruixueyun.com",
                  "https://api2.ruixueyun.com"
              },
              isLogEnable = true,
              usePrivacy = false
          };

          RXSDK.Initialize(config, result =>
          {
              if (result.IsSuccess)
              {
                  Debug.Log("SDK 初始化成功: " + result.Data);
              }
              else
              {
                  Debug.LogError($"SDK 初始化失败 [{result.Code}]: {result.Error}");
              }
          });
      }
  }

# ==================== 注意事项 ====================
note: |
  1. v2 推荐统一使用 RXSDK 与 SdkCallback（SdkResult）
  2. RuiXueSdk 仅保留兼容别名，不建议新项目继续使用
  3. 初始化必须在其他 SDK 功能调用前完成
