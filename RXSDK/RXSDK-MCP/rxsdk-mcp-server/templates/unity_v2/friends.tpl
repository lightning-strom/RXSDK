# 瑞雪 SDK Unity v2 好友管理
# Generated by MCP

# ==================== 添加好友 ====================
add_friends:
  method: "RXSDK.AddFriends(string target, string target_remarks, string user_remarks, SdkCallback callback)"
  code: |
    using RuiXue;

    RXSDK.AddFriends("target_open_id", "对方备注", "我的备注", result =>
    {
        if (result.IsSuccess) Debug.Log("添加好友成功");
        else Debug.LogError("添加好友失败: " + result.Error);
    });

# ==================== 删除好友 ====================
remove_friends:
  method: "RXSDK.RemoveFriends(string target, SdkCallback callback)"
  code: |
    RXSDK.RemoveFriends("target_open_id", result =>
    {
        if (result.IsSuccess) Debug.Log("删除好友成功");
    });

# ==================== 获取好友列表 ====================
relation_friends:
  method: "RXSDK.RelationFriends(SdkCallback callback)"
  code: |
    RXSDK.RelationFriends(result =>
    {
        if (result.IsSuccess) Debug.Log("好友列表: " + result.Data);
    });

# ==================== 判断是否为好友 ====================
is_friend:
  method: "RXSDK.IsFriend(string target, SdkCallback callback)"
  code: |
    RXSDK.IsFriend("target_open_id", result =>
    {
        if (result.IsSuccess) Debug.Log("是否好友: " + result.Data);
    });

# ==================== 更新好友备注 ====================
update_friend_remarks:
  method: "RXSocial.UpdateFriendRemarks(string target, string target_remarks, SdkCallback callback)"
  code: |
    using RuiXue.Social;

    RXSocial.UpdateFriendRemarks("target_open_id", "新备注", result =>
    {
        if (result.IsSuccess) Debug.Log("更新备注成功");
    });

# ==================== 导入语句 ====================
imports:
  - "using RuiXue;"
  - "using RuiXue.Social;"
