# 瑞雪 SDK Unity v2 账号注销
# Generated by MCP

# ==================== RXDeregisterConfig ====================
config:
  class_name: RXDeregisterConfig
  namespace: RuiXue.Login
  fields:
    - name: idcard
      type: string
      description: 身份证号
    - name: realname
      type: string
      description: 真实姓名
    - name: cpdata
      type: string
      description: CP 自定义数据
    - name: thirdParams
      type: "Dictionary<string, object>"
      description: 第三方参数

# ==================== 注销账号 ====================
deregister:
  method: "RXSDK.Deregister(RXDeregisterConfig config, SdkCallback callback)"
  code: |
    using RuiXue;
    using RuiXue.Login;

    var config = new RXDeregisterConfig
    {
        realname = "张三",
        idcard = "110101199001011234",
        cpdata = "自定义数据"
    };

    RXSDK.Deregister(config, result =>
    {
        if (result.IsSuccess)
        {
            Debug.Log("注销申请成功: " + result.Data);
        }
        else
        {
            Debug.LogError("注销申请失败: " + result.Error);
        }
    });

# ==================== 撤销注销 ====================
deregister_cancel:
  method: "RXSDK.DeregisterCancel(SdkCallback callback)"
  code: |
    RXSDK.DeregisterCancel(result =>
    {
        if (result.IsSuccess) Debug.Log("撤销注销成功");
        else Debug.LogError("撤销注销失败: " + result.Error);
    });

# ==================== 导入语句 ====================
imports:
  - "using RuiXue;"
  - "using RuiXue.Login;"
