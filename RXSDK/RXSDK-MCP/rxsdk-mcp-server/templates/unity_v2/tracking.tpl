# ==================== 埋点数据上报 ====================
data_track:
  method: "RXSDK.DataTrack(string eventName, string distinctId, Dictionary<string, object> properties, SdkCallback callback)"
  code: |
    using System.Collections.Generic;
    using RuiXue;

    // 自定义事件上报
    var properties = new Dictionary<string, object>
    {
        { "level", 10 },
        { "scene", "main_city" },
        { "item_id", "sword_001" }
    };

    RXSDK.DataTrack("level_up", "user_distinct_id", properties, result =>
    {
        if (result.IsSuccess) Debug.Log("埋点上报成功");
        else Debug.LogError("埋点上报失败: " + result.Error);
    });

# ==================== 公共属性 ====================
public_properties:
  set:
    method: "RXSDK.SetPublicProperties(Dictionary<string, object> publicProperties)"
    code: |
      // 设置公共属性（所有埋点事件都会携带）
      var publicProps = new Dictionary<string, object>
      {
          { "server_id", "server_001" },
          { "role_name", "玩家名" },
          { "vip_level", 5 }
      };
      RXSDK.SetPublicProperties(publicProps);

  update:
    method: "RXSDK.UpdatePublicProperties(string key, object value)"
    code: |
      // 修改单个公共属性
      RXSDK.UpdatePublicProperties("vip_level", 6);

  delete:
    method: "RXSDK.DeletePublicProperties(string key)"
    code: |
      // 删除公共属性
      RXSDK.DeletePublicProperties("vip_level");

# ==================== 导入语句 ====================
imports:
  - "using System.Collections.Generic;"
  - "using RuiXue;"
