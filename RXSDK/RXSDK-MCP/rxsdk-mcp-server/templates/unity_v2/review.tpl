# 瑞雪 SDK Unity v2 应用商店评分
# Generated by MCP

# ==================== 跳转应用商店 ====================
jump_to_app_store:
  method: "RXSDK.JumpToAppStore()"
  return: bool
  description: 跳转到当前平台的应用商店页面
  code: |
    using RuiXue;

    bool success = RXSDK.JumpToAppStore();
    if (success)
    {
        Debug.Log("已跳转到应用商店");
    }
    else
    {
        Debug.LogWarning("跳转应用商店失败，当前平台可能不支持");
    }

# ==================== 注意事项 ====================
note: |
  - Android：跳转到对应应用商店（Google Play、华为、小米等）
  - iOS：跳转到 App Store
  - 编辑器/WebGL：不支持此功能

# ==================== 导入语句 ====================
imports:
  - "using RuiXue;"
