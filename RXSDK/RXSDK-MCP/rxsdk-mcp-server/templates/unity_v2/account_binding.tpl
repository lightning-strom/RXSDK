# ==================== 绑定手机号 ====================
bind_phone:
  method: "RXSDK.BindPhone(string phone, string password, string captchaCode, object migrateArgs, SdkCallback callback)"
  code: |
    RXSDK.BindPhone("13800138000", "password123", "123456", null, result =>
    {
        if (result.IsSuccess) Debug.Log("绑定手机号成功");
        else Debug.LogError("绑定手机号失败: " + result.Error);
    });

# ==================== 解绑手机号 ====================
unbind_phone:
  method: "RXSDK.UnBindPhone(string phone, string captchaCode, SdkCallback callback)"
  code: |
    RXSDK.UnBindPhone("13800138000", "123456", result =>
    {
        if (result.IsSuccess) Debug.Log("解绑手机号成功");
    });

# ==================== 修改手机号 ====================
change_phone:
  method: "RXSDK.ChangePhone(string newPhone, string newCaptcha, string oldCaptcha, object migrateArgs, SdkCallback callback)"
  code: |
    RXSDK.ChangePhone("13900139000", "654321", "123456", null, result =>
    {
        if (result.IsSuccess) Debug.Log("修改手机号成功");
    });

