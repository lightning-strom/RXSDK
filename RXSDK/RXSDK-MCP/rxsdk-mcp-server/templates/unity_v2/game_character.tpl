# 瑞雪 SDK Unity v2 游戏角色
# Generated by MCP

# ==================== 说明 ====================
description: |
  兼容层通过 RuiXueSdk.SetGameInfo 上报到瑞雪，通过
  RuiXueSdk.SetThirdGameInfo 在 Android 上报完整三方渠道信息，
  在 iOS 使用 roleId/serverId 复用 SetGameInfo。
  角色 CRUD 可继续通过 RXSDK.CreateRequest 实现。

preflight_check:
  min_version:
    unity: "4.0.3"
    android: "4.0.16"

game_info_code: |
  RuiXueSdk.SetGameInfo("role_001", "server_001");

  GameInfo gameInfo = new GameInfo(2, "role_001", "server_001")
  {
      roleName = "勇者小明",
      serverName = "一区",
      gameRoleLevel = "10",
      attach = "{\"roleType\":\"战士\"}"
  };
  RuiXueSdk.SetThirdGameInfo(gameInfo);

api_semantics:
  SetGameInfo: "上报到瑞雪的游戏信息"
  SetThirdGameInfo: "Android 上报完整三方渠道信息；iOS 使用 roleId/serverId 调用 SetGameInfo"

# ==================== 通过 CreateRequest 实现 ====================
code: |
  using System.Collections.Generic;
  using RuiXue;

  // ========== 创建游戏角色 ==========
  private void CreateGameCharacter(string roleName, string roleId, string serverId)
  {
      var body = new Dictionary<string, string>
      {
          { "role_name", roleName },
          { "role_id", roleId },
          { "server_id", serverId }
      };

      RXSDK.CreateRequest(
          "/game/character/create",
          new Dictionary<string, string>(),
          body,
          HttpMethod.POST,
          true,
          result =>
          {
              if (result.IsSuccess) Debug.Log("创建角色成功: " + result.Data);
              else Debug.LogError("创建角色失败: " + result.Error);
          }
      );
  }

  // ========== 查询角色列表 ==========
  private void SearchGameCharacterList()
  {
      RXSDK.CreateRequest(
          "/game/character/list",
          new Dictionary<string, string>(),
          new Dictionary<string, string>(),
          HttpMethod.POST,
          true,
          result =>
          {
              if (result.IsSuccess) Debug.Log("角色列表: " + result.Data);
          }
      );
  }

  // ========== 更新角色信息 ==========
  private void UpdateGameCharacter(string roleId, string roleName, string roleLevel)
  {
      var body = new Dictionary<string, string>
      {
          { "role_id", roleId },
          { "role_name", roleName },
          { "role_level", roleLevel }
      };

      RXSDK.CreateRequest(
          "/game/character/update",
          new Dictionary<string, string>(),
          body,
          HttpMethod.POST,
          true,
          result =>
          {
              if (result.IsSuccess) Debug.Log("更新角色成功");
          }
      );
  }

# ==================== 导入语句 ====================
imports:
  - "using System.Collections.Generic;"
  - "using RuiXue;"
