# 瑞雪 SDK Unity v2 验证码
# Generated by MCP

# ==================== CaptchaType 枚举 ====================
captcha_type:
  - name: CaptchaType_email
    value: 0
    description: 邮箱验证码
  - name: CaptchaType_phone
    value: 1
    description: 手机验证码

# ==================== 发送验证码 ====================
send_captcha:
  method: "RXSDK.SendCaptcha(CaptchaType type, string target, string purpose, SdkCallback callback)"
  code: |
    using RuiXue;
    using RuiXue.Login;

    // 发送手机验证码
    RXSDK.SendCaptcha(CaptchaType.CaptchaType_phone, "13800138000", "login", result =>
    {
        if (result.IsSuccess)
        {
            Debug.Log("验证码发送成功");
        }
        else
        {
            Debug.LogError("验证码发送失败: " + result.Error);
        }
    });

    // 发送邮箱验证码
    RXSDK.SendCaptcha(CaptchaType.CaptchaType_email, "user@example.com", "login", result =>
    {
        if (result.IsSuccess) Debug.Log("邮箱验证码发送成功");
    });

# ==================== 校验验证码 ====================
verify_captcha:
  method: "RXSDK.VerifyCaptcha(CaptchaType type, string target, string purpose, string code, SdkCallback callback)"
  code: |
    // 校验手机验证码
    RXSDK.VerifyCaptcha(CaptchaType.CaptchaType_phone, "13800138000", "login", "123456", result =>
    {
        if (result.IsSuccess)
        {
            Debug.Log("验证码校验成功");
        }
        else
        {
            Debug.LogError("验证码校验失败: " + result.Error);
        }
    });

# ==================== purpose 参数说明 ====================
purpose_values:
  - login: 登录
  - register: 注册
  - bindphone: 绑定手机
  - bindemail: 绑定邮箱
  - resetpwd: 重置密码

# ==================== 导入语句 ====================
imports:
  - "using RuiXue;"
  - "using RuiXue.Login;"
