# ==================== 样板代码 ====================
code: |
  using System.Collections.Generic;
  using UnityEngine;
  using RuiXue;

  // ========== 发起支付 ==========
  private void DoPay()
  {
      var payParams = new Dictionary<string, object>
      {
          { "goods_tag", "diamond_100" },
          { "trade_no", System.Guid.NewGuid().ToString() },
          { "amount", 100 },
          { "product_name", "100钻石" },
          { "product_desc", "购买100颗钻石" }
      };

      RXSDK.Pay(payParams, result =>
      {
          if (result.IsSuccess)
          {
              Debug.Log("支付请求成功: " + result.Data);
          }
          else
          {
              Debug.LogError($"支付请求失败 [{result.Code}]: {result.Error}");
          }
      });
  }

