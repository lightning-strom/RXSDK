# 瑞雪 SDK Unity MuMu/Yofun 渠道
# Generated by MCP
# 最低版本：Unity 公共 UPM 4.0.2，Android 4.0.19

preflight_check:
  min_version:
    unity: "4.0.2"
    android: "4.0.19"
  required_packages:
    - "com.ruixue.unitysdk.base"
    - "com.ruixue.unitysdk.login"
    - "com.ruixue.unitysdk.pay"
  requirements:
    - "Android 包名以 .yofun.mumu 结尾"
    - "Android 工程已配置 Yofun Maven、rxsdk_yofun、YOFUN_APP_ID 和 MultiDex"
    - "已完成 RuiXueSdk.Initialize、SetPrivacyAgree、带 debugMode 的 InitThirdSdk 和 InvokeChannelAction"

configuration:
  android:
    packageSuffix: ".yofun.mumu"
    appId: "通过 AndroidManifest 的 YOFUN_APP_ID 配置"
    multidex: true

code: |
  using System.Collections.Generic;
  using RuiXue;
  using RuiXue.Login;
  using UnityEngine;

  // 初始化成功并同意隐私后初始化三方 SDK
  var thirdConfig = new Dictionary<string, object>
  {
      ["debugMode"] = Debug.isDebugBuild
  };
  RuiXueSdk.InitThirdSdk(thirdConfig, _ =>
      RuiXueSdk.InvokeChannelAction(
          RuiXueSdk.ChannelActionShowSplash,
          new Dictionary<string, object> { ["splashType"] = 0 },
          data => Debug.Log("MuMu 闪屏完成: " + data),
          Debug.LogError),
      Debug.LogError);

  // MuMu 登录
  RXLogin.Login(new LoginConfig { loginType = LoginMethod.MuMu },
      data => Debug.Log("MuMu 登录成功: " + data),
      Debug.LogError);

  // 监听渠道 UI 展示；type=1 展示，type=2 隐藏
  RuiXueSdk.SetSdkCallback((type, data) =>
  {
      if (type == 1)
      {
          Time.timeScale = 1f;
          AudioListener.pause = false;
      }
  }, null, null);

  // MuMu 三方渠道用户信息：1=创角成功、2=登录成功、3=角色升级
  GameInfo info = new GameInfo(2, "role_001", "server_001")
  {
      roleName = "勇者小明",
      serverName = "一区",
      gameRoleLevel = "10",
      attach = "{\"roleType\":\"战士\"}"
  };
  RuiXueSdk.SetThirdGameInfo(info);

notes:
  - "标准 RXApplication 已自动处理 applicationAttach/applicationCreate，宿主不要重复转发生命周期"
  - "splashType 支持 0/1/2；公共 Base 已自动注入 MuMu 混淆规则"
  - "正式发版必须关闭测试模式，并使用真实 APP_ID、包名及签名在 MuMu 环境验收"
