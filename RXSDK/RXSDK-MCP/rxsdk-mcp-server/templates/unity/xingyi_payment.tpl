# 瑞雪 SDK Unity 星驿支付
# Generated by MCP

overview:
  feature: xingyi_payment
  supported_target: Android
  upm_package: "com.ruixue.unitysdk.xingyi"
  minimum_upm_version: "4.0.0"
  minimum_android_sdk: "4.0.14"
  native_dependencies:
    app: "com.ruixue:rxsdk_xingyi:4.0.14"
    h5: "com.ruixue:rxsdk_h5pay:4.0.14"

app_example_csharp: |
  using System.Collections.Generic;
  using RuiXue.XingYi;

  var order = new Dictionary<string, object>
  {
      ["goods_tag"] = "YOUR_GOODS_TAG",
      ["trade_no"] = "YOUR_TRADE_NO"
  };
  RXXingYiPay.PayApp(
      order,
      result => Debug.Log(result),
      error => Debug.LogError(error)
  );

h5_example_csharp: |
  using System.Collections.Generic;
  using RuiXue.XingYi;

  var order = new Dictionary<string, object>
  {
      ["goods_tag"] = "YOUR_GOODS_TAG",
      ["trade_no"] = "YOUR_TRADE_NO"
  };
  RXXingYiPay.PayH5(
      order,
      result => Debug.Log(result),
      error => Debug.LogError(error)
  );

requirements:
  - 调用支付前必须完成 RuiXueSdk.Initialize。
  - paymentMode=app 需要 rxsdk_xingyi；paymentMode=h5 需要 rxsdk_h5pay；both 同时需要。
  - Unity iOS 构建目标不支持星驿支付。
