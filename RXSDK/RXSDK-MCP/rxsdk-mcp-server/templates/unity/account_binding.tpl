# 瑞雪 SDK Unity 账号绑定
# Generated by MCP
#
# 版本要求:
# - BindAccount 仅支持 UnitySDK 1.6.22 及以上版本
# - Android 原生 SDK 需要 4.0.8 及以上版本，请检查 Assets/Plugins/Android/mainTemplate.gradle 中的 rxVersion
# - iOS 原生 SDK 需要 RXSDK_Pure 4.0.2 及以上版本；使用 Facebook / Google 绑定时，RXFacebookSDK / RXGoogleSDK 需要 4.0.0 及以上版本
# - 如果当前 SDK 版本过低，MCP/Agent 应先自动升级对应依赖：Unity Package Manager、iOS Pod、Android Gradle 引用版本

# ==================== 绑定第三方账号 ====================
bind_account:
  method: "RuiXueSdk.BindAccount(Dictionary<string, object> ext, RequestResponseDelegate onResponse, RequestErrorDelegate onError)"
  min_unity_sdk: "1.6.22"
  min_android_sdk: "4.0.8"
  min_ios_pods:
    RXSDK_Pure: "4.0.2"
    RXFacebookSDK: "4.0.0"
    RXGoogleSDK: "4.0.0"
  code: |
    // ========== 瑞雪 SDK 绑定第三方账号 ==========
    // 版本要求：
    // - UnitySDK >= 1.6.22
    // - Android 原生 SDK >= 4.0.8（检查 mainTemplate.gradle 中 rxVersion）
    // - iOS RXSDK_Pure >= 4.0.2
    // - 若 method 为 facebook/google，RXFacebookSDK/RXGoogleSDK 需 >= 4.0.0
    // - 若版本过低，请先按 native_version_check.auto_upgrade 自动升级对应依赖
    // 参数说明：
    // - method: wechat / facebook / google / apple 等三方登录方式
    // - scene: authorization（三方账号绑定，默认）或 bind（红包绑定微信账号场景）
    var ext = new Dictionary<string, object>
    {
        { "method", "wechat" },
        { "scene", "authorization" }
    };

    RuiXueSdk.BindAccount(
        ext,
        data => Debug.Log("绑定第三方账号成功: " + data),
        error => Debug.LogError("绑定第三方账号失败: " + error)
    );

# ==================== 绑定手机号 ====================
bind_phone:
  method: "RXSDK.BindPhone(string phone, string password, string captchaCode, object migrateArgs, SdkCallback callback)"
  code: |
    RXSDK.BindPhone("13800138000", "password123", "123456", null, result =>
    {
        if (result.IsSuccess) Debug.Log("绑定手机号成功");
        else Debug.LogError("绑定手机号失败: " + result.Error);
    });

# ==================== 解绑手机号 ====================
unbind_phone:
  method: "RXSDK.UnBindPhone(string phone, string captchaCode, SdkCallback callback)"
  code: |
    RXSDK.UnBindPhone("13800138000", "123456", result =>
    {
        if (result.IsSuccess) Debug.Log("解绑手机号成功");
    });

# ==================== 修改手机号 ====================
change_phone:
  method: "RXSDK.ChangePhone(string newPhone, string newCaptcha, string oldCaptcha, object migrateArgs, SdkCallback callback)"
  code: |
    RXSDK.ChangePhone("13900139000", "654321", "123456", null, result =>
    {
        if (result.IsSuccess) Debug.Log("修改手机号成功");
    });

# ==================== 绑定邮箱 ====================
bind_email:
  method: "RXSDK.BindEmail(string email, string password, string captchaCode, object migrateArgs, SdkCallback callback)"
  code: |
    RXSDK.BindEmail("user@example.com", "password123", "123456", null, result =>
    {
        if (result.IsSuccess) Debug.Log("绑定邮箱成功");
    });

# ==================== 解绑邮箱 ====================
unbind_email:
  method: "RXSDK.UnBindEmail(string email, string captchaCode, SdkCallback callback)"
  code: |
    RXSDK.UnBindEmail("user@example.com", "123456", result =>
    {
        if (result.IsSuccess) Debug.Log("解绑邮箱成功");
    });

# ==================== 导入语句 ====================
imports:
  - "using System.Collections.Generic;"
  - "using RuiXue;"
  - "using UnityEngine;"

{{template "unity_native_dependency_upgrade" .NativeDependencyUpgrade}}
