# ==================== 样板代码 ====================
code: |
  // ========== 瑞雪 SDK Unity v1 登录 ==========
  using UnityEngine;
  using RuiXue;
  using RuiXue.Login;

  // ---------- 游客登录 ----------
  private void LoginAsGuest()
  {
      var config = new LoginConfig
      {
          loginType = LoginMethod.Guest
      };

      RXLogin.Login(
          config,
          data =>
          {
              Debug.Log("游客登录成功: " + data);
          },
          error =>
          {
              Debug.LogError("游客登录失败: " + error);
          }
      );
  }

  // ---------- 账号密码登录 ----------
  private void LoginWithPassword(string username, string password)
  {
      var config = new LoginConfig
      {
          loginType = LoginMethod.Username,
          username = username,
          password = password
      };

      RXLogin.Login(
          config,
          data => Debug.Log("账号登录成功: " + data),
          error => Debug.LogError("账号登录失败: " + error)
      );
  }

  // ---------- 验证码登录 ----------
  private void LoginWithCaptcha(string phone, string captchaCode)
  {
      var config = new LoginConfig
      {
          loginType = LoginMethod.CaptchaCode,
          username = phone,
          captchaCode = captchaCode
      };

      RXLogin.Login(
          config,
          data => Debug.Log("验证码登录成功: " + data),
          error => Debug.LogError("验证码登录失败: " + error)
      );
  }

  // ---------- 第三方登录示例 ----------
  private void LoginWithWechat()
  {
      var config = new LoginConfig { loginType = LoginMethod.Wechat };
      RXLogin.Login(config, data => { }, error => Debug.LogError(error));
  }

  // ---------- 注册 ----------
  private void Register(string username, string password, string captchaCode)
  {
      RXLogin.Register(
          username,
          password,
          captchaCode,
          null,
          data => Debug.Log("注册成功: " + data),
          error => Debug.LogError("注册失败: " + error)
      );
  }

  // ---------- 退出登录 ----------
  private void Logout()
  {
      RXLogin.Logout(
          data => Debug.Log("退出登录成功: " + data),
          error => Debug.LogError("退出登录失败: " + error)
      );
  }

# ==================== 检查指南 ====================
check_guide:
  - 检查是否存在 RXLogin.Login 方法调用
  - 验证 LoginConfig 是否正确配置了 loginType
  - 检查是否正确处理 onResponse 与 onError 双回调
  - 对于账号密码登录，检查是否传入了 username 和 password
  - 对于验证码登录，检查是否传入了 username 和 captchaCode

