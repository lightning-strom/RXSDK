# 瑞雪 SDK Unity GDT 接入规范
# Generated by MCP

overview:
  feature: gdt
  capabilities:
    mobile:
      package: "com.ruixue.unitysdk.gdt"
      minimum_version: "1.6.38"
      android_dependency: "com.ruixue:rxsdk_gdt:4.0.16"
      ios_pods:
        RXGDTSDK: "1.0.2"
        RXSDK_Pure: "4.0.8"
    weixin_minigame:
      package: "com.ruixue.unitysdk.minigame.weixin"
      minimum_version: "1.6.38"
      jssdk_minimum_version: "4.0.2"
  note: |
    移动端 RXGDT 与微信小游戏 RXMiniGameWeiXin 是两套独立能力。
    直玩广告状态接口仅属于微信小游戏，不属于 com.ruixue.unitysdk.gdt。

mobile:
  dependencies: |
    "com.ruixue.unitysdk.base": "1.6.38",
    "com.ruixue.unitysdk.gdt": "1.6.38"
  code_csharp: |
    using RuiXue.GDT;

    // iOS 必须在 RuiXueSdk.Initialize 前调用；Android 为空操作。
    RXGDT.RegisterSdk();
    RuiXueSdk.Initialize(config, onSuccess, onFailure);

    RXGDT.Initialize("YOUR_ACTION_SET_ID", "YOUR_SECRET_KEY", "tencent", "tencent");
    RXGDT.ReportCreateRole("role-id");
    RXGDT.ReportCheckout("item", "礼包", "sku-1", 1, false, "", "CNY", true);
    // 金额单位为分。
    RXGDT.ReportPurchase("item", "礼包", "sku-1", 1, "wechat", "CNY", 600, true);
  other_methods:
    - RXGDT.ReportRegister
    - RXGDT.ReportLogin
    - RXGDT.ReportQuestFinish
    - RXGDT.ReportShare
    - RXGDT.ReportUpdateLevel
    - RXGDT.ReportRateApp
    - RXGDT.ReportViewContent
    - RXGDT.ReportAddToCart

weixin_minigame:
  dependencies: |
    "com.ruixue.unitysdk.base": "1.6.38",
    "com.ruixue.unitysdk.minigame.weixin": "1.6.38"
  build_artifacts:
    - channelSDK/index.js（JSSDK >= 4.0.2）
    - channelSDK/tencent-sdk.js
    - game.js 中 import { SDK } from './tencent-sdk'
    - wx.TencentSDK = SDK
  code_csharp: |
    using System.Collections.Generic;
    using RuiXue.MiniGame.WeiXin;

    // 收藏和右上角分享监听不会自动注册，必须在初始化成功回调中显式调用。
    void OnInitSuccess(string data) {
        RXMiniGameWeiXin.RegisterGdtMenuEventListeners();
    }

    RXMiniGameWeiXin.LoadFinish();
    RXMiniGameWeiXin.Subscribe();
    RXMiniGameWeiXin.TutorialStart();
    RXMiniGameWeiXin.ReportGdt("QUEST", new Dictionary<string, object> {
        ["outer_action_id"] = "quest-1001"
    });

    var status = RXMiniGameWeiXin.GetDirectAdStatusSync();
    RXMiniGameWeiXin.OnDirectAdStatusChange(nextStatus => {
        // nextStatus.isInDirectGameAd / isInMask / isEndByAbnormal
    });
  required_events:
    - ReportCreateRole
    - ReportUpdateLevel
    - RegisterGdtMenuEventListeners
    - ReportViewContent
  payment_note: JSSDK 4.0.2 自动查询缓存订单并补报，不要调用已废弃的 ReportPurchase。

preflight_check:
  mobile:
    - UPM GDT 包、基础初始化、RXGDT 注册/目标 API
    - Android rxsdk_gdt 4.0.16
    - iOS RXGDTSDK 1.0.2 与 RXSDK_Pure 4.0.8
  weixin_minigame:
    - UPM 微信小游戏包 1.6.38
    - JSSDK 4.0.2、tencent-sdk.js、wx.TencentSDK
    - ReportGdt 与直玩广告 API
