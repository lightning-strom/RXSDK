password_policy:
  method: "RuiXueSdk.SetPasswordStrength(RXPasswordStrength type) / RuiXueSdk.SetPwdPattern(string pattern)"
  code: |
    RuiXueSdk.SetPasswordStrength(RXPasswordStrength.Strong);
    RuiXueSdk.SetPwdPattern(@"^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d]{8,}$");

imports:
