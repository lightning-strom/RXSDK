# ==================== 埋点数据上报 ====================
data_track:
  method: "RXAnalysis.DataTrack(string eventName, string distinctId, Dictionary<string, object> properties, RequestResponseDelegate onResponse, RequestErrorDelegate onError)"
  code: |
    using System.Collections.Generic;
    using RuiXue;
    using RuiXue.Analysis;

    // 自定义事件上报
    var properties = new Dictionary<string, object>
    {
        { "level", 10 },
        { "scene", "main_city" },
        { "item_id", "sword_001" }
    };

    RXAnalysis.DataTrack("level_up", "user_distinct_id", properties,
        data => Debug.Log("埋点上报成功: " + data),
        error => Debug.LogError("埋点上报失败: " + error)
    );

# ==================== 公共属性 ====================
public_properties:
  set:
    method: "RXAnalysis.SetPublicProperties(Dictionary<string, object> publicProperties)"
    code: |
      // 设置公共属性（所有埋点事件都会携带）
      var publicProps = new Dictionary<string, object>
      {
          { "server_id", "server_001" },
          { "role_name", "玩家名" },
          { "vip_level", 5 }
      };
      RXAnalysis.SetPublicProperties(publicProps);

  update:
    method: "RXAnalysis.UpdatePublicProperties(string key, object value)"
    code: |
      // 修改单个公共属性
      RXAnalysis.UpdatePublicProperties("vip_level", 6);

  delete:
    method: "RXAnalysis.DeletePublicProperties(string key)"
    code: |
      // 删除公共属性
      RXAnalysis.DeletePublicProperties("vip_level");

# ==================== 导入语句 ====================
imports:
  - "using System.Collections.Generic;"
  - "using RuiXue;"
  - "using RuiXue.Analysis;"
