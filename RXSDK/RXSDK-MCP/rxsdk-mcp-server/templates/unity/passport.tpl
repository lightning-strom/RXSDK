# 瑞雪 SDK Unity 用户通行证
# Generated by MCP
# 版本要求：com.ruixue.unitysdk.login >= 1.6.26

# ==================== 接入前强制检查 ====================
preflight_check:
  must_do_before_insert_code: true
  description: 在生成 RXLogin.GetUserInfoByField 业务代码前，必须先确认 Unity 工程、导出 Android/iOS 工程均满足基础接入和版本要求。
  checks:
    - name: "检查 Unity UPM 依赖"
      target: "Packages/manifest.json"
      required:
        com.ruixue.unitysdk.base: ">= 1.6.26"
        com.ruixue.unitysdk.login: ">= 1.6.26"
      failure_action: "如果缺少 base/login 或版本低于 1.6.26，先引导执行 unity feature=setup version=1.6.26 或 unity feature=dependency version=1.6.26。"
    - name: "检查 Unity 初始化代码"
      target: "MonoBehaviour 初始化脚本"
      required:
        - "存在 RuiXueSdk.Initialize / RXSDK.Initialize 初始化调用"
        - "cpId / productId / channelId / baseUrlList 已配置"
      failure_action: "如果未初始化，不要只插入 RXLogin.GetUserInfoByField；先生成并接入 unity feature=init 初始化代码。"
    - name: "检查 Android 原生依赖版本"
      target: "Assets/Plugins/Android/mainTemplate.gradle 或导出工程 build.gradle"
      required:
        android_sdk: ">= 4.0.9"
      failure_action: "如果导出 Android 工程使用瑞雪原生依赖，确保 com.ruixue:* 版本 >= 4.0.9。"
    - name: "检查 iOS 原生依赖版本"
      target: "Podfile / PodfileTemplate"
      required:
        RXSDK_Pure: ">= 4.0.4"
      failure_action: "如果导出 iOS 工程使用瑞雪原生依赖，确保 RXSDK_Pure >= 4.0.4 并执行 pod install / pod update RXSDK_Pure。"
    - name: "检查调用时机"
      required:
        - "必须在 SDK 初始化成功后调用"
        - "AccessToken 调用场景需要用户已登录"
      failure_action: "若调用位置早于初始化或登录成功回调，先调整调用链。"
  agent_rule: |
    当用户要求“接入瑞雪查询用户绑定信息 / 查询绑定登录方式 / 获取实名信息”等 passport 能力时，
    先执行上述基础接入和版本检查；未满足时先补基础配置或升级依赖，再插入业务接口代码。

# ==================== 用户信息管理 ====================

# 获取指定用户信息
get_user_info_by_field:
  method: "RXLogin.GetUserInfoByField(Dictionary<string, object> param, RequestResponseDelegate onResponse, RequestErrorDelegate onError)"
  api: "/v1/passport/user/info_by_field"
  request_method: "POST"
  min_version:
    unity: "1.6.26"
    android: "4.0.9"
    ios_RXSDK_Pure: "4.0.4"
  prompt_guidance: |
    当用户提出“获取用户信息、查询用户资料、查询实名信息、查询绑定信息、查询登录方式、查询防沉迷信息”等需求时，优先使用 RXLogin.GetUserInfoByField。
    根据用户问题组合字段，不要固定只查默认字段：
    - 用户实名信息：使用 user 分组，字段通常为 real_auth_id、real_auth_name、real_auth_id_card、real_auth_time、real_auth_ip、real_auth_device_code、age、birthday、sex。
    - 用户基础资料：使用 user 分组，字段通常为 openid、cp_user_id、nickname、avatar、phone、email、flag、regtime。
    - 用户绑定信息 / 用户绑定的登录方式 / 查询用户绑定了哪些账号 / 接入瑞雪查询用户绑定信息：使用 account 分组；如果只问“绑定的登录方式”，参数必须是 account: ["method"]。
    - 当前登录凭证信息：使用 current_account 分组，字段通常为 method、username、user_id、add_time。
    - 上次登录信息：使用 login 分组，字段通常为 method、login_time、last_login_time、devicecode、login_ip。
    - 本次请求环境：使用 current 分组，字段通常为 product_id、channel_id、devicecode、ip、os、os_version。
    - 防沉迷信息：使用 aas 分组，字段通常为 limit、aas、flag、suitable_age、trip。
    - 用户可能要求任意组合，例如“实名信息 + 绑定登录方式”：传 user 的实名字段，同时传 account: ["method"]。
  code: |
    using System.Collections.Generic;
    using RuiXue;
    using RuiXue.Login;
    using UnityEngine;

    Dictionary<string, object> param = new()
    {
        // user/login/current/aas/current_account/account 六个分组均为可选，至少传一个
        { "user", new[] { "openid", "cp_user_id", "nickname", "avatar", "phone", "email", "real_auth_name" } },
        { "login", new[] { "product_id", "channel_id", "login_time", "last_login_time", "method" } },
        { "current", new[] { "product_id", "channel_id", "devicecode", "ip", "os", "os_version" } },
        { "aas", new[] { "flag", "limit", "aas", "suitable_age", "trip" } },
        { "current_account", new[] { "user_id", "method", "username", "add_time" } },
        { "account", new[] { "user_id", "method", "username", "add_time" } },
        // Accesstoken 调用时无需传 openid/cp_user_id；服务端签名调用时二选一
        // { "openid", "rxuxxxx" },
        // { "cp_user_id", "10001" }
    };

    RXLogin.GetUserInfoByField(
        param,
        data => Debug.Log("获取指定用户信息成功: " + data),
        error => Debug.LogError("获取指定用户信息失败: " + error)
    );

  supported_fields:
    user: [openid, cp_user_id, product_id, channel_id, custom, source, promoter, devicecode, subchannelid, platformid, attr, nickname, avatar, regtime, regip, birthday, age, sex, user_state, phone, email, flag, topinviter_platformid, topinviter_openid, topinviter_subchannelid, inviter_level, inviter_subchannelid, inviter_openid, inviter_platformid, realauthid, realauth_time, real_auth_id, real_auth_name, real_auth_id_card, real_auth_time, real_auth_ip, real_auth_device_code]
    login: [devicecode, product_id, channel_id, login_ip, login_time, last_login_time, method]
    current: [product_id, channel_id, devicecode, ip, os, os_version]
    aas: [flag, limit, aas, suitable_age, trip]
    account: [user_id, add_time, product_id, channel_id, username, method, devicecode]
  examples:
    real_auth_and_bound_methods:
      description: 获取用户实名信息和用户绑定的登录方式信息
      code: |
        Dictionary<string, object> param = new()
        {
            { "user", new[] { "real_auth_id", "real_auth_name", "real_auth_id_card", "real_auth_time", "age", "sex" } },
            { "account", new[] { "method" } }
        };
    bound_login_methods_only:
      description: 接入瑞雪查询用户绑定信息 / 查询用户绑定的登录方式
      code: |
        Dictionary<string, object> param = new()
        {
            { "account", new[] { "method" } }
        };
    profile_and_current_request:
      description: 获取用户基础资料和本次请求环境
      code: |
        Dictionary<string, object> param = new()
        {
            { "user", new[] { "openid", "nickname", "avatar", "phone", "email" } },
            { "current", new[] { "ip", "os", "os_version" } }
        };

