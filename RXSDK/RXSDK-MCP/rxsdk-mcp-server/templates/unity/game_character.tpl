# 瑞雪 SDK Unity 游戏角色
# Generated by MCP

# ==================== 说明 ====================
description: |
  SetGameInfo 上报角色与区服；SetThirdGameInfo 在 Android 上报完整三方渠道信息，
  在 iOS 使用 roleId/serverId 复用 SetGameInfo。
  角色 CRUD 仍可通过 RuiXueSdk.CreateRequest 自定义请求接口实现。

preflight_check:
  min_version:
    unity: "4.0.3"
    android: "4.0.16"
  requirements:
    - "Packages/manifest.json 中全部 com.ruixue.unitysdk.* 版本 >= 4.0.3"
    - "已完成 RuiXueSdk.Initialize / RXSdkInitConfig 初始化"
    - "Android 导出依赖中的 com.ruixue:* 版本 >= 4.0.16"

# ==================== 游戏信息上报 ====================
game_info_code: |
  using RuiXue;

  // 上报到瑞雪：仅设置角色 ID 与区服标识
  RuiXueSdk.SetGameInfo("role_001", "server_001");

  // 上报到三方渠道：完整用户/角色信息，仅 Android 实现底层调用
  GameInfo gameInfo = new GameInfo(2, "role_001", "server_001")
  {
      roleName = "勇者小明",
      serverName = "一区",
      gameRoleLevel = "10",
      partyId = "guild_001",
      partyName = "瑞雪公会",
      vipLevel = 5,
      gameRolePower = 100000,
      experience = "1000",
      balance = "100",
      attach = "{\"roleType\":\"战士\"}"
  };
  RuiXueSdk.SetThirdGameInfo(gameInfo);

api_semantics:
  SetGameInfo: "上报到瑞雪的游戏信息，参数为 roleId、regionTag"
  SetThirdGameInfo: "Android 上报完整三方渠道信息；iOS 使用 GameInfo.roleId/serverId 调用 SetGameInfo；WebGL 不实现"
  mumu_type_mapping:
    1: 创角成功
    2: 登录成功
    3: 角色升级

# ==================== 通过 CreateRequest 实现 ====================
code: |
  using System.Collections.Generic;
  using RuiXue;

  // ========== 创建游戏角色 ==========
  private void CreateGameCharacter(string roleName, string roleId, string serverId)
  {
      var body = new Dictionary<string, string>
      {
          { "role_name", roleName },
          { "role_id", roleId },
          { "server_id", serverId }
      };

      RuiXueSdk.CreateRequest(
          "/game/character/create",
          new Dictionary<string, string>(),
          body,
          HttpMethod.POST,
          true,
          data => Debug.Log("创建角色成功: " + data),
          error => Debug.LogError("创建角色失败: " + error)
      );
  }

  // ========== 查询角色列表 ==========
  private void SearchGameCharacterList()
  {
      RuiXueSdk.CreateRequest(
          "/game/character/list",
          new Dictionary<string, string>(),
          new Dictionary<string, string>(),
          HttpMethod.POST,
          true,
          data => Debug.Log("角色列表: " + data),
          error => Debug.LogError("查询角色列表失败: " + error)
      );
  }

  // ========== 更新角色信息 ==========
  private void UpdateGameCharacter(string roleId, string roleName, string roleLevel)
  {
      var body = new Dictionary<string, string>
      {
          { "role_id", roleId },
          { "role_name", roleName },
          { "role_level", roleLevel }
      };

      RuiXueSdk.CreateRequest(
          "/game/character/update",
          new Dictionary<string, string>(),
          body,
          HttpMethod.POST,
          true,
          data => Debug.Log("更新角色成功: " + data),
          error => Debug.LogError("更新角色失败: " + error)
      );
  }

# ==================== 导入语句 ====================
imports:
  - "using System.Collections.Generic;"
  - "using RuiXue;"
