# ==================== 获取反馈类型 ====================
get_feedback_kind_list:
  method: "RXFeedback.GetFeedbackKindList(RequestResponseDelegate onResponse, RequestErrorDelegate onError)"
  code: |
    using RuiXue;
    using RuiXue.Feedback;
    using UnityEngine;

    RXFeedback.GetFeedbackKindList(
        data => Debug.Log("反馈类型列表: " + data),
        error => Debug.LogError("获取反馈类型失败: " + error)
    );

# ==================== 创建反馈 ====================
create_feedback:
  method: "RXFeedback.CreateFeedback(Dictionary<string, object> dic, RequestResponseDelegate onResponse, RequestErrorDelegate onError)"
  code: |
    var feedbackData = new Dictionary<string, object>
    {
        { "content", "游戏出现闪退问题" },
        { "kind_id", 1 },
        { "contact", "user@example.com" }
    };

    RXFeedback.CreateFeedback(
        feedbackData,
        data => Debug.Log("反馈创建成功: " + data),
        error => Debug.LogError("反馈创建失败: " + error)
    );

# ==================== 满意度评价 ====================
satisfaction_evaluation:
  method: "RXFeedback.SatisfactionEvaluation(Dictionary<string, object> dic, RequestResponseDelegate onResponse, RequestErrorDelegate onError)"
  code: |
    var evalData = new Dictionary<string, object>
    {
        { "score", 5 },
        { "feedback_id", 12345 }
    };

    RXFeedback.SatisfactionEvaluation(
        evalData,
        data => Debug.Log("评价成功: " + data),
        error => Debug.LogError("评价失败: " + error)
    );

