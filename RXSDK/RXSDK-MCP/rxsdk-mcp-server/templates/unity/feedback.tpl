# ==================== 上报反馈日志 ====================
report_feedback_log:
  method: "RXFeedback.ReportFeedbackLog(byte[] data, RequestResponseDelegate onResponse, RequestErrorDelegate onError)"
  code: |
    byte[] logData = System.Text.Encoding.UTF8.GetBytes("日志内容");
    RXFeedback.ReportFeedbackLog(
        logData,
        data => Debug.Log("日志上报成功: " + data),
        error => Debug.LogError("日志上报失败: " + error)
    );

