# 瑞雪 SDK Unity Sign in with Apple 工程配置
# Generated by MCP

project_config:
  capability: "Target -> Signing & Capabilities -> Sign in with Apple"
  generated_script: "Assets/RuiXueSettings/Editor/RXMCPAppleLoginPostBuildProcessor.cs"
  auto_config: |
    调用 unity feature=apple_signin_config 并传入 workspacePath 后，MCP 会幂等生成 Editor PostBuild。
    Unity 导出 iOS 工程时，脚本会：
    1. 读取 Unity 主 Target 已配置的 CODE_SIGN_ENTITLEMENTS。
    2. 优先复用宿主已有 entitlements，保留 Push、Associated Domains、Keychain 等能力。
    3. 未配置时使用 Unity-iPhone/Unity-iPhone.entitlements。
    4. 调用 ProjectCapabilityManager.AddSignInWithApple()。
  manual_step:
    - "在 Apple Developer 后台为对应 App ID 开启 Sign in with Apple。"
    - "重新生成或刷新包含该 Capability 的 Provisioning Profile。"

apple_login_example:
  code_csharp: |
    using RuiXue;
    using RuiXue.Login;

    var config = new LoginConfig { loginType = LoginMethod.Apple };
    RXLogin.Login(
        config,
        data => Debug.Log("Apple 登录成功: " + data),
        error => Debug.LogError("Apple 登录失败: " + error)
    );

check_guide:
  - "必须显式调用 apple_signin_config；普通 login 不会生成 Apple PostBuild。"
  - "Unity 导出 iOS 后检查主 Target 的 Sign in with Apple Capability。"
  - "确认原有 entitlements 能力仍然保留。"
