# ==================== RXSdkInitConfig 配置类 ====================
config_class:
  name: RXSdkInitConfig
  namespace: RuiXue
  description: SDK 初始化配置类
  properties:
    - name: cpId
      type: string
      required: true
      description: CP 唯一 ID，从 7 位数 1000000 开始递增
    - name: productId
      type: string
      required: true
      description: 瑞雪内部的应用 ID
    - name: channelId
      type: string
      required: true
      description: 瑞雪内部渠道 ID
    - name: baseUrlList
      type: "List<string>"
      required: true
      description: "瑞雪域名地址 https://domain.com/ 格式"
    - name: isLogEnable
      type: bool
      required: false
      default: "true"
      description: 日志开关
    - name: autoInitThird
      type: bool
      required: false
      default: "true"
      description: 是否自动初始化第三方 SDK，对应 Android setAutoInitThird
    - name: usePrivacy
      type: bool
      required: false
      default: "false"
      description: 首次启动是否展示用户隐私授权页面
    - name: agreementTitle
      type: string
      required: false
      default: "用户协议和隐私政策"
      description: 协议标题
    - name: isUseDNS
      type: bool
      required: false
      default: "false"
      description: 是否打开 DNS
    - name: agreementMap
      type: "Dictionary<string, object>"
      required: false
      description: 自定义协议键值对
    - name: thirdSdkParams
      type: "Dictionary<string, object>"
      required: false
      description: 第三方 SDK 初始化参数，对应 Android setThirdSdkParams

# ==================== 回调规范 ====================
callback:
  type: RequestResponseDelegate / RequestErrorDelegate
  description: 成功回调返回 JSON 字符串，失败回调返回错误信息字符串

# ==================== 样板代码 ====================
code: |
  // ========== 瑞雪 SDK Unity 初始化 ==========
  using System.Collections.Generic;
  using UnityEngine;
  using RuiXue;

  public class GameManager : MonoBehaviour
  {
      void Start()
      {
          InitSDK();
      }

      private void InitSDK()
      {
          // 方式一：使用配置对象初始化（推荐）
          var config = new RXSdkInitConfig
          {
              cpId = "your_cpid",                    // CP 唯一 ID
              productId = "your_product_id",         // 应用 ID
              channelId = "your_channel_id",         // 渠道 ID
              baseUrlList = new List<string>
              {
                  "https://api1.ruixueyun.com",
                  "https://api2.ruixueyun.com"
              },
              isLogEnable = true,                    // 日志开关
              autoInitThird = true,                  // 是否自动初始化第三方 SDK
              thirdSdkParams = new Dictionary<string, object>
              {
                  { "your_third_sdk_key", "your_third_sdk_value" }
              },
              usePrivacy = false,                    // 是否展示隐私协议弹窗
          };

          RuiXueSdk.Initialize(
              config,
              data =>
              {
                  Debug.Log("SDK 初始化成功: " + data);
                  // TODO: 初始化成功，可以进行登录等操作
              },
              error =>
              {
                  Debug.LogError("SDK 初始化失败: " + error);
                  // TODO: 处理初始化失败
              }
          );

          // 方式二：直接传参初始化
          // RuiXueSdk.Initialize("your_cpid", "your_product_id", "your_channel_id",
          //     new List<string> { "https://api1.ruixueyun.com" },
          //     data => { ... },
          //     error => { ... });
      }
  }

# ==================== 配置说明 ====================
config_options: |
  // ========== 可选配置 ==========

  // 隐私协议配置
  RuiXueSdk.SetPrivacyAgree(agreed =>
  {
      if (agreed)
      {
          Debug.Log("用户已同意隐私协议");
      }
  });

  // 日志开关
  RuiXueSdk.SetLogEnable(true);

  // 设置语言
  RuiXueSdk.SetLanguage("zh-Hans");

  // 设置子渠道 ID
  RuiXueSdk.SetSubChannelId("sub_channel_001");

  // 设置防沉迷监听
  // RuiXueSdk.SetupAddictDelegate(addictDelegate);

  // 设置全局回调（事件回调、登出回调、切换账号回调）
  RuiXueSdk.SetSdkCallback(
      publicDelegate: (int type, string jsonDicData) => { Debug.Log($"事件: {type}, {jsonDicData}"); },
      onLogout: (code, msg) => { Debug.Log($"登出: {code}, {msg}"); },
      onSwitchAccount: (code, data) =>
      {
          Debug.Log($"切换账号: {code}");
          return true; // 返回 true 表示处理成功
      }
  );

# ==================== 注意事项 ====================
note: |
  1. 初始化必须在使用其他 SDK 功能前调用
  2. cpId、productId、channelId、baseUrlList 为必须参数
  3. 所有 SDK 回调默认在 Unity 主线程执行（MainThreadScheduler）
  4. 建议在游戏启动场景的 MonoBehaviour.Start() 中调用初始化
  5. 初始化成功后再调用登录等其他功能
  6. async 方法需要 Unity 2019.4+ 支持
  7. 调用 MCP unity feature=init 时应同时传入 workspacePath、channel、androidVersion；MCP 会检查并自动补齐 Android Manifest、UnityPlayerActivity 生命周期和 Gradle 工程配置
