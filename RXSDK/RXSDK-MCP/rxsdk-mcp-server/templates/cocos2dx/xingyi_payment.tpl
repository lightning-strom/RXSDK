# 瑞雪 SDK Cocos2dx 星驿支付
# Generated by MCP

overview:
  feature: xingyi_payment
  supported_platform: Android
  unsupported_platform: iOS
  minimum_android_sdk: "4.0.14"
  dependencies:
    app: "com.ruixue:rxsdk_xingyi:4.0.14"
    h5: "com.ruixue:rxsdk_h5pay:4.0.14"

app_example_cpp: |
  auto bridge = ruixue::RuixueBridge::getInstance();
  bridge->pay(R"({
    "payType":"xy",
    "goodsTag":"YOUR_GOODS_TAG",
    "tradeNo":"YOUR_TRADE_NO"
  })", callback);

h5_example_cpp: |
  auto bridge = ruixue::RuixueBridge::getInstance();
  bridge->pay(R"({
    "payType":"xy",
    "goodsTag":"YOUR_GOODS_TAG",
    "tradeNo":"YOUR_TRADE_NO",
    "ext":{"is_h5":1}
  })", callback);

notes:
  - H5 的 ext.is_h5 必须是 JSON 整数 1。
  - paymentMode=app/h5/both 决定 Android Gradle 必需依赖。
  - iOS 不支持星驿支付，不要为 iOS 生成伪桥接调用。
