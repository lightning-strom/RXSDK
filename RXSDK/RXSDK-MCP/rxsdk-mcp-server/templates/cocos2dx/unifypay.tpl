# 瑞雪 SDK Cocos2dx 银联综合支付
# Generated by MCP

overview:
  feature: unifypay
  supported_platform: Android
  unsupported_platform: iOS
  android_dependency: "com.ruixue:rxsdk_unifypay:4.0.17"
  android_direct_api: "UPPaySdkWrapper.getInstance().doPay"
  minimum_min_sdk: 22

example_cpp: |
  auto bridge = ruixue::RuixueBridge::getInstance();
  bridge->pay(R"({
    "payType":"aums",
    "goodsTag":"YOUR_GOODS_TAG",
    "tradeNo":"YOUR_TRADE_NO",
    "ext":{
      "hq_type":"uac",
      "supportBank":"CCB",
      "invokeType":"APP"
    }
  })", callback);

requirements:
  - "仅支持 Cocos2dx Android；iOS 不生成伪调用。"
  - "调用前必须完成 RuixueBridge 基础初始化。"
  - "Android 工程必须集成当前已验证的 com.ruixue:rxsdk_unifypay >= 4.0.17，minSdkVersion >= 22。"
  - "C++ 通过 RuixueBridge::pay 进入支付链路，Android 银联插件使用 UPPaySdkWrapper.getInstance().doPay。"
