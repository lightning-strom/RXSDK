// ============================================================
// 1. 发起支付
// ============================================================

sdk.pay({
    amount: 100,                    // 必填：金额（单位：分）
    product_name: '100钻石',        // 必填：商品名称
    product_desc: '游戏内虚拟道具',  // 必填：商品描述
    cp_order_id: 'CP202401010001', // 必填：CP 订单号（需唯一）
    product_id: 'diamond_100',     // 选填：商品 ID
    role_id: 'role_001',           // 选填：角色 ID
    server_id: 'server_001',      // 选填：服务器 ID
    ext: '{}',                     // 选填：扩展参数（JSON 字符串）
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('支付成功', res.data)
        } else {
            console.error('支付失败', res.code, res.msg)
            // res.thirdcode - 微信支付错误码
            // res.thirdmsg  - 微信支付错误信息
        }
    }
})

// ============================================================
// 2. 补单（补偿订单）
// ============================================================

// 检查是否有待补偿订单
const hasCompensate = sdk.checkHasCompensatePayOrder()

// 发起补单
sdk.compensatePayOrder({}, {
    complete(res) {
        if (res.code === 0) {
            console.log('补单成功', res.data)
        } else {
            console.error('补单失败', res.code, res.msg)
        }
    }
})

// ============================================================
// 3. 订单查询
// ============================================================

sdk.tradeQuery({ order_no: 'ORDER_NO_HERE' }, {
    complete(res) {
        if (res.code === 0) {
            console.log('订单状态', res.data)
        }
    }
})

// ============================================================
// 4. 商户转账
// ============================================================

sdk.requestMerchantTransfer({
    // 转账参数
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('转账成功', res.data)
        }
    }
})

// ============================================================
// 注意事项
// ============================================================

// 1. 支付前必须已登录
// 2. cp_order_id 必须全局唯一，建议使用时间戳+随机数
// 3. amount 单位为分（1元 = 100分）
// 4. 微信支付取消时 errCode == -2
// 5. 登录 session 过期会自动重试（最多 2 次）
