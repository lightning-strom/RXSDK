// ============================================================
// 1. 上报位置
// ============================================================

sdk.reportLocation({
    latitude: 39.9042,              // 纬度
    longitude: 116.4074,            // 经度
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('位置上报成功')
        }
    }
})

// ============================================================
// 2. 删除位置
// ============================================================

sdk.deleteReportLocation({}, {
    complete(res) {
        if (res.code === 0) {
            console.log('位置删除成功')
        }
    }
})

// ============================================================
// 3. 获取附近玩家
// ============================================================

sdk.getNearlyPeasonByRadius({
    latitude: 39.9042,
    longitude: 116.4074,
    radius: 5000,                   // 半径（米）
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('附近玩家', res.data)
        }
    }
})

