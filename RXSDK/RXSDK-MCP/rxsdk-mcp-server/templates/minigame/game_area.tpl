// ============================================================
// 1. 获取区服列表
// ============================================================

sdk.getGameAreaList({
    complete(res) {
        if (res.code === 0) {
            console.log('区服列表', res.data)
        }
    }
})

// ============================================================
// 2. 获取区服信息
// ============================================================

sdk.getGameArea({ area_id: 'area_001' }, {
    complete(res) {
        if (res.code === 0) {
            console.log('区服信息', res.data)
        }
    }
})

// ============================================================
// 3. 创建区服
// ============================================================

sdk.createGameArea({
    area_id: 'area_001',
    area_name: '1区-龙之谷',
    status: 1,                      // 1:正常 0:维护
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('创建区服成功')
        }
    }
})

// ============================================================
// 4. 更新区服
// ============================================================

sdk.putGameArea({
    area_id: 'area_001',
    area_name: '1区-龙之谷（新）',
    status: 1,
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('更新区服成功')
        }
    }
})

// ============================================================
// 5. 删除区服
// ============================================================

sdk.delGameArea({ area_id: 'area_001' }, {
    complete(res) {
        if (res.code === 0) {
            console.log('删除区服成功')
        }
    }
})

// ============================================================
// 注意事项
// ============================================================

// 1. 区服管理通常在服务端操作
// 2. 必须在登录后调用
