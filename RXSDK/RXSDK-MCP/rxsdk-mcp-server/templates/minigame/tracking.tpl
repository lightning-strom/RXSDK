// ============================================================
// 1. 自定义事件上报
// ============================================================

sdk.track({
    event: '#custom_event',         // 事件名称（# 开头为预置事件）
    properties: {                   // 自定义属性
        level: 10,
        score: 9999,
        item_name: '道具名称'
    }
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('埋点上报成功')
        }
    }
})

