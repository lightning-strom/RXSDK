// ============================================================
// 1. 获取反馈分类列表
// ============================================================

sdk.getFeedbackKindList({
    complete(res) {
        if (res.code === 0) {
            console.log('反馈分类', res.data)
        }
    }
})

// ============================================================
// 2. 创建反馈
// ============================================================

sdk.createFeedback({
    kind_id: 1,                     // 反馈分类 ID
    content: '反馈内容描述',
    contact: '13800138000',         // 联系方式（选填）
    images: [],                     // 图片列表（选填）
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('反馈提交成功')
        }
    }
})

// ============================================================
// 3. 获取反馈列表
// ============================================================

sdk.getFeedbackList({ page: 1, page_size: 20 }, {
    complete(res) {
        if (res.code === 0) {
            console.log('反馈列表', res.data)
        }
    }
})

// ============================================================
// 4. 获取反馈详情
// ============================================================

sdk.getFeedbackDetail({ feedback_id: 'feedback_001' }, {
    complete(res) {
        if (res.code === 0) {
            console.log('反馈详情', res.data)
        }
    }
})

// ============================================================
// 5. 满意度评价
// ============================================================

sdk.satisfactionEvaluation({
    feedback_id: 'feedback_001',
    score: 5,                       // 评分 1-5
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('评价成功')
        }
    }
})

// ============================================================
// 注意事项
// ============================================================

// 1. 创建反馈前先获取分类列表
// 2. 图片需先上传获取 URL
// 3. 必须在登录后调用
