// ============================================================
// 3. 获取同玩游戏好友列表 getRelationFriendList
//    版本要求：jssdk >= 4.0.1，需微信基础库 3.16.2 及以上（低版本走失败回调）
// ============================================================

sdk.getRelationFriendList(
    {
        // 以下参数全部可选，无需参数时传入空对象 {}
        guideAuthWhenDeny: true,                     // 拒绝授权时是否自动弹窗引导去设置页开启，默认 true
        authModalTitle: '授权提示',                   // 引导弹窗标题
        authModalContent: '需要获取互动好友信息，请在设置中开启授权', // 引导弹窗内容
    },
    {
        complete(res) {
            if (res.code === 0) {
                console.log('同玩好友列表', res.data)
            }
        }
    }
)

