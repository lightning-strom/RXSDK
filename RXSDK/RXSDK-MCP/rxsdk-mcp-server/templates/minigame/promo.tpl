// ============================================================
// 1. 获取福利码
// ============================================================

sdk.getPromoDisplayKEY({
    complete(res) {
        if (res.code === 0) {
            console.log('福利码', res.data)
            // res.data.promo_code - 福利码
        }
    }
})

// ============================================================
// 2. 兑换福利码
// ============================================================

sdk.exchangePromoCDKEY('PROMO_CODE_HERE', {
    complete(res) {
        if (res.code === 0) {
            console.log('兑换成功', res.data)
        } else {
            console.error('兑换失败', res.msg)
        }
    }
})

// ============================================================
// 3. 检查是否为达人
// ============================================================

const isPromoter = sdk.checkIsPromoter()
console.log('是否为达人:', isPromoter)

