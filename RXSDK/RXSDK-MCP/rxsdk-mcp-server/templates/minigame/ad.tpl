 */

// ============================================================
// 1. 激励视频广告
// ============================================================

sdk.showRewardedVideoAd({
    adUnitId: 'adunit-xxxxxxxxxx',  // 广告位 ID
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('激励视频播放完成，发放奖励')
            // res.data.isEnded - 是否完整观看
        } else {
            console.error('广告播放失败', res.code, res.msg)
        }
    }
})

// ============================================================
// 2. Banner 广告
// ============================================================

// 显示 Banner 广告
sdk.showBannerAd({
    adUnitId: 'adunit-xxxxxxxxxx',
    style: {                        // 广告位置和尺寸
        left: 0,
        top: 0,
        width: 300
    }
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('Banner 广告显示成功')
        }
    }
})

// 隐藏 Banner 广告
sdk.hideBannerAd()

// 销毁 Banner 广告
sdk.destroyBannerAd()

// ============================================================
// 3. 插屏广告
// ============================================================

sdk.showInterstitialAd({
    adUnitId: 'adunit-xxxxxxxxxx',
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('插屏广告显示成功')
        }
    }
})

// ============================================================
// 注意事项
// ============================================================

// 1. 广告位 ID 从微信后台获取
// 2. 激励视频需完整观看才能发放奖励（isEnded === true）
// 3. Banner 广告可能被微信 SDK 自动调整尺寸
// 4. 广告加载失败时会自动上报错误埋点
// 5. 广告展示频率受微信平台限制
