# 瑞雪 SDK 小游戏版本检查 v2
# Generated by MCP
# 最低版本：JSSDK >= 4.0.2

preflight_check:
  must_do_before_insert_code: true
  minimum_sdk:
    minigame: ">= 4.0.2"
  checks:
    - "检查 JSSDK 构建版本是否 >= 4.0.2"
    - "检查构建产物是否包含 updateGameVersion 和 /v1/vcapi/update_module_version"
    - "检查项目是否已完成 RxSdk 初始化"
  failure_action:
    - "如果 preflight.satisfied=false，先替换为 JSSDKFile/v4.0.2 或更高版本构建产物"
    - "重新调用 minigame feature=version_check workspacePath=/path/to/project"

response_data:
  schema:
    code: "Number，接口状态码；0 表示请求正常，非 0 表示请求失败"
    data:
      type: Object
      description: 业务数据
      fields:
        modules:
          type: Array<ModuleResponse>
          description: 模块检查结果数组
          item_fields:
            module_tag: "String，模块标识"
            category_tag: "String，分类标识"
            version: "Number，最新版本；大于 0 表示有新版本，0 表示无最新版本"
            uri: "String，版本包下载地址"
  example: |
    {
      "data": {
        "modules": [
          {
            "module_tag": "dsa",
            "category_tag": "dass",
            "uri": "https://rxfile-test.ruixueyun.com/release/pkg/25031110GjPuOV0TkITessHcdWpgyWn3Tb3T2U.zip",
            "version": 88
          },
          {
            "module_tag": "_nNNN",
            "category_tag": "default",
            "uri": "https://rxfile-test.ruixueyun.com/release/pkg/25031110jCFrdMrEvsqRMDnMEC7vMoJO7EinKp.zip",
            "version": 99
          }
        ]
      },
      "code": 0
    }

update_game_version_v2:
  method: "sdk.updateGameVersion(params, callback)"
  description: 瑞雪版本检查 v2，统一检查模块版本
  minimum_version: "4.0.2"
  params:
    modules:
      - module_tag: "@test"
        category_tag: "@test"
        clientversion: 0
        checkversion: 0
      - module_tag: "@test"
        category_tag: "@test"
        clientversion: 0
        checkversion: 0
    type: "js"
  module_fields:
    module_tag: "String，必填，模块标识"
    category_tag: "String，必填，分类标识"
    clientversion: "Number，必填，客户端当前版本；0 表示首次接入或当前无相关版本"
    checkversion: "Number，必填，优先检查版本；不指定时传 0"
  code: |
    sdk.updateGameVersion({
      modules: [
        {
          module_tag: '@test',
          category_tag: '@test',
          clientversion: 0,
          checkversion: 0
        },
        {
          module_tag: '@test',
          category_tag: '@test',
          clientversion: 0,
          checkversion: 0
        }
      ],
      type: 'js'
    }, {
      complete(res) {
        if (res.code === 0) {
          console.log('版本检查 v2 成功', res)
          // TODO: 解析 res.data，按服务端返回处理模块更新
        } else {
          console.error('版本检查 v2 失败', res.code, res.msg)
        }
      }
    })

insert_behavior:
  trigger_phrases:
    - "接入瑞雪版本检查"
    - "小游戏版本检查"
    - "检查更新"
    - "版本检查 v2"
  actions:
    - "固定使用 updateGameVersion v2 代码片段"
    - "插入前先确认 preflight.satisfied=true"
    - "不得生成旧版 checkVersionGameLobby、checkGameVersion、checkActivityVersion 接口"
