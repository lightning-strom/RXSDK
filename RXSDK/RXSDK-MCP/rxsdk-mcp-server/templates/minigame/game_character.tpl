// ============================================================
// 1. 创建角色
// ============================================================

sdk.createGameCharacter({
    area_id: 'area_001',
    character_id: 'char_001',
    character_name: '勇者',
    character_level: 1,
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('创建角色成功')
        }
    }
})

