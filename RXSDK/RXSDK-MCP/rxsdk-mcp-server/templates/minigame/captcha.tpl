/**
 * 瑞雪 SDK 小游戏 - 验证码
 * Generated by MCP
 */

// ============================================================
// 1. 发送手机验证码
// ============================================================

sdk.sendCaptcha({
    phone: '13800138000',           // 手机号
    purpose: 'bindphone',           // 用途：bindphone/unbindphone/bindmail 等
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('验证码发送成功')
        } else {
            console.error('发送失败', res.msg)
        }
    }
})

// ============================================================
// 2. 发送邮箱验证码
// ============================================================

sdk.sendCaptcha({
    email: 'user@example.com',
    purpose: 'bindmail',
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('邮箱验证码发送成功')
        }
    }
})

// ============================================================
// 3. 带微信授权的验证码（防刷）
// ============================================================

sdk.sendCaptcha({
    phone: '13800138000',
    purpose: 'bindphone',
    auth: true,                     // 启用微信 code 验证
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('验证码发送成功（带授权）')
        }
    }
})

// ============================================================
// purpose 可选值
// ============================================================

// bindphone    - 绑定手机
// unbindphone  - 解绑手机
// bindmail     - 绑定邮箱
// unbindmail   - 解绑邮箱
// changephone  - 换绑手机

// ============================================================
// 注意事项
// ============================================================

// 1. auth: true 时会自动调用 wx.login 获取 code 进行防刷验证
// 2. 验证码有效期通常为 5 分钟
// 3. 发送频率有限制，通常 60 秒内只能发送一次
