 * Generated by MCP
 */

// ============================================================
// 1. 微信授权登录（默认方式）
// ============================================================

sdk.login({}, {
    complete(res) {
        if (res.code === 0) {
            console.log('登录成功', res.data)
            // res.data.token   - 登录 Token
            // res.data.openid  - 用户 OpenID
            // res.data.tid     - 用户 TID
            // res.data.user_flag - 用户标志位
        } else {
            console.error('登录失败', res.code, res.msg)
        }
    }
})

// ============================================================
// 2. 指定 OpenID 登录（用于特殊场景）
// ============================================================

sdk.login({ login_openid: 'user_openid_here' }, {
    complete(res) {
        if (res.code === 0) {
            console.log('登录成功', res.data)
        }
    }
})

// ============================================================
// 3. 登录返回数据结构
// ============================================================

// 成功返回：
// {
//   code: 0,
//   data: {
//     token: "eyJhbGciOi...",       // JWT Token
//     openid: "oXXXX...",           // 用户唯一标识
//     tid: "100001",                // 瑞雪用户 ID
//     user_flag: 1,                 // 用户标志位（位运算）
//     flag: 0,                      // 附加标志
//     last_login_time: 1700000000   // 上次登录时间戳（秒）
//   }
// }

// ============================================================
// 注意事项
// ============================================================

// 1. login 内部自动调用 wx.login 获取 code
// 2. 登录成功后 Token 自动缓存到本地存储
// 3. user_flag & 1 == 1 表示新用户注册
// 4. 登录前必须完成 SDK 初始化
