// ============================================================
// 1. 申请注销账号
// ============================================================

sdk.deregister({}, {
    complete(res) {
        if (res.code === 0) {
            console.log('注销申请提交成功')
            // 注销有冷静期，期间可撤销
        } else {
            console.error('注销申请失败', res.msg)
        }
    }
})

// ============================================================
// 2. 撤销注销申请
// ============================================================

sdk.deregisterCancel({
    complete(res) {
        if (res.code === 0) {
            console.log('已撤销注销申请')
        } else {
            console.error('撤销失败', res.msg)
        }
    }
})

// ============================================================
// 注意事项
// ============================================================

// 1. 注销申请后有冷静期（通常 15 天），期间可撤销
// 2. 冷静期结束后账号将被永久删除
// 3. 注销前建议提示用户确认
// 4. 必须在登录状态下调用
