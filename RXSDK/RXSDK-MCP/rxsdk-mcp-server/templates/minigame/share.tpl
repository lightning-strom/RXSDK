/**
 * 瑞雪 SDK 小游戏 - 分享功能
 * Generated by MCP
 */

// ============================================================
// 1. 获取分享数据
// ============================================================

sdk.getShareData({
    share_type: 1,                  // 分享类型
    readCache: true,                // 是否读取缓存
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('分享数据', res.data)
            // res.data.title    - 分享标题
            // res.data.imageUrl - 分享图片 URL
            // res.data.query    - 分享携带参数
        }
    }
})

// ============================================================
// 2. 主动分享（转发给好友）
// ============================================================

sdk.share({
    share_type: 1,
    func: 'shareAppMessage',        // 分享方式
    autoReport: true,               // 自动上报分享数据
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('分享成功')
        } else {
            console.error('分享失败', res.msg)
        }
    }
})

// ============================================================
// 3. 分享海报（图片分享）
// ============================================================

sdk.sharePoster({
    share_type: 1,
    imageUrl: 'https://example.com/poster.png',  // 海报图片
    // 或使用 func 函数动态生成图片
    // func: () => canvas.toTempFilePathSync()
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('海报分享成功')
        }
    }
})

// ============================================================
// 4. 分享给好友（消息卡片）
// ============================================================

sdk.shareMessageToFriend({
    share_type: 1,
    openId: 'friend_openid',                // 好友 OpenID
    shareMessageToFriendScene: 0,            // 场景值
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('消息分享成功')
        }
    }
})

// ============================================================
// 5. 显示分享图片菜单
// ============================================================

sdk.showShareImageMenu({
    share_type: 1,
    needShowEntrance: false,
    style: 'default',               // 'default' 或 'v2'
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('分享图片成功')
        }
    }
})

// ============================================================
// 6. 获取消息好友查询
// ============================================================

sdk.fetchMessageToFriendQuery({
    complete(res) {
        if (res.code === 0) {
            console.log('好友消息数据', res.data)
        }
    }
})

// ============================================================
// 注意事项
// ============================================================

// 1. 分享功能需要登录后使用
// 2. autoReport: true 会自动上报分享调度数据
// 3. 分享图片需符合微信尺寸要求（5:4 比例）
// 4. 分享频率受微信限制
