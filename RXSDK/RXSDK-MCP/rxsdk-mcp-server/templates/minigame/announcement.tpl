// ============================================================
// 1. 获取公告列表
// ============================================================

sdk.getAnnouncement(10, {           // 参数：limit（1-100）
    complete(res) {
        if (res.code === 0) {
            console.log('公告列表', res.data)
        }
    }
})

// ============================================================
// 2. 获取临时公告
// ============================================================

sdk.getTempNotice({
    complete(res) {
        if (res.code === 0) {
            console.log('临时公告', res.data)
        }
    }
})

// ============================================================
// 3. 获取邮件列表
// ============================================================

sdk.getEmailList({ page: 1, page_size: 20 }, {
    complete(res) {
        if (res.code === 0) {
            console.log('邮件列表', res.data)
        }
    }
})

// ============================================================
// 4. 获取邮件详情
// ============================================================

sdk.getEmailDetail({ email_id: 'email_001' }, {
    complete(res) {
        if (res.code === 0) {
            console.log('邮件详情', res.data)
        }
    }
})

// ============================================================
// 5. 领取邮件道具
// ============================================================

sdk.receiveEmail({ email_id: 'email_001' }, {
    complete(res) {
        if (res.code === 0) {
            console.log('领取成功')
        }
    }
})

// ============================================================
// 6. 删除邮件
// ============================================================

sdk.delEmail({ email_id: 'email_001' }, {
    complete(res) {
        if (res.code === 0) {
            console.log('删除成功')
        }
    }
})

// ============================================================
// 注意事项
// ============================================================

// 1. getAnnouncement 的 limit 参数范围 1-100
// 2. 邮件道具领取后不可重复领取
// 3. 必须在登录后调用
