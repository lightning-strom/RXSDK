 */

// ============================================================
// 1. 绑定手机号
// ============================================================

sdk.bindPhone({
    phone: '13800138000',
    captcha: '123456',              // 验证码（先调用 sendCaptcha）
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('绑定手机成功')
        }
    }
})

// ============================================================
// 2. 解绑手机号
// ============================================================

sdk.unBindPhone({
    phone: '13800138000',
    captcha: '123456',
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('解绑手机成功')
        }
    }
})

// ============================================================
// 3. 换绑手机号
// ============================================================

sdk.changePhone({
    phone: '13900139000',           // 新手机号
    captcha: '654321',              // 新手机的验证码
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('换绑手机成功')
        }
    }
})

// ============================================================
// 4. 绑定邮箱
// ============================================================

sdk.bindEmail({
    email: 'user@example.com',
    captcha: '123456',
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('绑定邮箱成功')
        }
    }
})

// ============================================================
// 5. 解绑邮箱
// ============================================================

sdk.UnbindEmail({
    email: 'user@example.com',
    captcha: '123456',
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('解绑邮箱成功')
        }
    }
})

// ============================================================
// 6. 获取手机号（微信快速获取）
// ============================================================

// 需要用户点击 button 组件触发
sdk.getPhoneNumber({ isRealtime: true, phoneNumberNoQuotaToast: false }, {
    complete(res) {
        if (res.code === 0) {
            console.log('获取手机号成功', res.data)
        }
    }
})

// ============================================================
// 7. 校验解绑验证码
// ============================================================

sdk.validateUnbindCode({
    phone: '13800138000',
    captcha: '123456',
}, {
    complete(res) {
        if (res.code === 0) {
            console.log('验证码校验成功')
        }
    }
})

// ============================================================
// 注意事项
// ============================================================

// 1. 绑定/解绑前需先调用 sendCaptcha 发送验证码
// 2. getPhoneNumber 需要用户主动点击按钮触发（微信限制）
// 3. 所有接口需登录后调用
