# 瑞雪 Go 服务端 SDK — 风控 Risk
# Generated by MCP
# SDK: github.com/ruixueyun/ruixuego@v0.1.57

placeholder_note:
  description: "@test 是占位符，接入时必须替换为真实业务参数。"

overview:
  description: |
    内容安全（文本/图片）与实名认证。文本审核用 RiskContentTextScan；
    图片推荐 RiskContentImageScanV2；实名推荐 RealAuthV2。
  keywords:
    - RiskContentTextScan
    - RiskContentImageScanV2
    - RealAuthV2

prerequisites:
  - ruixuego.Init 已完成
  - 文本审核需合法 Scene；图片需可访问 URL

recommended_flow:
  - 用户产生昵称/聊天内容前先文本扫描
  - 用户上传图片后做图片扫描
  - 需要实名时调用 RealAuthV2
  - Suggestion==risky 时拦截或替换

apis:
  - name: RiskContentTextScan
    signature: 'func (c *Client) RiskContentTextScan(req *RiskContentTextScanReq) (*RiskContentTextScanResp, error)'
    when_to_use: 文本内容安全审核（唯一公开文本接口）
  - name: RiskContentImageScan
    signature: 'func (c *Client) RiskContentImageScan(url string) (*RiskContentImageScanResp, error)'
    when_to_use: 旧版图片审核
    deprecated: true
    prefer: RiskContentImageScanV2
  - name: RiskContentImageScanV2
    signature: 'func (c *Client) RiskContentImageScanV2(req *RiskContentImageScanReq) (*RiskContentImageScanResp, error)'
    when_to_use: 推荐：图片内容安全审核
  - name: RealAuth
    signature: 'func (c *Client) RealAuth(productID, idCard, realName string) (*RealAuthResponse, error)'
    when_to_use: 旧版实名认证
    deprecated: true
    prefer: RealAuthV2
  - name: RealAuthV2
    signature: 'func (c *Client) RealAuthV2(arg *RealAuthReq) (*RealAuthResponse, error)'
    when_to_use: 推荐：实名认证

api_details:
  - name: RiskContentTextScan
    signature: 'func (c *Client) RiskContentTextScan(req *RiskContentTextScanReq) (*RiskContentTextScanResp, error)'
    when_to_use: 昵称、私聊、公聊等场景的文本审核
    request_fields:
      - name: OpenID
        type: string
        required: false
        desc: 用户 openid（注释示例为微信小程序 openid，按业务填写）
      - name: Scene
        type: string
        required: true
        desc: "场景：nick_name / private_chat / public_chat"
        constraint: 必须为约定场景值之一
      - name: Content
        type: string
        required: true
        desc: 待审核文本
    response_fields:
      - name: Suggestion
        type: string
        desc: "pass 通过；risky 风险"
      - name: Words
        type: "[]string"
        desc: 命中敏感词
      - name: Content
        type: string
        desc: 替换后的文本内容
    validation:
      - Scene / Content 为空可能导致校验失败（binding required）
    errors:
      - 打印 err 与 ruixuego.ErrTraceID(err)
    code_go: |
      package example

      import (
      	"fmt"
      	"log"

      	"github.com/ruixueyun/ruixuego"
      )

      func riskTextScan() {
      	c := ruixuego.GetDefaultClient()
      	resp, err := c.RiskContentTextScan(&ruixuego.RiskContentTextScanReq{
      		OpenID:  "@test",
      		Scene:   "public_chat", // nick_name / private_chat / public_chat
      		Content: "@test",
      	})
      	if err != nil {
      		log.Printf("text scan failed: %v trace=%s", err, ruixuego.ErrTraceID(err))
      		return
      	}
      	fmt.Printf("suggestion=%s hit_words=%d\n", resp.Suggestion, len(resp.Words))
      	// 勿将 Content / Words 原文写入生产日志
      }

  - name: RiskContentImageScanV2
    signature: 'func (c *Client) RiskContentImageScanV2(req *RiskContentImageScanReq) (*RiskContentImageScanResp, error)'
    when_to_use: 对图片 URL 做内容安全检测
    request_fields:
      - name: URL
        type: string
        required: true
        desc: 图片地址（需服务端可访问）
    response_fields:
      - name: URL
        type: string
        desc: 图片地址
      - name: Suggestion
        type: string
        desc: "pass 通过；risky 风险"
      - name: Results
        type: "[]Results"
        desc: "检测详情：Label、Confidence(0-100，部分标签无置信分)"
    validation:
      - URL 为空会失败（以返回为准）
    errors:
      - 打印 err 与 ruixuego.ErrTraceID(err)
    code_go: |
      package example

      import (
      	"fmt"
      	"log"

      	"github.com/ruixueyun/ruixuego"
      )

      func riskImageScanV2() {
      	resp, err := ruixuego.GetDefaultClient().RiskContentImageScanV2(&ruixuego.RiskContentImageScanReq{
      		URL: "@test", // 可访问的图片 URL
      	})
      	if err != nil {
      		log.Printf("image scan failed: %v trace=%s", err, ruixuego.ErrTraceID(err))
      		return
      	}
      	fmt.Printf("suggestion=%s results=%+v\n", resp.Suggestion, resp.Results)
      }

  - name: RealAuthV2
    signature: 'func (c *Client) RealAuthV2(arg *RealAuthReq) (*RealAuthResponse, error)'
    when_to_use: 身份证+姓名实名认证
    request_fields:
      - name: CPID
        type: uint32
        required: false
        desc: 请求里填写会被 SDK 用 Init 配置的 CPID 覆盖；以全局 Config.CPID 为准
      - name: ProductID
        type: string
        required: true
        desc: 产品 ID
        constraint: 空 → ErrInvalidParam
      - name: IDCard
        type: string
        required: true
        desc: 身份证号（敏感）
        constraint: 空 → ErrInvalidParam
      - name: RealName
        type: string
        required: true
        desc: 真实姓名（敏感）
        constraint: 空 → ErrInvalidParam
    response_fields:
      - name: Code
        type: int
        desc: 业务码（以服务端返回为准）
      - name: Msg
        type: string
        desc: 描述
      - name: Data.Verified
        type: int32
        desc: 是否通过（以服务端返回为准）
    validation:
      - ProductID / IDCard / RealName 为空 → ErrInvalidParam
      - arg.CPID 在调用时被设为 config.CPID
    errors:
      - 打印 err 与 ruixuego.ErrTraceID(err)；勿打印身份证/姓名明文
    code_go: |
      package example

      import (
      	"fmt"
      	"log"

      	"github.com/ruixueyun/ruixuego"
      )

      func realAuthV2() {
      	resp, err := ruixuego.GetDefaultClient().RealAuthV2(&ruixuego.RealAuthReq{
      		// CPID 会被 Init 配置覆盖，无需也不应依赖请求里的值
      		ProductID: "@test",
      		IDCard:    "@test",
      		RealName:  "@test",
      	})
      	if err != nil {
      		log.Printf("real auth failed: %v trace=%s", err, ruixuego.ErrTraceID(err))
      		return
      	}
      	fmt.Printf("code=%d verified=%v\n", resp.Code, resp.Data.Verified)
      }

notes:
  - Suggestion: pass / risky
  - 实名与身份证属敏感信息，禁止落盘明文日志
  - 图片审核优先 V2
