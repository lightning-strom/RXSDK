api_details:
  - name: LBSUpdateV2
    signature: 'func (c *Client) LBSUpdateV2(req *ReqLBSUpdate) error'
    when_to_use: 玩家位置变化时上报经纬度
    request_fields:
      - name: OpenID
        type: string
        required: false
        desc: 瑞雪 openid
        constraint: "二者至少一个非空，否则 ErrInvalidOpenID"
      - name: UserID
        type: string
        required: false
        desc: CP 用户 ID
        constraint: "二者至少一个非空，否则 ErrInvalidOpenID"
      - name: Types
        type: "[]string"
        required: true
        desc: LBS 业务类型列表
        constraint: "不可为空，否则 ErrInvalidType"
      - name: Lon
        type: float64
        required: true
        desc: 经度（真实坐标，不能写字符串）
      - name: Lat
        type: float64
        required: true
        desc: 纬度
    response_fields:
      - name: "(error)"
        type: error
        desc: 成功 nil
    validation:
      - OpenID 与 UserID 至少一个非空，否则 ErrInvalidOpenID
      - Types 不可为空，否则 ErrInvalidType
    errors:
      - 打印 err 与 ruixuego.ErrTraceID(err)
    code_go: |
      package example

      import (
      	"log"

      	"github.com/ruixueyun/ruixuego"
      )

      func lbsUpdateV2() {
      	err := ruixuego.GetDefaultClient().LBSUpdateV2(&ruixuego.ReqLBSUpdate{
      		OpenID: "@test",
      		UserID: "@test",
      		Types:  []string{"@test"},
      		Lon:    116.397128, // 【必须替换】真实经度
      		Lat:    39.916527,  // 【必须替换】真实纬度
      	})
      	if err != nil {
      		log.Printf("LBSUpdateV2 failed: %v trace=%s", err, ruixuego.ErrTraceID(err))
      	}
      }

  - name: LBSRadiusV2
    signature: 'func (c *Client) LBSRadiusV2(req *ReqLBSRadius) ([]*RelationUser, error)'
    when_to_use: 查询某坐标半径内附近用户
    request_fields:
      - name: OpenID
        type: string
        required: false
        desc: 查询者 openid
        constraint: "二者至少一个非空，否则 ErrInvalidOpenID"
      - name: UserID
        type: string
        required: false
        desc: 查询者 user id
        constraint: "二者至少一个非空，否则 ErrInvalidOpenID"
      - name: Typ
        type: string
        required: true
        desc: LBS 业务类型（单个）
        constraint: "不可为空，否则 ErrInvalidType"
      - name: Lon
        type: float64
        required: true
        desc: 中心经度
      - name: Lat
        type: float64
        required: true
        desc: 中心纬度
      - name: Radius
        type: float64
        required: true
        desc: 半径（单位以服务端约定为准，示例按米理解）
      - name: Page
        type: int
        required: false
        desc: 页码
      - name: PageSize
        type: int
        required: false
        desc: 每页数量
      - name: Count
        type: "[]int"
        required: false
        desc: 计数相关参数（以服务端约定为准）
        note: "仅当 len(Count)==1 时才会写入请求；其它长度忽略"
    response_fields:
      - name: "[].OpenID / CPUserID / NickName / Dist ..."
        type: RelationUser
        desc: 附近用户信息；Dist 为距离相关字段
    validation:
      - OpenID 与 UserID 至少一个非空，否则 ErrInvalidOpenID
      - Typ 不可为空，否则 ErrInvalidType
      - 仅当 len(Count)==1 时将 Count[0] 写入请求；其它长度忽略
    errors:
      - 打印 err 与 ruixuego.ErrTraceID(err)
    code_go: |
      package example

      import (
      	"fmt"
      	"log"

      	"github.com/ruixueyun/ruixuego"
      )

      func lbsRadiusV2() {
      	users, err := ruixuego.GetDefaultClient().LBSRadiusV2(&ruixuego.ReqLBSRadius{
      		OpenID:   "@test",
      		UserID:   "@test",
      		Typ:      "@test",
      		Lon:      116.397128, // 【必须替换】
      		Lat:      39.916527,  // 【必须替换】
      		Radius:   1000,
      		Page:     1,
      		PageSize: 20,
      	})
      	if err != nil {
      		log.Printf("LBSRadiusV2 failed: %v trace=%s", err, ruixuego.ErrTraceID(err))
      		return
      	}
      	fmt.Println("nearby:", len(users))
      	for _, u := range users {
      		fmt.Printf("%+v\n", u)
      	}
      }

