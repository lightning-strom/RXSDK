  - name: GetLoginResultSign
    signature: 'func GetLoginResultSign(cpKey string, result *LoginResult, signFields []string) string'
    when_to_use: 校验客户端登录结果签名
    request_fields:
      - name: cpKey
        type: string
        required: true
        desc: CP 密钥
      - name: result
        type: "*LoginResult"
        required: true
        desc: "Nickname/Avatar/OpenID/Region/Sex/Age"
      - name: signFields
        type: "[]string"
        required: true
        desc: "参与签名字段，可用 SignFieldOpenID 等常量"
    response_fields:
      - name: sign
        type: string
        desc: 计算得到的签名
    validation:
      - signFields 应与对端约定一致
    errors:
      - 签名不一致则校验失败（业务层比较）
    code_go: |
      package example

      import (
      	"fmt"

      	"github.com/ruixueyun/ruixuego"
      )

      func verifyLoginSign() {
      	result := &ruixuego.LoginResult{
      		OpenID:   "@test",
      		Nickname: "@test",
      		Avatar:   "@test",
      		Region:   "@test",
      		Sex:      0,
      		Age:      0,
      	}
      	sign := ruixuego.GetLoginResultSign("@test", result, []string{
      		ruixuego.SignFieldOpenID,
      		ruixuego.SignFieldNickname,
      	})
      	fmt.Println("valid:", sign == "@test") // 生产勿打印完整签名
      }

