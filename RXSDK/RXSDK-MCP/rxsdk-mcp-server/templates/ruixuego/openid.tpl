# 瑞雪 Go 服务端 SDK — OpenID / 登录凭证
# Generated by MCP
# SDK: github.com/ruixueyun/ruixuego@v0.1.57

placeholder_note:
  description: "@test 是占位符，接入时必须替换为真实业务参数。"

overview:
  description: |
    LoginOpenID 为瑞雪登录成功后下发的加密串。CP 服务端可用 AppKey 解密校验，
    也可加密、生成虚拟登录数据、校验登录签名。多数为本地计算；需先 AddAESKey 或 Init.AppKeys。
  keywords:
    - DecryptOpenIDData
    - EncryptOpenIDData
    - GenerateVirtualLoginData
    - GetLoginResultSign
    - GetSign
    - AddAESKey

prerequisites:
  - 本地加解密可用极简 Init(&Config{})；生产建议完整 Config + AppKeys
  - AppKey 长度必须为 16 / 24 / 32 字节

recommended_flow:
  - AddAESKey（或 Init 注入 AppKeys）
  - DecryptOpenIDData 校验登录密文
  - 需要虚拟登录时 GenerateVirtualLoginData
  - 需要校验客户端回包签名时 GetLoginResultSign
  - OpenIDData 用完 Release

apis:
  - name: AddAESKey
    signature: 'func AddAESKey(productID, channelID string, key []byte) error'
    when_to_use: 为 product/channel 注册 AES 密钥
  - name: DelAESKey
    signature: 'func DelAESKey(productID, channelID string)'
    when_to_use: 移除内存中密钥（demo 用；生产 Init 后慎用）
  - name: EncryptOpenIDData
    signature: 'func EncryptOpenIDData(traceID, productID, channelID, method, openID, ext string) (string, error)'
    when_to_use: 使用已注册密钥加密 OpenID 数据
  - name: EncryptOpenIDDataWithKey
    signature: 'func EncryptOpenIDDataWithKey(aesData *AESData, traceID, productID, channelID, method, openID, ext string) (string, error)'
    when_to_use: 显式传入 *AESData 加密（不依赖全局 key 表）；先 NewAESData(key)
  - name: DecryptOpenIDData
    signature: 'func DecryptOpenIDData(productID, channelID, openIDCipherText string) (*OpenIDData, error)'
    when_to_use: 使用已注册密钥解密 LoginOpenID
  - name: DecryptOpenIDDataWithKey
    signature: 'func DecryptOpenIDDataWithKey(aesData *AESData, openIDCipherText string) (*OpenIDData, error)'
    when_to_use: 显式传入 *AESData 解密；先 NewAESData(key)
  - name: GenerateVirtualLoginData
    signature: 'func GenerateVirtualLoginData(traceID, productID, channelID, userID string) (string, error)'
    when_to_use: 生成 method=virtual 的虚拟登录密文
  - name: GenerateVirtualLoginDataWithKey
    signature: 'func GenerateVirtualLoginDataWithKey(aesData *AESData, traceID, productID, channelID, userID string) (string, error)'
    when_to_use: 显式 *AESData 生成虚拟登录密文；先 NewAESData(key)
  - name: NewAESData
    signature: 'func NewAESData(key []byte) (*AESData, error)'
    when_to_use: 将 16/24/32 字节 key 转为 *AESData，供 *WithKey API 使用
  - name: GetLoginResultSign
    signature: 'func GetLoginResultSign(cpKey string, result *LoginResult, signFields []string) string'
    when_to_use: 校验登录回包字段签名
  - name: GetSign
    signature: 'func GetSign(cpKey string, traceID, ts string) string'
    when_to_use: 计算通用请求签名（traceID + ts）

api_details:
  - name: AddAESKey
    signature: 'func AddAESKey(productID, channelID string, key []byte) error'
    when_to_use: 解密/加密前注册 AppKey
    request_fields:
      - name: productID
        type: string
        required: true
        desc: 产品 ID
      - name: channelID
        type: string
        required: true
        desc: 渠道 ID
      - name: key
        type: "[]byte"
        required: true
        desc: AES AppKey
        constraint: 长度必须为 16/24/32；禁止 5 字节 "@test"
    response_fields:
      - name: "(error)"
        type: error
        desc: key 非法时 NewCipher 失败
    validation:
      - key 长度非 16/24/32 → error
    errors:
      - 检查 AppKey 是否被截断或编码错误
    code_go: |
      package example

      import (
      	"log"

      	"github.com/ruixueyun/ruixuego"
      )

      func addAESKeyDemo() {
      	// 【重要】落地时整段替换为真实 AppKey（16/24/32 字节）
      	appKey := []byte("00000000000000000000000000000000") // 【必须替换】恰好 32 字节真实 AppKey // 示意 24 字节，禁止原样上线
      	if err := ruixuego.AddAESKey("@test", "@test", appKey); err != nil {
      		log.Fatal(err)
      	}
      }

