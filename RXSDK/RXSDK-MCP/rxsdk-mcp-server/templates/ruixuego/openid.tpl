  - name: DecryptOpenIDData
    signature: 'func DecryptOpenIDData(productID, channelID, openIDCipherText string) (*OpenIDData, error)'
    when_to_use: 校验客户端登录回包中的 LoginOpenID
    request_fields:
      - name: productID
        type: string
        required: true
        desc: 产品 ID
      - name: channelID
        type: string
        required: true
        desc: 渠道 ID
      - name: openIDCipherText
        type: string
        required: true
        desc: 加密 LoginOpenID 密文
    response_fields:
      - name: OpenID
        type: string
        desc: 解密后的 openid
      - name: Timestamp
        type: int64
        desc: 时间戳
      - name: Method / TokenID / Ext / AccountDetail
        type: mixed
        desc: 其他字段见 OpenIDData；用完建议 Release()
    validation:
      - 需先 AddAESKey 或 Init.AppKeys
    errors:
      - 密钥错误、product/channel 不匹配、密文截断均会导致解密失败
    code_go: |
      package example

      import (
      	"fmt"
      	"log"

      	"github.com/ruixueyun/ruixuego"
      )

      func decryptOpenID() {
      	_ = ruixuego.Init(&ruixuego.Config{})
      	productID, channelID := "@test", "@test"
      	appKey := []byte("00000000000000000000000000000000") // 【必须替换】恰好 32 字节真实 AppKey // 替换为真实 16/24/32 字节密钥
      	if err := ruixuego.AddAESKey(productID, channelID, appKey); err != nil {
      		log.Fatal(err)
      	}
      	defer ruixuego.DelAESKey(productID, channelID)

      	data, err := ruixuego.DecryptOpenIDData(productID, channelID, "@test")
      	if err != nil {
      		log.Fatal(err)
      	}
      	defer data.Release()
      	fmt.Printf("openid=%s ts=%d\n", data.OpenID, data.Timestamp)
      }

  - name: DecryptOpenIDDataWithKey
    signature: 'func DecryptOpenIDDataWithKey(aesData *AESData, openIDCipherText string) (*OpenIDData, error)'
    when_to_use: 不写全局 key 表；先 NewAESData(key) 再解密
    request_fields:
      - name: aesData
        type: "*AESData"
        required: true
        desc: 由 NewAESData(key) 创建；key 长度 16/24/32
      - name: openIDCipherText
        type: string
        required: true
        desc: LoginOpenID 密文
    response_fields:
      - name: "*OpenIDData"
        type: "*OpenIDData"
        desc: 同 DecryptOpenIDData；用完 Release
    validation:
      - NewAESData 要求 key 长度 16/24/32
    errors:
      - 同解密失败原因
    code_go: |
      package example

      import (
      	"fmt"
      	"log"

      	"github.com/ruixueyun/ruixuego"
      )

      func decryptWithKey() {
      	key := []byte("00000000000000000000000000000000") // 【必须替换】恰好 32 字节真实 AppKey
      	aesData, err := ruixuego.NewAESData(key)
      	if err != nil {
      		log.Fatal(err)
      	}
      	data, err := ruixuego.DecryptOpenIDDataWithKey(aesData, "@test")
      	if err != nil {
      		log.Fatal(err)
      	}
      	defer data.Release()
      	fmt.Println(data.OpenID)
      }

