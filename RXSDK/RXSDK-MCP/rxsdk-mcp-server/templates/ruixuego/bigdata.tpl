api_details:
  - name: Tracks
    signature: 'func (c *Client) Tracks(devicecode, distinctID string, opts ...BigdataOptions) error'
    when_to_use: 常规异步埋点（事件或用户属性）
    request_fields:
      - name: devicecode
        type: string
        required: false
        desc: 设备码
        constraint: "至少一个非空，否则 ErrInvalidDevicecode"
      - name: distinctID
        type: string
        required: false
        desc: 用户唯一标识
        constraint: "至少一个非空，否则 ErrInvalidDevicecode"
      - name: opts
        type: "...BigdataOptions"
        required: true
        desc: SetEvent / SetProperties / SetPreset / SetUserUpdateType 等
    response_fields:
      - name: "(error)"
        type: error
        desc: 入队/发送失败
    validation:
      - devicecode 与 distinctID 至少一个非空，否则 ErrInvalidDevicecode
      - opts 必须设置 Type（如 SetEvent/SetUpdateEvent/SetFirstEvent/SetUserUpdateType），否则 ErrInvalidType
    errors:
      - 打印 err；退出前务必 Close
    code_go: |
      package example

      import (
      	"log"

      	"github.com/ruixueyun/ruixuego"
      )

      func tracksEvent() {
      	c := ruixuego.GetDefaultClient()
      	err := c.Tracks(
      		"@test", // device code
      		"@test", // distinct id
      		ruixuego.SetEvent("@test"), // 如 login
      		ruixuego.SetPreset(map[string]interface{}{
      			ruixuego.PresetKeyProductID:    "@test",
      			ruixuego.PresetKeyChannelID:    "@test",
      			ruixuego.PresetKeySubChannelID: "@test",
      		}),
      		ruixuego.SetProperties(map[string]interface{}{"@test": "@test"}),
      	)
      	if err != nil {
      		log.Fatal(err)
      	}
      }

