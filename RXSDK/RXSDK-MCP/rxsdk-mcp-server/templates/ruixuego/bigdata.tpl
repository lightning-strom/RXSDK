  - name: Track
    signature: 'func (c *Client) Track(track *ReqTrack) (int, error)'
    when_to_use: 底层发送已编码 Data；多数业务应优先 Tracks/SyncTrackV2
    request_fields:
      - name: Data
        type: "[]byte"
        required: true
        desc: 已编码埋点体
      - name: LogCount
        type: int
        required: true
        desc: 日志条数
      - name: Compress
        type: bool
        required: false
        desc: 是否压缩
    response_fields:
      - name: "(int, error)"
        type: mixed
        desc: 发送结果码与错误
    validation:
      - 一般不直接手写 Data，除非自建编码
    errors:
      - 打印 err
    code_go: |
      package example

      import (
      	"fmt"
      	"log"

      	"github.com/ruixueyun/ruixuego"
      )

      func trackLowLevel() {
      	// 多数场景请用 Tracks / SyncTrackV2；此处仅展示签名
      	n, err := ruixuego.GetDefaultClient().Track(&ruixuego.ReqTrack{
      		Data:     []byte("@test"),
      		LogCount: 1,
      		Compress: false,
      	})
      	if err != nil {
      		log.Fatal(err)
      	}
      	fmt.Println("track result:", n)
      }

bigdata_config_fields:
  - name: CacheCapacity
    type: int
    desc: 缓存容量（0 则用默认）
  - name: BatchSize
    type: int
    desc: 批量发送每批条数
  - name: AutoFlushInterval
    type: time.Duration
    desc: 自动上传间隔（配置单位秒，见 SDK done()）
  - name: AutoFlush
    type: bool
    desc: 是否自动上传
  - name: DisableCompress
    type: bool
    desc: 是否禁用 GZip

notes:
  - 未配置 Config.BigData 时，Tracks 会因 producer 为 nil 而 panic；SyncTrackV2 也会在读取 BigData 配置时 panic
  - Init 时必须配置 BigData，并 defer ruixuego.Close()；短生命周期脚本尤其注意
  - 预置 Key 用 PresetKeyProductID 等常量
  - 优先 SyncTrackV2；SyncTrack 为 deprecated
