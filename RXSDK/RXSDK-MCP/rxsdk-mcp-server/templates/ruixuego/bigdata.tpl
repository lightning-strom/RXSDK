  - name: SyncTrackV2
    signature: 'func (c *Client) SyncTrackV2(track *ReqSyncTrack) error'
    when_to_use: 关键路径同步上报，确保送达
    request_fields:
      - name: DeviceCode
        type: string
        required: false
        desc: 设备码
        constraint: "至少一个非空，否则 ErrInvalidDevicecode"
      - name: DistinctID
        type: string
        required: false
        desc: 用户标识
        constraint: "至少一个非空，否则 ErrInvalidDevicecode"
      - name: Opts
        type: "[]BigdataOptions"
        required: true
        desc: SetEvent / SetProperties 等
    response_fields:
      - name: "(error)"
        type: error
        desc: 同步失败
    validation:
      - DeviceCode 与 DistinctID 至少一个非空，否则 ErrInvalidDevicecode
      - Opts 必须设置 Type（如 SetEvent/SetUpdateEvent/SetFirstEvent），否则 ErrInvalidType
    errors:
      - 打印 err 与 ErrTraceID
    code_go: |
      package example

      import (
      	"log"

      	"github.com/ruixueyun/ruixuego"
      )

      func syncTrackV2Event() {
      	err := ruixuego.GetDefaultClient().SyncTrackV2(&ruixuego.ReqSyncTrack{
      		DeviceCode: "@test",
      		DistinctID: "@test",
      		Opts: []ruixuego.BigdataOptions{
      			ruixuego.SetEvent("@test"),
      			ruixuego.SetProperties(map[string]interface{}{"@test": "@test"}),
      		},
      	})
      	if err != nil {
      		log.Printf("sync event failed: %v trace=%s", err, ruixuego.ErrTraceID(err))
      	}
      }

