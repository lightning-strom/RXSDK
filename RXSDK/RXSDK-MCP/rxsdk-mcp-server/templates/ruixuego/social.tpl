      - {name: Type, type: string, required: true, desc: 关系类型, constraint: 非空}
      - {name: OpenID, type: string, required: false, desc: 发起方瑞雪 OpenID, constraint: 与 UserID 至少一个非空}
      - {name: UserID, type: string, required: false, desc: 发起方 CP 用户 ID, constraint: 与 OpenID 至少一个非空}
      - {name: TargetOpenID, type: string, required: false, desc: 目标方瑞雪 OpenID, constraint: 与 TargetUserID 至少一个非空}
      - {name: TargetUserID, type: string, required: false, desc: 目标方 CP 用户 ID, constraint: 与 TargetOpenID 至少一个非空}
    response_fields:
      - {name: RelationUser, type: '*RelationUser', desc: '包含 OpenID、CPUserID、NickName、Birthday、Remarks、Avatar、Custom、Dist、Time、Score、CPID、Sex'}
    validation: [Type 为空返回 ErrInvalidType, 任一方两种用户 ID 均为空返回 ErrInvalidOpenID]
    errors: [无对应关系时以服务端返回为准, 网络/签名/业务失败需记录 trace ID]
    code_go: |
      package example
      import ("fmt"; "log"; "github.com/ruixueyun/ruixuego")
      func getRelationUserV2() {
          u, err := ruixuego.GetDefaultClient().GetRelationUserV2(&ruixuego.ReqGetRelationUser{Type: "@test", OpenID: "@test", UserID: "@test", TargetOpenID: "@test", TargetUserID: "@test"})
          if err != nil { log.Printf("get relation user: %v trace=%s", err, ruixuego.ErrTraceID(err)); return }; fmt.Printf("%+v\n", u)
      }

  - name: IsFriendV2
    signature: 'func (c *Client) IsFriendV2(req *ReqIsFriend) (bool, error)'
    when_to_use: 发消息、邀请或展示好友专属信息前判断好友关系
    request_fields:
      - {name: OpenID, type: string, required: false, desc: 发起方瑞雪 OpenID, constraint: 与 UserID 至少一个非空}
      - {name: UserID, type: string, required: false, desc: 发起方 CP 用户 ID, constraint: 与 OpenID 至少一个非空}
      - {name: TargetOpenID, type: string, required: false, desc: 目标方瑞雪 OpenID, constraint: 与 TargetUserID 至少一个非空}
      - {name: TargetUserID, type: string, required: false, desc: 目标方 CP 用户 ID, constraint: 与 TargetOpenID 至少一个非空}
    response_fields: [{name: is_friend, type: bool, desc: true 表示双方为好友}]
    validation: [任一方两种用户 ID 均为空返回 ErrInvalidOpenID]
    errors: [false 不等于调用失败，必须先检查 error, 网络/签名/业务失败需记录 trace ID]
    code_go: |
      package example
      import ("fmt"; "log"; "github.com/ruixueyun/ruixuego")
      func isFriendV2() {
          ok, err := ruixuego.GetDefaultClient().IsFriendV2(&ruixuego.ReqIsFriend{OpenID: "@test", UserID: "@test", TargetOpenID: "@test", TargetUserID: "@test"})
          if err != nil { log.Printf("is friend: %v trace=%s", err, ruixuego.ErrTraceID(err)); return }; fmt.Println(ok)
      }

notes:
  - RelationTypes 是 map[string]bool：true 明确表示双向，false 明确表示单向，不是「启用/禁用」开关
  - 身份字段通常任选 OpenID 或 UserID；同时提供时必须确保指向同一用户
  - Remarks 切片下标 0/1 分别代表两个方向的备注，越界项不会发送
  - ruixuego@v0.1.57 的 UpdateRelationRemarksV2 未把 req.Remarks 写入请求参数；生产接入前应升级或验证修复版本
  - RelationUser.Custom 可能含业务数据，返回给客户端前应做权限与敏感字段过滤
  - 新代码优先 V2；V1 仅用于兼容存量调用
