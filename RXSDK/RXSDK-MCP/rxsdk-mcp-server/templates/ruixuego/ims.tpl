      - {name: Ext, type: 'map[string]string', required: false, desc: CP 会话扩展, constraint: 明确覆盖/合并语义}
      - {name: IMSExt, type: 'map[string]string', required: false, desc: IMS 扩展, constraint: SDK 注释标明不可更改}
    response_fields: [{name: error, type: error, desc: nil 表示更新成功}]
    validation: [SDK 不做本地校验；不要尝试修改 IMSExt]
