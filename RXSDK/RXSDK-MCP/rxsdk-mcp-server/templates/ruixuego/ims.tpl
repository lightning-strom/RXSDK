api_details:
  - name: IMSLogin
    signature: 'func (c *Client) IMSLogin(req *IMSLoginReq) (*IMSLoginResp, error)'
    when_to_use: 为用户获取 IMS Entry 连接令牌、刷新令牌和 AES 密钥
    request_fields:
      - {name: UserID, type: string, required: true, desc: CP 下唯一用户 ID, constraint: 建议先通过 IMSVerifyUserID}
      - {name: ProductID, type: string, required: true, desc: 产品 ID, constraint: 使用真实产品配置}
      - {name: ChannelID, type: string, required: true, desc: 渠道 ID, constraint: 使用真实渠道配置}
      - {name: DeviceCode, type: string, required: true, desc: 设备唯一标识, constraint: 不得固定写死或跨用户复用}
      - {name: CPID, type: uint32, required: true, desc: CP 数字 ID, constraint: 必须替换示例值}
      - {name: ClientType, type: int32, required: true, desc: 客户端类型, constraint: 按 IMS 约定枚举传值}
    response_fields:
      - {name: AccessToken, type: string, desc: Entry 连接令牌}
      - {name: AccessTokenExpire, type: int64, desc: 连接令牌过期时间，毫秒}
      - {name: RefreshToken, type: string, desc: 刷新令牌}
      - {name: RefreshTokenExpire, type: int64, desc: 刷新令牌过期时间，毫秒}
      - {name: AESKey, type: string, desc: 64 位十六进制字符串，解析后为 32 Byte 密钥}
    validation: [v0.1.57 SDK 不做本地字段校验，调用方必须校验 UserID 和必填配置]
    errors: [令牌和 AESKey 不得写入日志, 网络/签名/业务失败需记录 trace ID]
    code_go: |
      package example
      import ("fmt"; "log"; "github.com/ruixueyun/ruixuego")
      func imsLogin() {
          req := &ruixuego.IMSLoginReq{UserID: "@test", ProductID: "@test", ChannelID: "@test", DeviceCode: "@test", CPID: 1000000, /* 【必须替换】 */ ClientType: 1}
          res, err := ruixuego.GetDefaultClient().IMSLogin(req); if err != nil { log.Printf("ims login: %v trace=%s", err, ruixuego.ErrTraceID(err)); return }; fmt.Println("access expires:", res.AccessTokenExpire)
      }

  - name: IMSSendMessage
    signature: 'func (c *Client) IMSSendMessage(req *IMSMessage) (*IMSMessageAck, error)'
    when_to_use: 服务端向单聊、群聊、自定义单聊或频道发送消息
    request_fields:
      - {name: MilliTS, type: int64, required: false, desc: 消息毫秒时间戳, constraint: 0 时 SDK 自动取当前时间}
      - {name: UUID, type: string, required: false, desc: 客户端消息唯一 ID, constraint: 空时 SDK 自动生成；重试幂等应自行持久化}
      - {name: Sender, type: string, required: true, desc: 发送者 UserID, constraint: 应通过 IMSVerifyUserID}
      - {name: Receivers, type: '[]string', required: false, desc: 接收者列表, constraint: 按会话类型使用}
      - {name: ConversationID, type: string, required: true, desc: 会话 ID, constraint: 必须能被 IMSParseConversationID 解析}
      - {name: ConvType, type: int32, required: false, desc: 会话类型, constraint: 0 时 SDK 从 ConversationID 推导}
      - {name: CPID, type: uint32, required: false, desc: 请求字段会被 Init 的 CPID 覆盖；以全局配置为准}
      - {name: ProductID, type: string, required: true, desc: 产品 ID, constraint: 非空}
      - {name: ChannelID, type: string, required: true, desc: 渠道 ID, constraint: 非空}
      - {name: Content, type: string, required: true, desc: 消息正文, constraint: 长度与编码按服务端规则}
      - {name: Attr/Option/Status/ClientType/Type/SubType/InboxID/UnreadCount/ReceiverNum, type: integer, required: false, desc: 消息控制字段, constraint: 按 IMS 协议枚举和位定义传值}
      - {name: Ext/IMSExt, type: 'map[string]string', required: false, desc: CP/IMS 扩展字段, constraint: IMSExt 不应由 CP 任意修改}
    response_fields:
      - {name: MsgID, type: string, desc: 服务端消息 ID}
      - {name: UUID, type: string, desc: 对应请求 UUID}
      - {name: InboxID, type: int64, desc: 收件箱 ID}
      - {name: MilliTS, type: int64, desc: 服务端消息时间戳}
    validation: [ConversationID 非法返回 ErrInvalidIMSConversationID, UUID/MilliTS 为空时由 SDK 填充, CPID 强制取全局配置]
    errors: [重试复用同一 UUID 防止重复消息, 网络/签名/业务失败需记录 trace ID]
    code_go: |
      package example
      import ("fmt"; "log"; "github.com/ruixueyun/ruixuego")
      func imsSendMessage() {
          convID := ruixuego.IMSGetSingleConversationID("@test", "@test")
          req := &ruixuego.IMSMessage{UUID: "@test", Sender: "@test", ConversationID: convID, ProductID: "@test", ChannelID: "@test", Content: "@test", Type: 1}
          // CPID 由 SDK 用 Init 配置覆盖，无需在请求中依赖填写
          ack, err := ruixuego.GetDefaultClient().IMSSendMessage(req); if err != nil { log.Printf("send: %v trace=%s", err, ruixuego.ErrTraceID(err)); return }; fmt.Println(ack.MsgID)
      }

  - name: IMSGetHistory
    signature: 'func (c *Client) IMSGetHistory(req *IMSHistoryReq) (*IMSHistoryResp, error)'
    when_to_use: 按起始消息 ID 分页读取指定会话历史
    request_fields:
      - {name: ConversationID, type: string, required: true, desc: 会话 ID, constraint: 应先用 IMSParseConversationID 校验}
      - {name: StartMsgID, type: string, required: false, desc: 分页起始消息 ID, constraint: 非空时应能被 IMSParseMsgID 解析}
      - {name: FetchCount, type: int32, required: true, desc: 本次获取条数, constraint: 使用正数并限制批量大小}
    response_fields:
      - {name: Messages, type: '[]*IMSMessage', desc: 历史消息数组}
      - {name: Count, type: int32, desc: 本页消息数}
      - {name: Done, type: bool, desc: 是否已拉取完毕}
    validation: [v0.1.57 SDK 不做本地参数校验，调用方校验 ConversationID、StartMsgID 和 FetchCount]
    errors: [分页应以服务端返回和 Done 驱动，避免死循环, 网络/签名/业务失败需记录 trace ID]
    code_go: |
      package example
      import ("fmt"; "log"; "github.com/ruixueyun/ruixuego")
      func imsGetHistory() {
          req := &ruixuego.IMSHistoryReq{ConversationID: "@test", StartMsgID: "@test", FetchCount: 50}
          res, err := ruixuego.GetDefaultClient().IMSGetHistory(req); if err != nil { log.Printf("history: %v trace=%s", err, ruixuego.ErrTraceID(err)); return }; fmt.Printf("count=%d done=%v\n", res.Count, res.Done)
      }

  - name: IMSCreateConversation
    signature: 'func (c *Client) IMSCreateConversation(req *IMSCreateConvReq) error'
    when_to_use: 创建群聊、频道或业务管理的会话及初始成员
    request_fields:
      - {name: ConversationID, type: string, required: true, desc: 会话 ID, constraint: 使用 helper 生成或按合法格式构造}
      - {name: ConvType, type: int32, required: true, desc: 会话类型, constraint: 1 单聊、2 群聊、3 自定义单聊、4 频道}
      - {name: Creator, type: string, required: true, desc: 会话创建者 UserID, constraint: 应通过 IMSVerifyUserID}
      - {name: Members, type: '[]*MemberInfo', required: false, desc: 初始成员, constraint: MemberInfo.UserID 必须合法}
      - {name: Option, type: int64, required: false, desc: 会话选项, constraint: 按 IMS 位定义}
      - {name: Ext/IMSExt, type: 'map[string]string', required: false, desc: CP/IMS 会话扩展, constraint: IMSExt 不可由 CP 任意更改}
    response_fields: [{name: error, type: error, desc: nil 表示创建成功}]
    validation: [SDK 不做本地校验；调用前校验 ConversationID、ConvType、Creator 和成员]
    errors: [重复创建与成员上限由服务端判定, 网络/签名/业务失败需记录 trace ID]
    code_go: |
      package example
      import ("log"; "github.com/ruixueyun/ruixuego")
      func imsCreateConversation() {
          id := ruixuego.IMSGetGroupConversationID("@test")
          members := []*ruixuego.MemberInfo{
          	{UserID: "@test"},
          	{UserID: "@test"},
          }
          req := &ruixuego.IMSCreateConvReq{
          	ConversationID: id,
          	ConvType:       ruixuego.IMSConvTypeGroup,
          	Creator:        "@test",
          	Members:        members,
          	Ext:            map[string]string{"title": "@test"},
          }
          if err := ruixuego.GetDefaultClient().IMSCreateConversation(req); err != nil { log.Printf("create conv: %v trace=%s", err, ruixuego.ErrTraceID(err)) }
      }

