      - {name: Option, type: int64, required: false, desc: 用户会话选项, constraint: 按 IMS 位定义}
      - {name: Ext, type: 'map[string]string', required: false, desc: 用户扩展信息, constraint: 明确覆盖/合并语义}
      - {name: ClientType, type: int32, required: false, desc: 客户端类型, constraint: 按 IMS 枚举}
    response_fields: [{name: error, type: error, desc: nil 表示更新成功}]
    validation: [SDK 不做本地参数校验]
    errors: [用户不在会话中或无权限由服务端返回, 网络/签名/业务失败需记录 trace ID]
    code_go: |
      package example
      import ("log"; "github.com/ruixueyun/ruixuego")
      func imsUpdateConversationUserData() {
          req := &ruixuego.IMSUpdateConvUserDataReq{ConversationID: "@test", UserID: "@test", Option: 1, Ext: map[string]string{"role": "@test"}, ClientType: 1}
          if err := ruixuego.GetDefaultClient().IMSUpdateConversationUserData(req); err != nil { log.Printf("update conv user: %v trace=%s", err, ruixuego.ErrTraceID(err)) }
      }

  - name: IMSConversationUserList
    signature: 'func (c *Client) IMSConversationUserList(req *IMSConversationUserListReq) ([]*IMSConversation, error)'
    when_to_use: 查询某用户已加入的会话及其用户视角数据
    request_fields:
      - {name: UserID, type: string, required: true, desc: 用户 ID, constraint: 应通过 IMSVerifyUserID}
    response_fields:
      - {name: conversations, type: '[]*IMSConversation', desc: 用户会话列表}
      - {name: IMSConversation, type: object, desc: 会话 ID、属性、时间、创建者、扩展、成员、类型与状态}
    validation: [SDK 不做本地参数校验]
    errors: [空列表不是错误, 网络/签名/业务失败需记录 trace ID]
    code_go: |
      package example
      import ("fmt"; "log"; "github.com/ruixueyun/ruixuego")
      func imsConversationUserList() {
          list, err := ruixuego.GetDefaultClient().IMSConversationUserList(&ruixuego.IMSConversationUserListReq{UserID: "@test"})
          if err != nil { log.Printf("user conv list: %v trace=%s", err, ruixuego.ErrTraceID(err)); return }; for _, c := range list { fmt.Println(c.ConversationID, c.Type, c.Status) }
      }

  - name: IMSChannelUsersCountV2
    signature: 'func (c *Client) IMSChannelUsersCountV2(count *ReqIMSChannelUsersCount) (map[string]int64, error)'
    when_to_use: 批量查询频道类型会话的当前玩家数量
    request_fields:
      - {name: ChannelConvIds, type: '[]string', required: true, desc: 频道 ConversationID 列表, constraint: 非空；每项应解析为 IMSConvTypeChannel}
      - {name: ReqHeader.Header, type: 'map[string]string', required: false, desc: 请求头覆盖, constraint: 通常留空}
    response_fields:
      - {name: counts, type: 'map[string]int64', desc: ConversationID 到玩家数量的映射}
    validation: [SDK 不做本地参数和会话类型校验；count 不可为 nil]
    errors: [返回映射可能不包含无数据 ID，读取时需检查 key, 网络/签名/业务失败需记录 trace ID]
    code_go: |
      package example
      import ("fmt"; "log"; "github.com/ruixueyun/ruixuego")
      func imsChannelUsersCountV2() {
          req := &ruixuego.ReqIMSChannelUsersCount{ChannelConvIds: []string{"$4$@test"}}
          res, err := ruixuego.GetDefaultClient().IMSChannelUsersCountV2(req); if err != nil { log.Printf("channel count: %v trace=%s", err, ruixuego.ErrTraceID(err)); return }; fmt.Printf("%+v\n", res)
      }

  - name: IMSVerifyUserID
    signature: 'func IMSVerifyUserID(userID string) bool'
    when_to_use: 生成会话 ID 或调用 IMS 网络 API 前做快速本地校验
    request_fields:
      - {name: userID, type: string, required: true, desc: 待校验 ID, constraint: '正则 ^[a-zA-Z0-9_-]{1,32}$'}
    response_fields: [{name: valid, type: bool, desc: true 表示格式合法}]
    validation: [空串、超过 32 字符或含其他字符返回 false]
    errors: [仅校验格式，不证明用户存在或有权限]
    code_go: |
      package example
      import ("fmt"; "github.com/ruixueyun/ruixuego")
      func imsVerifyUserID() { fmt.Println(ruixuego.IMSVerifyUserID("@test")) }

  - name: IMSParseMsgID
    signature: 'func IMSParseMsgID(msgID string) (msgSeqID int64, convType int32, conversationID string, ok bool)'
    when_to_use: 从服务端 MsgID 提取消息序号、会话类型和会话 ID
    request_fields:
      - {name: msgID, type: string, required: true, desc: IMS 消息 ID, constraint: '格式为非零十进制序号.ConversationID'}
    response_fields:
      - {name: msgSeqID, type: int64, desc: 非零消息序号}
      - {name: convType, type: int32, desc: 会话类型 1/2/3/4}
      - {name: conversationID, type: string, desc: 完整会话 ID}
      - {name: ok, type: bool, desc: 是否解析成功}
    validation: [空串、缺少点号、序号为 0 或会话 ID 非法时 ok=false]
    errors: [无 error 返回值，必须检查 ok 后再使用其余结果]
    code_go: |
      package example
      import ("fmt"; "github.com/ruixueyun/ruixuego")
      func imsParseMsgID() { seq, typ, id, ok := ruixuego.IMSParseMsgID("@test"); if !ok { return }; fmt.Println(seq, typ, id) }

  - name: IMSParseConversationID
    signature: 'func IMSParseConversationID(conversationID string) (convType int32, conversationIDData string, ok bool)'
    when_to_use: 校验 ConversationID 并拆出类型与数据部分
    request_fields:
      - {name: conversationID, type: string, required: true, desc: 会话 ID, constraint: '$<type>$<data>；type 仅 1/2/3/4'}
    response_fields:
      - {name: convType, type: int32, desc: 1 单聊、2 群聊、3 自定义单聊、4 频道}
      - {name: conversationIDData, type: string, desc: 会话数据部分}
      - {name: ok, type: bool, desc: 是否格式合法}
    validation: [单聊 data 必须是两个合法 UserID 以冒号连接, 其他类型 data 必须匹配 1 到 32 位字母数字下划线横线]
    errors: [无 error 返回值，必须检查 ok]
    code_go: |
      package example
      import ("fmt"; "github.com/ruixueyun/ruixuego")
      func imsParseConversationID() { typ, data, ok := ruixuego.IMSParseConversationID("@test"); if !ok { return }; fmt.Println(typ, data) }

  - name: IMSGetSingleConversationID
    signature: 'func IMSGetSingleConversationID(sender, receiver string) string'
    when_to_use: 为两个用户生成与传入顺序无关的稳定单聊 ConversationID
    request_fields:
      - {name: sender, type: string, required: true, desc: 一方 UserID, constraint: 必须通过 IMSVerifyUserID}
      - {name: receiver, type: string, required: true, desc: 另一方 UserID, constraint: 必须通过 IMSVerifyUserID}
    response_fields: [{name: conversationID, type: string, desc: '$1$较小UserID:较大UserID；非法时为空串'}]
    validation: [任一 ID 非法返回空串, SDK 按字符串字典序固定双方顺序]
    errors: [生成后仍应检查结果非空]
    code_go: |
      package example
      import ("fmt"; "github.com/ruixueyun/ruixuego")
      func imsGetSingleConversationID() { id := ruixuego.IMSGetSingleConversationID("@test", "@test"); if id == "" { return }; fmt.Println(id) }

  - name: IMSGetGroupConversationID
    signature: 'func IMSGetGroupConversationID(groupID string) string'
    when_to_use: 从业务群 ID 生成群聊 ConversationID
    request_fields:
      - {name: groupID, type: string, required: true, desc: 群唯一 ID, constraint: 必须匹配 1 到 32 位合法字符}
    response_fields: [{name: conversationID, type: string, desc: '$2$groupID；非法时为空串'}]
    validation: [groupID 未通过 IMSVerifyUserID 时返回空串]
    errors: [仅生成格式，不创建远端会话]
    code_go: |
      package example
      import ("fmt"; "github.com/ruixueyun/ruixuego")
      func imsGetGroupConversationID() { id := ruixuego.IMSGetGroupConversationID("@test"); if id == "" { return }; fmt.Println(id) }

  - name: IMSGetCustomSingleConversationID
    signature: 'func IMSGetCustomSingleConversationID(customID string) string'
    when_to_use: 业务已有稳定自定义标识并需要自定义单聊类型时生成 ID
    request_fields:
      - {name: customID, type: string, required: true, desc: 自定义单聊 ID 数据, constraint: 必须匹配 1 到 32 位合法字符}
    response_fields: [{name: conversationID, type: string, desc: '$3$customID；非法时为空串'}]
    validation: [customID 未通过 IMSVerifyUserID 时返回空串]
    errors: [customID 唯一性由业务保证；仅生成格式，不创建远端会话]
    code_go: |
      package example
      import ("fmt"; "github.com/ruixueyun/ruixuego")
      func imsGetCustomSingleConversationID() { id := ruixuego.IMSGetCustomSingleConversationID("@test"); if id == "" { return }; fmt.Println(id) }

  - name: IMSParseSingleConversationIDData
    signature: 'func IMSParseSingleConversationIDData(data string) (minUserID, maxUserID string, ok bool)'
    when_to_use: 已取得单聊 ConversationIDData 后解析双方 UserID
    request_fields:
      - {name: data, type: string, required: true, desc: 单聊会话数据部分, constraint: 两个合法 UserID 以冒号连接}
    response_fields:
      - {name: minUserID, type: string, desc: 字典序较小的 UserID}
      - {name: maxUserID, type: string, desc: 字典序较大的 UserID}
      - {name: ok, type: bool, desc: 是否解析成功}
    validation: [缺少冒号或任一 UserID 非法时 ok=false, 返回值总按字典序重排]
    errors: [传完整 ConversationID 会失败，应先用 IMSParseConversationID 获取 data]
    code_go: |
      package example
      import ("fmt"; "github.com/ruixueyun/ruixuego")
      func imsParseSingleConversationIDData() { minID, maxID, ok := ruixuego.IMSParseSingleConversationIDData("@test:@test"); if !ok { return }; fmt.Println(minID, maxID) }

notes:
  - CPID 示例统一使用 1000000 并标注【必须替换】；生产值应来自真实配置
  - IMSSendMessage 会把 req.CPID 覆盖为 ruixuego.Init 配置中的 CPID，必须确保全局配置正确
  - UserID、groupID、customID 仅允许 1 到 32 位字母、数字、下划线和横线
  - 会话类型常量：IMSConvTypeSingle=1、IMSConvTypeGroup=2、IMSConvTypeCustomSingle=3、IMSConvTypeChannel=4
  - 频道会话不支持离线消息、已读、撤回等能力
  - AccessToken、RefreshToken、AESKey、消息正文及扩展字段均按敏感数据处理
  - IMSChannelUsersCount 仅兼容旧代码；新代码使用 IMSChannelUsersCountV2
