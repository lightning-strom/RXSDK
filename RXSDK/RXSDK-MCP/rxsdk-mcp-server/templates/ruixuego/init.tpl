# 瑞雪 Go 服务端 SDK 初始化
# Generated by MCP
# SDK: github.com/ruixueyun/ruixuego@v0.1.57
# module: github.com/ruixueyun/ruixuego

placeholder_note:
  description: "@test 是占位符，接入时必须替换为真实业务参数。"
  string_fields:
    - APIDomain
    - CPKey
    - ProductID
    - ChannelID
    - AppKey
    - ServiceMark
    - Region
    - Language
  numeric_fields_note: "CPID 为 uint32，模板中的示例数字必须替换为瑞雪团队下发的真实 CPID。"

overview:
  description: |
    在 CP 游戏服 / 后端进程启动时调用 ruixuego.Init，退出前调用 ruixuego.Close。
    初始化成功后通过 ruixuego.GetDefaultClient() 调用业务 API。
    也可 NewClient 自建客户端（高级用法）。
  keywords:
    - Init
    - Close
    - GetDefaultClient
    - NewClient
    - Config
    - BigData

prerequisites:
  - go.mod 已依赖 github.com/ruixueyun/ruixuego
  - 已拿到 APIDomain / CPID / CPKey；使用 OpenID 加解密时还需 AppKeys

recommended_flow:
  - feature=dependency 写入依赖
  - feature=init 生成 Init/Close
  - 替换全部 @test 与示例 CPID
  - GetDefaultClient 后调用业务 V2 API
  - 使用埋点时 defer Close

config_class:
  name: Config
  properties:
    - name: APIDomain
      type: string
      required: true
      description: 瑞雪云 API 域名，以 http[s]:// 开头
    - name: CPID
      type: uint32
      required: true
      description: CP 唯一 ID（数字，必须替换）
    - name: CPKey
      type: string
      required: true
      description: CP 密钥
    - name: AppKeys
      type: "map[string]map[string]string"
      required: false
      description: "map[productID]map[channelID]appKey；OpenID 加解密需要。Init 允许为空，但业务用 OpenID 时必须配置合法长度密钥"
    - name: ProductID
      type: string
      required: false
      description: 默认产品 ID
    - name: ChannelID
      type: string
      required: false
      description: 默认渠道 ID
    - name: Region
      type: string
      required: false
      description: 分区 / 分服
    - name: ServiceMark
      type: string
      required: false
      description: 游戏服分区标识，常用 default
    - name: Language
      type: string
      required: false
      description: 语言
    - name: BigData
      type: "*BigDataConfig"
      required: false
      description: 埋点时必须配置；退出前必须 Close
    - name: Timeout
      type: time.Duration
      required: false
      description: "按毫秒数字传入（如 5000），Init 内部 *= Millisecond；勿传 5*time.Second"
    - name: TrackTimeout
      type: time.Duration
      required: false
      description: "埋点超时，同样按毫秒数字"
    - name: Concurrency
      type: int
      required: false
      description: 并发请求限制

apis:
  - name: Init
    signature: "func Init(conf *Config) error"
    when_to_use: 进程启动初始化默认 Client
  - name: GetDefaultClient
    signature: "func GetDefaultClient() *Client"
    when_to_use: 获取默认 Client
  - name: Close
    signature: "func Close() error"
    when_to_use: 进程退出前关闭（埋点必须）
  - name: NewClient
    signature: "func NewClient() (*Client, error)"
    when_to_use: 高级：自建 Client（一般用 Init + GetDefaultClient）
  - name: GetProductID
    signature: "func (c *Client) GetProductID() string"
    when_to_use: 读取 Client 默认 ProductID
  - name: GetChannelID
    signature: "func (c *Client) GetChannelID() string"
    when_to_use: 读取默认 ChannelID
  - name: GetRegion
    signature: "func (c *Client) GetRegion() string"
    when_to_use: 读取 Region
  - name: GetLanguage
    signature: "func (c *Client) GetLanguage() string"
    when_to_use: 读取 Language
  - name: Client.Close
    signature: "func (c *Client) Close() error"
    when_to_use: 关闭某个 Client（与包级 Close 对应默认客户端）
  - name: RegisterLogger
    signature: "func RegisterLogger(l Logger)"
    when_to_use: 可选：注册自定义日志实现
  - name: GetLogger
    signature: "func GetLogger() Logger"
    when_to_use: 获取当前 Logger
  - name: ErrTraceID
    signature: "func ErrTraceID(err error) string"
    when_to_use: 从错误提取 traceId 便于排查

api_details:
  - name: Init
    signature: "func Init(conf *Config) error"
    when_to_use: 服务启动时初始化 SDK
    request_fields:
      - name: conf
        type: "*Config"
        required: true
        desc: 见上方 config_class；@test 必须替换
    response_fields:
      - name: "(error)"
        type: error
        desc: 配置非法或初始化失败
    validation:
      - Timeout/TrackTimeout 填毫秒数字
      - AppKeys 非 Init 硬性必填；若密钥非法，错误信息可能含 AppKey，勿把完整 err 打进公开日志
    errors:
      - 初始化失败：记录错误类型/trace，避免原样打印含密钥的 err
    code_go: |
      package main

      import (
      	"fmt"
      	"log"

      	"github.com/ruixueyun/ruixuego"
      )

      func main() {
      	err := ruixuego.Init(&ruixuego.Config{
      		APIDomain: "@test", // 例如 https://cn-api.ruixueyun.com
      		CPID:      1000000, // 【必须替换】
      		CPKey:     "@test",
      		AppKeys: map[string]map[string]string{
      			"@test": {"@test": "@test"}, // AppKey 须为 16/24/32 字节
      		},
      		ServiceMark: "default",
      		Region:      "@test",
      		// Timeout: 5000,
      		BigData: &ruixuego.BigDataConfig{AutoFlush: true},
      	})
      	if err != nil {
      		// 无效 AppKey 时 SDK 错误可能含密钥明文，勿把完整 err 写入公开日志
      		log.Fatal("ruixuego init failed")
      	}
      	defer func() {
      		if cerr := ruixuego.Close(); cerr != nil {
      			fmt.Println("close:", cerr)
      		}
      	}()
      	c := ruixuego.GetDefaultClient()
      	fmt.Println(c.GetProductID(), c.GetChannelID(), c.GetRegion(), c.GetLanguage())
      }

  - name: GetDefaultClient
    signature: "func GetDefaultClient() *Client"
    when_to_use: Init 之后获取默认客户端
    request_fields: []
    response_fields:
      - name: "*Client"
        type: "*Client"
        desc: 默认客户端；未 Init 时行为以 SDK 为准
    validation:
      - 必须先 Init
    errors: []
    code_go: |
      package example

      import "github.com/ruixueyun/ruixuego"

      func client() *ruixuego.Client {
      	return ruixuego.GetDefaultClient()
      }

  - name: Close
    signature: "func Close() error"
    when_to_use: 使用 BigData 后进程退出前必须调用
    request_fields: []
    response_fields:
      - name: "(error)"
        type: error
        desc: flush/关闭失败
    validation:
      - 埋点场景缺少 Close 可能丢数
    errors:
      - 记录 Close 错误日志
    code_go: |
      package example

      import (
      	"fmt"

      	"github.com/ruixueyun/ruixuego"
      )

      func shutdown() {
      	if err := ruixuego.Close(); err != nil {
      		fmt.Println("close:", err)
      	}
      }

  - name: NewClient
    signature: "func NewClient() (*Client, error)"
    when_to_use: 需要独立 Client 实例时（多数项目用 Init 即可）
    request_fields: []
    response_fields:
      - name: "*Client"
        type: "*Client"
        desc: 新客户端
    validation:
      - 高级用法；需自行管理生命周期
    errors:
      - 创建失败返回 error
    code_go: |
      package example

      import (
      	"log"

      	"github.com/ruixueyun/ruixuego"
      )

      func newClientDemo() {
      	c, err := ruixuego.NewClient()
      	if err != nil {
      		log.Fatal(err)
      	}
      	_ = c
      }

notes:
  - 凭证勿提交公开仓库
  - Timeout / TrackTimeout 填毫秒数字
  - 业务 API 优先 *V2
  - 错误排查用 ruixuego.ErrTraceID(err)
  - "@test 必须全部替换后再编译运行"
