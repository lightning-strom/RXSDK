    signature: 'func (c *Client) QueryUserRankV2(req *ReqQueryUserRank) (*RankMember, error)'
    when_to_use: 展示用户当前名次、分数和榜单用户资料
    request_fields:
      - {name: RankID, type: string, required: true, desc: 排行榜 ID, constraint: 非空}
      - {name: OpenId, type: string, required: false, desc: 瑞雪 OpenID, constraint: 与 CpUserID 至少一个非空}
      - {name: CpUserID, type: string, required: false, desc: CP 用户 ID, constraint: 与 OpenId 至少一个非空}
    response_fields:
      - {name: Score, type: int64, desc: 用户当前分数}
      - {name: Rank, type: int64, desc: 用户当前名次}
      - {name: UserInfo, type: '*RelationUser', desc: 用户社交资料，含 OpenID、CPUserID、昵称、头像等}
    validation: [RankID 为空或两种用户 ID 同时为空返回 ErrInvalidOpenID]
    errors: [未上榜与查询失败应按服务端错误语义区分, 网络/签名/业务失败需记录 trace ID]
    code_go: |
      package example
      import ("fmt"; "log"; "github.com/ruixueyun/ruixuego")
      func queryUserRankV2() {
          m, err := ruixuego.GetDefaultClient().QueryUserRankV2(&ruixuego.ReqQueryUserRank{RankID: "@test", OpenId: "@test", CpUserID: "@test"})
          if err != nil { log.Printf("query user rank: %v trace=%s", err, ruixuego.ErrTraceID(err)); return }; fmt.Printf("rank=%d score=%d user=%+v\n", m.Rank, m.Score, m.UserInfo)
      }

  - name: GetRankListV2
    signature: 'func (c *Client) GetRankListV2(req *ReqGetRankList) ([]*RankMember, error)'
    when_to_use: 分页展示全服排行榜区间
    request_fields:
