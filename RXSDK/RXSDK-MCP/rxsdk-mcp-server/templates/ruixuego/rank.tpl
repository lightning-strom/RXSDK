api_details:
  - name: CreateRankV2
    signature: 'func (c *Client) CreateRankV2(req *ReqCreateRank) error'
    when_to_use: 创建赛季榜、活动榜或常驻榜
    request_fields:
      - {name: RankID, type: string, required: true, desc: 排行榜唯一 ID, constraint: 非空；建议包含环境与赛季}
      - {name: StartTime, type: time.Time, required: true, desc: 开榜时间, constraint: SDK 按 RFC3339 发送}
      - {name: DestroyTime, type: time.Time, required: true, desc: 销毁时间, constraint: SDK 按 RFC3339 发送且业务上应晚于 StartTime}
      - {name: ReqHeader.Header, type: 'map[string]string', required: false, desc: 请求头覆盖, constraint: 通常留空}
    response_fields: [{name: error, type: error, desc: nil 表示创建成功}]
    validation: [RankID 为空时 SDK 返回 ErrInvalidOpenID, SDK 不校验两个时间的先后关系]
    errors: [重复 RankID 和非法时间由服务端判定, 网络/签名/业务失败需记录 trace ID]
    code_go: |
      package example
      import ("log"; "time"; "github.com/ruixueyun/ruixuego")
      func createRankV2() {
          req := &ruixuego.ReqCreateRank{RankID: "@test", StartTime: time.Now(), DestroyTime: time.Now().Add(30 * 24 * time.Hour)}
          if err := ruixuego.GetDefaultClient().CreateRankV2(req); err != nil { log.Printf("create rank: %v trace=%s", err, ruixuego.ErrTraceID(err)) }
      }

