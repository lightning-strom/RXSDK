  - name: RankAddScoreV2
    signature: 'func (c *Client) RankAddScoreV2(req *ReqRankAddScore) error'
    when_to_use: 每次事件产生确定增量时累加分数
    request_fields:
      - {name: RankID, type: string, required: true, desc: 排行榜 ID, constraint: 非空}
      - {name: OpenId, type: string, required: false, desc: 瑞雪 OpenID（字段名大小写为 OpenId）, constraint: 与 CpUserID 至少一个非空}
      - {name: CpUserID, type: string, required: false, desc: CP 用户 ID, constraint: 与 OpenId 至少一个非空}
      - {name: Score, type: int64, required: true, desc: 本次增量, constraint: 正负值业务含义与服务端规则一致}
    response_fields: [{name: error, type: error, desc: nil 表示累加成功}]
    validation: [RankID 为空或两种用户 ID 同时为空返回 ErrInvalidOpenID, SDK 不限制 Score 范围]
    errors: [重试可能重复加分，必须使用业务幂等键或写分流水去重, 网络/签名/业务失败需记录 trace ID]
    code_go: |
      package example
      import ("log"; "github.com/ruixueyun/ruixuego")
      func rankAddScoreV2() {
          req := &ruixuego.ReqRankAddScore{RankID: "@test", OpenId: "@test", CpUserID: "@test", Score: 10}
          if err := ruixuego.GetDefaultClient().RankAddScoreV2(req); err != nil { log.Printf("add score: %v trace=%s", err, ruixuego.ErrTraceID(err)) }
      }

