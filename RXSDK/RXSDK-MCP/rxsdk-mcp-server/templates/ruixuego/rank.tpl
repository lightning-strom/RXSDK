      - {name: Start, type: int32, required: true, desc: 起始名次, constraint: SDK 不校验；基数和边界以服务端约定为准}
      - {name: End, type: int32, required: true, desc: 结束名次, constraint: 应不小于 Start 且控制单次区间大小}
    response_fields:
      - {name: members, type: '[]*RankMember', desc: 按服务端顺序返回的榜单成员}
      - {name: RankMember, type: object, desc: Score、Rank、UserInfo *RelationUser}
    validation: [仅校验 RankID 非空；Start/End 不做本地校验]
    errors: [超大区间可能造成延迟和内存压力, 网络/签名/业务失败需记录 trace ID]
    code_go: |
      package example
      import ("fmt"; "log"; "github.com/ruixueyun/ruixuego")
      func getRankListV2() {
          list, err := ruixuego.GetDefaultClient().GetRankListV2(&ruixuego.ReqGetRankList{RankID: "@test", Start: 1, End: 100})
          if err != nil { log.Printf("get rank list: %v trace=%s", err, ruixuego.ErrTraceID(err)); return }; for _, m := range list { fmt.Printf("%d %d %+v\n", m.Rank, m.Score, m.UserInfo) }
      }

