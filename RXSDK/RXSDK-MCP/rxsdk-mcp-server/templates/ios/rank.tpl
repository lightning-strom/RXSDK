# 瑞雪 SDK iOS 排行榜功能
# Generated by MCP
# 包含：增加分数、设置分数、查询排名、获取排行榜、好友排行榜

# ==================== 增加用户分数 ====================
addScore:
  method_name: "[[RXSDK sharedSDK] addscoreWithRank_id:score:complete:]"
  description: 增加用户分数（累加）
  parameters:
    - name: rank_id
      type: NSString *
      required: true
      description: 榜单 ID（格式：Flag_榜单容量_重置周期_自定义标识）
    - name: score
      type: NSInteger
      required: true
      description: 增加的分数值
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 回调
  code_objc: |
    // ========== 瑞雪 SDK 增加分数 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *rankId = @"daily_rank";  // 必填，榜单 ID，类型 NSString *
    NSInteger score = 100;             // 必填，增加的分数，类型 NSInteger
    
    [[RXSDK sharedSDK] addscoreWithRank_id:rankId
                                     score:score
                                  complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"分数增加失败: %@", error.responesObject);
        } else {
            NSDictionary *data = response[@"data"];  // 类型 NSDictionary *
            NSNumber *newScore = data[@"score"];     // 类型 NSNumber *
            NSLog(@"分数增加成功，当前分数: %@", newScore);
        }
    }];

# ==================== 设置用户分数 ====================
setScore:
  method_name: "[[RXSDK sharedSDK] setScoreWithRank_id:score:complete:]"
  description: 设置用户分数（覆盖原有分数）
  parameters:
    - name: rank_id
      type: NSString *
      required: true
      description: 榜单 ID
    - name: score
      type: NSInteger
      required: true
      description: 分数值
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 回调
  code_objc: |
    // ========== 瑞雪 SDK 设置分数 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *rankId = @"high_score";  // 必填，榜单 ID，类型 NSString *
    NSInteger score = 9999;            // 必填，分数，类型 NSInteger
    
    [[RXSDK sharedSDK] setScoreWithRank_id:rankId
                                     score:score
                                  complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"分数设置失败: %@", error.responesObject);
        } else {
            NSLog(@"分数设置成功: %@", response);
        }
    }];

# ==================== 查询用户排名 ====================
queryUserRank:
  method_name: "[[RXSDK sharedSDK] queryUserRankWithRank_id:target:complete:]"
  description: 查询用户排名
  parameters:
    - name: rank_id
      type: NSString *
      required: true
      description: 榜单 ID
    - name: target
      type: NSString *
      required: true
      description: 目标用户 OpenID
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 回调
  code_objc: |
    // ========== 瑞雪 SDK 查询用户排名 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *rankId = @"daily_rank";      // 必填，榜单 ID，类型 NSString *
    NSString *openId = @"user_openid";     // 必填，用户 OpenID（查自己可用当前用户 OpenID），类型 NSString *
    
    [[RXSDK sharedSDK] queryUserRankWithRank_id:rankId
                                         target:openId
                                       complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"查询失败: %@", error.responesObject);
        } else {
            NSDictionary *data = response[@"data"];  // 类型 NSDictionary *
            NSNumber *rank = data[@"rank"];          // 类型 NSNumber *
            NSNumber *score = data[@"score"];        // 类型 NSNumber *
            
            if (rank.integerValue > 0) {
                NSLog(@"排名: 第%@名, 分数: %@", rank, score);
            } else {
                NSLog(@"暂无排名，分数: %@", score);
            }
        }
    }];

# ==================== 获取排行榜列表 ====================
getRankList:
  method_name: "[[RXSDK sharedSDK] getRankListWithRank_id:start_rank:end_rank:complete:]"
  description: 获取排行榜列表
  parameters:
    - name: rank_id
      type: NSString *
      required: true
      description: 榜单 ID
    - name: start_rank
      type: NSInteger
      required: true
      description: 开始排名（从 1 开始）
    - name: end_rank
      type: NSInteger
      required: true
      description: 结束排名
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 回调
  code_objc: |
    // ========== 瑞雪 SDK 获取排行榜 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *rankId = @"daily_rank";  // 必填，榜单 ID，类型 NSString *
    NSInteger startRank = 1;           // 必填，开始排名，类型 NSInteger
    NSInteger endRank = 100;           // 必填，结束排名，类型 NSInteger
    
    [[RXSDK sharedSDK] getRankListWithRank_id:rankId
                                   start_rank:startRank
                                     end_rank:endRank
                                     complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"获取排行榜失败: %@", error.responesObject);
        } else {
            NSArray *list = response[@"data"];  // 类型 NSArray *
            NSLog(@"排行榜数据: %@", list);
            
            // 解析排行榜
            for (NSDictionary *item in list) {
                NSNumber *rank = item[@"rank"];          // 类型 NSNumber *
                NSString *nickname = item[@"nickname"];  // 类型 NSString *
                NSString *avatar = item[@"avatar"];      // 类型 NSString *
                NSNumber *score = item[@"score"];        // 类型 NSNumber *
                
                NSLog(@"第%@名: %@ - %@分", rank, nickname, score);
            }
            // TODO: 更新排行榜 UI
        }
    }];

