# ==================== 法务信息获取 ====================
get_legal_info:
  method_name: "[[RXSDK sharedSDK] getLegalInfo:]"
  description: 获取法务配置信息（用户协议、隐私政策等）
  parameters:
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 获取法务信息 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    [[RXSDK sharedSDK] getLegalInfo:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"获取法务信息失败: %@", error.responesObject);
        } else {
            // 解析法务条款
            NSDictionary *data = response[@"data"];
            NSString *userAgreement = data[@"user_agreement"];  // 用户协议
            NSString *privacyPolicy = data[@"privacy_policy"];  // 隐私政策
            NSString *thirdPartySDK = data[@"third_party_sdk"];  // 第三方 SDK
            
            NSLog(@"法务信息: %@", data);
        }
    }];

