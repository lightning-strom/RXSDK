  code_objc: |
    // ========== 瑞雪 SDK 自定义请求 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    // ========== 自定义 POST 请求 ==========
    NSString *url = @"/api/custom/endpoint";  // 必填
    NSInteger method = 1;  // 必填，1=POST 2=GET
    BOOL needLogin = YES;  // 必填
    
    NSMutableDictionary *header = [NSMutableDictionary dictionary];
    header[@"Custom-Header"] = @"value";
    
    NSMutableDictionary *body = [NSMutableDictionary dictionary];
    body[@"param1"] = @"value1";
    body[@"param2"] = @"value2";
    
    [[RXSDK sharedSDK] createRequestWithUrl:url
                                     header:header
                                       body:body
                                     method:method
                                  needLogin:needLogin
                                   complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"请求失败: %@", error.responesObject);
        } else {
            NSLog(@"请求成功: %@", response);
        }
    }];
