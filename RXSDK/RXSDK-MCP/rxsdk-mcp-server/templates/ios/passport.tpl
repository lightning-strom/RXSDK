# ==================== 查询用户拥有的账号 ====================
search_has_accounts:
  method_name: "[[RXSDK sharedSDK] searchHasAccountsWithMethod:devicecode:states:complete:]"
  description: 查询用户拥有的账号
  parameters:
    - name: method
      type: NSString *
      required: true
      description: 登录方式，对应登录/绑定三方账号接口参数中的 method 字段
    - name: devicecode
      type: NSString *
      required: false
      description: 设备码，不传默认取当前设备码
    - name: states
      type: NSInteger
      required: true
      description: 账号状态位标记
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 查询用户拥有的账号 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>

    NSString *method = @"phone";     // 必填，登录方式
    NSString *devicecode = nil;      // 可选，传 nil 默认取当前设备码
    NSInteger states = 1;            // 必填，账号状态位标记

    [[RXSDK sharedSDK] searchHasAccountsWithMethod:method
                                        devicecode:devicecode
                                            states:states
                                          complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"查询账号失败: %@", error.responesObject);
        } else {
            NSLog(@"查询账号成功: %@", response);
        }
    }];

