# 瑞雪 SDK iOS 游戏角色功能
# Generated by MCP
# 包含：上报瑞雪游戏信息、创建角色、查询角色、更新角色、删除角色

preflight_check:
  requirements:
    - "Podfile 已接入 RXSDK_Pure"
    - "已完成 RXSdkInitConfig / initWithConfig:complete: 初始化"

# ==================== 上报瑞雪游戏信息 ====================
setGameInfo:
  method_name: "[[RXSDK sharedSDK] setGameInfoWithRoleId:regionTag:]"
  unity_api: "RuiXueSdk.SetGameInfo(roleId, regionTag)"
  description: 上报到瑞雪的当前游戏角色 ID 和区服标识，供瑞雪请求头、日志及业务接口使用
  parameters:
    - name: roleId
      type: NSString *
      required: true
      description: 游戏角色 ID
    - name: regionTag
      type: NSString *
      required: true
      description: 区服/服务器标识
  code_objc: |
    // ========== 上报到瑞雪的游戏信息 ==========
    NSString *roleId = @"role_001";
    NSString *regionTag = @"server_001";
    [[RXSDK sharedSDK] setGameInfoWithRoleId:roleId regionTag:regionTag];

setThirdGameInfo:
  supported: false
  description: Unity SetThirdGameInfo(GameInfo) 在 iOS 提取 roleId/serverId，并复用 SetGameInfo

# ==================== 创建游戏角色 ====================
create_game_character:
  method_name: "[[RXSDK sharedSDK] createGameCharacterWithAreaId:characterFaction:characterId:characterLevel:characterName:characterProfession:characterStatus:characterType:characterVipLevel:cpUserId:extension:complete:]"
  description: 创建游戏角色
  parameters:
    - name: areaId
      type: NSString *
      required: true
      description: 区服 ID
    - name: characterFaction
      type: NSString *
      required: false
      description: 角色阵营
    - name: characterId
      type: NSString *
      required: true
      description: 角色 ID
    - name: characterLevel
      type: NSString *
      required: false
      description: 角色等级
    - name: characterName
      type: NSString *
      required: true
      description: 角色名称
    - name: characterProfession
      type: NSString *
      required: false
      description: 角色职业
    - name: characterStatus
      type: NSString *
      required: false
      description: 角色状态
    - name: characterType
      type: NSString *
      required: false
      description: 角色类型
    - name: characterVipLevel
      type: NSString *
      required: false
      description: 角色 VIP 等级
    - name: cpUserId
      type: NSString *
      required: true
      description: 游戏用户 ID
    - name: extension
      type: NSDictionary *
      required: false
      description: 扩展字段
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 创建游戏角色 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *areaId = @"server_001";             // 必填，区服 ID，类型 NSString *
    NSString *characterId = @"char_001";          // 必填，角色 ID，类型 NSString *
    NSString *characterName = @"新角色";          // 必填，角色名称，类型 NSString *
    NSString *cpUserId = @"cp_user_001";          // 必填，游戏用户 ID，类型 NSString *
    NSString *characterFaction = @"联盟";         // 可选，角色阵营，类型 NSString *
    NSString *characterLevel = @"1";              // 可选，角色等级，类型 NSString *
    NSString *characterProfession = @"战士";      // 可选，角色职业，类型 NSString *
    NSString *characterStatus = @"1";             // 可选，角色状态，类型 NSString *
    NSString *characterType = @"1";               // 可选，角色类型，类型 NSString *
    NSString *characterVipLevel = @"0";           // 可选，角色 VIP 等级，类型 NSString *
    
    [[RXSDK sharedSDK] createGameCharacterWithAreaId:areaId
                                    characterFaction:characterFaction
                                         characterId:characterId
                                      characterLevel:characterLevel
                                       characterName:characterName
                                 characterProfession:characterProfession
                                     characterStatus:characterStatus
                                       characterType:characterType
                                   characterVipLevel:characterVipLevel
                                            cpUserId:cpUserId
                                           extension:nil  // 可选，扩展字段，类型 NSDictionary *
                                            complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"创建角色失败: %@", error.responesObject);
        } else {
            NSLog(@"创建角色成功: %@", response);
        }
    }];

# ==================== 查询角色列表 ====================
search_game_character_list:
  method_name: "[[RXSDK sharedSDK] searchGameCharacterListInfoWithCpUserId:complete:]"
  description: 查询账号下所有角色列表
  parameters:
    - name: cpUserId
      type: NSString *
      required: true
      description: 游戏用户 ID
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 查询角色列表 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *cpUserId = @"cp_user_001";  // 必填，游戏用户 ID，类型 NSString *
    
    [[RXSDK sharedSDK] searchGameCharacterListInfoWithCpUserId:cpUserId
                                                      complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"查询角色列表失败: %@", error.responesObject);
        } else {
            NSArray *list = response[@"data"][@"list"];  // 类型 NSArray *
            for (NSDictionary *character in list) {
                NSString *charId = character[@"character_id"];      // 角色 ID，类型 NSString *
                NSString *charName = character[@"character_name"];  // 角色名称，类型 NSString *
                NSString *charLevel = character[@"character_level"]; // 角色等级，类型 NSString *
                NSLog(@"角色: id=%@, name=%@, level=%@", charId, charName, charLevel);
            }
        }
    }];

