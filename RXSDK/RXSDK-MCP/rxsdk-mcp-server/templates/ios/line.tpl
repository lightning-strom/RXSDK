# 瑞雪 SDK iOS Line 组件接入规范
# Generated by MCP

# ==================== 概述 ====================
overview:
  description: Line 登录和分享组件
  keywords:
    - line
    - line 登录
    - line 分享
  note: |
    1. Line 组件是可选组件，需要根据业务需求选择接入
    2. 需要在 Info.plist 中配置 LineSDKConfig（Dictionary 类型，含 ChannelID）
    3. 需要在 LSApplicationQueriesSchemes 中添加 lineauth2
    4. 需要在 URL Types 中添加 line3rdp.$(PRODUCT_BUNDLE_IDENTIFIER)
    5. 组件注册必须在瑞雪 SDK 初始化之前执行

# ==================== 组件信息 ====================
component:
  name: Line
  pod_name: RXLineSDK
  service_class: RXLineService
  singleton: sharedSDK
  import: "#import <RXLineSDK/RXLineService.h>"
  description: Line 登录和分享组件

# ==================== 工程配置 ====================
project_config:
  info_plist:
    - key: LineSDKConfig
      type: Dictionary
      required: true
      description: Line SDK 配置字典
      children:
        - key: ChannelID
          type: String
          required: true
          description: Line Channel ID，从 Line 开发者后台获取
  ls_application_queries_schemes:
    - lineauth2
  url_types:
    - scheme: "line3rdp.$(PRODUCT_BUNDLE_IDENTIFIER)"
      description: Line URL Scheme，固定格式

# ==================== Pod 依赖 ====================
pod_install: |
  # ========== Line 组件接入 ==========
  # 在 Podfile 中添加以下依赖：
  
  pod 'RXLineSDK'
  
  # 然后执行：
  # cd 项目目录
  # pod install

# ==================== 初始化方法 ====================
init_method:
  method_name: "[[RXLineService sharedSDK] regist]"
  description: 注册 Line 组件
  parameters: []
  note: 必须在瑞雪 SDK 初始化之前调用

# ==================== 方法签名 ====================

regist:
  method_name: "[[RXLineService sharedSDK] regist]"
  description: 初始化 Line 组件
  parameters: []

loginWithPermissions:
  method_name: "[[RXLineService sharedSDK] loginWithPermissions:sign_fields:migrate_args:]"
  description: Line 登录
  parameters:
    - name: permissions
      type: NSArray<NSString *> *
      required: true
      description: 权限数组（如 profile、openid）
    - name: sign_fields
      type: NSArray *
      required: false
      description: 签名字段
    - name: migrate_args
      type: id
      required: false
      description: 账号迁移参数
  code_objc: |
    [[RXLineService sharedSDK] loginWithPermissions:@[@"profile", @"openid"]
                                        sign_fields:@[@"nickname", @"avatar"]
                                       migrate_args:nil];

handleOpenURL:
  method_name: "[[RXLineService sharedSDK] handleOpenURL:]"
  description: 处理 URL 跳转回调
  parameters:
    - name: url
      type: NSURL *
      required: true
      description: 回调 URL

shareWithContent:
  method_name: "[[RXLineService sharedSDK] shareWithContent:url:complete:]"
  description: Line 分享
  parameters:
    - name: content
      type: NSString *
      required: true
      description: 分享描述
    - name: url
      type: NSString *
      required: true
      description: 分享链接
    - name: complete
      type: RequestComplete
      required: true
      description: 结果回调
  code_objc: |
    [[RXLineService sharedSDK] shareWithContent:@"快来玩游戏"
                                            url:@"https://example.com"
                                       complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        NSLog(@"分享结果: %@", response);
    }];

checkLineIsInstall:
  method_name: "[[RXLineService sharedSDK] checkLineIsInstall]"
  description: 检测 Line 是否安装
  return_type: BOOL

syncInfoWithComplete:
  method_name: "[[RXLineService sharedSDK] syncInfoWithComplete:]"
  description: 同步信息（授权但不登录）
  parameters:
    - name: complete
      type: block
      required: true
      description: 结果回调

# ==================== 完整代码示例 ====================
code_objc: |
  // ========== AppDelegate.m - Line 接入 ==========
  #import <RXLineSDK/RXLineService.h>
  #import <RXSDK_Pure/RXSDK_Pure.h>
  
  - (BOOL)application:(UIApplication *)application 
          didFinishLaunchingWithOptions:(NSDictionary *)launchOptions {
      
      // 1. 【必须在瑞雪 SDK 初始化之前】注册 Line
      [[RXLineService sharedSDK] regist];
      
      // 2. 初始化瑞雪 SDK...
      return YES;
  }
  
  // ========== URL Scheme 回调 ==========
  - (BOOL)application:(UIApplication *)app 
              openURL:(NSURL *)url 
              options:(NSDictionary<UIApplicationOpenURLOptionsKey, id> *)options {
      [[RXLineService sharedSDK] handleOpenURL:url];
      [[RXSDK sharedSDK] application:app openURL:url options:options];
      return YES;
  }
  
  // ========== Line 登录 ==========
  if ([[RXLineService sharedSDK] checkLineIsInstall]) {
      [[RXLineService sharedSDK] loginWithPermissions:@[@"profile", @"openid"]
                                          sign_fields:@[@"nickname", @"avatar"]
                                         migrate_args:nil];
  }
  
  // ========== Line 分享 ==========
  [[RXLineService sharedSDK] shareWithContent:@"快来玩游戏"
                                          url:@"https://example.com"
                                     complete:^(NSDictionary *response, RX_CommonRequestError *error) {
      NSLog(@"分享结果: %@", response);
  }];

# ==================== 注意事项 ====================
notes:
  - title: 初始化顺序
    content: "[[RXLineService sharedSDK] regist] 必须在瑞雪 SDK 初始化之前调用"
  - title: LineSDKConfig
    content: Info.plist 中必须添加 LineSDKConfig（Dictionary），包含 ChannelID
  - title: URL Types
    content: "URL Types 中添加 line3rdp.$(PRODUCT_BUNDLE_IDENTIFIER)"
  - title: LSApplicationQueriesSchemes
    content: 必须添加 lineauth2
  - title: URL 回调
    content: 必须在 application:openURL:options: 中调用 handleOpenURL
  - title: 依赖安装
    content: 添加 pod 依赖后必须执行 pod install 安装组件
  - title: 检测安装
    content: 登录前建议调用 checkLineIsInstall 检测 Line 是否安装
