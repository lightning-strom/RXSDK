# 瑞雪 SDK iOS 反馈功能
# Generated by MCP
# 包含：创建反馈、获取反馈列表、满意度评价、客服消息

# ==================== 获取反馈类型 ====================
get_feedback_kind:
  method_name: "[[RXSDK sharedSDK] getFeedbackKindListWithComplete:]"
  description: 获取意见反馈类型列表
  parameters:
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 获取反馈类型 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    [[RXSDK sharedSDK] getFeedbackKindListWithComplete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"获取反馈类型失败: %@", error.responesObject);
        } else {
            NSArray *kindList = response[@"data"][@"list"];  // 类型 NSArray *
            for (NSDictionary *kind in kindList) {
                NSString *kindId = kind[@"id"];    // 反馈类型 ID，类型 NSString *
                NSString *kindName = kind[@"name"]; // 反馈类型名称，类型 NSString *
                NSLog(@"反馈类型: id=%@, name=%@", kindId, kindName);
            }
        }
    }];

# ==================== 创建反馈 ====================
create_feedback:
  method_name: "[[RXSDK sharedSDK] createFeedbackWithParams:complete:]"
  description: 创建意见反馈
  parameters:
    - name: params
      type: NSDictionary *
      required: true
      description: 反馈参数
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 创建反馈 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSDictionary *params = @{
        @"game_id": @(1001),                       // 游戏 ID，类型 NSNumber
        @"kind_id": @(1),                          // 反馈类型 ID，类型 NSNumber
        @"kind_name": @"Bug 反馈",                  // 反馈类型名称，类型 NSString
        @"priority": @(1),                         // 紧急程度：1 紧急 2 不紧急，类型 NSNumber
        @"content": @"遇到了一个问题...",            // 反馈内容，类型 NSString
        @"picture": @"https://example.com/screenshot.png",  // 图片 URL，类型 NSString
        @"player_gameid": @"player_001",           // 玩家游戏 ID，类型 NSString
        @"send_voided_mails": @(1)                 // 作废是否发邮件：1 发 2 不发，类型 NSNumber
    };  // 类型 NSDictionary *
    
    [[RXSDK sharedSDK] createFeedbackWithParams:params
                                       complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"创建反馈失败: %@", error.responesObject);
        } else {
            NSInteger feedbackId = [response[@"data"][@"id"] integerValue];  // 类型 NSInteger
            NSLog(@"创建反馈成功，ID: %ld", (long)feedbackId);
        }
    }];

# ==================== 创建反馈（简化版） ====================
feedback_create:
  method_name: "[[RXSDK sharedSDK] feedbackCreateWithContent:attachments:phone:tags:complete:]"
  description: 创建反馈（简化版）
  parameters:
    - name: content
      type: NSString *
      required: true
      description: 反馈内容
    - name: attachmentsArray
      type: NSArray *
      required: false
      description: 附件地址数组
    - name: phone
      type: NSString *
      required: true
      description: 手机号
    - name: tagArray
      type: NSArray *
      required: false
      description: 游戏透传标识
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 创建反馈（简化版） ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *content = @"遇到了一个问题...";  // 必填，反馈内容，类型 NSString *
    NSString *phone = @"xxxxxx";          // 必填，手机号，类型 NSString *
    NSArray *attachments = @[@"https://example.com/image1.png"];  // 可选，附件地址数组，类型 NSArray *
    NSArray *tags = @[@"tag1", @"tag2"];       // 可选，游戏透传标识，类型 NSArray *
    
    [[RXSDK sharedSDK] feedbackCreateWithContent:content
                                     attachments:attachments
                                           phone:phone
                                            tags:tags
                                        complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"创建反馈失败: %@", error.responesObject);
        } else {
            NSLog(@"创建反馈成功: %@", response);
        }
    }];

# ==================== 满意度评价 ====================
satisfaction_evaluation:
  method_name: "[[RXSDK sharedSDK] satisfactionEvaluationWithParams:complete:]"
  description: 满意度评价
  parameters:
    - name: params
      type: NSDictionary *
      required: true
      description: 评价参数
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 满意度评价 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSInteger feedbackId = 12345;   // 必填，反馈 ID，类型 NSInteger
    BOOL pleased = YES;             // 必填，是否满意，类型 BOOL
    NSString *reason = @"服务很好"; // 可选，评价理由，类型 NSString *
    
    NSDictionary *params = @{
        @"key_number": @(feedbackId),          // 反馈 ID，类型 NSNumber
        @"pleased_status": @(pleased ? 1 : 2), // 1 满意 2 不满意，类型 NSNumber
        @"reason": reason ?: @""               // 理由，类型 NSString
    };  // 类型 NSDictionary *
    
    [[RXSDK sharedSDK] satisfactionEvaluationWithParams:params
                                               complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"评价失败: %@", error.responesObject);
        } else {
            NSLog(@"评价成功: %@", response);
        }
    }];

