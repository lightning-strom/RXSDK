# ==================== 获取反馈列表 ====================
get_feedback_list:
  method_name: "[[RXSDK sharedSDK] getFeedbackListWithPage:size:status:complete:]"
  description: 获取反馈列表
  parameters:
    - name: page
      type: int
      required: true
      description: 页数
    - name: size
      type: int
      required: true
      description: 每页个数
    - name: status
      type: int
      required: true
      description: 状态（1 未处理，2 已处理，0 获取所有状态）
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 获取反馈列表 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    int page = 1;    // 必填，页数，类型 int
    int size = 10;   // 必填，每页个数，类型 int
    int status = 0;  // 必填，状态（1 未处理，2 已处理，0 所有），类型 int
    
    [[RXSDK sharedSDK] getFeedbackListWithPage:page
                                          size:size
                                        status:status
                                      complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"获取反馈列表失败: %@", error.responesObject);
        } else {
            NSArray *list = response[@"data"][@"list"];  // 类型 NSArray *
            for (NSDictionary *feedback in list) {
                NSInteger feedbackId = [feedback[@"id"] integerValue];  // 反馈 ID，类型 NSInteger
                NSString *content = feedback[@"content"];                // 反馈内容，类型 NSString *
                NSLog(@"反馈: id=%ld, content=%@", (long)feedbackId, content);
            }
        }
    }];

