# ==================== 上报反馈日志 ====================
report_feedback_log:
  method_name: "[[RXSDK sharedSDK] reportFeedbackLogWithData:complete:]"
  description: 上报反馈日志
  parameters:
    - name: data
      type: NSData *
      required: true
      description: 文件二进制数据
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 上报反馈日志 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    // 获取日志文件数据
    NSString *logPath = @"日志文件路径";  // 类型 NSString *
    NSData *logData = [NSData dataWithContentsOfFile:logPath];  // 类型 NSData *
    
    [[RXSDK sharedSDK] reportFeedbackLogWithData:logData
                                        complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"上报日志失败: %@", error.responesObject);
        } else {
            NSLog(@"上报日志成功: %@", response);
        }
    }];
