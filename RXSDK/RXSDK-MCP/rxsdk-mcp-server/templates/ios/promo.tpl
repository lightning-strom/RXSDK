# 瑞雪 SDK iOS 达人福利功能
# Generated by MCP
# 包含：获取福利码、兑换福利码

# ==================== 获取福利码展示 KEY ====================
get_promo_display_key:
  method_name: "[[RXSDK sharedSDK] getPromoDisplayKeyWithAutoRefresh:complete:]"
  description: 获取达人游戏内显示福利码
  parameters:
    - name: autoRefresh
      type: BOOL
      required: true
      description: 是否自动刷新
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 获取福利码展示 KEY ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    BOOL autoRefresh = YES;  // 必填，YES 自动刷新并返回福利码，NO 不自动刷新，类型 BOOL
    
    [[RXSDK sharedSDK] getPromoDisplayKeyWithAutoRefresh:autoRefresh
                                                complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"获取福利码失败: %@", error.responesObject);
        } else {
            NSDictionary *data = response[@"data"];       // 类型 NSDictionary *
            NSString *displayKey = data[@"display_key"];  // 福利码展示 KEY，类型 NSString *
            
            NSLog(@"福利码展示 KEY: %@", displayKey);
            // TODO: 在游戏内展示福利码
        }
    }];

# ==================== 兑换福利码 ====================
exchange_promo_cdkey:
  method_name: "[[RXSDK sharedSDK] exchangePromoCDKEY:complete:]"
  description: 兑换达人福利码
  parameters:
    - name: cdkey
      type: NSString *
      required: true
      description: 福利码
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 兑换福利码 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *cdkey = @"ABCD1234EFGH5678";  // 必填，福利码，类型 NSString *
    
    [[RXSDK sharedSDK] exchangePromoCDKEY:cdkey
                                 complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"兑换福利码失败: %@", error.responesObject);
        } else {
            NSDictionary *data = response[@"data"];  // 类型 NSDictionary *
            NSLog(@"兑换福利码成功: %@", data);
            // TODO: 处理兑换成功逻辑，如发放奖励
        }
    }];
