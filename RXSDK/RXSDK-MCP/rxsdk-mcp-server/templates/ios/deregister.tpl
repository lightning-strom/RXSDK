# 瑞雪 SDK iOS 账号注销功能
# Generated by MCP
# 包含：申请注销、撤销注销

# ==================== RXDeregisterConfig 配置类 ====================
RXDeregisterConfig:
  description: 账号注销配置类
  properties:
    # 必须参数
    - name: idCard
      type: NSString *
      required: true
      description: 身份证号码
    - name: realname
      type: NSString *
      required: true
      description: 真实姓名
    # 可选参数
    - name: cpdata
      type: NSString *
      required: false
      description: CP 自定义数据
    - name: thirdParams
      type: NSDictionary *
      required: false
      description: 三方渠道透传数据

# ==================== 申请注销账号 ====================
deregister:
  method_name: "[[RXSDK sharedSDK] deregisterWithConfig:complete:]"
  description: 申请注销账号
  parameters:
    - name: config
      type: RXDeregisterConfig *
      required: true
      description: 注销参数配置
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 申请注销账号 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    // 注意：注销有冷静期，期间可以撤销
    
    RXDeregisterConfig *config = [[RXDeregisterConfig alloc] init];
    config.idCard = @"110101199001011234";  // 必填，身份证号码
    config.realname = @"张三";  // 必填，真实姓名
    // config.cpdata = @"custom_data";  // 可选，CP 自定义数据
    // config.thirdParams = @{@"key": @"value"};  // 可选，三方渠道透传数据
    
    [[RXSDK sharedSDK] deregisterWithConfig:config
                                   complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"申请注销失败: %@", error.responesObject);
        } else {
            // 获取冷静期结束时间
            NSDictionary *data = response[@"data"];
            NSString *cancelDeadline = data[@"cancel_deadline"];  // 冷静期截止时间
            
            NSLog(@"申请注销成功，冷静期截止: %@", cancelDeadline);
            // TODO: 提示用户冷静期内可撤销
        }
    }];

# ==================== 撤销注销申请 ====================
deregister_cancel:
  method_name: "[[RXSDK sharedSDK] deregisterCancelWithComplete:]"
  description: 撤销账号注销申请
  parameters:
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 撤销注销申请 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    [[RXSDK sharedSDK] deregisterCancelWithComplete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"撤销注销失败: %@", error.responesObject);
        } else {
            NSLog(@"撤销注销成功: %@", response);
            // TODO: 账号恢复正常
        }
    }];
