    // ========== 瑞雪 SDK 获取带 OG 标签的短链接 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    // 注意：支持社交媒体解析预览
    
    NSString *url = @"https://example.com/share";             // 必填
    NSString *title = @"分享标题";                             // 必填
    NSString *content = @"分享描述";                           // 必填
    NSString *image = @"https://example.com/preview.png";     // 必填
    NSDictionary *ext = @{@"custom": @"value"};               // 可选
    
    [[RXSDK sharedSDK] getShortUrl:url
                             title:title
