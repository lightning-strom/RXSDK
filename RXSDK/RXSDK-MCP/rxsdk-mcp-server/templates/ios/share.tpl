# ==================== show_content_in_circle 补充说明 ====================
show_content_in_circle_note:
  description: |
    分享到朋友圈的文案是否展示 content，true 展示 content，false 展示 title，默认 false。
    朋友圈只支持展示 title，该字段可以控制将 "title" 内容替换成 "content" 内容。

# ==================== 一键分享 ====================
share:
  method_name: "[[RXSDK sharedSDK] share:complete:]"
  description: 一键分享
  parameters:
    - name: config
      type: RXShareConfig *
      required: true
      description: 分享配置
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 一键分享 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    RXShareConfig *config = [[RXShareConfig alloc] init];
    config.func = @"share_func_id";           // 必填，埋点标识
    config.platform = @"wechat";              // 必填，分享平台：wechat/system/facebook/messenger/line/tiktok/zalo
    config.region = @"CN";                    // 可选，地区码
    config.transmits = @"custom_data";        // 可选，透传参数
    config.iOSScheme = @"yourapp://";         // 可选，iOS 唤醒协议
    config.useScheme = @"1";                  // 可选，是否使用游戏协议
    config.shareScene = 0;                    // 可选，0 好友，1 朋友圈
    config.show_content_in_circle = NO;       // 可选，朋友圈是否展示 content；默认 NO 展示 title，YES 时用 content 替换 title
    config.useShortUrl = YES;                 // 可选，是否使用短链接
    config.autoReport = YES;                  // 可选，是否自动上报，默认 YES
    config.game_info = @{@"key": @"value"};   // 可选，客户端透传数据
    config.ext = @{@"param": @"value"};       // 可选，扩展字段
    
    [[RXSDK sharedSDK] share:config complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"分享失败: %@", error.responesObject);
        } else {
            NSLog(@"分享成功: %@", response);
        }
    }];

# ==================== 自定义分享 ====================
share_custom:
  method_name: "[[RXSDK sharedSDK] shareCustom:complete:]"
  description: 自定义分享
  parameters:
    - name: config
      type: RXCustomShareConfig *
      required: true
      description: 自定义分享配置
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 自定义分享 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    RXCustomShareConfig *config = [[RXCustomShareConfig alloc] init];
    config.platform = @"wechat";                      // 必填，分享平台
    config.materialType = @"link";                    // 必填，分享类型：text/image/landing/link/video
    config.title = @"分享标题";                        // 可选，分享标题
    config.content = @"分享描述";                      // 可选，分享描述
    config.url = @"https://example.com/share";        // 可选，分享链接
    config.image = @"https://example.com/image.png";  // 可选，图片 url 或本地路径
    config.video = @"https://example.com/video.mp4";  // 可选，视频 url 或本地路径
    config.shareScene = 0;                            // 可选，0 好友，1 朋友圈
    config.show_content_in_circle = NO;               // 可选，朋友圈是否展示 content；默认 NO 展示 title，YES 时用 content 替换 title
    config.thirdAppid = @"wx1234567890";              // 可选，三方 appid
    config.iOSScheme = @"yourapp://";                 // 可选，iOS 唤醒协议
    config.useScheme = @"1";                          // 可选，是否使用游戏协议
    // 二维码配置（image 类型时使用短链接生成二维码）
    // config.x = 100;                                // 二维码坐标 x
    // config.y = 100;                                // 二维码坐标 y
    // config.width = 200;                            // 二维码宽度
    // config.height = 200;                           // 二维码高度
    // config.borderSize = 5;                         // 二维码白边
    
    [[RXSDK sharedSDK] shareCustom:config complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"自定义分享失败: %@", error.responesObject);
        } else {
            NSLog(@"自定义分享成功: %@", response);
        }
    }];

# ==================== 获取分享信息 ====================
get_share_info:
  method_name: "[[RXSDK sharedSDK] getShareInfoWithConfig:complete:]"
  description: 获取分享信息
  parameters:
    - name: config
      type: RXShareConfig *
      required: true
      description: 分享配置
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 获取分享信息 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    RXShareConfig *config = [[RXShareConfig alloc] init];
    config.func = @"share_func_id";    // 必填，埋点标识
    config.platform = @"wechat";       // 必填，分享平台
    
    [[RXSDK sharedSDK] getShareInfoWithConfig:config
                                     complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"获取分享信息失败: %@", error.responesObject);
        } else {
            // 使用获取到的分享信息自行实现分享
            NSDictionary *shareInfo = response[@"data"];
            NSLog(@"分享信息: %@", shareInfo);
        }
    }];

# ==================== 系统分享 ====================
system_share:
  method_name: "[[RXSDK sharedSDK] SystemShareWithShareInfo:complete:]"
  description: 调用系统分享
  parameters:
    - name: shareInfo
      type: NSDictionary *
      required: true
      description: 分享信息（从 getShareInfo 获取）
    - name: complete
      type: RXSDKShareCallBack
      required: true
      description: 分享结果回调
  code_objc: |
    // ========== 瑞雪 SDK 系统分享 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    // 分享信息（通常从 getShareInfoWithConfig 获取）
    NSDictionary *shareInfo = @{
        @"title": @"分享标题",
        @"content": @"分享内容",
        @"url": @"https://example.com"
    };
    
    [[RXSDK sharedSDK] SystemShareWithShareInfo:shareInfo
                                       complete:^(BOOL success) {
        if (success) {
            NSLog(@"系统分享成功");
        } else {
            NSLog(@"系统分享取消或失败");
        }
    }];

# ==================== 获取短链接 ====================
get_short_url:
  method_name: "[[RXSDK sharedSDK] getShortUrl:complete:]"
  description: 获取短链接
  parameters:
    - name: url
      type: NSString *
      required: true
      description: 要生成短链接的 URL
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 获取短链接 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *url = @"https://example.com/long/path/to/share";  // 必填
    
    [[RXSDK sharedSDK] getShortUrl:url
                          complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"获取短链接失败: %@", error.responesObject);
        } else {
            NSString *shortUrl = response[@"data"][@"short_url"];
            NSLog(@"短链接: %@", shortUrl);
        }
    }];

