# 瑞雪 SDK iOS 分享功能
# Generated by MCP
# 包含：一键分享、自定义分享、系统分享、短链接

# ==================== 接入前强制检查 ====================
preflight_check:
  min_version:
    RXSDK_Pure: ">= 4.0.5"
  required:
    - Podfile 已接入 RXSDK_Pure 4.0.5 或更高版本
    - 已完成 RXSdkInitConfig / initWithConfig:complete: 初始化
  auto_upgrade:
    - 传入 workspacePath 时，MCP 会检查 Podfile 中的 RXSDK_Pure 版本
    - 低于 4.0.5 时会自动升级到 4.0.5
    - 未找到 Podfile、RXSDK_Pure 或初始化代码时，返回 preflight.missing 和 nextSteps
  reason: "show_content_in_circle 需要 iOS SDK RXSDK_Pure 4.0.5 或更高版本"

# ==================== RXShareConfig 配置类 ====================
RXShareConfig:
  description: 一键分享配置类
  properties:
    # 必须参数
    - name: func
      type: NSString *
      required: true
      description: 埋点标识
    - name: platform
      type: NSString *
      required: true
      description: 分享平台：wechat/system/facebook/messenger/line/tiktok/zalo
    # 可选参数
    - name: region
      type: NSString *
      required: false
      description: 地区码
    - name: transmits
      type: NSString *
      required: false
      description: 透传参数，原样返回
    - name: iOSScheme
      type: NSString *
      required: false
      description: iOS 唤醒协议
    - name: androidScheme
      type: NSString *
      required: false
      description: Android 唤醒协议
    - name: useScheme
      type: NSString *
      required: false
      description: 是否使用游戏协议，0 不使用，1 使用
    - name: readCache
      type: BOOL
      required: false
      description: 是否读取缓存，默认 NO
    - name: shareScene
      type: NSInteger
      required: false
      description: 0 好友，1 朋友圈
    - name: show_content_in_circle
      type: BOOL
      required: false
      description: 分享到朋友圈的文案是否展示 content，true 展示 content，false 展示 title，默认 false；朋友圈只支持展示 title，该字段可以控制将 title 内容替换成 content 内容
    - name: game_info
      type: NSDictionary *
      required: false
      description: 客户端透传数据
    - name: ext
      type: NSDictionary *
      required: false
      description: 扩展字段，拼接 url 用
    - name: setCustomExt
      type: NSDictionary *
      required: false
      description: 自定义透传参数
    - name: useShortUrl
      type: BOOL
      required: false
      description: 是否使用短链接，默认 NO
    - name: autoReport
      type: BOOL
      required: false
      description: 是否自动上报分享结果，默认 YES
    - name: properties
      type: NSDictionary *
      required: false
      description: 自动上报时的自定义数据

