# ==================== 分享调度上报 ====================
share_report:
  method_name: "[[RXSDK sharedSDK] shareSchedulingReportWithFunc:platform:region:transmits:scheduling_event:scheduling_type:properties:complete:]"
  description: 分享/广告结果上报
  parameters:
    - name: func
      type: NSString *
      required: true
      description: 埋点标识
    - name: platform
      type: NSString *
      required: true
      description: 分享平台
    - name: region
      type: NSString *
      required: false
      description: 地区码
    - name: transmits
      type: NSString *
      required: false
      description: 透传参数
    - name: scheduling_event
      type: BOOL
      required: true
      description: 上报结果（YES 成功，NO 失败）
    - name: scheduling_type
      type: NSString *
      required: true
      description: 上报类型（ad/share）
    - name: properties
      type: NSDictionary *
      required: false
      description: 自定义属性
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 分享结果上报 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    [[RXSDK sharedSDK] shareSchedulingReportWithFunc:@"share_func_id"  // 必填，埋点标识
                                            platform:@"wechat"        // 必填，分享平台
                                              region:@"CN"            // 可选，地区码
                                           transmits:nil              // 可选，透传参数
                                    scheduling_event:YES              // 必填，YES 成功，NO 失败
                                     scheduling_type:@"share"         // 必填，ad/share
                                          properties:nil              // 可选，自定义属性
                                            complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"分享上报失败: %@", error.responesObject);
        } else {
            NSLog(@"分享上报成功");
        }
    }];

