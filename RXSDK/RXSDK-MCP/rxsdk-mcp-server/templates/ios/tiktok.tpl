# 瑞雪 SDK iOS TikTok 组件接入规范
# Generated by MCP

# ==================== 概述 ====================
overview:
  description: TikTok 登录和分享组件
  keywords:
    - tiktok
    - tiktok 登录
    - tiktok 分享
  note: |
    1. TikTok 组件是可选组件，需要根据业务需求选择接入
    2. 需要在 Info.plist 中配置 TikTokAppID、LSApplicationQueriesSchemes、URL Types
    3. 组件注册必须在瑞雪 SDK 初始化之前执行

# ==================== 组件信息 ====================
component:
  name: TikTok
  pod_name: RXTikTokSDK
  service_class: RXTikTokService
  singleton: sharedSDK
  import: "#import <RXTikTokSDK/RXTikTokService.h>"
  description: TikTok 登录和分享组件

# ==================== 工程配置 ====================
project_config:
  info_plist:
    - key: TikTokAppID
      type: String
      required: true
      description: TikTok App ID，从 TikTok 开发者后台获取
  ls_application_queries_schemes:
    - tiktokopensdk
    - tiktoksharesdk
    - snssdk1180
    - snssdk1233
  url_types:
    - scheme: "{TikTokAppID}"
      required: true
      description: TikTok URL Scheme，值为 TikTok App ID

# ==================== Pod 依赖 ====================
pod_install: |
  # ========== TikTok 组件接入 ==========
  # 在 Podfile 中添加以下依赖：
  
  pod 'RXTikTokSDK'
  
  # 然后执行：
  # cd 项目目录
  # pod install

# ==================== 初始化方法 ====================
init_method:
  method_name: "[[RXTikTokService sharedSDK] TTRegistWithApplication:launchOptions:]"
  description: 注册 TikTok 组件
  parameters:
    - name: application
      type: UIApplication *
      required: true
      description: UIApplication 实例
    - name: launchOptions
      type: NSDictionary *
      required: true
      description: 启动参数
  note: 必须在瑞雪 SDK 初始化之前调用

# ==================== 完整代码示例 ====================
code_objc: |
  // ========== AppDelegate.m - TikTok 接入 ==========
  #import <RXTikTokSDK/RXTikTokService.h>
  #import <RXSDK_Pure/RXSDK_Pure.h>
  
  - (BOOL)application:(UIApplication *)application 
          didFinishLaunchingWithOptions:(NSDictionary *)launchOptions {
      
      // 1. 【必须在瑞雪 SDK 初始化之前】注册 TikTok
      [[RXTikTokService sharedSDK] TTRegistWithApplication:application
                                             launchOptions:launchOptions];
      
      // 2. 初始化瑞雪 SDK...
      return YES;
  }

# ==================== 注意事项 ====================
notes:
  - title: 初始化顺序
    content: TTRegistWithApplication 必须在瑞雪 SDK 初始化之前调用
  - title: TikTokAppID
    content: 必须在 Info.plist 中配置 TikTokAppID，值从 TikTok 开发者后台获取
  - title: URL Types
    content: URL Types 中添加 TikTok App ID 作为 Scheme
  - title: LSApplicationQueriesSchemes
    content: 必须添加 tiktokopensdk、tiktoksharesdk、snssdk1180、snssdk1233
  - title: 依赖安装
    content: 添加 pod 依赖后必须执行 pod install 安装组件
