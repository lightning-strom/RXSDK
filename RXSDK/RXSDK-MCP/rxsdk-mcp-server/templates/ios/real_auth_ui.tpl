# ==================== 防沉迷弹窗 ====================
setAntiAdditionViewWithTitle:
  method_name: "[[RXUIKitService sharedSDK] setAntiAdditionViewWithTitle:des:btnTitle:complete:]"
  description: 防沉迷提示弹窗
  parameters:
    - name: title
      type: NSString *
      required: true
      description: 弹窗标题
    - name: des
      type: NSString *
      required: true
      description: 弹窗内容
    - name: btnTitle
      type: NSString *
      required: true
      description: 按钮标题
    - name: complete
      type: void(^)(void)
      required: true
      description: 点击回调
  code: |
    // ========== 瑞雪 SDK 防沉迷弹窗 ==========
    // 注意：需要添加 pod 依赖 pod 'RXUIKit'
    
    #import <RXUIKit/RXUIKitService.h>
    
    NSString *title = @"防沉迷提示";
    NSString *content = @"根据国家最新法规规定，未进行实名认证的用户不能体验任何游戏内容。当前账号游戏累计时间已超过限制，请合理安排游戏时间。";
    NSString *buttonTitle = @"退出游戏";
    
    [[RXUIKitService sharedSDK] setAntiAdditionViewWithTitle:title
                                                         des:content
                                                    btnTitle:buttonTitle
                                                    complete:^{
        NSLog(@"防沉迷弹窗点击确认");
        // TODO: 处理点击确认逻辑，如退出游戏
    }];

