  description: 实名认证弹窗
  parameters:
    - name: canClose
      type: BOOL
      required: true
      description: 是否展示关闭按钮，默认不展示
    - name: complete
      type: void(^)(NSDictionary *response, RX_CommonRequestError *error)
      required: true
      description: 结果回调
  code: |
    // ========== 瑞雪 SDK 实名认证弹窗 ==========
    // 注意：需要添加 pod 依赖 pod 'RXUIKit'
    
    #import <RXUIKit/RXUIKitService.h>
    
    BOOL canClose = NO;  // 是否可关闭，NO 表示强制实名
    
    [[RXUIKitService sharedSDK] setRealauthViewWithCanClose:canClose complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"实名认证失败: %@", error.responesObject[@"msg"]);
            // TODO: 处理实名认证失败逻辑
        } else {
            NSLog(@"实名认证成功: %@", response);
            // TODO: 处理实名认证成功逻辑
        }
    }];

