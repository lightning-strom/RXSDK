# ==================== 占位符说明 ====================
placeholder_note:
  description: "@test 是占位符，接入时必须替换为真实业务参数。"

# ==================== 概述 ====================
overview:
  description: Adjust 广告归因分析 SDK 封装，提供事件追踪、会话管理、隐私合规等功能
  keywords:
    - Adjust
  note: |
    1. Adjust 组件是可选组件，需要根据业务需求选择接入
    2. 需要调用 appDidLaunch: 进行初始化
    3. 提供事件追踪、会话参数、隐私合规、标识符获取等完整功能

# ==================== 组件信息 ====================
component:
  name: Adjust
  pod_name: RXAdjustSDK
  service_class: RXAdjust
  singleton: sharedSDK
  import: "#import <RXAdjustSDK/RXAdjust.h>"
  description: Adjust 广告归因分析组件，提供事件追踪、归因回调、隐私合规等功能

# ==================== Pod 依赖 ====================
pod_install: |
  # ========== Adjust 组件接入 ==========
  # 在 Podfile 中添加以下依赖：
  
  pod 'RXAdjustSDK'
  # 如需 Adjust 防作弊签名库：
  # pod 'RXAdjustSigSDK'
  
  # 然后执行：
  # cd 项目目录
  # pod install

# ==================== 接入步骤 ====================
setup_steps:
  - step: 1
    title: 添加 Pod 依赖
    description: 在 Podfile 中添加 Adjust 组件
    code: |
      # Podfile
      target '@test' do
        use_frameworks!
        
        # 瑞雪 SDK Adjust 组件
        pod 'RXAdjustSDK'
      end
  
  - step: 2
    title: 执行 Pod Install
    description: 在终端中执行 pod install
    code: |
      cd @test
      pod install
  
  - step: 3
    title: 初始化配置
    description: 创建 RXADJConfig 并调用 appDidLaunch 初始化

# ==================== 可选系统框架 ====================
optional_frameworks:
  - name: AdSupport.framework
    description: 允许 SDK 访问 IDFA 与 iOS 14 前的 LAT 信息；儿童类应用不要添加
  - name: AdServices.framework
    description: 处理 Apple Search Ads 必要框架
  - name: StoreKit.framework
    description: 访问 SKAdNetwork，并让 Adjust SDK 自动处理相关通讯
  - name: AppTrackingTransparency.framework
    description: iOS 14+ 请求用户跟踪许可并访问许可响应；儿童类应用不要添加
  - name: WebKit.framework
    description: 仅当应用使用 WebView 时需要

