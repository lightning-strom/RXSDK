# ==================== 完整代码示例 ====================
code_objc: |
  // ========== AppDelegate.m - Adjust 接入 ==========
  #import <RXAdjustSDK/RXAdjust.h>
  #import <RXSDK_Pure/RXSDK_Pure.h>
  
  - (BOOL)application:(UIApplication *)application 
          didFinishLaunchingWithOptions:(NSDictionary *)launchOptions {
      
      // 1. 初始化 Adjust
      RXADJConfig *config = [[RXADJConfig alloc] initWithAppToken:@"@test" 
                                                       environment:@"production"];
      [[RXAdjust sharedSDK] appDidLaunch:config];
      
      // 2. 设置代理（可选）
      [RXAdjust sharedSDK].delegate = self;
      
      // 3. 初始化瑞雪 SDK
      RXSdkInitConfig *sdkConfig = [[RXSdkInitConfig alloc] init];
      sdkConfig.cpId = @"@test";
      sdkConfig.productId = @"@test";
      sdkConfig.channelId = @"@test";
      sdkConfig.baseUrlList = @[@"@test"];
      sdkConfig.launchOptions = launchOptions;
      
      [[RXSDK sharedSDK] initWithConfig:sdkConfig complete:^(NSDictionary *response, RX_CommonRequestError *error) {
          if (error) {
              NSLog(@"SDK 初始化失败: %@", error.responesObject);
              return;
          }
          NSLog(@"SDK 初始化成功: %@", response);
      }];
      
      return YES;
  }
  
  // ========== 事件追踪 ==========
  
  // 记录事件
  RXADJEvent *event = [[RXADJEvent alloc] initWithEventToken:@"@test"];
  [event setRevenue:9.99 currency:@"@test"];
  [event setTransactionId:@"@test"];
  [event addCallbackParameter:@"@test" value:@"@test"];
  [event addPartnerParameter:@"@test" value:@"@test"];
  [event setCallbackId:@"@test"];
  [[RXAdjust sharedSDK] trackEvent:event];
  
  // ========== 标识符获取 ==========
  
  // 获取归因信息
  RXADJAttribution *attribution = [[RXAdjust sharedSDK] attribution];
  NSLog(@"归因网络: %@", attribution.network);
  
  // 获取 IDFA
  NSString *idfa = [[RXAdjust sharedSDK] idfa];
  
  // 获取 ADID
  NSString *adid = [[RXAdjust sharedSDK] adid];
  
  // ========== 隐私合规 ==========
  
  // GDPR 被遗忘权
  [[RXAdjust sharedSDK] gdprForgetMe];

  // 会话参数
  [[RXAdjust sharedSDK] addSessionCallbackParameter:@"@test" value:@"@test"];
  [[RXAdjust sharedSDK] addSessionPartnerParameter:@"@test" value:@"@test"];

  // 推送 token / 后台跟踪 / 启停
  [[RXAdjust sharedSDK] setDeviceToken:deviceToken];
  [[RXAdjust sharedSDK] setSendInBackground:YES];
  [[RXAdjust sharedSDK] setEnabled:YES];

# ==================== 防作弊签名库 ====================
signature_library:
  dependency: "pod 'RXAdjustSigSDK'"
  requirement:
    - "Adjust SDK 4.35.2 或更高版本"
    - "iOS 12 或更高版本"
  notes:
    - "签名库无需改变 Adjust SDK 调用方式"
    - "测试时需使用 sandbox 模式，并通过 release/TestFlight/蒲公英/fir.im 等方式安装"
    - "需要在 Adjust suite 配置所有调试和正式证书指纹"

# ==================== 注意事项 ====================
notes:
  - title: 初始化
    content: 使用 RXADJConfig 创建配置后调用 appDidLaunch: 初始化
  - title: 环境参数
    content: environment 参数正式环境用 @"production"，测试环境用 @"sandbox"
  - title: 依赖安装
    content: 添加 pod 依赖后必须执行 pod install 安装组件
  - title: 归因回调
    content: 实现 RXAdjustDelegate 协议可获取归因回传、事件/会话跟踪回调
  - title: 隐私合规
    content: 提供 GDPR 被遗忘权、第三方数据分享控制等隐私合规功能
  - title: 附加功能
    content: 已覆盖会话回传/合作伙伴参数、离线模式、事件缓冲、数据驻留、许可监测、推送 token、后台跟踪、停用/重启、外部设备 ID、预装默认 tracker
  - title: 防作弊签名
    content: 如需 Adjust 防作弊签名库，添加 pod 'RXAdjustSigSDK'，并在 Adjust suite 配置证书指纹
