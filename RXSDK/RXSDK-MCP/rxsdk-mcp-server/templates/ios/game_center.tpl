# 瑞雪 SDK iOS GameCenter 组件接入规范
# Generated by MCP

# ==================== 概述 ====================
overview:
  description: Apple Game Center 服务组件，提供登录、排行榜、成就等功能
  keywords:
    - GameCenter
  note: |
    1. GameCenter 组件是可选组件，需要根据业务需求选择接入
    2. 需要在 Xcode 中添加 Game Center Capability（自动配置）
    3. 提供登录、排行榜分数上传、成就解锁、界面展示等功能

# ==================== 组件信息 ====================
component:
  name: GameCenter
  pod_name: RXGameCenterSDK
  service_class: RXGameCenterService
  singleton: sharedSDK
  import: "#import <RXGameCenterSDK/RXGameCenterService.h>"
  description: Apple Game Center 服务组件

# ==================== 工程配置 ====================
project_config:
  capability: Game Center
  entitlements_key: com.apple.developer.game-center
  entitlements_value: true (Boolean)
  note: 需要在 entitlements 文件中添加 Game Center 配置，方式同 Associated Domains

# ==================== Pod 依赖 ====================
pod_install: |
  # ========== GameCenter 组件接入 ==========
  # 在 Podfile 中添加以下依赖：
  
  pod 'RXGameCenterSDK'
  
  # 然后执行：
  # cd 项目目录
  # pod install

# ==================== 接入步骤 ====================
setup_steps:
  - step: 1
    title: 添加 Pod 依赖
    description: 在 Podfile 中添加 GameCenter 组件
    code: |
      # Podfile
      target 'YourApp' do
        use_frameworks!
        
        # 瑞雪 SDK GameCenter 组件
        pod 'RXGameCenterSDK'
      end
  
  - step: 2
    title: 执行 Pod Install
    description: 在终端中执行 pod install
    code: |
      cd /path/to/your/project
      pod install

  - step: 3
    title: 添加 Game Center Capability
    description: 在 entitlements 文件中添加 Game Center 配置（自动完成）

# ==================== 方法签名 ====================

# --- 登录 ---
authenticateWithComplete:
  method_name: "[[RXGameCenterService sharedSDK] authenticateWithComplete:]"
  description: 登录 Game Center
  parameters:
    - name: complete
      type: RequestComplete
      required: true
      description: 结果回调
  code_objc: |
    [[RXGameCenterService sharedSDK] authenticateWithComplete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"登录失败: %@", error.msg);
        } else {
            NSLog(@"登录成功");
        }
    }];

# --- 上传排行榜分数 ---
submitScoreWithScore:
  method_name: "[[RXGameCenterService sharedSDK] submitScoreWithScore:leaderboardID:complete:]"
  description: 上传排行榜分数
  parameters:
    - name: score
      type: NSInteger
      required: true
      description: 分数
    - name: leaderboardID
      type: NSString *
      required: true
      description: 排行榜 ID
    - name: complete
      type: RequestComplete
      required: true
      description: 结果回调
  code_objc: |
    [[RXGameCenterService sharedSDK] submitScoreWithScore:1000
                                            leaderboardID:@"leaderboard_001"
                                                 complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        NSLog(@"上传分数结果: %@", response);
    }];

# --- 解锁成就进度 ---
unlockGKAchievementWithAchievementID:
  method_name: "[[RXGameCenterService sharedSDK] unlockGKAchievementWithAchievementID:percentComplete:complete:]"
  description: 解锁成就进度
  parameters:
    - name: achievementID
      type: NSString *
      required: true
      description: 成就 ID
    - name: percentComplete
      type: double
      required: true
      description: 进度（0-100）
    - name: complete
      type: RequestComplete
      required: true
      description: 结果回调
  code_objc: |
    [[RXGameCenterService sharedSDK] unlockGKAchievementWithAchievementID:@"achievement_001"
                                                          percentComplete:100
                                                                 complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        NSLog(@"成就解锁结果: %@", response);
    }];

# --- 展示 Game Center 主界面 ---
showGameCenterWithComplete:
  method_name: "[[RXGameCenterService sharedSDK] showGameCenterWithComplete:]"
  description: 展示 Game Center 主界面
  parameters:
    - name: complete
      type: RequestComplete
      required: true
      description: 结果回调
  code_objc: |
    [[RXGameCenterService sharedSDK] showGameCenterWithComplete:^(NSDictionary *response, RX_CommonRequestError *error) {
        NSLog(@"Game Center 操作: %@", response);
    }];

# --- 展示排行榜界面 ---
showLeaderboardWithComplete:
  method_name: "[[RXGameCenterService sharedSDK] showLeaderboardWithComplete:]"
  description: 展示排行榜界面
  parameters:
    - name: complete
      type: RequestComplete
      required: true
      description: 结果回调
  code_objc: |
    [[RXGameCenterService sharedSDK] showLeaderboardWithComplete:^(NSDictionary *response, RX_CommonRequestError *error) {
        NSLog(@"排行榜操作: %@", response);
    }];

# --- 展示成就界面 ---
showAchievementsWithComplete:
  method_name: "[[RXGameCenterService sharedSDK] showAchievementsWithComplete:]"
  description: 展示成就界面
  parameters:
    - name: complete
      type: RequestComplete
      required: true
      description: 结果回调
  code_objc: |
    [[RXGameCenterService sharedSDK] showAchievementsWithComplete:^(NSDictionary *response, RX_CommonRequestError *error) {
        NSLog(@"成就操作: %@", response);
    }];

# ==================== 完整代码示例 ====================
code_objc: |
  // ========== GameCenter 接入示例 ==========
  #import <RXGameCenterSDK/RXGameCenterService.h>
  
  // 1. 登录 Game Center
  [[RXGameCenterService sharedSDK] authenticateWithComplete:^(NSDictionary *response, RX_CommonRequestError *error) {
      if (error) {
          NSLog(@"登录失败: %@", error.msg);
          return;
      }
      NSLog(@"登录成功");
  }];
  
  // 2. 上传排行榜分数
  [[RXGameCenterService sharedSDK] submitScoreWithScore:1000
                                          leaderboardID:@"leaderboard_001"
                                               complete:^(NSDictionary *response, RX_CommonRequestError *error) {
      NSLog(@"上传分数结果: %@", response);
  }];
  
  // 3. 解锁成就进度（0-100）
  [[RXGameCenterService sharedSDK] unlockGKAchievementWithAchievementID:@"achievement_001"
                                                        percentComplete:100
                                                               complete:^(NSDictionary *response, RX_CommonRequestError *error) {
      NSLog(@"成就解锁结果: %@", response);
  }];
  
  // 4. 展示 Game Center 主界面
  [[RXGameCenterService sharedSDK] showGameCenterWithComplete:^(NSDictionary *response, RX_CommonRequestError *error) {
      NSLog(@"Game Center 操作: %@", response);
  }];
  
  // 5. 展示排行榜界面
  [[RXGameCenterService sharedSDK] showLeaderboardWithComplete:^(NSDictionary *response, RX_CommonRequestError *error) {
      NSLog(@"排行榜操作: %@", response);
  }];
  
  // 6. 展示成就界面
  [[RXGameCenterService sharedSDK] showAchievementsWithComplete:^(NSDictionary *response, RX_CommonRequestError *error) {
      NSLog(@"成就操作: %@", response);
  }];

# ==================== 注意事项 ====================
notes:
  - title: Capability 配置
    content: 必须在 Xcode 中添加 Game Center Capability（自动配置 entitlements）
  - title: Apple Developer 后台
    content: 需要在 Apple Developer 后台为 App ID 开启 Game Center 能力
  - title: 排行榜/成就 ID
    content: 排行榜 ID 和成就 ID 需要在 App Store Connect 中预先配置
  - title: 成就进度
    content: percentComplete 取值范围 0-100，100 表示完全解锁
  - title: 依赖安装
    content: 添加 pod 依赖后必须执行 pod install 安装组件
