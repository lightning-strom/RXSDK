# 瑞雪 SDK iOS LBS 功能
# Generated by MCP
# 包含：高德设备定位工程配置与位置获取、瑞雪社交坐标上报/附近用户/坐标删除

important_note: |
  本 feature 同时包含两类能力：
  1. RXLBSKit：调用高德定位 SDK 获取当前设备位置。
  2. RXSDK_Pure 社交 LBS：上报坐标、查询附近用户、删除坐标。

# ==================== 高德 iOS 原生工程配置 ====================
amap_project_config:
  dependency: "pod 'RXLBSKit', '4.0.0'（最低版本，低版本由 preflight 自动升级）"
  info_plist: |
    <key>NSLocationAlwaysUsageDescription</key>
    <string>是否允许访问定位权限？</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>是否允许访问定位权限？</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>是否允许访问定位权限？</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
    </array>
  note: |
    UIBackgroundModes/location 对应 Xcode Signing & Capabilities >
    Background Modes > Location updates。
    传入 workspacePath 后，MCP 会自动幂等补齐以上 Info.plist 配置。

# ==================== 高德初始化与获取位置 ====================
amapLocation:
  methods:
    - "+ (instancetype)sharedSDK"
    - "- (void)registeAMWithAppkey:(NSString *)appkey"
    - "- (BOOL)enableLocationAuthorizationStatus"
    - "- (void)requestLocationAuthorization:(void(^)(BOOL authorization))complete"
    - "- (void)getLocationInfo:(void(^)(RXLBSModel *location, NSError *error))complete"
    - "- (void)setAllowsBackgroundLocationUpdates:(BOOL)allow"
    - "- (void)setLocationTimeout:(NSInteger)locationTimeout"
  code_objc: |
    #import <RXLBSKit/RXLBSKit.h>

    RXLBSKitService *lbsService = [RXLBSKitService sharedSDK];
    [lbsService registeAMWithAppkey:@"your_amap_ios_key"];
    [lbsService setLocationTimeout:2];

    [lbsService requestLocationAuthorization:^(BOOL authorization) {
        if (!authorization) {
            NSLog(@"未获得定位权限");
            return;
        }
        [lbsService getLocationInfo:^(RXLBSModel *location, NSError *error) {
            if (error) {
                NSLog(@"高德定位失败: %@", error.localizedDescription);
                return;
            }
            NSLog(@"地址: %@, 经度: %f, 纬度: %f",
                  location.formattedAddress,
                  location.longitude,
                  location.latitude);
        }];
    }];
  background_location: |
    // 仅在确实需要后台定位且已配置 UIBackgroundModes/location 时开启
    [[RXLBSKitService sharedSDK] setAllowsBackgroundLocationUpdates:YES];

# ==================== 上报/更新经纬度坐标 ====================
lbsUpdate:
  method_name: "[[RXSDK sharedSDK] lbsUpdateWithLon:lat:types:complete:]"
  description: 上报/更新经纬度坐标
  parameters:
    - name: lon
      type: double
      required: true
      description: 经度
    - name: lat
      type: double
      required: true
      description: 纬度
    - name: types
      type: NSArray *
      required: true
      description: 自定义坐标分组类型，字符串数组
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 回调
  code_objc: |
    // ========== 瑞雪 SDK 上报位置 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    // 前置条件：需要先申请定位权限（NSLocationWhenInUseUsageDescription）
    double lon = 116.403963;  // 必填，经度（示例：北京天安门），类型 double
    double lat = 39.915119;   // 必填，纬度，类型 double
    NSArray *types = @[@"game"];  // 必填，类型数组，类型 NSArray *
    
    [[RXSDK sharedSDK] lbsUpdateWithLon:lon
                                    lat:lat
                                  types:types
                               complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"位置上报失败: %@", error.responesObject);
        } else {
            NSLog(@"位置上报成功: %@", response);
        }
    }];

# ==================== 获取附近用户 ====================
lbsRadius:
  method_name: "[[RXSDK sharedSDK] getRadiusAccountWithLon:lat:radius:count:page:page_size:type:complete:]"
  description: 获取指定半径内的其他用户信息
  parameters:
    - name: lon
      type: double
      required: true
      description: 经度
    - name: lat
      type: double
      required: true
      description: 纬度
    - name: radius
      type: NSInteger
      required: true
      description: 半径（单位：米）
    - name: count
      type: NSInteger
      required: false
      description: 查询数量（默认 0 为全部）
    - name: page
      type: NSInteger
      required: true
      description: 页数，从 1 开始
    - name: page_size
      type: NSInteger
      required: true
      description: 每页数量
    - name: type
      type: NSString *
      required: true
      description: 查询类型
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 回调
  code_objc: |
    // ========== 瑞雪 SDK 获取附近用户 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    double lon = 116.403963;     // 必填，经度，类型 double
    double lat = 39.915119;      // 必填，纬度，类型 double
    NSInteger radius = 1000;     // 必填，半径（米），这里是 1 公里，类型 NSInteger
    NSInteger count = 20;        // 可选，返回数量（0 为全部），类型 NSInteger
    NSInteger page = 1;          // 必填，页码，从 1 开始，类型 NSInteger
    NSInteger page_size = 20;    // 必填，每页大小，类型 NSInteger
    NSString *type = @"game";    // 必填，类型，类型 NSString *
    
    [[RXSDK sharedSDK] getRadiusAccountWithLon:lon
                                           lat:lat
                                        radius:radius
                                         count:count
                                          page:page
                                     page_size:page_size
                                          type:type
                                      complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"获取附近用户失败: %@", error.responesObject);
        } else {
            NSArray *users = response[@"data"];  // 类型 NSArray *
            NSLog(@"附近用户: %@", users);
            
            // 解析用户列表
            for (NSDictionary *user in users) {
                NSString *openid = user[@"openid"];      // 类型 NSString *
                NSString *nickname = user[@"nickname"];  // 类型 NSString *
                NSNumber *distance = user[@"distance"];  // 距离（米），类型 NSNumber *
                NSLog(@"%@ 距离: %@米", nickname, distance);
            }
            // TODO: 更新附近玩家 UI
        }
    }];

# ==================== 删除坐标 ====================
lbsDelete:
  method_name: "[[RXSDK sharedSDK] deleteLocationWithTypes:complete:]"
  description: 删除经纬度坐标
  parameters:
    - name: types
      type: NSArray *
      required: true
      description: 自定义坐标分组类型数组
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 回调
  code_objc: |
    // ========== 瑞雪 SDK 删除位置 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    // 退出游戏或不想显示位置时调用
    NSArray *types = @[@"game"];  // 必填，类型数组，类型 NSArray *
    
    [[RXSDK sharedSDK] deleteLocationWithTypes:types
                                      complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"位置删除失败: %@", error.responesObject);
        } else {
            NSLog(@"位置删除成功");
        }
    }];

# 权限要求
permissions:
  - NSLocationWhenInUseUsageDescription
  - NSLocationAlwaysAndWhenInUseUsageDescription
  - NSLocationAlwaysUsageDescription
  - UIBackgroundModes/location（后台定位需要）

# 导入语句
imports:
  - "#import <RXSDK_Pure/RXSDK_Pure.h>"
  - "#import <RXLBSKit/RXLBSKit.h>"

# 检查指南 (给 AI 的指令)
check_guide:
  - 检查 Podfile 是否包含 RXSDK_Pure 与 RXLBSKit 4.0.0+
  - 检查 Info.plist 是否包含三个定位权限用途描述
  - 后台定位场景检查 UIBackgroundModes 是否包含 location
  - 检查是否已通过 registeAMWithAppkey 注册高德 Key
  - 验证经纬度参数是否有效
  - 验证 types 数组不为空

