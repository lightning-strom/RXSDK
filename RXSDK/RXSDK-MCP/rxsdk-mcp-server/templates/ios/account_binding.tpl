    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *phone = @"xxxxxx";   // 必填，当前绑定的手机号，类型 NSString *
    NSString *captchaCode = @"xxxxxx";  // 必填，验证码（purpose 为 unbindphone），类型 NSString *
    
    [[RXSDK sharedSDK] unBindPhoneWithCaptchaCode:captchaCode
