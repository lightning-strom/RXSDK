# 瑞雪 SDK iOS 账号绑定功能
# Generated by MCP
# 包含：绑定第三方账号、绑定手机、解绑手机、更换手机、绑定邮箱、解绑邮箱
#
# 版本要求:
# - BindAccount 需要 RXSDK_Pure 4.0.2 及以上版本
# - 使用 Facebook / Google 绑定时，RXFacebookSDK / RXGoogleSDK 需要 4.0.0 及以上版本
# - 如果当前 SDK 版本过低，不支持自动升级，请先手动升级 Pod 依赖后再接入

# ==================== 绑定第三方账号 ====================
bindAccount:
  method_name: "[[RXSDK sharedSDK] bindAccountWithExt:complete:]"
  description: 绑定第三方账号
  min_versions:
    RXSDK_Pure: "4.0.2"
    RXFacebookSDK: "4.0.0"
    RXGoogleSDK: "4.0.0"
  parameters:
    - name: ext
      type: NSDictionary *
      required: true
      description: 绑定参数，包含 method、scene 等字段
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 绑定第三方账号 ==========
    // 版本要求：
    // - RXSDK_Pure >= 4.0.2
    // - 若 method 为 facebook/google，RXFacebookSDK/RXGoogleSDK 需 >= 4.0.0
    // - SDK 版本过低不支持自动升级，请先手动升级 Pod 依赖
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSDictionary *ext = @{
        @"method": @"wechat",          // 必填：wechat / facebook / google / apple
        @"scene": @"authorization"     // 可选：authorization（三方账号绑定，默认）或 bind（红包绑定微信账号场景）
    };
    
    [[RXSDK sharedSDK] bindAccountWithExt:ext complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"绑定第三方账号失败: %@", error.responesObject);
        } else {
            NSLog(@"绑定第三方账号成功: %@", response);
        }
    }];

# ==================== 绑定手机 ====================
bind_phone:
  method_name: "[[RXSDK sharedSDK] bindPhoneWithCaptchaCode:password:phone:migrateArgs:complete:]"
  description: 绑定手机号
  parameters:
    - name: captchaCode
      type: NSString *
      required: true
      description: 验证码
    - name: password
      type: NSString *
      required: true
      description: 密码
    - name: phone
      type: NSString *
      required: true
      description: 手机号
    - name: migrateArgs
      type: id
      required: false
      description: 账号迁移参数
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 绑定手机 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *phone = @"xxxxxx";        // 必填，手机号，类型 NSString *
    NSString *password = @"xxxxxx";   // 必填，密码，类型 NSString *
    NSString *captchaCode = @"xxxxxx";       // 必填，验证码（purpose 为 bindphone），类型 NSString *
    
    [[RXSDK sharedSDK] bindPhoneWithCaptchaCode:captchaCode
                                       password:password
                                          phone:phone
                                    migrateArgs:nil  // 可选，账号迁移参数，类型 id
                                       complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"绑定手机失败: %@", error.responesObject);
        } else {
            NSLog(@"绑定手机成功: %@", response);
        }
    }];

