# ==================== 更换手机 ====================
change_phone:
  method_name: "[[RXSDK sharedSDK] changePhoneWithOldPhoneCaptcha:newphone:newPhoneCaptcha:migrateArgs:complete:]"
  description: 更换绑定的手机号
  parameters:
    - name: oldPhoneCaptcha
      type: NSString *
      required: true
      description: 当前手机号的 unbindphone 验证码
    - name: newphone
      type: NSString *
      required: true
      description: 新手机号
    - name: newPhoneCaptcha
      type: NSString *
      required: true
      description: 新手机号的 bindphone 验证码
    - name: migrateArgs
      type: id
      required: false
      description: 账号迁移参数
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 更换手机 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *oldPhoneCaptcha = @"xxxxxx";      // 必填，当前手机号的 unbindphone 验证码，类型 NSString *
    NSString *newPhone = @"xxxxxx";        // 必填，新手机号，类型 NSString *
    NSString *newPhoneCaptcha = @"xxxxxx";      // 必填，新手机号的 bindphone 验证码，类型 NSString *
    
    [[RXSDK sharedSDK] changePhoneWithOldPhoneCaptcha:oldPhoneCaptcha
                                             newphone:newPhone
                                      newPhoneCaptcha:newPhoneCaptcha
                                          migrateArgs:nil  // 可选，账号迁移参数，类型 id
                                             complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"更换手机失败: %@", error.responesObject);
        } else {
            NSLog(@"更换手机成功: %@", response);
        }
    }];

