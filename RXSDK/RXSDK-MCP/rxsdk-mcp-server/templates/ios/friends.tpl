# ==================== 判断是否为好友 ====================
isFriend:
  method_name: "[[RXSDK sharedSDK] requestIsFriendWithTarget:complete:]"
  description: 判断两用户是否为好友
  parameters:
    - name: target
      type: NSString *
      required: true
      description: 对方 OpenID
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 回调
  code_objc: |
    // ========== 瑞雪 SDK 判断是否为好友 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *targetOpenId = @"target_user_openid";  // 必填，对方 OpenID，类型 NSString *
    
    [[RXSDK sharedSDK] requestIsFriendWithTarget:targetOpenId
                                        complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"查询失败: %@", error.responesObject);
        } else {
            NSDictionary *data = response[@"data"];  // 类型 NSDictionary *
            BOOL isFriend = [data[@"is_friend"] boolValue];  // 类型 BOOL
            NSLog(@"是否为好友: %@", isFriend ? @"是" : @"否");
            // TODO: 根据结果更新 UI（如显示"添加好友"或"发送消息"按钮）
        }
    }];

# ==================== 获取好友列表 ====================
getFriendList:
  method_name: "[[RXSDK sharedSDK] getFriendListWithComplete:]"
  description: 获取好友列表
  parameters:
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 回调
  code_objc: |
    // ========== 瑞雪 SDK 获取好友列表 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    [[RXSDK sharedSDK] getFriendListWithComplete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"获取好友列表失败: %@", error.responesObject);
        } else {
            NSArray *friends = response[@"data"];  // 类型 NSArray *
            NSLog(@"好友列表: %@", friends);
            
            // 解析好友列表
            for (NSDictionary *friend in friends) {
                NSString *openid = friend[@"openid"];      // 类型 NSString *
                NSString *nickname = friend[@"nickname"];  // 类型 NSString *
                NSString *avatar = friend[@"avatar"];      // 类型 NSString *
                NSString *remarks = friend[@"remarks"];    // 类型 NSString *
                NSLog(@"好友: %@ (%@)", nickname, remarks);
            }
            // TODO: 更新好友列表 UI
        }
    }];

