# 瑞雪 SDK iOS 好友管理功能
# Generated by MCP
# 包含：添加好友、删除好友、更新好友备注、判断是否好友、获取好友列表

# ==================== 添加好友 ====================
addFriend:
  method_name: "[[RXSDK sharedSDK] addFriendWithTarget:target_remarks:user_remarks:complete:]"
  description: 添加好友
  parameters:
    - name: target
      type: NSString *
      required: true
      description: 对方 OpenID
    - name: target_remarks
      type: NSString *
      required: false
      description: 用户给对方设置的备注（最长 512 字符）
    - name: user_remarks
      type: NSString *
      required: false
      description: 对方给用户设置的备注（最长 512 字符）
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 回调
  code_objc: |
    // ========== 瑞雪 SDK 添加好友 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *targetOpenId = @"target_user_openid";  // 必填，对方 OpenID，类型 NSString *
    NSString *remarks = @"我的好友";                  // 可选，备注，类型 NSString *
    
    [[RXSDK sharedSDK] addFriendWithTarget:targetOpenId
                            target_remarks:remarks
                              user_remarks:nil
                                  complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"好友添加失败: %@", error.responesObject);
            // 常见错误：对方已是好友、对方不存在
        } else {
            NSLog(@"好友添加成功: %@", response);
            // TODO: 更新好友列表 UI
        }
    }];

