  code_objc: |
    // ========== 瑞雪 SDK 更新公共属性 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    // 注意：已存在的属性会被覆盖，新属性会被添加
    
    NSDictionary *properties = @{
        @"user_level": @"vip"   // 类型 NSString
    };  // 必填，要更新的公共属性，类型 NSDictionary *
    
