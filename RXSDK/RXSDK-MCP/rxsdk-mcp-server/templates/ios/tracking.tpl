# ==================== 埋点配置 ====================
track_config:
  method_name: "[[RXSDK sharedSDK] trackConfigWithReportTime:maxCount:]"
  description: 配置埋点上报参数
  parameters:
    - name: reportTime
      type: NSInteger
      required: true
      description: 上报间隔（秒），-1 为默认值（60s）
    - name: maxCount
      type: NSInteger
      required: true
      description: 最大缓存数，达到后触发上报
  code_objc: |
    // ========== 瑞雪 SDK 埋点配置 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSInteger reportTime = 60;   // 上报间隔（秒），-1 为默认值（60s），类型 NSInteger
    NSInteger maxCount = 100;    // 最大缓存数，达到后触发上报，类型 NSInteger
    
    [[RXSDK sharedSDK] trackConfigWithReportTime:reportTime maxCount:maxCount];

# ==================== 设置测试环境 ====================
set_track_env:
  method_name: "[[RXSDK sharedSDK] setTrackEnv:]"
  description: 设置是否为测试数据
  parameters:
    - name: env
      type: BOOL
      required: true
      description: YES 测试数据，NO 正式数据
  code_objc: |
    // ========== 瑞雪 SDK 设置测试环境 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    BOOL isTest = YES;  // YES 测试数据，NO 正式数据，类型 BOOL
    [[RXSDK sharedSDK] setTrackEnv:isTest];

# ==================== 数据埋点（批量上报） ====================
data_track:
  method_name: "[[RXSDK sharedSDK] dataTrackWithEvent:distinctId:properties:]"
  description: 数据埋点（批量上报）
  parameters:
    - name: event
      type: NSString *
      required: true
      description: 埋点事件标识
    - name: distinctId
      type: NSString *
      required: false
      description: 用户唯一标识，传空默认为 openID
    - name: properties
      type: NSDictionary *
      required: false
      description: 自定义属性
  code_objc: |
    // ========== 瑞雪 SDK 数据埋点（批量上报） ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    // 注意：会根据配置的上报间隔和最大缓存数自动上报
    
    NSString *event = @"user_login";  // 必填，埋点事件标识，类型 NSString *
    NSString *distinctId = nil;       // 可选，用户唯一标识，传空默认为 openID，类型 NSString *
    
    NSDictionary *properties = @{
        @"login_type": @"wechat",       // 类型 NSString
        @"is_first_login": @(YES)       // 类型 NSNumber (BOOL)
    };  // 可选，自定义属性，类型 NSDictionary *
    
    BOOL success = [[RXSDK sharedSDK] dataTrackWithEvent:event
                                              distinctId:distinctId
                                              properties:properties];  // 类型 BOOL
    if (success) {
        NSLog(@"埋点添加成功: %@", event);
    } else {
        NSLog(@"埋点添加失败: %@", event);
    }

# ==================== 数据埋点（单条上报） ====================
data_track_single:
  method_name: "[[RXSDK sharedSDK] addLogSingleWithEvent:distinctId:properties:complete:]"
  description: 数据埋点（单条上报，有回调）
  parameters:
    - name: event
      type: NSString *
      required: true
      description: 埋点事件标识
    - name: distinctId
      type: NSString *
      required: false
      description: 用户唯一标识
    - name: properties
      type: NSDictionary *
      required: false
      description: 自定义属性
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 数据埋点（单条上报） ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *event = @"purchase_success";  // 必填，埋点事件标识，类型 NSString *
    NSString *distinctId = nil;              // 可选，用户唯一标识，类型 NSString *
    
    NSDictionary *properties = @{
        @"product_id": @"item_001",   // 类型 NSString
        @"amount": @(100)             // 类型 NSNumber
    };  // 可选，自定义属性，类型 NSDictionary *
    
    [[RXSDK sharedSDK] addLogSingleWithEvent:event
                                  distinctId:distinctId
                                  properties:properties
                                    complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"埋点上报失败: %@", error.responesObject);
        } else {
            NSLog(@"埋点上报成功: %@", event);
        }
    }];

