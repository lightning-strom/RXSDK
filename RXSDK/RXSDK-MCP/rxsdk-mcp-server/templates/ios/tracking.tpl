# ==================== 设置公共属性 ====================
set_public_properties:
  method_name: "[[RXSDK sharedSDK] setPublicProperties:]"
  description: 设置公共属性（所有埋点自动携带）
  parameters:
    - name: properties
      type: NSDictionary *
      required: true
      description: 公共属性
  code_objc: |
    // ========== 瑞雪 SDK 设置公共属性 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    // 注意：设置后由 SDK 自动填入所有埋点的自定义属性中
    
    NSDictionary *properties = @{
        @"app_version": @"1.0.0",                     // 类型 NSString
        @"channel": @"appstore",                      // 类型 NSString
        @"device_model": [[UIDevice currentDevice] model]  // 类型 NSString
    };  // 必填，公共属性，类型 NSDictionary *
    
    [[RXSDK sharedSDK] setPublicProperties:properties];

