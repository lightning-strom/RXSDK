# ==================== 获取邮件列表 ====================
get_email_list:
  method_name: "[[RXSDK sharedSDK] getEmailListWithCpUserID:complete:]"
  description: 获取邮件列表
  parameters:
    - name: cpUserID
      type: NSString *
      required: true
      description: 游戏用户 ID
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 获取邮件列表 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *cpUserID = @"cp_user_001";  // 必填，游戏用户 ID，类型 NSString *
    
    [[RXSDK sharedSDK] getEmailListWithCpUserID:cpUserID
                                       complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"获取邮件列表失败: %@", error.responesObject);
        } else {
            NSArray *list = response[@"data"][@"list"];  // 类型 NSArray *
            for (NSDictionary *email in list) {
                NSString *emailId = email[@"id"];       // 邮件 ID，类型 NSString *
                NSString *title = email[@"title"];      // 邮件标题，类型 NSString *
                NSString *hasGift = email[@"has_gift"]; // 是否有礼物，类型 NSString *
                NSLog(@"邮件: id=%@, title=%@, hasGift=%@", emailId, title, hasGift);
            }
        }
    }];

