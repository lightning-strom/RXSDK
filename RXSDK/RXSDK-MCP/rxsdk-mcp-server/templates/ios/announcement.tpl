    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    [[RXSDK sharedSDK] getTempNotice:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"获取临时公告失败: %@", error.responesObject);
        } else {
            NSDictionary *data = response[@"data"];  // 类型 NSDictionary *
            if (data && data.count > 0) {
                NSString *title = data[@"title"];      // 公告标题，类型 NSString *
                NSString *content = data[@"content"];  // 公告内容，类型 NSString *
                NSLog(@"临时公告: %@ - %@", title, content);
                // TODO: 展示临时公告
            }
        }
    }];

