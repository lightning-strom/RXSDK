  description: 删除邮件
  parameters:
    - name: cpUserID
      type: NSString *
      required: true
      description: 游戏用户 ID
    - name: type
      type: NSInteger
      required: true
      description: 1 删除当前，2 一键删除所有
    - name: emailID
      type: NSInteger
      required: true
      description: 邮件 ID（type=2 时可传 0）
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 删除邮件 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *cpUserID = @"cp_user_001";  // 必填，游戏用户 ID，类型 NSString *
    NSInteger type = 1;                    // 必填，1 删除当前 2 一键删除所有，类型 NSInteger
    NSInteger emailID = 12345;             // 必填，邮件 ID（type=2 时可传 0），类型 NSInteger
    
    [[RXSDK sharedSDK] deleteEmailWithCpUserID:cpUserID
                                          type:type
                                       emailID:emailID
                                      complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"删除邮件失败: %@", error.responesObject);
        } else {
            NSLog(@"删除邮件成功");
        }
    }];
