# ==================== 领取道具 ====================
receive_props:
  method_name: "[[RXSDK sharedSDK] receivePropsWithCpUserID:type:emailID:complete:]"
  description: 领取邮件中的道具
  parameters:
    - name: cpUserID
      type: NSString *
      required: true
      description: 游戏用户 ID
    - name: type
      type: NSInteger
      required: true
      description: 1 领取当前，2 一键领取所有
    - name: emailID
      type: NSInteger
      required: true
      description: 邮件 ID（type=2 时可传 0）
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 领取道具 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    // ========== 领取单封邮件的道具 ==========
    NSString *cpUserID = @"cp_user_001";  // 必填，游戏用户 ID，类型 NSString *
    NSInteger type = 1;                    // 必填，1 领取当前 2 一键领取所有，类型 NSInteger
    NSInteger emailID = 12345;             // 必填，邮件 ID（type=2 时可传 0），类型 NSInteger
    
    [[RXSDK sharedSDK] receivePropsWithCpUserID:cpUserID
                                           type:type
                                        emailID:emailID
                                       complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"领取道具失败: %@", error.responesObject);
        } else {
            NSLog(@"领取道具成功: %@", response);
        }
    }];
    
    // ========== 一键领取所有道具 ==========
    [[RXSDK sharedSDK] receivePropsWithCpUserID:cpUserID
                                           type:2  // 2 一键领取所有，类型 NSInteger
                                        emailID:0
                                       complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"一键领取失败: %@", error.responesObject);
        } else {
            NSLog(@"一键领取成功: %@", response);
        }
    }];

# ==================== 删除邮件 ====================
