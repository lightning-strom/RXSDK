# ==================== 获取公告列表 ====================
get_announcement:
  method_name: "[[RXSDK sharedSDK] getAnnouncementWithLimit:complete:]"
  description: 获取公告列表
  parameters:
    - name: limit
      type: int
      required: true
      description: 返回公告条数（1-100）
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 获取公告列表 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    int limit = 10;  // 必填，返回公告条数（1-100），类型 int
    
    [[RXSDK sharedSDK] getAnnouncementWithLimit:limit
                                       complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"获取公告失败: %@", error.responesObject);
        } else {
            NSArray *list = response[@"data"][@"list"];  // 类型 NSArray *
            for (NSDictionary *announcement in list) {
                NSString *title = announcement[@"title"];      // 公告标题，类型 NSString *
                NSString *content = announcement[@"content"];  // 公告内容，类型 NSString *
                NSLog(@"公告: title=%@, content=%@", title, content);
            }
        }
    }];

# ==================== 获取临时公告 ====================
get_temp_notice:
  method_name: "[[RXSDK sharedSDK] getTempNotice:]"
  description: 获取临时公告
  parameters:
    - name: complete
      type: RXSDKRequestComplete
      required: true
