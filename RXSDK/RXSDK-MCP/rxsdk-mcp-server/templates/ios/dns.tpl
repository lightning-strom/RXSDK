# 瑞雪 SDK iOS DNS 组件库接入规范
# Generated by MCP

# ==================== 概述 ====================
overview:
  description: DNS 组件库用于 HTTP DNS 解析，支持阿里云 DNS 和腾讯云 DNS 两种方案
  note: |
    1. DNS 组件是可选组件，需要根据业务需求选择接入
    2. 阿里云和腾讯云 DNS 二选一，不要同时接入
    3. DNS 初始化必须在瑞雪 SDK 初始化之前执行
    4. RXSdkInitConfig 需要设置 config.isUseDNS = YES

# ==================== DNS 组件选择 ====================
dns_selection:
  description: DNS 组件库选择
  options:
    - name: aliyun
      display_name: 阿里云 DNS
      pod_name: RXAliCloudDNSSDK
      description: 阿里云 HTTPDNS 服务，提供域名解析加速
    - name: tencent
      display_name: 腾讯云 DNS
      pod_name: RXTecentCloudDNSSDK
      description: 腾讯云 HTTPDNS 服务，提供域名解析加速

# ==================== 阿里云 DNS ====================
ali_dns:
  name: 阿里云 DNS
  pod_name: RXAliCloudDNSSDK
  service_class: RXAliCloudDNSSDKService
  singleton: sharedSDK
  import: "#import <RXAliCloudDNSSDK/RXAliCloudDNSSDKService.h>"
  description: 阿里云 HTTPDNS 组件，提供域名解析加速，防劫持
  
  init_method:
    name: "initWithAccountID:secretKey:debug:"
    parameters:
      - name: accountID
        type: NSString *
        required: true
        description: 阿里云账号 ID
      - name: secretKey
        type: NSString *
        required: true
        description: 阿里云密钥
      - name: debug
        type: BOOL
        required: false
        description: 是否开启调试模式，建议测试时开启，正式发布时关闭
  
  pod_install: |
    # ========== 阿里云 DNS 组件接入 ==========
    # 在 Podfile 中添加以下依赖：
    
    pod 'RXAliCloudDNSSDK'
    
    # 然后执行：
    # cd 项目目录
    # pod install
  
  setup_steps:
    - step: 1
      title: 添加 Pod 依赖
      description: 在 Podfile 中添加阿里云 DNS 组件
      code: |
        # Podfile
        target 'YourApp' do
          use_frameworks!
          
          # 瑞雪 SDK 阿里云 DNS 组件
          pod 'RXAliCloudDNSSDK'
        end
    
    - step: 2
      title: 执行 Pod Install
      description: 在终端中执行 pod install
      code: |
        cd /path/to/your/project
        pod install
    
    - step: 3
      title: 初始化配置
      description: 在 SDK 初始化时配置阿里云 DNS
  
  code_objc: |
    // ========== AppDelegate.m - 阿里云 DNS ==========
    #import <RXAliCloudDNSSDK/RXAliCloudDNSSDKService.h>
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    - (BOOL)application:(UIApplication *)application 
            didFinishLaunchingWithOptions:(NSDictionary *)launchOptions {
        
        // 1. 【必须在瑞雪 SDK 初始化之前】初始化阿里云 DNS
        [[RXAliCloudDNSSDKService sharedSDK] initWithAccountID:@"your account id" 
                                                     secretKey:@"your secretKey" 
                                                         debug:YES];
        
        // 2. 创建瑞雪 SDK 初始化配置
        RXSdkInitConfig *config = [[RXSdkInitConfig alloc] init];
        config.cpId = @"YOUR_CP_ID";
        config.productId = @"YOUR_PRODUCT_ID";
        config.channelId = @"YOUR_CHANNEL_ID";
        config.baseUrlList = @[@"https://api.example.com/"];
        config.launchOptions = launchOptions;
        
        // 【重要】开启 DNS 功能
        config.isUseDNS = YES;
        
        // 3. 初始化瑞雪 SDK
        [[RXSDK sharedSDK] initWithConfig:config complete:^(NSDictionary *response, RX_CommonRequestError *error) {
            if (error) {
                NSLog(@"SDK 初始化失败: %@", error.responesObject);
                return;
            }
            NSLog(@"SDK 初始化成功: %@", response);
        }];
        
        return YES;
    }

# ==================== 腾讯云 DNS ====================
tencent_dns:
  name: 腾讯云 DNS
  pod_name: RXTecentCloudDNSSDK
  service_class: RXTecentCloudDNSSDKService
  singleton: sharedSDK
  import: "#import <RXTecentCloudDNSSDK/RXTecentCloudDNSSDKService.h>"
  description: 腾讯云 HTTPDNS 组件，提供域名解析加速，防劫持
  
  init_method:
    name: "initWithAppID:dnsID:dnsKey:debug:"
    parameters:
      - name: appID
        type: NSString *
        required: true
        description: 腾讯云应用 ID
      - name: dnsID
        type: NSString *
        required: true
        description: 腾讯云 DNS ID
      - name: dnsKey
        type: NSString *
