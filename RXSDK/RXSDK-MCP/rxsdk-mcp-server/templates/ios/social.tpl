# ==================== 判断是否存在关系 ====================
hasRelation:
  method_name: "[[RXSDK sharedSDK] requestHasRelationWithTarget:type:complete:]"
  description: 判断两用户是否存在某自定义关系
  parameters:
    - name: target
      type: NSString *
      required: true
      description: 目标 OpenID
    - name: type
      type: NSString *
      required: true
      description: CP 自定义关系类型
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 回调
  code_objc: |
    // ========== 瑞雪 SDK 判断是否存在关系 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *targetOpenId = @"target_user_openid";  // 必填，对方 OpenID，类型 NSString *
    NSString *relationType = @"follow";               // 必填，关系类型，类型 NSString *
    
    [[RXSDK sharedSDK] requestHasRelationWithTarget:targetOpenId
                                               type:relationType
                                           complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"查询失败: %@", error.responesObject);
        } else {
            NSDictionary *data = response[@"data"];  // 类型 NSDictionary *
            BOOL hasRelation = [data[@"has_relation"] boolValue];  // 类型 BOOL
            NSLog(@"是否存在关系: %@", hasRelation ? @"是" : @"否");
            // TODO: 根据结果更新 UI
        }
    }];

# ==================== 获取关系列表 ====================
getRelationList:
  method_name: "[[RXSDK sharedSDK] getRelationListWithType:complete:]"
  description: 获取自定义关系列表
  parameters:
    - name: type
      type: NSString *
      required: true
      description: 自定义关系类型
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 回调
  code_objc: |
    // ========== 瑞雪 SDK 获取关系列表 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *relationType = @"follow";  // 必填，关系类型，类型 NSString *
    
    [[RXSDK sharedSDK] getRelationListWithType:relationType
                                      complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"获取列表失败: %@", error.responesObject);
        } else {
            NSArray *list = response[@"data"];  // 类型 NSArray *
            NSLog(@"关系列表: %@", list);
            
            // 解析关系列表
            for (NSDictionary *item in list) {
                NSString *openid = item[@"openid"];      // 类型 NSString *
                NSString *nickname = item[@"nickname"];  // 类型 NSString *
                NSString *remarks = item[@"remarks"];    // 类型 NSString *
                NSLog(@"用户: %@, 备注: %@", nickname, remarks);
            }
            // TODO: 更新关系列表 UI
        }
    }];

