# 瑞雪 SDK iOS 社交关系功能
# Generated by MCP
# 包含：设置用户自定义信息、添加/删除/更新关系、获取关系列表、判断关系

# ==================== 设置用户自定义信息 ====================
setUserCustom:
  method_name: "[[RXSDK sharedSDK] setUserCustomWithCustom:complete:]"
  description: 设置用户自定义信息
  parameters:
    - name: custom
      type: NSString *
      required: true
      description: 自定义信息（最大长度 512 字节）
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 回调
  code_objc: |
    // ========== 瑞雪 SDK 设置用户自定义信息 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    // 将自定义数据转换为 JSON 字符串
    NSDictionary *customData = @{
        @"level": @50,
        @"vip": @3,
        @"title": @"王者"
    };  // 类型 NSDictionary *
    NSData *jsonData = [NSJSONSerialization dataWithJSONObject:customData options:0 error:nil];  // 类型 NSData *
    NSString *custom = [[NSString alloc] initWithData:jsonData encoding:NSUTF8StringEncoding];  // 类型 NSString *
    
    [[RXSDK sharedSDK] setUserCustomWithCustom:custom
                                      complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"自定义信息设置失败: %@", error.responesObject);
        } else {
            NSLog(@"自定义信息设置成功: %@", response);
        }
    }];

# ==================== 添加自定义关系 ====================
addRelation:
  method_name: "[[RXSDK sharedSDK] addRelationWithTarget:types:target_remarks:user_remarks:complete:]"
  description: 添加自定义关系
  parameters:
    - name: target
      type: NSString *
      required: true
      description: 目标 OpenID
    - name: types
      type: NSDictionary *
      required: true
      description: 自定义关系类型列表（value 必须为 BOOL）
    - name: target_remarks
      type: NSString *
      required: false
      description: 用户给 Target 设置的备注信息（最长 512 字符）
    - name: user_remarks
      type: NSString *
      required: false
      description: Target 给用户设置的备注信息（最长 512 字符）
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 回调
  code_objc: |
    // ========== 瑞雪 SDK 添加自定义关系 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *targetOpenId = @"target_user_openid";  // 必填，对方 OpenID，类型 NSString *
    NSString *relationType = @"follow";               // 关系类型: follow/block/mute 等，类型 NSString *
    NSString *remarks = @"好友A";                     // 可选，备注，类型 NSString *
    
    // 构建关系类型字典（value 必须为 BOOL）
    NSDictionary *types = @{relationType: @YES};  // 类型 NSDictionary *
    
    [[RXSDK sharedSDK] addRelationWithTarget:targetOpenId
                                       types:types
                              target_remarks:remarks
                                user_remarks:nil
                                    complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"关系添加失败: %@", error.responesObject);
        } else {
            NSLog(@"关系添加成功: %@", response);
        }
    }];

