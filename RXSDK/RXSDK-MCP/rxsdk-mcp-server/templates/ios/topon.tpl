# 瑞雪 SDK iOS TopOn 广告聚合接入规范
# Generated by MCP
# 包含：初始化、激励视频、插屏、开屏、横幅、原生广告

# ==================== 概述 ====================
overview:
  description: TopOn（AnyThink）广告聚合 SDK 封装，提供激励视频、插屏、开屏、横幅、原生广告
  keywords:
    - TopOn
    - AnyThink
    - 广告聚合
    - 激励视频
    - 插屏广告
    - 开屏广告
    - 横幅广告
    - 原生广告
  note: |
    1. TopOn 组件是可选组件，需要根据业务需求选择接入
    2. TopOn 为独立组件，需调用 startWithAppID:appKey:error: 初始化
    3. 必须在用户同意《隐私政策》后再初始化 TopOn SDK
    4. 广告位 ID（placementID）需在 TopOn 后台创建并配置广告源
    5. 仅支持 iOS 13 及以上版本
    6. 官方文档：https://help.toponad.com/cn/docs/iOS

# ==================== 组件信息 ====================
component:
  name: TopOn
  pod_name: RXTopOnSDK
  init_class: RXTopOnInitManager
  ad_manager_class: RXTopOnATAdManager
  singleton: sharedSDK
  import: "#import <RXTopOnSDK/RXTopOnSDK.h>"
  description: TopOn 广告聚合组件，提供多种广告形式的加载与展示

# ==================== Pod 依赖 ====================
pod_install: |
  # ========== TopOn 组件接入 ==========
  # 1. 前往 TopOn SDK 下载页面选择需要的广告平台，生成接入代码
  #    https://portal.toponad.com/m/sdk/download
  # 2. 在 Podfile 中添加 TopOn 核心 SDK（必须锁定版本号 6.3.50）：

  pod 'TPNiOS','6.3.50'
  pod 'TraminiSDK','6.3.50'
  # 以下为各广告平台 Adapter，按需添加（版本号需统一为 6.3.50.x）：
  pod 'TPNAdmobSDKAdapter','6.3.50.2'
  pod 'TPNGDTSDKAdapter','6.3.50.4'
  pod 'TPNPangleSDKAdapter','6.3.50.4'
  pod 'TPNMintegralSDKAdapter','6.3.50.2'
  pod 'TPNUnityAdsSDKAdapter','6.3.50.2'
  pod 'TPNApplovinSDKAdapter','6.3.50.2'
  pod 'TPNVungleSDKAdapter','6.3.50.2'
  pod 'TPNIronSourceSDKAdapter','6.3.50.2'
  # ...（更多平台见官方下载页生成的列表）

  # 3. 添加瑞雪 TopOn 封装：
  pod 'RXTopOnSDK'

  # 4. 如集成 Facebook 广告平台，需添加：
  pod 'RXFacebookADSDK_official'

  # 然后执行：
  # cd 项目目录
  # pod install

# ==================== Info.plist 配置 ====================
plist_config: |
  <!-- 如集成 Admob 广告平台，必须在 Info.plist 中添加 GADApplicationIdentifier，否则会 crash -->
  <key>GADApplicationIdentifier</key>
  <string>ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy</string>
  <key>GADIsAdManagerApp</key>
  <true/>

# ==================== 接入步骤 ====================
setup_steps:
  - step: 1
    title: 添加 Pod 依赖
    description: 在 Podfile 中添加 TopOn 核心 SDK、平台 Adapter 及 RXTopOnSDK
  - step: 2
    title: 执行 Pod Install
    description: 在终端中执行 pod install
  - step: 3
    title: 配置 Info.plist
    description: 如集成 Admob，添加 GADApplicationIdentifier
  - step: 4
    title: 初始化 TopOn
    description: 在 AppDelegate 的 didFinishLaunchingWithOptions 中初始化（确保用户已同意隐私政策）
  - step: 5
    title: 接入广告
    description: 按需接入激励视频、插屏、开屏、横幅、原生广告

# ==================== 初始化方法 ====================
init_method:
  method_name: "[[RXTopOnInitManager sharedSDK] startWithAppID:appKey:error:]"
  description: 初始化 TopOn SDK
  parameters:
    - name: appID
      type: NSString *
      required: true
      description: TopOn AppID，从 TopOn 后台获取
    - name: appKey
      type: NSString *
      required: true
      description: TopOn AppKey，从 TopOn 后台获取
  note: 建议在 AppDelegate 的 didFinishLaunchingWithOptions 中调用
  code_objc: |
    #import <RXTopOnSDK/RXTopOnSDK.h>
    #import <AppTrackingTransparency/AppTrackingTransparency.h>

    - (BOOL)application:(UIApplication *)application didFinishLaunchingWithOptions:(NSDictionary *)launchOptions {
        [RXTopOnInitManager setLogEnabled:NO]; // 日志开关，打包上线时需关闭
        [RXTopOnInitManager integrationChecking]; // 应用完整性校验（需配合 setLogEnabled:YES）
        [[RXTopOnInitManager sharedSDK] setSystemPlatformType:ATSystemPlatformTypeIOS];
        if (@available(iOS 14, *)) {
            [ATTrackingManager requestTrackingAuthorizationWithCompletionHandler:^(ATTrackingManagerAuthorizationStatus status) {
                [[RXTopOnInitManager sharedSDK] startWithAppID:@"your TopOn AppId" appKey:@"your TopOn AppKey" error:nil];
            }];
        } else {
            [[RXTopOnInitManager sharedSDK] startWithAppID:@"your TopOn AppId" appKey:@"your TopOn AppKey" error:nil];
        }
        return YES;
    }

# ==================== 辅助方法 ====================
helper_methods:
  - method_name: "[RXTopOnInitManager setLogEnabled:]"
    description: 设置是否打印日志，YES 打印，NO 不打印，默认 NO（上线前需关闭）
    code_objc: "[RXTopOnInitManager setLogEnabled:YES];"
  - method_name: "[RXTopOnInitManager integrationChecking]"
    description: 检查应用完整性（需配合 setLogEnabled:YES）
    code_objc: "[RXTopOnInitManager integrationChecking];"
  - method_name: "[[RXTopOnInitManager sharedSDK] setSystemPlatformType:]"
    description: 设置当前系统平台类型
    code_objc: "[[RXTopOnInitManager sharedSDK] setSystemPlatformType:ATSystemPlatformTypeIOS];"

# ==================== 广告加载通用代理 ====================
loading_delegate:
  protocol_name: RXTopOnATAdLoadingrDelegate
  description: 所有广告类型共用的加载代理，需配合各广告类型专属代理使用
  methods:
    - "didStartLoadingADSourceWithPlacementID:extra:"
    - "didFinishLoadingADSourceWithPlacementID:extra:"
    - "didFailToLoadADSourceWithPlacementID:extra:error:"
    - "didStartBiddingADSourceWithPlacementID:extra:"
    - "didFinishBiddingADSourceWithPlacementID:extra:"
    - "didFailBiddingADSourceWithPlacementID:extra:error:"
    - "didFinishLoadingADWithPlacementID:"
    - "didFailToLoadADWithPlacementID:error:"

# ==================== 激励视频 ====================
reward_video:
  description: 激励视频广告，支持手动加载和全自动加载两种模式
  delegate: RXTopOnATRewardedVideoDelegate
  manual_api:
    - "- (void)loadADWithPlacementID:(NSString *)placementID extra:(NSDictionary *)extra"
    - "- (BOOL)rewardedVideoReadyForPlacementID:(NSString *)placementID"
    - "- (void)entryRewardedVideoScenarioWithPlacementID:(NSString *)placementID scene:(NSString *)scene"
    - "- (void)showRewardedVideoWithPlacementID:(NSString *)placementID scene:(NSString *)scene inViewController:(UIViewController *)viewController"
  auto_api:
    - "- (void)addAutoLoadAdPlacementIDArray:(NSArray<NSString *> *)placementIDArray"
    - "- (void)removeAutoLoadAdPlacementIDArray:(NSArray<NSString *> *)placementIDArray"
    - "- (BOOL)autoLoadRewardedVideoReadyForPlacementID:(NSString *)placementID"
    - "- (void)entryAdScenarioWithPlacementID:(NSString *)placementID scenarioID:(NSString *)scenarioID"
    - "- (void)showAutoLoadRewardedVideoWithPlacementID:(NSString *)placementID scene:(NSString *)scene inViewController:(UIViewController *)viewController"
  code_objc: |
    // ========== 激励视频 - 手动加载 ==========
    // @interface RewardViewController ()<RXTopOnATAdLoadingrDelegate, RXTopOnATRewardedVideoDelegate>
    - (void)loadAd {
        [[RXTopOnATAdManager sharedSDK] loadADWithPlacementID:self.placementID extra:@{}];
        [RXTopOnATAdManager sharedSDK].loadingDelegate = self;
        [RXTopOnATAdManager sharedSDK].rewardDelegate = self;
    }

    - (void)showRewardVideoAd {
        [[RXTopOnATAdManager sharedSDK] entryRewardedVideoScenarioWithPlacementID:self.placementID scene:@"your scene id"];
        if ([[RXTopOnATAdManager sharedSDK] rewardedVideoReadyForPlacementID:self.placementID]) {
            [[RXTopOnATAdManager sharedSDK] showRewardedVideoWithPlacementID:self.placementID scene:@"your scene id" inViewController:self];
        } else {
            [self loadAd];
        }
    }

    // ========== 激励视频 - 全自动加载 ==========
    - (void)autoLoadAd {
        [RXTopOnATAdManager sharedSDK].loadingDelegate = self;
        [RXTopOnATAdManager sharedSDK].rewardDelegate = self;
        [[RXTopOnATAdManager sharedSDK] addAutoLoadAdPlacementIDArray:@[self.placementID]];
    }

    - (void)autoShowRewardVideoAd {
        [[RXTopOnATAdManager sharedSDK] entryAdScenarioWithPlacementID:self.placementID scenarioID:@"your scene id"];
        if ([[RXTopOnATAdManager sharedSDK] autoLoadRewardedVideoReadyForPlacementID:self.placementID]) {
            [[RXTopOnATAdManager sharedSDK] showAutoLoadRewardedVideoWithPlacementID:self.placementID scene:@"your scene id" inViewController:self];
        } else {
            [self autoLoadAd];
        }
    }
  delegate_methods:
    - "rewardedVideoDidStartPlayingForPlacementID:extra:"
    - "rewardedVideoDidEndPlayingForPlacementID:extra:"
    - "rewardedVideoDidFailToPlayForPlacementID:error:extra:"
    - "rewardedVideoDidCloseForPlacementID:rewarded:extra:"
    - "rewardedVideoDidClickForPlacementID:extra:"
    - "rewardedVideoDidRewardSuccessForPlacemenID:extra:"

# ==================== 插屏广告 ====================
interstitial:
  description: 插屏广告，支持手动加载和全自动加载两种模式
  delegate: RXTopOnATInterstitialDelegate
  manual_api:
    - "- (void)loadADWithPlacementID:(NSString *)placementID extra:(NSDictionary *)extra"
    - "- (BOOL)interstitialReadyForPlacementID:(NSString *)placementID"
    - "- (void)entryInterstitialScenarioWithPlacementID:(NSString *)placementID scene:(NSString *)scene"
    - "- (void)showInterstitialWithPlacementID:(NSString *)placementID scene:(NSString *)scene inViewController:(UIViewController *)viewController"
  auto_api:
    - "- (void)autoInterstitial_addAutoLoadAdPlacementIDArray:(NSArray<NSString *> *)placementIDArray"
    - "- (void)autoInterstitial_removeAutoLoadAdPlacementIDArray:(NSArray<NSString *> *)placementIDArray"
    - "- (BOOL)autoInterstitial_autoLoadInterstitialReadyForPlacementID:(NSString *)placementID"
    - "- (void)autoInterstitial_entryAdScenarioWithPlacementID:(NSString *)placementID scenarioID:(NSString *)scenarioID"
    - "- (void)autoInterstitial_showAutoLoadInterstitialWithPlacementID:(NSString *)placementID scene:(NSString *)scene inViewController:(UIViewController *)viewController"
  code_objc: |
    // ========== 插屏广告 - 手动加载 ==========
    // @interface VC ()<RXTopOnATAdLoadingrDelegate, RXTopOnATInterstitialDelegate>
    - (void)loadAd {
        [[RXTopOnATAdManager sharedSDK] loadADWithPlacementID:self.placementID extra:@{}];
        [RXTopOnATAdManager sharedSDK].loadingDelegate = self;
        [RXTopOnATAdManager sharedSDK].interstitialDelegate = self;
    }

    - (void)showInterstitialAd {
        [[RXTopOnATAdManager sharedSDK] entryInterstitialScenarioWithPlacementID:self.placementID scene:@"your scene id"];
        if ([[RXTopOnATAdManager sharedSDK] interstitialReadyForPlacementID:self.placementID]) {
            [[RXTopOnATAdManager sharedSDK] showInterstitialWithPlacementID:self.placementID scene:@"your scene id" inViewController:self];
        } else {
            [self loadAd];
        }
    }

    // ========== 插屏广告 - 全自动加载 ==========
    - (void)autoLoadAd {
        [RXTopOnATAdManager sharedSDK].loadingDelegate = self;
        [RXTopOnATAdManager sharedSDK].interstitialDelegate = self;
        [[RXTopOnATAdManager sharedSDK] setLocalExtra:@{} placementID:self.placementID];
        [[RXTopOnATAdManager sharedSDK] autoInterstitial_addAutoLoadAdPlacementIDArray:@[self.placementID]];
    }

    - (void)autoShowInterstitialAd {
        [[RXTopOnATAdManager sharedSDK] autoInterstitial_entryAdScenarioWithPlacementID:self.placementID scenarioID:@"your scene id"];
        if ([[RXTopOnATAdManager sharedSDK] autoInterstitial_autoLoadInterstitialReadyForPlacementID:self.placementID]) {
            [[RXTopOnATAdManager sharedSDK] autoInterstitial_showAutoLoadInterstitialWithPlacementID:self.placementID scene:@"your scene id" inViewController:self];
        } else {
            [self autoLoadAd];
        }
    }
  delegate_methods:
    - "interstitialDidShowForPlacementID:extra:"
    - "interstitialDidCloseForPlacementID:extra:"
    - "interstitialDidClickForPlacementID:extra:"
    - "interstitialDidStartPlayingVideoForPlacementID:extra:"
    - "interstitialDidEndPlayingVideoForPlacementID:extra:"
    - "interstitialFailedToShowForPlacementID:error:extra:"

# ==================== 开屏广告 ====================
splash:
  description: 开屏广告，展示区域至少占屏幕 75%，传入项目 keyWindow
  delegate: RXTopOnATSplashDelegate
  api:
    - "- (void)loadADWithPlacementID:(NSString *)placementID extra:(NSDictionary *)extra containerView:(UIView *)containerView"
    - "- (BOOL)splashReadyForPlacementID:(NSString *)placementID"
    - "- (void)entrySplashScenarioWithPlacementID:(NSString *)placementID scene:(NSString *)scene"
    - "- (void)showSplashWithPlacementID:(NSString *)placementID scene:(NSString *)scene window:(UIWindow *)window inViewController:(UIViewController *)viewController extra:(NSDictionary *)extra"
  code_objc: |
    // ========== 开屏广告 ==========
    // @interface VC ()<RXTopOnATAdLoadingrDelegate, RXTopOnATSplashDelegate>
    - (void)loadSplashAd {
        NSMutableDictionary *extra = [NSMutableDictionary dictionary];
        [extra setValue:@5.5 forKey:kATSplashExtraTolerateTimeoutKey];
        [[RXTopOnATAdManager sharedSDK] loadADWithPlacementID:self.placementID extra:extra containerView:nil];
        [RXTopOnATAdManager sharedSDK].loadingDelegate = self;
        [RXTopOnATAdManager sharedSDK].splashDelegate = self;
    }

    - (void)showSplashAd {
        [[RXTopOnATAdManager sharedSDK] entrySplashScenarioWithPlacementID:self.placementID scene:@"your scene id"];
        if ([[RXTopOnATAdManager sharedSDK] splashReadyForPlacementID:self.placementID]) {
            UIWindow *mainWindow = [UIApplication sharedApplication].windows.firstObject;
            [[RXTopOnATAdManager sharedSDK] showSplashWithPlacementID:self.placementID
                                                                scene:@"your scene id"
                                                               window:mainWindow
                                                     inViewController:self
                                                                extra:@{}];
        } else {
            [self loadSplashAd];
        }
    }
  delegate_methods:
    - "didFinishLoadingSplashADWithPlacementID:isTimeout:"
    - "didTimeoutLoadingSplashADWithPlacementID:"
    - "splashDidShowForPlacementID:extra:"
    - "splashDidCloseForPlacementID:extra:"
    - "splashDidClickForPlacementID:extra:"
    - "splashCountdownTime:forPlacementID:extra:"

# ==================== 横幅广告 ====================
banner:
  description: 横幅广告，ATBannerView 对象可重复使用，支持后台自动刷新
  delegate: RXTopOnATBannerDelegate
  api:
    - "- (void)loadADWithPlacementID:(NSString *)placementID extra:(NSDictionary *)extra"
    - "- (BOOL)bannerAdReadyForPlacementID:(NSString *)placementID"
    - "- (void)entryBannerScenarioWithPlacementID:(NSString *)placementID scene:(NSString *)scene"
    - "- (ATBannerView *)retrieveBannerViewForPlacementID:(NSString *)placementID scene:(NSString *)scene"
  code_objc: |
    // ========== 横幅广告 ==========
    // @interface VC ()<RXTopOnATAdLoadingrDelegate, RXTopOnATBannerDelegate>
    - (void)loadBannerAdView {
        CGSize adSize = CGSizeMake(CGRectGetWidth(self.view.bounds), 250.0f);
        NSDictionary *dict = @{ kATAdLoadingExtraBannerAdSizeKey:[NSValue valueWithCGSize:adSize] };
        [[RXTopOnATAdManager sharedSDK] loadADWithPlacementID:self.placementID extra:dict];
        [RXTopOnATAdManager sharedSDK].loadingDelegate = self;
        [RXTopOnATAdManager sharedSDK].bannerDelegate = self;
    }

    - (void)showBanner {
        [[RXTopOnATAdManager sharedSDK] entryBannerScenarioWithPlacementID:self.placementID scene:@"your scene id"];
        if ([[RXTopOnATAdManager sharedSDK] bannerAdReadyForPlacementID:self.placementID]) {
            ATBannerView *bannerView = [[RXTopOnATAdManager sharedSDK] retrieveBannerViewForPlacementID:self.placementID scene:@"your scene id"];
            if (bannerView != nil) {
                bannerView.presentingViewController = self;
                bannerView.frame = CGRectMake(0, 0, CGRectGetWidth(self.view.bounds), 250);
                [self.view addSubview:bannerView];
            }
        } else {
            [self loadBannerAdView];
        }
    }
  delegate_methods:
    - "bannerView:didShowAdWithPlacementID:extra:"
    - "bannerView:didClickWithPlacementID:extra:"
    - "bannerView:didAutoRefreshWithPlacement:extra:"
    - "bannerView:didTapCloseButtonWithPlacementID:extra:"

# ==================== 原生广告 ====================
native:
  description: 原生广告，获取广告素材后自定义 view 展示
  delegate: RXTopOnNativeDelegate
  api:
    - "- (void)loadADWithPlacementID:(NSString *)placementID extra:(NSDictionary *)extra"
    - "- (BOOL)nativeAdReadyForPlacementID:(NSString *)placementID"
    - "- (void)entryNativeScenarioWithPlacementID:(NSString *)placementID scene:(NSString *)scene"
    - "- (ATNativeAdOffer *)getNativeAdOfferWithPlacementID:(NSString *)placementID scene:(NSString *)scene"
  code_objc: |
    // ========== 原生广告 ==========
    // @interface VC ()<RXTopOnATAdLoadingrDelegate, RXTopOnNativeDelegate>
    - (void)loadAd {
        CGSize size = CGSizeMake(CGRectGetWidth(self.view.bounds), 350);
        NSDictionary *extra = @{ kATExtraInfoNativeAdSizeKey:[NSValue valueWithCGSize:size] };
        [[RXTopOnATAdManager sharedSDK] loadADWithPlacementID:self.placementID extra:extra];
        [RXTopOnATAdManager sharedSDK].loadingDelegate = self;
        [RXTopOnATAdManager sharedSDK].nativeDelegate = self;
    }

    - (void)showNativeAd {
        [[RXTopOnATAdManager sharedSDK] entryNativeScenarioWithPlacementID:self.placementID scene:@"your scene id"];
        if (![[RXTopOnATAdManager sharedSDK] nativeAdReadyForPlacementID:self.placementID]) {
            [self loadAd];
            return;
        }
        ATNativeADConfiguration *config = [[ATNativeADConfiguration alloc] init];
        config.ADFrame = CGRectMake(0, 0, CGRectGetWidth(self.view.bounds), 350);
        config.delegate = [RXTopOnATAdManager sharedSDK];
        config.sizeToFit = YES;
        config.rootViewController = self;
        ATNativeAdOffer *offer = [[RXTopOnATAdManager sharedSDK] getNativeAdOfferWithPlacementID:self.placementID scene:@"your scene id"];
        // 后续通过自定义 view 展示对应的原生广告素材
    }
  delegate_methods:
    - "didShowNativeAdInAdView:placementID:extra:"
    - "didClickNativeAdInAdView:placementID:extra:"
    - "didCloseDetailInAdView:placementID:extra:"
    - "didStartPlayingVideoInAdView:placementID:extra:"
    - "didEndPlayingVideoInAdView:placementID:extra:"

# ==================== 完整代码示例 ====================
code_objc: |
  // ========== AppDelegate.m - TopOn 接入 ==========
  #import <RXTopOnSDK/RXTopOnSDK.h>
  #import <AppTrackingTransparency/AppTrackingTransparency.h>

  - (BOOL)application:(UIApplication *)application
          didFinishLaunchingWithOptions:(NSDictionary *)launchOptions {
      // 确保用户已同意《隐私政策》后再初始化
      [RXTopOnInitManager setLogEnabled:NO];
      [[RXTopOnInitManager sharedSDK] setSystemPlatformType:ATSystemPlatformTypeIOS];
      if (@available(iOS 14, *)) {
          [ATTrackingManager requestTrackingAuthorizationWithCompletionHandler:^(ATTrackingManagerAuthorizationStatus status) {
              [[RXTopOnInitManager sharedSDK] startWithAppID:@"your TopOn AppId" appKey:@"your TopOn AppKey" error:nil];
          }];
      } else {
          [[RXTopOnInitManager sharedSDK] startWithAppID:@"your TopOn AppId" appKey:@"your TopOn AppKey" error:nil];
      }
      return YES;
  }

# ==================== 注意事项 ====================
notes:
  - title: 隐私合规
    content: 必须确保用户同意《隐私政策》之后再初始化 TopOn SDK
  - title: 初始化参数
    content: startWithAppID:appKey: 的 AppID 和 AppKey 从 TopOn 后台获取
  - title: 版本锁定
    content: TopOn 自动生成的 Pod 依赖必须将版本号统一锁定为 6.3.50（部分 Adapter 为 6.3.50.x）
  - title: Admob 配置
    content: 若集成 Admob，必须在 Info.plist 中配置 GADApplicationIdentifier，否则会 crash
  - title: 系统版本
    content: TopOn SDK 仅支持 iOS 13 及以上版本
  - title: 加载失败重试
    content: 禁止在 didFailToLoadADWithPlacementID 回调中执行加载方法，否则会引起无用请求与卡顿
  - title: 代理设置
    content: 所有广告类型都需设置 loadingDelegate，并设置各自专属代理（rewardDelegate/interstitialDelegate/splashDelegate/bannerDelegate/nativeDelegate）
  - title: 开屏区域
    content: 开屏广告展示区域至少占屏幕 75%，需传入项目 keyWindow，否则可能展示无效
  - title: 上线前
    content: 提交审核/上线前需关闭 setLogEnabled 并移除 integrationChecking 调用
