# 瑞雪 SDK iOS 游戏区服功能
# Generated by MCP
# 包含：创建区服、查询区服、更新区服、删除区服

# ==================== 创建游戏区服 ====================
create_game_area:
  method_name: "[[RXSDK sharedSDK] createGameAreaWithAreaId:areaName:areaStatus:areaType:extension:complete:]"
  description: 创建游戏区服
  parameters:
    - name: areaId
      type: NSString *
      required: true
      description: 区服 ID
    - name: areaName
      type: NSString *
      required: true
      description: 区服名称
    - name: areaStatus
      type: NSString *
      required: true
      description: 区服状态
    - name: areaType
      type: NSString *
      required: true
      description: 区服类型
    - name: extension
      type: NSDictionary *
      required: false
      description: 扩展字段
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 创建游戏区服 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *areaId = @"server_001";   // 必填，区服 ID，类型 NSString *
    NSString *areaName = @"测试服务器"; // 必填，区服名称，类型 NSString *
    NSString *areaStatus = @"1";        // 必填，区服状态 1 正常，类型 NSString *
    NSString *areaType = @"1";          // 必填，区服类型，类型 NSString *
    
    NSDictionary *extension = @{
        @"custom_field": @"自定义值"   // 类型 NSString
    };  // 可选，扩展字段，类型 NSDictionary *
    
    [[RXSDK sharedSDK] createGameAreaWithAreaId:areaId
                                       areaName:areaName
                                     areaStatus:areaStatus
                                       areaType:areaType
                                      extension:extension
                                       complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"创建区服失败: %@", error.responesObject);
        } else {
            NSLog(@"创建区服成功: %@", response);
        }
    }];

# ==================== 查询游戏区服信息 ====================
search_game_area:
  method_name: "[[RXSDK sharedSDK] searchGameAreaInfoWithAreaId:complete:]"
  description: 查询游戏区服信息
  parameters:
    - name: areaId
      type: NSString *
      required: true
      description: 区服 ID
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 查询游戏区服 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *areaId = @"server_001";  // 必填，区服 ID，类型 NSString *
    
    [[RXSDK sharedSDK] searchGameAreaInfoWithAreaId:areaId
                                           complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"查询区服失败: %@", error.responesObject);
        } else {
            NSDictionary *data = response[@"data"];         // 类型 NSDictionary *
            NSString *areaName = data[@"area_name"];        // 区服名称，类型 NSString *
            NSString *areaStatus = data[@"area_status"];    // 区服状态，类型 NSString *
            
            NSLog(@"区服信息: name=%@, status=%@", areaName, areaStatus);
        }
    }];

# ==================== 查询区服列表 ====================
search_game_area_list:
  method_name: "[[RXSDK sharedSDK] searchGameAreaListInfoWithComplete:]"
  description: 查询所有区服列表
  parameters:
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 查询区服列表 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    [[RXSDK sharedSDK] searchGameAreaListInfoWithComplete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"查询区服列表失败: %@", error.responesObject);
        } else {
            NSArray *list = response[@"data"][@"list"];  // 类型 NSArray *
            for (NSDictionary *area in list) {
                NSString *areaId = area[@"area_id"];      // 区服 ID，类型 NSString *
                NSString *areaName = area[@"area_name"];  // 区服名称，类型 NSString *
                NSLog(@"区服: id=%@, name=%@", areaId, areaName);
            }
        }
    }];

