# 瑞雪 SDK iOS Firebase 组件接入规范
# Generated by MCP

# ==================== 占位符说明 ====================
placeholder_note:
  description: "@test 是占位符，接入时必须替换为真实业务参数。"

# ==================== 概述 ====================
overview:
  description: Firebase Analytics 和推送组件
  keywords:
    - Firebase
  note: |
    1. Firebase 组件是可选组件，需要根据业务需求选择接入
    2. configure 初始化必须在瑞雪 SDK 初始化之前执行
    3. 提供事件记录、用户属性设置、用户ID设置、数据收集控制、FCM 注册令牌等功能
    4. 推送能力使用 RXFirebasePush，需配置 APNs 证书/密钥并注册远程通知

# ==================== 组件信息 ====================
component:
  name: Firebase
  pod_name: RXFirebaseSDK
  service_class: RXFirebaseService / RXFirebasePush
  singleton: sharedSDK
  import: "#import <RXFirebaseSDK/RXFirebaseService.h> / #import <RXFirebaseSDK/RXFirebasePush.h>"
  description: Firebase Analytics 和 FCM 推送组件，提供事件记录、用户属性设置、注册令牌、APNs token 绑定等功能

# ==================== Pod 依赖 ====================
pod_install: |
  # ========== Firebase 组件接入 ==========
  # 在 Podfile 中添加以下依赖：
  
  pod 'RXFirebaseSDK'
  
  # 然后执行：
  # cd 项目目录
  # pod install

# ==================== 接入步骤 ====================
setup_steps:
  - step: 1
    title: 添加 Pod 依赖
    description: 在 Podfile 中添加 Firebase 组件
    code: |
      # Podfile
      target '@test' do
        use_frameworks!
        
        # 瑞雪 SDK Firebase 组件
        pod 'RXFirebaseSDK'
      end
  
  - step: 2
    title: 执行 Pod Install
    description: 在终端中执行 pod install
    code: |
      cd @test
      pod install
  
  - step: 3
    title: 初始化配置
    description: 在瑞雪 SDK 初始化之前调用 configure 方法

# ==================== 初始化方法 ====================
init_method:
  method_name: "[[RXFirebaseService sharedSDK] configure]"
  description: 初始化 Firebase 配置
  parameters: []
  note: 必须在瑞雪 SDK 初始化之前调用

# ==================== 方法签名 ====================

# --- configure ---
configure:
  method_name: "[[RXFirebaseService sharedSDK] configure]"
  description: 初始化配置（必须在瑞雪 SDK 初始化之前调用）
  parameters: []
  code_objc: |
    [[RXFirebaseService sharedSDK] configure];

# --- logEventWithName ---
logEventWithName:
  method_name: "[[RXFirebaseService sharedSDK] logEventWithName:parameters:]"
  description: 记录事件
  parameters:
    - name: name
      type: NSString *
      required: true
      description: 事件名（1-40 个字符，必须以字母开头）
    - name: parameters
      type: NSDictionary<NSString *, id> *
      required: false
      description: 事件参数（最多 25 个）
  code_objc: |
    [[RXFirebaseService sharedSDK] logEventWithName:@"@test"
                                         parameters:@{
        @"@test": @"@test",
        @"price": @(6.0)
    }];

# --- setDefaultEventParameters ---
setDefaultEventParameters:
  method_name: "[[RXFirebaseService sharedSDK] setDefaultEventParameters:]"
  description: 设置默认事件参数（会自动附加到所有后续事件）
  parameters:
    - name: parameters
      type: NSDictionary<NSString *, id> *
      required: false
      description: 默认参数字典，传 nil 可清除已设置的默认参数
  code_objc: |
    // 设置默认事件参数（会自动附加到所有后续事件）
    [[RXFirebaseService sharedSDK] setDefaultEventParameters:@{
        @"@test": @"@test"
    }];
    
    // 清除默认事件参数
    // [[RXFirebaseService sharedSDK] setDefaultEventParameters:nil];

# --- setUserPropertyString ---
setUserPropertyString:
  method_name: "[[RXFirebaseService sharedSDK] setUserPropertyString:forName:]"
  description: 设置用户属性
  parameters:
    - name: value
      type: NSString *
      required: false
      description: 属性值，传 nil 可清除该属性
    - name: name
      type: NSString *
      required: true
      description: 属性名
  code_objc: |
    // 设置用户属性
    [[RXFirebaseService sharedSDK] setUserPropertyString:@"@test" forName:@"@test"];
    
    // 清除用户属性
    // [[RXFirebaseService sharedSDK] setUserPropertyString:nil forName:@"@test"];

# --- setUserID ---
setUserID:
  method_name: "[[RXFirebaseService sharedSDK] setUserID:]"
  description: 设置用户 ID（最长 256 字符）
  parameters:
    - name: userID
      type: NSString *
      required: true
      description: 用户 ID，最长 256 字符
  code_objc: |
    [[RXFirebaseService sharedSDK] setUserID:@"@test"];

# --- setAnalyticsCollectionEnabled ---
setAnalyticsCollectionEnabled:
  method_name: "[[RXFirebaseService sharedSDK] setAnalyticsCollectionEnabled:]"
  description: 启用/禁用数据收集（默认 YES）
  parameters:
    - name: enable
      type: BOOL
      required: true
      description: YES 启用数据收集，NO 禁用数据收集，默认 YES
  code_objc: |
    // 启用数据收集（默认）
    [[RXFirebaseService sharedSDK] setAnalyticsCollectionEnabled:YES];
    
    // 禁用数据收集
    // [[RXFirebaseService sharedSDK] setAnalyticsCollectionEnabled:NO];

# --- getInstanceId ---
getInstanceId:
  method_name: "[[RXFirebaseService sharedSDK] getInstanceId]"
  description: 获取 Firebase instanceID
  parameters: []
  return_type: NSString *
  code_objc: |
    NSString *instanceId = [[RXFirebaseService sharedSDK] getInstanceId];
    NSLog(@"Firebase instanceID: %@", instanceId);

# --- RXFirebasePush setDelegate ---
push_setDelegate:
  method_name: "[[RXFirebasePush sharedSDK] setDelegate:]"
  description: 设置 FIRMessagingDelegate，用于接收 FCM 注册令牌更新
  parameters:
    - name: delegate
      type: id<FIRMessagingDelegate>
      required: true
      description: 消息代理对象，通常为 AppDelegate
  code_objc: |
    #import <RXFirebaseSDK/RXFirebasePush.h>
    #import <FirebaseMessaging/FirebaseMessaging.h>
    
    [[RXFirebasePush sharedSDK] setDelegate:self];

# --- RXFirebasePush setDeviceToken ---
push_setDeviceToken:
  method_name: "[[RXFirebasePush sharedSDK] setDeviceToken:]"
  description: 设置 APNs deviceToken；当 FirebaseAppDelegateProxyEnabled=NO 时必须在 didRegisterForRemoteNotificationsWithDeviceToken 中调用
  parameters:
    - name: deviceToken
      type: NSData *
      required: true
      description: APNs deviceToken
  code_objc: |
    - (void)application:(UIApplication *)application
        didRegisterForRemoteNotificationsWithDeviceToken:(NSData *)deviceToken {
        [[RXFirebasePush sharedSDK] setDeviceToken:deviceToken];
    }

# --- RXFirebasePush tokenWithCompletion ---
push_tokenWithCompletion:
  method_name: "[[RXFirebasePush sharedSDK] tokenWithCompletion:]"
  description: 获取当前 FCM 注册令牌
  parameters:
    - name: completion
      type: void(^)(NSString *token, NSError *error)
      required: true
      description: token 获取结果回调
  code_objc: |
    [[RXFirebasePush sharedSDK] tokenWithCompletion:^(NSString *token, NSError *error) {
        if (error) {
            NSLog(@"Error getting FCM registration token: %@", error);
        } else {
            NSLog(@"FCM registration token: %@", token);
        }
    }];

# --- RXFirebasePush autoInitEnabled ---
push_autoInitEnabled:
  method_name: "[[RXFirebasePush sharedSDK] autoInitEnabled:]"
  description: 设置 FCM 自动初始化；关闭时需在 Info.plist 添加 FirebaseMessagingAutoInitEnabled = NO
  parameters:
    - name: enable
      type: BOOL
      required: true
      description: YES 开启，NO 关闭
  code_objc: |
    [[RXFirebasePush sharedSDK] autoInitEnabled:YES];

# ==================== 完整代码示例 ====================
code_objc: |
  // ========== AppDelegate.m - Firebase 接入 ==========
  #import <RXFirebaseSDK/RXFirebaseService.h>
  #import <RXFirebaseSDK/RXFirebasePush.h>
  #import <FirebaseMessaging/FirebaseMessaging.h>
  #import <UserNotifications/UserNotifications.h>
  #import <RXSDK_Pure/RXSDK_Pure.h>
  #import <RXUIKit/RXUIKitService.h>  // 国内 UI 组件（或 RXOSUIKit 海外版）
  
  - (BOOL)application:(UIApplication *)application 
          didFinishLaunchingWithOptions:(NSDictionary *)launchOptions {
      
      // 1. 【必须在瑞雪 SDK 初始化之前】初始化 Firebase
      [[RXFirebaseService sharedSDK] configure];
      [[RXFirebasePush sharedSDK] setDelegate:self];
      
      // 2. 注册远程通知
      [UNUserNotificationCenter currentNotificationCenter].delegate = self;
      UNAuthorizationOptions authOptions = UNAuthorizationOptionAlert |
          UNAuthorizationOptionSound | UNAuthorizationOptionBadge;
      [[UNUserNotificationCenter currentNotificationCenter]
          requestAuthorizationWithOptions:authOptions
                        completionHandler:^(BOOL granted, NSError * _Nullable error) {
          // 根据业务处理授权结果
      }];
      [application registerForRemoteNotifications];
      
      // 3. 创建瑞雪 SDK 初始化配置
      RXSdkInitConfig *config = [[RXSdkInitConfig alloc] init];
      config.cpId = @"@test";
      config.productId = @"@test";
      config.channelId = @"@test";
      config.baseUrlList = @[@"@test"];
      config.launchOptions = launchOptions;
      
      // 4. 初始化瑞雪 SDK
      [[RXSDK sharedSDK] initWithConfig:config complete:^(NSDictionary *response, RX_CommonRequestError *error) {
          if (error) {
              NSLog(@"SDK 初始化失败: %@", error.responesObject);
              return;
          }
          NSLog(@"SDK 初始化成功: %@", response);
          
          // 5. 初始化 UI 组件（在 SDK 初始化成功后）
          [[RXUIKitService sharedSDK] regist];
      }];
      
      return YES;
  }
  
  - (void)application:(UIApplication *)application
      didRegisterForRemoteNotificationsWithDeviceToken:(NSData *)deviceToken {
      [[RXFirebasePush sharedSDK] setDeviceToken:deviceToken];
  }
  
  // 获取 FCM 注册令牌
  [[RXFirebasePush sharedSDK] tokenWithCompletion:^(NSString *token, NSError *error) {
      if (error) {
          NSLog(@"Error getting FCM registration token: %@", error);
      } else {
          NSLog(@"FCM registration token: %@", token);
      }
  }];
  
  // ========== Firebase 功能使用示例 ==========
  
  // 设置默认事件参数（会自动附加到所有后续事件）
  [[RXFirebaseService sharedSDK] setDefaultEventParameters:@{
      @"@test": @"@test"
  }];
  
  // 设置用户属性
  [[RXFirebaseService sharedSDK] setUserPropertyString:@"@test" forName:@"@test"];
  
  // 设置用户 ID
  [[RXFirebaseService sharedSDK] setUserID:@"@test"];
  
  // 启用数据收集（默认 YES）
  [[RXFirebaseService sharedSDK] setAnalyticsCollectionEnabled:YES];
  
  // 记录事件
  [[RXFirebaseService sharedSDK] logEventWithName:@"@test"
                                       parameters:@{
      @"@test": @"@test",
      @"price": @(6.0)
  }];
  
  // 获取 instanceID
  NSString *instanceId = [[RXFirebaseService sharedSDK] getInstanceId];

# ==================== 注意事项 ====================
notes:
  - title: 初始化顺序
    content: "[[RXFirebaseService sharedSDK] configure] 必须在瑞雪 SDK 初始化之前调用"
  - title: 依赖安装
    content: 添加 pod 依赖后必须执行 pod install 安装组件
  - title: 事件名规范
    content: 事件名 1-40 个字符，必须以字母开头
  - title: 参数限制
    content: 每个事件最多 25 个参数
  - title: 用户ID限制
    content: 用户 ID 最长 256 字符
  - title: 数据收集
    content: setAnalyticsCollectionEnabled 默认为 YES，如需禁用需显式设置为 NO
  - title: 推送配置
    content: 需要在 Firebase 控制台上传 APNs 身份验证密钥；使用 RXFirebasePush 设置 FIRMessagingDelegate、APNs deviceToken，并通过 tokenWithCompletion 获取 FCM 注册令牌
  - title: 自动初始化
    content: 如需关闭 FCM 自动初始化，在 Info.plist 添加 FirebaseMessagingAutoInitEnabled = NO，并按需调用 autoInitEnabled:YES 恢复
