# 瑞雪 SDK iOS 版本检查 v2
# Generated by MCP
# 最低版本：RXSDK_Pure >= 4.0.8

# ==================== 接入前强制检查 ====================
preflight_check:
  must_do_before_insert_code: true
  minimum_sdk:
    ios:
      RXSDK_Pure: ">= 4.0.8"
  checks:
    - "检查 Podfile 中 RXSDK_Pure 是否 >= 4.0.8；低于 4.0.8 时必须先升级"
    - "检查项目中是否已完成 RXSdkInitConfig / initWithConfig:complete: 初始化"
    - "只生成 v2 updateGameVersionWithInfo 接入，不返回旧版 checkUpdate_App/checkUpdate_Game/checkUpdate_Activity 代码"
  failure_action:
    - "如果 preflight.satisfied=false，先按 preflight.missing / preflight.nextSteps 补齐基础接入和版本升级"
    - "版本不足且 MCP 已修改 Podfile 时，先执行 pod update RXSDK_Pure 或 pod install --repo-update"
  agent_rule:
    - "用户说“接入瑞雪版本检查”“iOS 版本检查”“检查更新”时，直接返回本 v2 updateGameVersionWithInfo 接入"
    - "不得再生成旧版版本检查接口"

# ==================== 版本检查 v2 ====================
update_game_version_v2:
  method_name: "[[RXUpdateCheckService sharedSDK] updateGameVersionWithInfo:complete:]"
  description: 瑞雪版本检查 v2，统一检查模块版本
  parameters:
    - name: info
      type: NSDictionary
      required: true
      description: 请求体，包含 modules 和 type
    - name: complete
      type: RequestComplete
      required: true
      description: 请求完成回调
  body_schema:
    modules:
      type: NSArray<NSDictionary *>
      required: true
      item_fields:
        module_tag: "NSString，必填，模块标识"
        category_tag: "NSString，必填，分类标识"
        clientversion: "NSNumber，必填，客户端当前版本；0 表示首次接入或当前无相关版本"
        checkversion: "NSNumber，必填，优先检查版本；不指定时传 0"
    type:
      type: NSString
      required: false
      description: 脚本类型，如 js / lua / u3d
  response_schema:
    code: "NSNumber，接口状态码；0 表示请求正常，非 0 表示请求失败"
    data:
      type: NSDictionary
      description: 业务数据
      fields:
        modules:
          type: NSArray<NSDictionary *>
          description: 模块检查结果数组
          item_fields:
            module_tag: "NSString，模块标识"
            category_tag: "NSString，分类标识"
            version: "NSNumber，最新版本；大于 0 表示有新版本，0 表示无最新版本"
            uri: "NSString，版本包下载地址"
  response_example: |
    {
      "data": {
        "modules": [
          {
            "module_tag": "dsa",
            "category_tag": "dass",
            "uri": "https://rxfile-test.ruixueyun.com/release/pkg/25031110GjPuOV0TkITessHcdWpgyWn3Tb3T2U.zip",
            "version": 88
          },
          {
            "module_tag": "_nNNN",
            "category_tag": "default",
            "uri": "https://rxfile-test.ruixueyun.com/release/pkg/25031110jCFrdMrEvsqRMDnMEC7vMoJO7EinKp.zip",
            "version": 99
          }
        ]
      },
      "code": 0
    }
  code: |
    #import <RXSDK_Pure/RXUpdateCheckService.h>

    NSDictionary *info = @{
        @"modules": @[
            @{
                @"module_tag": @"@test",      // 必填：替换为实际模块标识
                @"category_tag": @"@test",    // 必填：替换为实际分类标识
                @"clientversion": @(0),       // 必填：0 表示首次接入或当前无相关版本
                @"checkversion": @(0)         // 必填：不指定优先检查版本时传 0
            },
            @{
                @"module_tag": @"@test",
                @"category_tag": @"@test",
                @"clientversion": @(0),
                @"checkversion": @(0)
            }
        ],
        @"type": @"u3d"                   // 可选：脚本类型，根据项目实际填写
    };

    [[RXUpdateCheckService sharedSDK] updateGameVersionWithInfo:info complete:^(NSDictionary * _Nullable response, RX_CommonRequestError * _Nullable error) {
        if (error) {
            NSLog(@"版本检查 v2 失败: %@", error.error);
            return;
        }

        NSLog(@"版本检查 v2 成功: %@", response);
        // TODO: 解析 response，按服务端返回处理模块更新
    }];

# 导入语句
imports:
  - "#import <RXSDK_Pure/RXUpdateCheckService.h>"

