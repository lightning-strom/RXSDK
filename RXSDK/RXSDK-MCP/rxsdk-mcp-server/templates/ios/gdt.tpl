# 瑞雪 SDK iOS GDT（腾讯广告/广点通）接入规范
# Generated by MCP

overview:
  feature: gdt
  compatibility_alias: tencent_ad
  minimum_versions:
    RXGDTSDK: "1.0.2"
    RXSDK_Pure: "4.0.8"
  note: |
    RXGDTSDK 必须先于瑞雪 SDK 注册。MCP preflight 会检查 Podfile、基础初始化、
    GDT 注册与生命周期，以及关键上报 API；低版本 RXSDK* Pod 会安全升级，不降级高版本。

dependencies:
  podfile: |
    pod 'RXSDK_Pure', '4.0.8'
    pod 'RXGDTSDK', '1.0.2'

initialization:
  code_objc: |
    #import <RXGDTSDK/RXGDTSDK.h>
    #import <RXSDK_Pure/RXSDK_Pure.h>

    - (BOOL)application:(UIApplication *)application
            didFinishLaunchingWithOptions:(NSDictionary *)launchOptions {
        // 必须在 RXSDK initWithConfig:complete: 之前调用。
        [[RXGDTService sharedSDK] regist];

        RXSdkInitConfig *config = [[RXSdkInitConfig alloc] init];
        config.cpId = @"YOUR_CP_ID";
        config.productId = @"YOUR_PRODUCT_ID";
        config.channelId = @"YOUR_CHANNEL_ID";
        config.baseUrlList = @[@"https://YOUR_API_HOST"];
        config.launchOptions = launchOptions;
        [[RXSDK sharedSDK] initWithConfig:config complete:nil];
        return YES;
    }

    - (void)applicationDidBecomeActive:(UIApplication *)application {
        [[RXGDTService sharedSDK] logAction:@"START_APP" actionParam:@{}];
    }

    - (BOOL)application:(UIApplication *)app
                openURL:(NSURL *)url
                options:(NSDictionary<UIApplicationOpenURLOptionsKey,id> *)options {
        [[RXGDTService sharedSDK] handleOpenUrl:url];
        return YES;
    }

manual_initialization:
  method: "-initWithActionSetId:secretKey:"
  code_objc: |
    [[RXGDTService sharedSDK] initWithActionSetId:@"YOUR_ACTION_SET_ID"
                                       secretKey:@"YOUR_SECRET_KEY"];

required_events:
  create_role: |
    [[RXGDTService sharedSDK] reportCreateRoleActionWithRole:@"role-id"];
  checkout: |
    [[RXGDTService sharedSDK]
        reportCheckoutActionWithContentType:@"item"
        contentName:@"礼包"
        contentID:@"sku-1"
        contentNumber:1
        isVirtualCurrency:NO
        virtualCurrencyType:@""
        realCurrencyType:@"CNY"
        isSuccess:YES];
  purchase: |
    // currencyAmount 的单位为分；600 表示 6.00 CNY。
    [[RXGDTService sharedSDK]
        reportPurchaseActionWithContentType:@"item"
        contentName:@"礼包"
        contentID:@"sku-1"
        contentNumber:1
        paymentChannel:@"wechat"
        realCurrency:@"CNY"
        currencyAmount:600
        isSuccess:YES];

other_events:
  methods:
    - reportRegisterActionWithMethod:isSuccess:
    - reportLoginActionWithMethod:isSuccess:
    - reportFinishQuestActionWithQuestID:questType:questName:questNumer:description:isSuccess:
    - reportShareActionWithChannel:isSuccess:
    - reportUpgradeLevelActionWithLevel:
    - reportRateActionWithRate:
    - reportViewContentActionWithContentType:contentName:contentID:
    - reportAddingToCartActionWithContentType:contentName:contentID:contentNumber:isSuccess:

preflight_check:
  required:
    - Podfile 包含 RXGDTSDK >= 1.0.2 与 RXSDK_Pure >= 4.0.8
    - 存在 RXSdkInitConfig / initWithConfig:complete:
    - regist 在瑞雪 SDK 初始化前调用
    - applicationDidBecomeActive 上报 START_APP
    - openURL 回调调用 handleOpenUrl
    - 构建目标包含 RXGDTService 关键上报 API
