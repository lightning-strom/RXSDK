# 瑞雪 SDK iOS 工程配置
# Generated by MCP
# 包含：Info.plist 隐私权限配置

# ==================== 配置说明 ====================
description: |
  iOS 应用需要在 Info.plist 中声明隐私权限描述，否则使用相关功能时会被系统拒绝。
  请根据您的应用环境（国内/海外）选择对应的配置。

# ==================== Info.plist 隐私权限配置 ====================
privacy_permissions:
  # 相机权限
  - key: NSCameraUsageDescription
    chinese: "是否允许使用相机"
    english: "Allow access to the camera?"
    usage: 用于拍照、扫码等功能
    
  # 麦克风权限
  - key: NSMicrophoneUsageDescription
    chinese: "是否允许使用麦克风"
    english: "Allow access to the microphone?"
    usage: 用于语音录制、视频录制等功能
    
  # 保存到相册权限
  - key: NSPhotoLibraryAddUsageDescription
    chinese: "是否允许保存到相册"
    english: "Allow saving photos to your photo library?"
    usage: 用于保存图片、截图等功能
    
  # 访问相册权限
  - key: NSPhotoLibraryUsageDescription
    chinese: "是否允许访问相册"
    english: "Allow access to your photo library?"
    usage: 用于选择图片、上传头像等功能
    
  # 广告追踪权限 (iOS 14+)
  - key: NSUserTrackingUsageDescription
    chinese: "此标识符将用于向您推荐个性化广告。"
    english: "This identifier will be used to deliver personalized ads to you."
    usage: 用于广告归因、个性化推荐

