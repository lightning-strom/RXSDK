# 瑞雪 SDK iOS Google 登录组件接入规范
# Generated by MCP

# ==================== 概述 ====================
overview:
  description: Google 登录组件，提供 Google 账号登录功能
  keywords:
    - google
    - google 登录
  note: |
    1. Google 组件是可选组件，需要根据业务需求选择接入
    2. 需要在 Info.plist 中配置 GIDClientID
    3. 需要在 URL Types 中添加 iOS 网址架构（从 Google Cloud Console 获取）
    4. 组件注册必须在瑞雪 SDK 初始化之前执行

# ==================== 组件信息 ====================
component:
  name: Google 登录
  pod_name: RXGoogleSDK
  service_class: RXGoogleService
  singleton: sharedSDK
  import: "#import <RXGoogleSDK/RXGoogleService.h>"
  description: Google 登录组件

# ==================== 工程配置 ====================
project_config:
  info_plist:
    - key: GIDClientID
      type: String
      required: true
      description: Google Client ID，从 Google Cloud Console 获取
  url_types:
    - scheme: iOS 网址架构
      required: true
      description: Google 后台凭据中的 iOS 网址架构（反向客户端 ID）

# ==================== Pod 依赖 ====================
pod_install: |
  # ========== Google 登录组件接入 ==========
  # 在 Podfile 中添加以下依赖：
  
  pod 'RXGoogleSDK'
  
  # 然后执行：
  # cd 项目目录
  # pod install

# ==================== 接入步骤 ====================
setup_steps:
  - step: 1
    title: 添加 Pod 依赖
    description: 在 Podfile 中添加 Google 组件
    code: |
      # Podfile
      target 'YourApp' do
        use_frameworks!
        
        # 瑞雪 SDK Google 登录组件
        pod 'RXGoogleSDK'
      end
  
  - step: 2
    title: 执行 Pod Install
    description: 在终端中执行 pod install
    code: |
      cd /path/to/your/project
      pod install

  - step: 3
    title: 配置 Info.plist
    description: 添加 GIDClientID 和 URL Types（自动完成）

  - step: 4
    title: 初始化代码
    description: 在瑞雪 SDK 初始化之前调用注册方法

# ==================== 初始化方法 ====================
init_method:
  method_name: "[[RXGoogleService sharedSDK] regist]"
  description: 注册 Google 组件
  parameters: []
  note: 必须在瑞雪 SDK 初始化之前调用

# ==================== 方法签名 ====================

# --- 注册 ---
GRegistWithClientID:
  method_name: "[[RXGoogleService sharedSDK] GRegistWithClientID:]"
  description: 注册 Google（使用 ClientID）
  parameters:
    - name: clientID
      type: NSString *
      required: true
      description: Google Client ID

# --- 登录 ---
GLoginInWithMigrate_args:
  method_name: "[[RXGoogleService sharedSDK] GLoginInWithMigrate_args:sign_fields:]"
  description: Google 登录
  parameters:
    - name: migrate_args
      type: NSDictionary *
      required: false
      description: 迁移参数
    - name: sign_fields
      type: NSArray *
      required: false
      description: 签名字段

# --- 恢复登录 ---
GRestorePreviousSignInWithMigrate_args:
  method_name: "[[RXGoogleService sharedSDK] GRestorePreviousSignInWithMigrate_args:sign_fields:]"
  description: 恢复登录（静默登录）
  parameters:
    - name: migrate_args
      type: NSDictionary *
      required: false
      description: 迁移参数
    - name: sign_fields
      type: NSArray *
      required: false
      description: 签名字段

# --- 退出登录 ---
GLogout:
  method_name: "[[RXGoogleService sharedSDK] GLogout]"
  description: Google 退出登录
  parameters: []

# --- 处理 URL ---
GOpenURL:
  method_name: "[[RXGoogleService sharedSDK] GOpenURL:]"
  description: 处理 openURL 回调
  parameters:
    - name: url
      type: NSURL *
      required: true
      description: 回调 URL

# ==================== 完整代码示例 ====================
code_objc: |
  // ========== AppDelegate.m - Google 登录接入 ==========
  #import <RXGoogleSDK/RXGoogleService.h>
  #import <RXSDK_Pure/RXSDK_Pure.h>
  
  - (BOOL)application:(UIApplication *)application 
          didFinishLaunchingWithOptions:(NSDictionary *)launchOptions {
      
      // 1. 【必须在瑞雪 SDK 初始化之前】注册 Google 组件
      [[RXGoogleService sharedSDK] regist];
      
      // 2. 初始化瑞雪 SDK...
      // [[RXSDK sharedSDK] initWithConfig:config complete:...];
      
      return YES;
  }
  
  // ========== URL Scheme 回调 ==========
  - (BOOL)application:(UIApplication *)app 
              openURL:(NSURL *)url 
              options:(NSDictionary<UIApplicationOpenURLOptionsKey, id> *)options {
      // 处理 Google 登录回调
      [[RXGoogleService sharedSDK] GOpenURL:url];
      [[RXSDK sharedSDK] application:app openURL:url options:options];
      return YES;
  }
  
  // ========== Google 登录使用示例 ==========
  
  // Google 登录
  [[RXGoogleService sharedSDK] GLoginInWithMigrate_args:nil
                                            sign_fields:@[@"nickname", @"avatar"]];
  
  // 恢复登录（静默登录）
  [[RXGoogleService sharedSDK] GRestorePreviousSignInWithMigrate_args:nil
                                                          sign_fields:nil];
  
  // Google 退出登录
  [[RXGoogleService sharedSDK] GLogout];

# ==================== 注意事项 ====================
notes:
  - title: 初始化顺序
    content: "[[RXGoogleService sharedSDK] regist] 必须在瑞雪 SDK 初始化之前调用"
  - title: GIDClientID
    content: 必须在 Info.plist 中配置 GIDClientID，值从 Google Cloud Console 获取
  - title: URL Types
    content: 必须在 URL Types 中添加 Google 后台凭据中的 iOS 网址架构（反向客户端 ID）
  - title: URL 回调
    content: 必须在 application:openURL:options: 中调用 GOpenURL 处理回调
  - title: 依赖安装
    content: 添加 pod 依赖后必须执行 pod install 安装组件
