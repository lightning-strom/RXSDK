# ==================== 用户中心弹窗 ====================
userCenterWithConfig:
  method_name: "[[RXUIKitService sharedSDK] userCenterWithConfig:complete:]"
  description: 用户中心界面
  parameters:
    - name: config
      type: RXUserCenterConfig *
      required: true
      description: 用户中心配置
    - name: complete
      type: void(^)(NSDictionary *response, RX_CommonRequestError *error)
      required: true
      description: 结果回调
  code: |
    // ========== 瑞雪 SDK 用户中心弹窗 ==========
    // 注意：需要添加 pod 依赖 pod 'RXUIKit'
    
    #import <RXUIKit/RXUIKitService.h>
    #import <RXUIKit/RXUserCenterConfig.h>
    
    // 创建用户中心配置
    RXUserCenterConfig *config = [[RXUserCenterConfig alloc] init];
    config.game_user_id = @"游戏用户ID";       // 用户的游戏 ID
    config.nickname = @"游戏昵称";             // 用户昵称
    config.queue_name = @"客服接入节点";        // 在瑞雪客服系统设置的接入点名称，不填写默认为 default
    // config.head_img_url = @"头像URL";       // 用户头像 URL
    // config.transmit_args = @"透传参数";     // 透传数据，使用 jsonString 形式
    // config.setLightTheme = YES;             // 是否使用浅色主题，默认 YES
    // config.setSyncInfoEnable = NO;          // 是否展示同步信息按钮，默认 NO
    // config.orientationVisible = NO;         // 帮助中心和客服页面是否允许横竖屏旋转，默认 NO
    
    // 配置用户中心显示的按钮
    config.setConfigParams = @{@"btns" : @[
        @"real_name",           // 实名认证
        @"privacy_policy",      // 隐私政策
        @"acount_cancel",       // 账号注销
        @"phone_management",    // 账号管理
        @"change_pwd"           // 修改密码
    ]};
    
    [[RXUIKitService sharedSDK] userCenterWithConfig:config complete:^(NSDictionary * _Nonnull response, RX_CommonRequestError * _Nonnull error) {
        if (!error) {
            NSLog(@"用户中心操作成功: %@", response);
            // response 中的 type 字段表示操作类型：
            // - "real_name": 实名认证
            // - "logout": 退出登录
            // - "cancel_account": 注销账号
            // TODO: 根据 type 处理相应逻辑
        } else {
            NSLog(@"用户中心操作失败: %@", error.responesObject);
            // TODO: 根据错误码处理失败逻辑
        }
    }];

