# RXUserCenterConfig 配置参数
user_center_config:
  class_name: RXUserCenterConfig
  import_path: <RXUIKit/RXUserCenterConfig.h>
  description: 用户中心/帮助中心/客服配置对象
  fields:
    - name: logoImage
      type: UIImage *
      description: 显示的 logo
    - name: transmit_args
      type: NSString *
      description: 透传数据，使用 jsonString 形式
    - name: game_user_id
      type: NSString *
      description: 用户的游戏 ID
    - name: nickname
      type: NSString *
      description: 用户昵称
    - name: head_img_url
      type: NSString *
      description: 用户头像 URL
    - name: queue_name
      type: NSString *
      description: 在瑞雪客服系统设置的接入点名称，不填写默认为 default
    - name: setLightTheme
      type: BOOL
      description: 设置主体模式，YES 为浅色（默认），NO 为深色模式
    - name: setSyncInfoEnable
      type: BOOL
      description: 用户中心是否展示同步信息按钮，用于同步三方信息，默认 NO
    - name: setConfigParams
      type: NSDictionary *
      description: 用户中心入口配置
    - name: orientationVisible
      type: BOOL
      description: 帮助中心和客服页面是否允许横竖屏旋转，需要工程配置支持横竖屏旋转，默认 NO

# 用户中心按钮配置
user_center_btns:
  - name: real_name
    description: 实名认证
  - name: privacy_policy
    description: 隐私政策
  - name: acount_cancel
    description: 账号注销
  - name: phone_management
    description: 账号管理
  - name: change_pwd
    description: 修改密码

# 导入语句
imports:
