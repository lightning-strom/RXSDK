# 瑞雪 SDK iOS App Store 评分功能
# Generated by MCP
# 包含：应用内评分、跳转评分

# ==================== 应用内评分 ====================
in_app_store_review:
  method_name: "[[RXSDK sharedSDK] inAppStoreReview:complete:]"
  description: 应用内拉起 App Store 评分页面
  parameters:
    - name: appid
      type: NSString *
      required: true
      description: App ID
    - name: complete
      type: void(^)(void)
      required: true
      description: 点击完成或取消回调
  code_objc: |
    // ========== 瑞雪 SDK 应用内评分 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    // 注意：此处点击完成并不代表用户已完成评分，仅监听 VC dismiss
    
    NSString *appid = @"xxxxxx";  // 必填，App Store 中的 App ID，类型 NSString *
    
    [[RXSDK sharedSDK] inAppStoreReview:appid complete:^{
        NSLog(@"评分页面已关闭");
    }];

# ==================== 跳转 App Store 评分 ====================
to_app_store_review:
  method_name: "[[RXSDK sharedSDK] toAppStoreReview:writeReview:]"
  description: 跳转到 App Store 评分
  parameters:
    - name: appid
      type: NSString *
      required: true
      description: App ID
    - name: writeReview
      type: BOOL
      required: true
      description: 是否直接拉起评论页
  code_objc: |
    // ========== 瑞雪 SDK 跳转 App Store 评分 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *appid = @"xxxxxx";  // 必填，App Store 中的 App ID，类型 NSString *
    BOOL writeReview = YES;           // 必填，YES 直接拉起评论页，NO 显示 App 详情页，类型 BOOL
    
    [[RXSDK sharedSDK] toAppStoreReview:appid writeReview:writeReview];

# ==================== 应用内评分弹框 ====================
alert_app_review:
  method_name: "[[RXSDK sharedSDK] alertAppReview]"
  description: 应用内评分弹框（系统样式）
  code_objc: |
    // ========== 瑞雪 SDK 应用内评分弹框 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    // 注意：使用 SKStoreReviewController 的系统评分弹框
    // 注意：每年每个 App 最多弹出 3 次
    
    [[RXSDK sharedSDK] alertAppReview];
