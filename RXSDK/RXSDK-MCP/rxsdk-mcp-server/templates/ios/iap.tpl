# ==================== 查询商品信息 ====================
get_product_info:
  method_name: "[[RXSDK sharedSDK] getProductInfoWithProductIdArr:complete:]"
  description: 查询 App Store 商品信息
  parameters:
    - name: productIdArr
      type: NSArray *
      required: true
      description: 商品 ID 数组
    - name: complete
      type: void(^)(NSArray<SKProduct *> *)
      required: true
      description: 结果回调（返回 SKProduct 数组）
  code_objc: |
    // ========== 瑞雪 SDK 查询商品信息 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    #import <StoreKit/StoreKit.h>
    
    NSArray *productIds = @[@"com.game.product001", @"com.game.product002"];  // 必填，商品 ID 数组，类型 NSArray *
    
    [[RXSDK sharedSDK] getProductInfoWithProductIdArr:productIds
                                             complete:^(NSArray<SKProduct *> *productInfoList) {  // 类型 NSArray<SKProduct *> *
        for (SKProduct *product in productInfoList) {
            NSString *productId = product.productIdentifier;  // 商品 ID，类型 NSString *
            NSString *title = product.localizedTitle;          // 商品标题，类型 NSString *
            NSDecimalNumber *price = product.price;            // 商品价格，类型 NSDecimalNumber *
            NSLog(@"商品: id=%@, title=%@, price=%@", productId, title, price);
        }
    }];

# ==================== 获取货币符号 ====================
get_locale_identifier:
  method_name: "[[RXSDK sharedSDK] getLocaleIdentifierWithProductId:timeout:complete:]"
  description: 获取地区货币符号
  parameters:
    - name: productId
      type: NSString *
      required: true
      description: 商品 ID
    - name: timeout
      type: NSInteger
      required: true
      description: 超时时间（秒）
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 获取货币符号 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *productId = @"com.game.product001";  // 必填，商品 ID，类型 NSString *
    NSInteger timeout = 2;                          // 必填，超时时间（秒），类型 NSInteger
    
    [[RXSDK sharedSDK] getLocaleIdentifierWithProductId:productId
                                                timeout:timeout
                                               complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"获取货币符号失败: %@", error.responesObject);
        } else {
            NSString *symbol = response[@"data"][@"symbol"];  // 类型 NSString *
            NSLog(@"货币符号: %@", symbol);
        }
    }];

# ==================== 设置重复下单间隔 ====================
set_iap_interval:
  method_name: "[[RXSDK sharedSDK] setIAPInterval:]"
  description: 设置重复下单间隔
  parameters:
    - name: interval
      type: NSInteger
      required: true
      description: 间隔时间（秒）
  code_objc: |
    // ========== 瑞雪 SDK 设置下单间隔 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    // 注意：防止结果回调前重复下单导致订单验证错误
    
    NSInteger interval = 300;  // 间隔时间（秒），默认 300s，类型 NSInteger
    [[RXSDK sharedSDK] setIAPInterval:interval];

# ==================== 查询订单状态 ====================
trade_query:
  method_name: "[[RXSDK sharedSDK] tradeQueryWithOrderNo:complete:]"
  description: 查询订单状态
  parameters:
    - name: orderNo
      type: NSString *
      required: true
      description: 订单号
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 查询订单状态 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *orderNo = @"订单号";  // 必填，订单号，类型 NSString *
    
    [[RXSDK sharedSDK] tradeQueryWithOrderNo:orderNo
                                    complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"查询订单失败: %@", error.responesObject);
        } else {
            NSDictionary *data = response[@"data"];           // 类型 NSDictionary *
            NSInteger status = [data[@"status"] integerValue]; // 订单状态，类型 NSInteger
            NSLog(@"订单状态: %ld", (long)status);
        }
    }];

