# 瑞雪 SDK iOS 内购支付功能
# Generated by MCP
# 包含：IAP 支付、补单、商品信息查询

# ==================== IAP 支付 ====================
iap:
  method_name: "[[RXSDK sharedSDK] iap:complete:]"
  description: 内购支付
  parameters:
    - name: dict
      type: NSDictionary *
      required: true
      description: 订单参数字典
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK IAP 内购支付 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *tradeNo = @"订单号从服务端获取";    // 必填，订单号，类型 NSString *
    NSString *productId = @"com.game.product001"; // 必填，商品 ID，类型 NSString *
    NSString *currency = @"CNY";                   // 可选，币种，类型 NSString *
    
    NSDictionary *orderDict = @{
        @"trade_no": tradeNo,              // 必填，订单号，类型 NSString
        @"currency": currency,             // 币种，默认 CNY，类型 NSString
        @"goods_tag": productId,           // 商品标签，类型 NSString
        @"env": @(0),                      // 0 正式 1 沙盒，类型 NSNumber
        @"indulge_auth": @(0),             // 0 不验证防沉迷 1 验证，类型 NSNumber
        @"is_debug": @(0),                 // 0 正式订单 1 测试订单，类型 NSNumber
        @"notify_url": @"https://your-server.com/pay/notify",  // 发货回调地址，类型 NSString
        @"ext": @{                         // 扩展字段，类型 NSDictionary
            @"custom_field": @"自定义值"
        },
        @"transmit_args": @"透传参数"       // 可选，透传参数，类型 NSString
    };  // 类型 NSDictionary *
    
    [[RXSDK sharedSDK] iap:orderDict complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"支付失败: %@", error.responesObject);
        } else {
            NSInteger code = [response[@"code"] integerValue];  // 类型 NSInteger
            if (code == 0) {
                NSLog(@"支付成功: %@", response);
                // TODO: 处理支付成功逻辑
            } else {
                NSLog(@"支付业务失败: %@", response[@"msg"]);
            }
        }
    }];

