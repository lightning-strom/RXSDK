# 瑞雪 SDK iOS 验证码功能
# Generated by MCP
# 包含：发送验证码、校验验证码、图形验证

# ==================== 发送验证码 ====================
send_captcha:
  method_name: "[[RXSDK sharedSDK] sendCaptchaWithType:target:purpose:complete:]"
  description: 发送验证码（手机或邮箱）
  parameters:
    - name: type
      type: CaptchaType
      required: true
      description: 验证码类型（CaptchaType_email 邮箱、CaptchaType_phone 手机）
    - name: target
      type: NSString *
      required: true
      description: 发送目标（手机号或邮箱）
    - name: purpose
      type: NSString *
      required: true
      description: 用途（register/login/bindphone/unbindphone/resetpwd/changepwd/bindemail/unbindemail）
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 发送验证码 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    // ========== 发送手机验证码 ==========
    // purpose 用途说明:
    //   - register: 注册
    //   - login: 登录
    //   - bindphone: 绑定手机
    //   - unbindphone: 解绑手机
    //   - resetpwd: 重置密码
    //   - changepwd: 修改密码
    //   - setpwd: 设置密码
    
    NSString *phone = @"xxxxxx";         // 必填，手机号，类型 NSString *
    NSString *purpose = @"login";        // 必填，用途，类型 NSString *
    
    [[RXSDK sharedSDK] sendCaptchaWithType:CaptchaType_phone  // 类型 CaptchaType
                                    target:phone
                                   purpose:purpose
                                  complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"发送验证码失败: %@", error.responesObject);
        } else {
            NSLog(@"发送验证码成功: %@", response);
            // TODO: 开始倒计时
        }
    }];
    
    // ========== 发送邮箱验证码 ==========
    // purpose 用途说明:
    //   - bindemail: 绑定邮箱
    //   - unbindemail: 解绑邮箱
    
    NSString *email = @"xxxxxx";   // 必填，邮箱地址，类型 NSString *
    NSString *emailPurpose = @"bindemail";   // 必填，用途，类型 NSString *
    
    [[RXSDK sharedSDK] sendCaptchaWithType:CaptchaType_email  // 类型 CaptchaType
                                    target:email
                                   purpose:emailPurpose
                                  complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"发送邮箱验证码失败: %@", error.responesObject);
        } else {
            NSLog(@"发送邮箱验证码成功: %@", response);
        }
    }];

