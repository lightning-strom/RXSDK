# ==================== 展示公告 UI ====================
showAnnounceViewWithLimit:
  method_name: "[[RXUIKitService sharedSDK] showAnnounceViewWithLimit:linkCallBack:isHasCallBack:]"
  description: 展示公告 UI
  parameters:
    - name: limit
      type: int
      required: true
      description: 展示公告条数
    - name: linkCallBack
      type: void(^)(NSString *link)
      required: true
      description: 用户点击链接回调
    - name: ishasCallBack
      type: void(^)(BOOL isHas)
      required: true
      description: 是否有公告回调
  code: |
    // ========== 瑞雪 SDK 展示公告 UI ==========
    
    #import <RXUIKit/RXUIKitService.h>
    
    int limit = 10;  // 展示公告条数
    
    [[RXUIKitService sharedSDK] showAnnounceViewWithLimit:limit linkCallBack:^(NSString *link) {
        NSLog(@"用户点击链接: %@", link);
        // TODO: 处理链接跳转
    } isHasCallBack:^(BOOL isHas) {
        if (isHas) {
            NSLog(@"有公告展示");
        } else {
            NSLog(@"没有公告");
        }
    }];

