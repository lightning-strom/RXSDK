# ==================== 邮件中心 ====================
showEmailViewWithCpUserId:
  method_name: "[[RXUIKitService sharedSDK] showEmailViewWithCpUserId:withComplete:]"
  description: 展示邮件中心
  parameters:
    - name: cpUserId
      type: NSString *
      required: true
      description: CP 方 userID
    - name: complete
      type: void(^)(NSDictionary *response, RX_CommonRequestError *error)
      required: true
      description: 结果回调
  code: |
    // ========== 瑞雪 SDK 展示邮件中心 ==========
    
    #import <RXUIKit/RXUIKitService.h>
    
    NSString *cpUserId = @"demo_user_001";  // 游戏用户 ID
    
    [[RXUIKitService sharedSDK] showEmailViewWithCpUserId:cpUserId withComplete:^(NSDictionary *response, RX_CommonRequestError *error) {
        dispatch_async(dispatch_get_main_queue(), ^{
            if (error) {
                NSLog(@"邮件中心错误: %@", error.msg);
            } else {
                NSLog(@"邮件中心操作完成");
            }
        });
    }];

