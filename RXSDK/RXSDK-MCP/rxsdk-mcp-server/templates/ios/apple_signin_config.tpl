# 瑞雪 SDK iOS Sign in with Apple 工程配置
# Generated by MCP

project_config:
  capability: "Target -> Signing & Capabilities -> Sign in with Apple"
  entitlements: |
    <key>com.apple.developer.applesignin</key>
    <array>
        <string>Default</string>
    </array>
  auto_config: |
    调用 ios feature=apple_signin_config 并传入 workspacePath、targetName 后：
    1. 仅修改指定 Target 的 Debug / Release build configuration。
    2. 复用 Target 已绑定的 entitlements；未绑定时创建 TargetName/TargetName.entitlements。
    3. 幂等写入 com.apple.developer.applesignin = [Default]。
    4. 幂等绑定 CODE_SIGN_ENTITLEMENTS。
  manual_step:
    - "在 Apple Developer 后台为对应 App ID 开启 Sign in with Apple。"
    - "重新生成或刷新包含该 Capability 的 Provisioning Profile。"

apple_login_example:
  code_objc: |
    #import <RXSDK_Pure/RXSDK_Pure.h>

    RXLoginConfig *config = [[RXLoginConfig alloc] init];
    config.loginType = LoginTypeApple;
    [[RXSDK sharedSDK] loginWithConfig:config
                              complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"Apple 登录失败: %@", error.responesObject);
            return;
        }
        NSLog(@"Apple 登录成功: %@", response);
    }];

check_guide:
  - "必须显式调用 apple_signin_config；普通 passport 不会修改 Apple Capability。"
  - "检查指定 Target 的 CODE_SIGN_ENTITLEMENTS。"
  - "检查 entitlements 中 com.apple.developer.applesignin 为包含 Default 的数组。"
