# 瑞雪 SDK iOS 登录功能
# Generated by MCP
# 包含：登录（多种方式）、法务信息获取

# ==================== RXLoginConfig 配置类 ====================
RXLoginConfig:
  description: API 登录配置类
  properties:
    # 必须参数
    - name: loginType
      type: LoginType
      required: true
      description: 登录类型枚举
    # 条件必须参数
    - name: username
      type: NSString *
      required: conditional
      description: 账号密码/验证码登录时必传
    - name: password
      type: NSString *
      required: conditional
      description: 账号密码登录时必传
    - name: captchaCode
      type: NSString *
      required: conditional
      description: 验证码登录时必传
    - name: permissions
      type: NSArray *
      required: conditional
      description: Facebook、Line 登录时必传
    # 可选参数
    - name: loginOpenId
      type: NSString *
      required: false
      description: 二次登录 openId
    - name: extDic
      type: NSMutableDictionary *
      required: false
      description: 扩展字段，断线重连时传 reconnect_login:YES
    - name: signFields
      type: NSArray *
      required: false
      description: 签名字段数组，如 @[@"nickname", @"avatar"]
    - name: migrateArgs
      type: id
      required: false
      description: 账号迁移参数

# LoginType 枚举值
LoginType:
  - LoginTypeVisitor    # 游客登录
  - LoginTypeAccount    # 账号密码登录
  - LoginTypeCapCode    # 验证码登录
  - LoginTypeApple      # 苹果登录
  - LoginTypeW          # 微信登录
  - LoginTypeGoogle     # Google 登录
  - LoginTypeFacebook   # Facebook 登录
  - LoginTypeLine       # Line 登录
  - LoginTypeAuth       # 一键登录
  - LoginTypeZalo       # Zalo 登录
  - LoginTypeTikTok     # TikTok 登录
  - LoginTypeSnapChat   # SnapChat 登录

# ==================== 登录（配置对象方式） ====================
login_with_config:
  method_name: "[[RXSDK sharedSDK] loginWithConfig:complete:]"
  description: 使用 RXLoginConfig 配置对象登录（推荐方式）
  parameters:
    - name: config
      type: RXLoginConfig *
      required: true
      description: 登录配置对象
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 登录结果回调
  code_objc: |
    // ========== 瑞雪 SDK 登录（配置对象方式） ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    // ========== 游客登录 ==========
    RXLoginConfig *visitorConfig = [[RXLoginConfig alloc] init];
    visitorConfig.loginType = LoginTypeVisitor;  // 必填，登录类型
    
    [[RXSDK sharedSDK] loginWithConfig:visitorConfig complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"游客登录失败: %@", error.responesObject);
        } else {
            NSLog(@"游客登录成功: %@", response);
        }
    }];
    
    // ========== 账号密码登录 ==========
    RXLoginConfig *accountConfig = [[RXLoginConfig alloc] init];
    accountConfig.loginType = LoginTypeAccount;  // 必填
    accountConfig.username = @"user@example.com";  // 必填，用户名/手机号/邮箱
    accountConfig.password = @"password123";  // 必填，密码
    // accountConfig.signFields = @[@"nickname", @"avatar"];  // 可选，签名字段
    // accountConfig.migrateArgs = @"migrate_data";  // 可选，账号迁移参数
    
    [[RXSDK sharedSDK] loginWithConfig:accountConfig complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"账号密码登录失败: %@", error.responesObject);
        } else {
            NSLog(@"账号密码登录成功: %@", response);
        }
    }];
    
    // ========== 验证码登录 ==========
    RXLoginConfig *captchaConfig = [[RXLoginConfig alloc] init];
    captchaConfig.loginType = LoginTypeCapCode;  // 必填
    captchaConfig.username = @"13800138000";  // 必填，手机号或邮箱
    captchaConfig.captchaCode = @"123456";  // 必填，验证码
    
    [[RXSDK sharedSDK] loginWithConfig:captchaConfig complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"验证码登录失败: %@", error.responesObject);
        } else {
            NSLog(@"验证码登录成功: %@", response);
        }
    }];
    
    // ========== Apple 登录 ==========
    RXLoginConfig *appleConfig = [[RXLoginConfig alloc] init];
    appleConfig.loginType = LoginTypeApple;  // 必填
    
    [[RXSDK sharedSDK] loginWithConfig:appleConfig complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"Apple 登录失败: %@", error.responesObject);
        } else {
            NSLog(@"Apple 登录成功: %@", response);
        }
    }];
    
    // ========== 二次登录（使用 loginOpenId） ==========
    RXLoginConfig *secondConfig = [[RXLoginConfig alloc] init];
    secondConfig.loginType = LoginTypeApple;  // 必填，登录方式
    secondConfig.loginOpenId = @"上次登录返回的 login_openid";  // 必填，二次登录 openId
    
    [[RXSDK sharedSDK] loginWithConfig:secondConfig complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"二次登录失败: %@", error.responesObject);
        } else {
            NSLog(@"二次登录成功: %@", response);
        }
    }];
    
    // ========== Facebook 登录 ==========
    RXLoginConfig *fbConfig = [[RXLoginConfig alloc] init];
    fbConfig.loginType = LoginTypeFacebook;  // 必填
    fbConfig.permissions = @[@"public_profile", @"email"];  // 必填，权限数组
    
    [[RXSDK sharedSDK] loginWithConfig:fbConfig complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"Facebook 登录失败: %@", error.responesObject);
        } else {
            NSLog(@"Facebook 登录成功: %@", response);
        }
    }];

# ==================== 获取法务信息 ====================
get_legal_info:
  method_name: "[[RXSDK sharedSDK] getLegalInfo:]"
  description: 获取法务配置信息（用户协议、隐私政策等）
  parameters:
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 获取法务信息 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    [[RXSDK sharedSDK] getLegalInfo:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"获取法务信息失败: %@", error.responesObject);
        } else {
            // 解析法务条款
            NSDictionary *data = response[@"data"];
            NSString *userAgreement = data[@"user_agreement"];  // 用户协议
            NSString *privacyPolicy = data[@"privacy_policy"];  // 隐私政策
            NSString *thirdPartySDK = data[@"third_party_sdk"];  // 第三方 SDK
            
            NSLog(@"法务信息: %@", data);
        }
    }];

# ==================== 自定义请求 ====================
custom_request:
  method_name: "[[RXSDK sharedSDK] createRequestWithUrl:header:body:method:needLogin:complete:]"
  description: 自定义网络请求
  parameters:
    - name: url
      type: NSString *
      required: true
      description: 接口名
    - name: header
      type: NSMutableDictionary *
      required: false
      description: 请求头
    - name: body
      type: NSMutableDictionary *
      required: false
      description: 请求参数
    - name: method
      type: NSInteger
      required: true
      description: 请求类型（1 POST，2 GET）
    - name: needLogin
      type: BOOL
      required: true
      description: 是否需要登录态
    - name: complete
      type: RXSDKRequestComplete
      required: true
      description: 结果回调
  code_objc: |
    // ========== 瑞雪 SDK 自定义请求 ==========
    #import <RXSDK_Pure/RXSDK_Pure.h>
    
    NSString *url = @"/api/custom/endpoint";  // 必填，接口地址
    NSInteger method = 1;  // 必填，1=POST 2=GET
    BOOL needLogin = YES;  // 必填，是否需要登录态
    
    NSMutableDictionary *header = [NSMutableDictionary dictionary];
    header[@"Custom-Header"] = @"value";
    
    NSMutableDictionary *body = [NSMutableDictionary dictionary];
    body[@"param1"] = @"value1";
    body[@"param2"] = @"value2";
    
    [[RXSDK sharedSDK] createRequestWithUrl:url
                                     header:header
                                       body:body
                                     method:method
                                  needLogin:needLogin
                                   complete:^(NSDictionary *response, RX_CommonRequestError *error) {
        if (error) {
            NSLog(@"请求失败: %@", error.responesObject);
        } else {
            NSLog(@"请求成功: %@", response);
        }
    }];
