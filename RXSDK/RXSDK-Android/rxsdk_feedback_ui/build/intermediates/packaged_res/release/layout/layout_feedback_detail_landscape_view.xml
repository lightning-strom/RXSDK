<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    
    <LinearLayout
        android:layout_width="531dp"
        android:layout_height="@dimen/dp_310"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:gravity="center"
        android:background="@drawable/bg_mail_border_common">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:textColor="#ff3D3D3D"
                android:textSize="@dimen/sp_16"
                android:text="@string/feedback_detail_title"
                android:textStyle="bold"
                android:layout_centerInParent="true"/>

            <FrameLayout
                android:id="@+id/close"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_20"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:src="@drawable/ruixue_close_dialog"
                    android:layout_marginEnd="@dimen/dp_17"
                    android:rotationY="@integer/rotation"/>
            </FrameLayout>

        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_214"
            android:layout_marginStart="@dimen/dp_17"
            android:layout_marginEnd="@dimen/dp_17"
            android:paddingTop="@dimen/dp_11">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/user_feedback_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#ff323232"
                    android:textSize="11sp"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_marginEnd="@dimen/dp_8"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/user_recycler_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_marginEnd="@dimen/dp_8"/>

                <LinearLayout
                    android:id="@+id/recover_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_114"
                    android:orientation="vertical"
                    android:background="@drawable/bg_mail_recycle_border"
                    android:layout_marginTop="@dimen/dp_15"
                    android:paddingStart="@dimen/dp_8"
                    android:paddingEnd="@dimen/dp_8"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/feedback_gm_replay"
                        android:textColor="#ff323232"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/dp_6"/>

                    <TextView
                        android:id="@+id/gm_feedback_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#ff323232"
                        android:textSize="11sp"
                        android:layout_marginTop="@dimen/dp_8"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/gm_recycler_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_6" />

                    <LinearLayout
                        android:id="@+id/prop_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="@dimen/dp_8"
                        android:layout_marginBottom="@dimen/dp_16"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/feedback_gm_attach"
                            android:textColor="#ff323232"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/attach_recycler_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:minWidth="0dp"
                            android:layout_marginTop="@dimen/dp_6"/>

                    </LinearLayout>

                </LinearLayout>


            </LinearLayout>

        </ScrollView>

        <Button
            android:id="@+id/sure_btn"
            android:layout_width="@dimen/dp_132"
            android:layout_height="@dimen/dp_38"
            android:layout_weight="1"
            android:background="@drawable/shape_feedback_detail_submit"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_17"
            android:layout_marginBottom="@dimen/dp_13"
            android:visibility="gone"/>

    </LinearLayout>

</FrameLayout>