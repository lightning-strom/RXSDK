<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_40"
    android:background="#ffF7F7F7">

    <TextView
        android:id="@+id/feedback_time"
        android:layout_width="@dimen/dp_90"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_20"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#ff444444"
        android:textSize="12sp"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        android:textStyle="bold"
        android:text="09-13 19:32:12"/>

    <TextView
        android:id="@+id/feedback_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@id/feedback_time"
        android:layout_centerVertical="true"
        android:textStyle="bold"
        android:textColor="#ffDC6E6E"
        android:textSize="12sp"
        android:layout_marginStart="@dimen/dp_20"
        android:text="已处理"/>

    <TextView
        android:id="@+id/feedback_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:textColor="#ff444444"
        android:textSize="12sp"
        android:maxLines="1"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@id/feedback_state"
        android:textStyle="bold"
        android:layout_alignParentStart="true"
        android:text="打发士大夫是打发士大夫是发多少发收到发生的发生的"/>

    <View
        android:id="@+id/devided_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:background="#ffEEEEEE"
        android:layout_alignParentBottom="true"/>

</RelativeLayout>