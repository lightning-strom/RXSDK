        <ImageView
            android:id="@+id/iv_title"
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_24"
            android:layout_gravity="center_vertical"
            android:scaleType="fitCenter"
            android:visibility="visible" />

        <TextView
