    <style name="NoBackGroundDialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:scrollHorizontally">true</item>
    </style>


    <style name="transparent_activity">
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
    </style>

      <!--    <style name="Theme.AppCompat.NoActionBar.Transparent" parent="@style/Theme.AppCompat.NoActionBar">-->
    <!--        <item name="android:windowNoTitle">true</item>-->
    <!--        <item name="android:windowBackground">@android:color/transparent</item>-->
    <!--        <item name="android:windowIsTranslucent">true</item>-->
    <!--    </style>-->
    <style name="Slide">
        <!-- 背景透明 -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- 浮于Activity之上 -->
        <item name="android:windowIsFloating">true</item>
        <!-- 边框 -->
        <item name="android:windowFrame">@null</item>
        <!-- Dialog以外的区域模糊效果 -->
        <item name="android:backgroundDimEnabled">true</item>
        <!-- 无标题 -->
        <item name="android:windowNoTitle">true</item>
        <!-- 半透明 -->
        <item name="android:windowIsTranslucent">true</item>
        <!-- Dialog进入及退出动画 -->
        <item name="android:windowAnimationStyle">@style/Animation.Dialog.Slide</item>
    </style>

    <style name="Dialog_None_Ani" parent="Slide">
        <!-- Dialog进入及退出动画 -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Animation.Dialog.Slide" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>

    <!-- Dialog自下而上动画 -->

    <!-- 淡入淡出缩放动画 -->
    <style name="ScaleFade">
        <!-- 背景透明 -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- 浮于Activity之上 -->
        <item name="android:windowIsFloating">true</item>
        <!-- 边框 -->
        <item name="android:windowFrame">@null</item>
        <!-- Dialog以外的区域模糊效果 -->
        <item name="android:backgroundDimEnabled">true</item>
        <!-- 无标题 -->
        <item name="android:windowNoTitle">true</item>
        <!-- 半透明 -->
        <item name="android:windowIsTranslucent">true</item>
        <!-- Dialog进入及退出动画 -->
        <item name="android:windowAnimationStyle">@style/Animation.Dialog.ScaleFade</item>
    </style>

    <style name="Animation.Dialog.ScaleFade" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/scale_fade_in</item>
        <item name="android:windowExitAnimation">@anim/scale_fade_out</item>
    </style>
    <!--淡入淡出缩放动画 -->

    <!--淡入淡出动画-->
    <style name="AlphaFade">
        <item name="android:windowShowAnimation">@anim/alpha_fade_in</item>
        <item name="android:windowHideAnimation">@anim/alpha_fade_out</item>
    </style>

