{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "gradle": { "enabled": true },
  "packageRules": [
    {
      "matchManagers": ["gradle"],
      "matchPackagePrefixes": ["com.google.firebase"],
      "groupName": "Firebase"
    },
    {
      "matchManagers": ["gradle"],
      "matchPackagePrefixes": ["com.google.android.gms"],
      "groupName": "Google Play Services"
    },
    {
      "matchPackagePrefixes": ["com.huawei.hms"],
      "groupName": "Huawei HMS",
      "enabled": false
    },
    {
      "matchPackagePrefixes": ["com.hihonor."],
      "groupName": "Honor",
      "enabled": false
    },
    {
      "matchPackagePrefixes": ["com.xiaomi.", "com.mi."],
      "groupName": "Xiaomi",
      "enabled": false
    },
    {
      "matchPackagePrefixes": ["com.vivo.", "com.heytap."],
      "groupName": "VIVO/OPPO",
      "enabled": false
    }
  ],
  "ignoreDeps": [
    "com.tencent.mm.opensdk:wechat-sdk-android",
    "com.alipay.sdk:alipaysdk-android"
  ]
}
