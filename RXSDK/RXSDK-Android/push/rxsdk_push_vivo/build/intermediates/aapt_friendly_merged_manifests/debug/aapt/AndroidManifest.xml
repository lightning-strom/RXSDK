<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ruixue.push.vivo" >

    <uses-sdk android:minSdkVersion="21" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <meta-data
            android:name="RX_PUSH_VIVO"
            android:value="com.ruixue.push.vivo.VivoPushProvider" />
        <meta-data
            android:name="com.vivo.push.api_key"
            android:value="dollar_openBracket_VIVO_API_KEY_closeBracket" />
        <meta-data
            android:name="com.vivo.push.app_id"
            android:value="dollar_openBracket_VIVO_APP_ID_closeBracket" />

        <!-- push应用定义消息receiver声明 -->
        <receiver
            android:name="com.ruixue.push.vivo.VivoPushReceiver"
            android:exported="true" >
            <intent-filter>

                <!-- 接收push消息 -->
                <action android:name="com.vivo.pushclient.action.RECEIVE" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.vivo.push.sdk.service.CommandClientService"
            android:exported="true"
            android:permission="com.push.permission.UPSTAGESERVICE" />
    </application>

</manifest>