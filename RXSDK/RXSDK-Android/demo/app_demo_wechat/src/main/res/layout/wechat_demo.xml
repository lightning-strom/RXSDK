<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="微信分享 api测试：" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="shareScene:" />

            <RadioGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/target_scene_session"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:onClick="onRadioButtonClicked"
                    android:text="会话" />

                <RadioButton
                    android:id="@+id/target_scene_timeline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="onRadioButtonClicked"
                    android:text="朋友圈" />

                <RadioButton
                    android:id="@+id/target_scene_favorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="onRadioButtonClicked"
                    android:text="收藏" />

                <RadioButton
                    android:id="@+id/target_scene_select"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="onRadioButtonClicked"
                    android:text="-1" />

            </RadioGroup>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="#cfcfcf"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/tv_share_file_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Share file Uri."
                android:minLines="2"
                android:textSize="15sp" />

            <Button
                android:id="@+id/bt_choose_share_file"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:onClick="onClickChooseFile"
                android:text="Choose Share File"
                android:textAllCaps="false"
                android:textSize="15sp" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_func"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="分享埋点 func:" />

            <EditText
                android:id="@+id/et_share_func"
                style="@style/EditTextStyle.Alignment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="match" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cb_qr_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="url:" />

            <EditText
                android:id="@+id/et_link"
                style="@style/EditTextStyle.Alignment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="请输入分享链接"
                android:singleLine="true" />


        </LinearLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="微信sdk api测试：" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/et_gh_username"
                style="@style/EditTextStyle.Alignment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="输入小程序原始 id" />

            <Button
                android:id="@+id/open_miniprogram"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="打开小程序" />
        </LinearLayout>

        <com.nex3z.flowlayout.FlowLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/send_mini"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="分享小程序" />

            <Button
                android:id="@+id/open_wx"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="打开微信" />

            <Button
                android:id="@+id/wx_business"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="微信红包" />

            <Button
                android:id="@+id/send_text"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="分享文本" />

            <Button
                android:id="@+id/send_img_net"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="分享HTTP图片" />

            <Button
                android:id="@+id/send_img_local"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="分享本地图片" />


            <Button
                android:id="@+id/send_webpage"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="分享icon+link网页" />

            <Button
                android:id="@+id/send_icon_web"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="分享app图标网页" />


            <Button
                android:id="@+id/send_video"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="分享视频" />

            <Button
                android:id="@+id/send_subscribe_msg"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="发送订阅" />


            <Button
                android:id="@+id/get_token"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="获取微信访问 token" />


            <Button
                android:id="@+id/unregister"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="从微信反注册" />

            <Button
                android:id="@+id/download_img"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="下载图片" />


        </com.nex3z.flowlayout.FlowLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="系统原生 api 分享：" />

        <com.nex3z.flowlayout.FlowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/sys_send_text"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:onClick="onClickSystemShare"
                android:text="分享文本" />

            <Button
                android:id="@+id/sys_send_file"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:onClick="onClickSystemShare"
                android:text="分享文件" />

            <Button
                android:id="@+id/sys_send_audio"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:onClick="onClickSystemShare"
                android:text="分享音频" />

            <Button
                android:id="@+id/sys_send_video"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:onClick="onClickSystemShare"
                android:text="分享视频" />


            <Button
                android:id="@+id/sys_send_image"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:onClick="onClickSystemShare"
                android:text="分享图片" />

            <Button
                android:id="@+id/sys_send_net_image"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:onClick="onClickSystemShare"
                android:text="分享http 图片" />


        </com.nex3z.flowlayout.FlowLayout>

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:focusable="true"
            android:text="this is log text"
            android:textIsSelectable="true" />


    </LinearLayout>

</ScrollView>