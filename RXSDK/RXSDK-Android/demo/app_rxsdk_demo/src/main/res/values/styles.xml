<resources>

    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/rx_primary</item>
        <item name="colorPrimaryDark">@color/rx_primary_dark</item>
        <item name="colorAccent">@color/rx_secondary</item>
        <item name="android:windowBackground">@color/rx_bg</item>
        <item name="android:statusBarColor">@color/rx_primary_dark</item>
    </style>

    <!-- ========== 按钮样式 ========== -->

    <!-- 基础按钮样式 -->
    <style name="RxButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/rx_text_inverse</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:elevation">1dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- FlowLayout 按钮样式（固定宽度，可显示4-5个中文字） -->
    <style name="RxButton.Flow">
        <item name="android:layout_width">88dp</item>
        <item name="android:layout_weight">0</item>
    </style>

    <!-- 主要按钮 - 蓝色 -->
    <style name="RxButton.Primary">
        <item name="android:background">@drawable/rx_btn_primary</item>
    </style>

    <style name="RxButton.Primary.Flow">
        <item name="android:layout_width">88dp</item>
        <item name="android:layout_weight">0</item>
    </style>

    <!-- 登录相关 - 蓝色 -->
    <style name="RxButton.Login">
        <item name="android:background">@drawable/rx_btn_login</item>
    </style>

    <style name="RxButton.Login.Flow">
        <item name="android:layout_width">88dp</item>
        <item name="android:layout_weight">0</item>
    </style>

    <!-- 用户相关 - 紫色 -->
    <style name="RxButton.User">
        <item name="android:background">@drawable/rx_btn_user</item>
    </style>

    <style name="RxButton.User.Flow">
        <item name="android:layout_width">88dp</item>
        <item name="android:layout_weight">0</item>
    </style>

    <!-- 支付相关 - 绿色 -->
    <style name="RxButton.Pay">
        <item name="android:background">@drawable/rx_btn_pay</item>
    </style>

    <style name="RxButton.Pay.Flow">
        <item name="android:layout_width">88dp</item>
        <item name="android:layout_weight">0</item>
    </style>

    <!-- 分享相关 - 橙色 -->
    <style name="RxButton.Share">
        <item name="android:background">@drawable/rx_btn_share</item>
    </style>

    <style name="RxButton.Share.Flow">
        <item name="android:layout_width">88dp</item>
        <item name="android:layout_weight">0</item>
    </style>

    <!-- 法务相关 - 红色 -->
    <style name="RxButton.Legal">
        <item name="android:background">@drawable/rx_btn_legal</item>
    </style>

    <style name="RxButton.Legal.Flow">
        <item name="android:layout_width">88dp</item>
        <item name="android:layout_weight">0</item>
    </style>

    <!-- 工具相关 - 灰色 -->
    <style name="RxButton.Tools">
        <item name="android:background">@drawable/rx_btn_tools</item>
    </style>

    <style name="RxButton.Tools.Flow">
        <item name="android:layout_width">88dp</item>
        <item name="android:layout_weight">0</item>
    </style>

    <!-- 版本相关 - 青色 -->
    <style name="RxButton.Version">
        <item name="android:background">@drawable/rx_btn_version</item>
    </style>

    <style name="RxButton.Version.Flow">
        <item name="android:layout_width">88dp</item>
        <item name="android:layout_weight">0</item>
    </style>

    <!-- 测试相关 - 靛蓝色 -->
    <style name="RxButton.Test">
        <item name="android:background">@drawable/rx_btn_test</item>
    </style>

    <style name="RxButton.Test.Flow">
        <item name="android:layout_width">88dp</item>
        <item name="android:layout_weight">0</item>
    </style>

    <!-- 危险操作 - 红色 -->
    <style name="RxButton.Danger">
        <item name="android:background">@drawable/rx_btn_danger</item>
    </style>

    <style name="RxButton.Danger.Flow">
        <item name="android:layout_width">88dp</item>
        <item name="android:layout_weight">0</item>
    </style>

    <!-- 次要按钮 - 边框样式 -->
    <style name="RxButton.Outline">
        <item name="android:background">@drawable/rx_btn_outline</item>
        <item name="android:textColor">@color/rx_primary</item>
    </style>

    <!-- ========== 卡片样式 ========== -->

    <style name="RxCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/rx_card_bg</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- ========== 标题样式 ========== -->

    <style name="RxSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/rx_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="RxSectionSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/rx_text_tertiary</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- ========== 兼容旧代码 ========== -->

    <style name="MyEditText" parent="Theme.AppCompat.Light">
        <item name="colorControlActivated">@color/rx_primary</item>
        <item name="colorControlNormal">@color/rx_primary</item>
    </style>

    <style name="EditTextStyle.Alignment" parent="Widget.AppCompat.EditText">
        <item name="android:textSize">13sp</item>
        <item name="android:paddingHorizontal">8dp</item>
    </style>

    <style name="custom_dialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>

    <style name="ThemeTranslucent" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <style name="AppThemeAct" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="TranslucentAct" parent="AppTheme">
        <item name="android:windowBackground">#80000000</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
    </style>
</resources>
