<?xml version="1.0" encoding="utf-8"?>
<!-- 初始化 功能卡片 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/RxCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:tag="collapsible">

        <TextView
            style="@style/RxSectionTitle"
            android:text="⚡ 初始化 · 配置" />

        <com.nex3z.flowlayout.FlowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flChildSpacing="4dp"
            app:flRowSpacing="4dp">

            <Button android:id="@+id/init" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="SDK初始化" />
            <Button android:id="@+id/switch_init_config" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="切换初始化" />
            <Button android:id="@+id/current_init_config" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="当前配置" />
            <Button android:id="@+id/sdk_version" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="SDK版本" />
            <Button android:id="@+id/init_status" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="初始化状态" />
            <Button android:id="@+id/init_params" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="初始化参数" />
            <Button android:id="@+id/sdk_json_config" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="SDK配置" />
            <Button android:id="@+id/btn_switch_lang" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="切换语言" />
            <Button android:id="@+id/current_lang" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="当前语言" />

        </com.nex3z.flowlayout.FlowLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <Button android:id="@+id/lang_zh" android:layout_width="0dp" android:layout_height="0dp" android:onClick="onClick" />
            <Button android:id="@+id/lang_en" android:layout_width="0dp" android:layout_height="0dp" android:onClick="onClick" />
            <Button android:id="@+id/lang_ja" android:layout_width="0dp" android:layout_height="0dp" android:onClick="onClick" />
            <Button android:id="@+id/lang_traditional_chinese" android:layout_width="0dp" android:layout_height="0dp" android:onClick="onClick" />
            <Button android:id="@+id/lang_philippines" android:layout_width="0dp" android:layout_height="0dp" android:onClick="onClick" />
            <Button android:id="@+id/lang_thai" android:layout_width="0dp" android:layout_height="0dp" android:onClick="onClick" />
            <Button android:id="@+id/lang_vietnamese" android:layout_width="0dp" android:layout_height="0dp" android:onClick="onClick" />
            <Button android:id="@+id/lang_indonesian" android:layout_width="0dp" android:layout_height="0dp" android:onClick="onClick" />
            <Button android:id="@+id/lang_arab" android:layout_width="0dp" android:layout_height="0dp" android:onClick="onClick" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
