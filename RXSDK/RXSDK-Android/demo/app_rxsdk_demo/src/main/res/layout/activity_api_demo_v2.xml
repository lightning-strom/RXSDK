<?xml version="1.0" encoding="utf-8"?>
<!-- RXSDK API V2 演示界面 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rx_bg"
    android:orientation="vertical">

    <!-- ==================== 顶部导航栏 ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/rx_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <!-- 返回按钮 -->
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="返回"
            android:padding="4dp"
            android:src="@drawable/rx_ic_back" />

        <!-- 标题 -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="🚀 RXSDK API V2"
            android:textColor="@color/rx_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 清空日志按钮 -->
        <TextView
            android:id="@+id/btn_clear_log"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="🗑️ 清空"
            android:textColor="@color/rx_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ==================== 按钮面板区域 ==================== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <com.ruixue.demo.widget.DynamicButtonPanel
            android:id="@+id/button_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp" />

    </ScrollView>

    <!-- ==================== 吸底日志区域 ==================== -->
    <com.ruixue.demo.widget.ResizableLogPanel
        android:id="@+id/log_panel"
        android:layout_width="match_parent"
        android:layout_height="180dp" />

</LinearLayout>
