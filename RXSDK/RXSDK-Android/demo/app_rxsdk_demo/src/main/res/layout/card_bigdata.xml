<?xml version="1.0" encoding="utf-8"?>
<!-- 大数据·归因 功能卡片 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/RxCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:tag="collapsed">

        <TextView
            style="@style/RxSectionTitle"
            android:text="📊 大数据 · 归因" />

        <com.nex3z.flowlayout.FlowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flChildSpacing="4dp"
            app:flRowSpacing="4dp">

            <Button android:id="@+id/track_report" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="大数据" />
            <Button android:id="@+id/buss_report" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="业务上报" />
            <Button android:id="@+id/buss_api" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="业务API" />
            <Button android:id="@+id/gdt_report" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="广点通" />
            <Button android:id="@+id/ad_register" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="广告注册" />
            <Button android:id="@+id/ad_pay" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="广告付费" />
            <Button android:id="@+id/sync_event_attrs" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="同步配置" />
            <Button android:id="@+id/stop_user_action" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="停止UA追踪" />

        </com.nex3z.flowlayout.FlowLayout>
    </LinearLayout>
</LinearLayout>
