<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.ruixue.demo.LoginActivity">

    <ImageView
        android:id="@+id/img_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hall" />

    <TextView
        android:id="@+id/tv_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginStart="15dp"
        android:layout_marginTop="35dp"
        android:text="v1.1.0"
        android:textColor="@color/white"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/dp_35"
        android:layout_marginEnd="20dp"
        android:orientation="vertical">


        <Button
            android:id="@+id/btn_rxshare"
            android:layout_width="124dp"
            android:layout_height="@dimen/dp_38"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="15dp"
            android:background="@drawable/selec_btn_bg"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:text="分享"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_rxusercenter"
            android:layout_width="124dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"

            android:background="@drawable/selec_btn_bg"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:text="用户中心"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            tools:ignore="HardcodedText,UsingOnClickInXml" />

        <Button
            android:id="@+id/btn_rxhelper"
            android:layout_width="124dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"

            android:layout_marginTop="15dp"
            android:background="@drawable/selec_btn_bg"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:text="帮助中心"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            tools:ignore="HardcodedText,UsingOnClickInXml" />

        <Button
            android:id="@+id/btn_rxpay"
            android:layout_width="124dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"

            android:layout_marginTop="15dp"
            android:background="@drawable/selec_btn_bg"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:text="支付"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            tools:ignore="HardcodedText,UsingOnClickInXml" />

        <Button
            android:id="@+id/btn_rxservices"
            android:layout_width="124dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="15dp"
            android:background="@drawable/selec_btn_bg"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:text="客服"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            android:visibility="gone"
            tools:ignore="HardcodedText,UsingOnClickInXml" />

        <Button
            android:id="@+id/btn_deregister"
            android:layout_width="124dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="15dp"
            android:background="@drawable/selec_btn_bg"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:text="注销"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            android:visibility="gone"
            tools:ignore="HardcodedText,UsingOnClickInXml" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/dp_20"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_rxret_login"
            android:layout_width="124dp"
            android:layout_height="@dimen/dp_38"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/selec_btn_bg"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:text="返回登录"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            tools:ignore="HardcodedText,UsingOnClickInXml" />


        <Button
            android:id="@+id/btn_rxopenconfig"
            android:layout_width="124dp"
            android:layout_height="@dimen/dp_38"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="15dp"
            android:background="@drawable/selec_btn_bg"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:text="返回设置"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            tools:ignore="HardcodedText,UsingOnClickInXml" />

        <!--        <Button-->
        <!--            android:layout_width="wrap_content"-->
        <!--            android:layout_height="@dimen/dp_38"-->
        <!--            android:layout_gravity="center_horizontal"-->
        <!--            android:background="@drawable/selec_btn_bg"-->
        <!--            android:layout_marginStart="20dp"-->
        <!--            android:gravity="center"-->
        <!--            android:onClick="onClick"-->
        <!--            android:stateListAnimator="@null"-->
        <!--            android:text="瑞雪登录"-->
        <!--            android:textColor="@color/white"-->
        <!--            android:textSize="@dimen/sp_16" />-->
    </LinearLayout>

</RelativeLayout>