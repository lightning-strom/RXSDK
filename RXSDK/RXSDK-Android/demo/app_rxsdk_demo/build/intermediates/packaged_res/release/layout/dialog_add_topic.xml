<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/dialog_topic_background"
    android:orientation="vertical"
    android:paddingTop="18dp">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="18dp"
        android:text="请输入信息"
        android:textAlignment="center"
        android:textColor="@color/rx_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_dialog_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="18dp"
        android:text="请填写以下测试参数"
        android:textAlignment="center"
        android:textColor="@color/rx_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:paddingHorizontal="18dp">

        <TextView
            android:id="@+id/tv_label_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="内容 1"
            android:textColor="@color/rx_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/ed_1"
            style="@style/EditTextStyle.Alignment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/rx_input_bg"
            android:hint="请输入内容 1"
            android:imeOptions="flagNoExtractUi"
            android:maxLines="1"
            android:minHeight="44dp"
            android:paddingHorizontal="12dp"
            android:textColor="@color/rx_text_primary"
            android:textColorHint="@color/rx_text_tertiary"
            android:textSize="15sp"
            android:theme="@style/MyEditText" />

        <TextView
            android:id="@+id/tv_label_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="内容 2"
            android:textColor="@color/rx_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/ed_2"
            style="@style/EditTextStyle.Alignment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/rx_input_bg"
            android:hint="请输入内容 2"
            android:imeOptions="flagNoExtractUi"
            android:maxLines="1"
            android:minHeight="44dp"
            android:paddingHorizontal="12dp"
            android:textColor="@color/rx_text_primary"
            android:textColorHint="@color/rx_text_tertiary"
            android:textSize="15sp"
            android:theme="@style/MyEditText" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="@color/rx_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="取消"
            android:textColor="@color/rx_text_secondary"
            android:textSize="16sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/rx_border" />

        <TextView
            android:id="@+id/tv_confirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="确定"
            android:textColor="@color/rx_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>