<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_register_push"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_button"

            android:paddingLeft="@dimen/set_padding"
            android:paddingRight="@dimen/set_padding"
            android:text="注册推送"
            android:textSize="@dimen/text_btn_size" />

        <Button
            android:id="@+id/btn_set_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/margin_button"

            android:paddingLeft="@dimen/set_padding"
            android:paddingRight="@dimen/set_padding"
            android:text="设置标签"
            android:textSize="@dimen/text_btn_size" />

        <Button
            android:id="@+id/btn_bind_alias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_button"

            android:paddingLeft="@dimen/set_padding"
            android:paddingRight="@dimen/set_padding"
            android:text="绑定别名"
            android:textSize="@dimen/text_btn_size" />

        <Button
            android:id="@+id/btn_turn_on"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_button"

            android:paddingLeft="@dimen/set_padding"
            android:paddingRight="@dimen/set_padding"
            android:text="开"
            android:textSize="@dimen/text_btn_size" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_unregister_push"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_button"

            android:paddingLeft="@dimen/set_padding"
            android:paddingRight="@dimen/set_padding"
            android:text="取消推送"
            android:textSize="@dimen/text_btn_size" />

        <Button
            android:id="@+id/btn_unset_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_button"

            android:paddingLeft="@dimen/set_padding"
            android:paddingRight="@dimen/set_padding"
            android:text="删除标签"
            android:textSize="@dimen/text_btn_size" />

        <Button
            android:id="@+id/btn_unbind_alias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_button"
            android:paddingLeft="@dimen/set_padding"
            android:paddingRight="@dimen/set_padding"
            android:text="删除别名"
            android:textSize="@dimen/text_btn_size" />

        <Button
            android:id="@+id/btn_turn_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_button"

            android:paddingLeft="@dimen/set_padding"
            android:paddingRight="@dimen/set_padding"
            android:text="关"
            android:textSize="@dimen/text_btn_size" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_get_token"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_button"

            android:paddingLeft="@dimen/set_padding"
            android:paddingRight="@dimen/set_padding"
            android:text="Token"
            android:textSize="@dimen/text_btn_size" />

        <Button
            android:id="@+id/btn_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_button"

            android:paddingLeft="@dimen/set_padding"
            android:paddingRight="@dimen/set_padding"
            android:text="2"
            android:textSize="@dimen/text_btn_size" />

        <Button
            android:id="@+id/btn_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_button"
            android:paddingLeft="@dimen/set_padding"
            android:paddingRight="@dimen/set_padding"
            android:text="3"
            android:textSize="@dimen/text_btn_size" />

        <Button
            android:id="@+id/btn_intent_uri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_button"

            android:paddingLeft="@dimen/set_padding"
            android:paddingRight="@dimen/set_padding"
            android:text="4"
            android:textSize="@dimen/text_btn_size" />
    </LinearLayout>

    <include
        layout="@layout/include_log_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>