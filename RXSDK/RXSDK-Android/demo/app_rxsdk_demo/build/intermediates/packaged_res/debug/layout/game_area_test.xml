<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                style="@style/RxCard"
                android:orientation="vertical">

                <TextView
                    style="@style/RxSectionTitle"
                    android:text="区服测试台" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="在二级页内完成区服、角色的参数配置、操作测试和结构化结果查看。"
                    android:textColor="@color/rx_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                style="@style/RxCard"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:tag="collapsible">

                    <TextView
                        style="@style/RxSectionTitle"
                        android:text="测试参数" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="默认已填充示例值，可直接测试，也可以替换成实际区服/角色参数。"
                        android:textColor="@color/rx_text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:tag="collapsible">

                        <TextView
                            style="@style/RxSectionTitle"
                            android:text="区服参数"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="区服 ID" />

                        <EditText
                            android:id="@+id/et_game_area_id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1001" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="区服名称" />

                        <EditText
                            android:id="@+id/et_game_area_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="New Area" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="区服状态" />

                                <EditText
                                    android:id="@+id/et_game_area_status"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="active" />
                            </LinearLayout>

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="1dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="区服类型" />

                                <EditText
                                    android:id="@+id/et_game_area_type"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="PVE" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="公会" />

                                <EditText
                                    android:id="@+id/et_game_area_guild"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Mighty Warriors" />
                            </LinearLayout>

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="1dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="战力" />

                                <EditText
                                    android:id="@+id/et_game_area_power"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:text="5000" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:tag="collapsed">

                        <TextView
                            style="@style/RxSectionTitle"
                            android:text="角色参数"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="角色 ID" />

                        <EditText
                            android:id="@+id/et_game_character_id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="char12345" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="角色名称" />

                        <EditText
                            android:id="@+id/et_game_character_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Hero123" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="等级" />

                                <EditText
                                    android:id="@+id/et_game_character_level"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="50" />
                            </LinearLayout>

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="1dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="CP用户 ID" />

                                <EditText
                                    android:id="@+id/et_game_cp_user_id"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="user789" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="阵营" />

                                <EditText
                                    android:id="@+id/et_game_character_faction"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Alliance" />
                            </LinearLayout>

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="1dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="职业" />

                                <EditText
                                    android:id="@+id/et_game_character_profession"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Mage" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="角色状态" />

                                <EditText
                                    android:id="@+id/et_game_character_status"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="active" />
                            </LinearLayout>

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="1dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="角色类型" />

                                <EditText
                                    android:id="@+id/et_game_character_type"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Standard" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="VIP等级" />

                        <EditText
                            android:id="@+id/et_game_character_vip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="VIP5" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/RxCard"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:tag="collapsed">

                    <TextView
                        style="@style/RxSectionTitle"
                        android:text="快捷测试流" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="按预设顺序自动调用区服或角色接口，快速完成一轮联调验证。"
                        android:textColor="@color/rx_text_secondary"
                        android:textSize="12sp" />

                    <com.nex3z.flowlayout.FlowLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:flChildSpacing="4dp"
                        app:flRowSpacing="4dp">

                        <Button android:id="@+id/game_quick_area_flow" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="区服测试流" />
                        <Button android:id="@+id/game_quick_character_flow" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="角色测试流" />
                    </com.nex3z.flowlayout.FlowLayout>
                </LinearLayout>
            </LinearLayout>

            <include layout="@layout/include_game_area_buttons" />

            <LinearLayout
                style="@style/RxCard"
                android:orientation="vertical">

                <TextView
                    style="@style/RxSectionTitle"
                    android:text="结果展示" />

                <TextView
                    android:id="@+id/tv_game_result_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="最近结果"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_game_result_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="尚未执行操作"
                    android:textColor="@color/rx_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="区服/角色列表结果支持点击卡片，一键回填上方测试参数。"
                    android:textColor="@color/rx_text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/ll_game_result_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tv_game_flow_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="快捷测试流状态会显示在这里"
                    android:textColor="@color/rx_text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_clear_game_result"
                    style="@style/RxButton.Tools.Flow"
                    android:layout_marginTop="12dp"
                    android:onClick="onClick"
                    android:text="清空结果" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="原始 JSON 日志"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/rx_input_bg"
                    android:minHeight="120dp"
                    android:padding="10dp"
                    android:text="尚未执行操作"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
