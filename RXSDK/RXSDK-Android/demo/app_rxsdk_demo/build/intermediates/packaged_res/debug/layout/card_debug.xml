<?xml version="1.0" encoding="utf-8"?>
<!-- 其他·调试 功能卡片 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/RxCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:tag="collapsed">

        <TextView
            style="@style/RxSectionTitle"
            android:text="🔧 其他 · 调试" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="工具操作"
            android:textColor="@color/rx_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.nex3z.flowlayout.FlowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:flChildSpacing="4dp"
            app:flRowSpacing="4dp">

            <!-- 工具 -->
            <Button android:id="@+id/btn_floating_log" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="📋日志" />
            <Button android:id="@+id/deviceid" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="设备ID" />
            <Button android:id="@+id/system_info" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="系统信息" />
            <Button android:id="@+id/copy_log" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="复制日志" />
            <Button android:id="@+id/read_clipboard" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="剪贴板" />
            <Button android:id="@+id/restart_app" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="重启应用" />
            <Button android:id="@+id/cleanup_app" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="清除缓存" />
            <Button android:id="@+id/apk_download" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="下载APK" />
            <Button android:id="@+id/apk_install" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="安装APK" />
            <Button android:id="@+id/test_ip" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="测试IP" />

        </com.nex3z.flowlayout.FlowLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="接口快测"
            android:textColor="@color/rx_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.nex3z.flowlayout.FlowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:flChildSpacing="4dp"
            app:flRowSpacing="4dp">

            <!-- 功能 -->
            <Button android:id="@+id/open_mini" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="小程序" />
            <Button android:id="@+id/sync_accounts" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="同步账号" />
            <Button android:id="@+id/search_game_account" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="搜索角色" />
            <Button android:id="@+id/appstore" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="应用商店" />

            <!-- 测试 -->
            <Button android:id="@+id/send_notification" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="发送通知" />
            <Button android:id="@+id/test3" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="账密测试" />
            <Button android:id="@+id/test_socket" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="Socket" />
            <Button android:id="@+id/ossupload" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="OSS上传" />
            <Button android:id="@+id/quickphone_tx" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="腾讯一键登录" />

            <!-- 配置 -->
            <Button android:id="@+id/login_config" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="登录配置" />
            <Button android:id="@+id/pwd_1" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="密码-默认" />
            <Button android:id="@+id/pwd_2" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="密码-中等" />
            <Button android:id="@+id/pwd_3" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="密码-强" />
            <Button android:id="@+id/btn_contacts" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="通讯录" />

            <!-- API：反馈 -->
            <Button android:id="@+id/feedback_list" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="反馈类目(API)" />
            <Button android:id="@+id/feedback_create" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="创建反馈(API)" />
            <Button android:id="@+id/feedback_update" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="评价反馈(API)" />

            <!-- API：客服 -->
            <Button android:id="@+id/service_unread_count" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="客服未读" />
            <Button android:id="@+id/clear_service_unread" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="清除未读" />

            <!-- API：其他 -->
            <Button android:id="@+id/proxy_test" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="代理检测" />
            <Button android:id="@+id/enable_sensitive" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="启用敏感信息" />

        </com.nex3z.flowlayout.FlowLayout>

        <!-- 版本 / 法务（从原「版本·其他」卡片合并过来） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="版本 · 法务"
            android:textColor="@color/rx_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.nex3z.flowlayout.FlowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:flChildSpacing="4dp"
            app:flRowSpacing="4dp">

            <!-- 法务 -->
            <Button android:id="@+id/policy1" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="用户协议" />
            <Button android:id="@+id/policyh5" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="协议H5" />
            <Button android:id="@+id/login_limit" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="实名查询" />

            <!-- 版本 -->
            <Button android:id="@+id/checkversion" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="大厅版本" />
            <Button android:id="@+id/checkgame" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="游戏版本" />
            <Button android:id="@+id/checkactivity" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="活动版本" />
            <Button android:id="@+id/check_new_version" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="检查更新" />

        </com.nex3z.flowlayout.FlowLayout>

        <!-- 公告（带输入的 API 快测） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/limit_count"
                android:layout_width="60dp"
                android:layout_height="32dp"
                android:background="@drawable/rx_input_bg"
                android:hint="数量"
                android:inputType="number"
                android:paddingHorizontal="8dp"
                android:textSize="12sp" />

            <Button
                android:id="@+id/get_announce"
                style="@style/RxButton.Tools"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:onClick="onClick"
                android:text="获取公告" />

            <TextView
                android:id="@+id/announce_data"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/rx_text_tertiary"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="⚡ 快捷测试"
            android:textColor="@color/rx_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.ruixue.demo.widget.DynamicButtonPanel
            android:id="@+id/dynamic_button_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />
    </LinearLayout>
</LinearLayout>
