<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                style="@style/RxCard"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RxSectionTitle"
                        android:text="社交测试台" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="在二级页内完成好友、关系、排行榜、LBS 的参数配置、操作测试和结果查看。"
                        android:textColor="@color/rx_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/RxCard"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:tag="collapsible">

                    <TextView
                        style="@style/RxSectionTitle"
                        android:text="测试参数" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="默认已填充示例值，可直接测试，也可替换成真实账号参数。"
                        android:textColor="@color/rx_text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:tag="collapsible">

                        <TextView
                            style="@style/RxSectionTitle"
                            android:text="通用参数"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="目标 openid" />

                        <EditText
                            android:id="@+id/et_social_target_openid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="输入目标 openid"
                            android:text="rxuNZP3GnkxYVXMf2xW6UZEKdg0z7wLm" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="查询 openid" />

                        <EditText
                            android:id="@+id/et_social_query_openid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="为空时默认使用目标 openid"
                            android:text="rxuNZP3GnkxYVXMf2xW6UZEKdg0z7wLm" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="用户备注" />

                        <EditText
                            android:id="@+id/et_social_user_remark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="例如：demo_user_remark"
                            android:text="demo_user_remark" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:tag="collapsed">

                        <TextView
                            style="@style/RxSectionTitle"
                            android:text="好友 / 关系参数"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="好友备注" />

                        <EditText
                            android:id="@+id/et_social_friend_remark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="例如：demo_friend_remark"
                            android:text="demo_friend_remark" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="关系 key" />

                        <EditText
                            android:id="@+id/et_social_relation_key"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="例如：test"
                            android:text="test" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="关系备注" />

                        <EditText
                            android:id="@+id/et_social_relation_remark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="例如：test_relation_remark"
                            android:text="test_relation_remark" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:tag="collapsed">

                        <TextView
                            style="@style/RxSectionTitle"
                            android:text="排行榜参数"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="排行榜 ID" />

                        <EditText
                            android:id="@+id/et_social_rank_id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="例如：2023_100_1680_weekly"
                            android:text="2023_100_1680_weekly" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="分数" />

                                <EditText
                                    android:id="@+id/et_social_score"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:text="66" />
                            </LinearLayout>

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="1dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="起始排名" />

                                <EditText
                                    android:id="@+id/et_social_rank_start"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:text="1" />
                            </LinearLayout>

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="1dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="结束排名" />

                                <EditText
                                    android:id="@+id/et_social_rank_end"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:text="20" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:tag="collapsed">

                        <TextView
                            style="@style/RxSectionTitle"
                            android:text="LBS 参数"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="经度" />

                                <EditText
                                    android:id="@+id/et_social_lon"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal|numberSigned"
                                    android:text="118.19646377354036" />
                            </LinearLayout>

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="1dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="纬度" />

                                <EditText
                                    android:id="@+id/et_social_lat"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal|numberSigned"
                                    android:text="24.483710802285128" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="半径(米)" />

                                <EditText
                                    android:id="@+id/et_social_radius"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:text="1000" />
                            </LinearLayout>

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="1dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="页码" />

                                <EditText
                                    android:id="@+id/et_social_page"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:text="1" />
                            </LinearLayout>

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="1dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="每页条数" />

                                <EditText
                                    android:id="@+id/et_social_page_size"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:text="10" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="LBS 类型（支持逗号分隔）" />

                        <EditText
                            android:id="@+id/et_social_lbs_type"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="例如：friend 或 friend,test"
                            android:text="friend" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <include layout="@layout/include_social_buttons" />

            <LinearLayout
                style="@style/RxCard"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RxSectionTitle"
                        android:text="结果展示" />

                    <TextView
                        android:id="@+id/tv_social_result_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="最近结果"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_social_result_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="尚未执行操作"
                        android:textColor="@color/rx_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="好友列表结果支持点击卡片，一键回填 target openid 和好友备注。"
                        android:textColor="@color/rx_text_secondary"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/ll_social_result_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tv_social_flow_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="快捷测试流状态会显示在这里"
                        android:textColor="@color/rx_text_secondary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_clear_social_result"
                        style="@style/RxButton.Tools.Flow"
                        android:layout_marginTop="12dp"
                        android:onClick="onClick"
                        android:text="清空结果" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="原始 JSON 日志"
                        android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_log"
                android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/rx_input_bg"
                        android:minHeight="120dp"
                        android:padding="10dp"
                        android:text="尚未执行操作"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>