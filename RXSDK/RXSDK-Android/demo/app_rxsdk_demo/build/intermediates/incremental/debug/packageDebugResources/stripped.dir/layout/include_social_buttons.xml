<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        style="@style/RxCard"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView
                style="@style/RxSectionTitle"
                android:text="快捷测试流" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="按预设顺序自动调用接口，便于快速完成一轮联调验证。"
                android:textColor="@color/rx_text_secondary"
                android:textSize="12sp" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button
                    android:id="@+id/social_quick_friend_flow"
                    style="@style/RxButton.Test.Flow"
                    android:onClick="onClick"
                    android:text="好友测试流" />

                <Button
                    android:id="@+id/social_quick_relation_flow"
                    style="@style/RxButton.Test.Flow"
                    android:onClick="onClick"
                    android:text="关系测试流" />

                <Button
                    android:id="@+id/social_quick_rank_flow"
                    style="@style/RxButton.Test.Flow"
                    android:onClick="onClick"
                    android:text="排行榜测试流" />

                <Button
                    android:id="@+id/social_quick_lbs_flow"
                    style="@style/RxButton.Test.Flow"
                    android:onClick="onClick"
                    android:text="LBS测试流" />
            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/RxCard"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView
                style="@style/RxSectionTitle"
                android:text="好友操作" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="写操作"
                android:textColor="@color/rx_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/addfriend" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="添加好友" />
                <Button android:id="@+id/deletefriend" style="@style/RxButton.Danger.Flow" android:onClick="onClick" android:text="删除好友" />
                <Button android:id="@+id/updatefriendremarks" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="修改好友备注" />
            </com.nex3z.flowlayout.FlowLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="查询操作"
                android:textColor="@color/rx_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/isfriend" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="好友状态" />
                <Button android:id="@+id/allfriends" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="好友列表" />
            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/RxCard"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView
                style="@style/RxSectionTitle"
                android:text="自定义关系" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="写操作"
                android:textColor="@color/rx_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/relationadd" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="添加关系" />
                <Button android:id="@+id/relationdelete" style="@style/RxButton.Danger.Flow" android:onClick="onClick" android:text="删除关系" />
                <Button android:id="@+id/updateRelationRemarks" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="修改关系备注" />
            </com.nex3z.flowlayout.FlowLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="查询操作"
                android:textColor="@color/rx_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/hasRelation" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="关系状态" />
                <Button android:id="@+id/relationlist" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="关系列表" />
            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/RxCard"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView
                style="@style/RxSectionTitle"
                android:text="排行榜操作" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="写操作"
                android:textColor="@color/rx_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/addscore" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="增加分数" />
                <Button android:id="@+id/setscore" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="设置分数" />
            </com.nex3z.flowlayout.FlowLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="查询操作"
                android:textColor="@color/rx_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/queryuserrank" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="用户排名" />
                <Button android:id="@+id/getranklist" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="排行榜" />
                <Button android:id="@+id/friendsrank" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="好友榜" />
            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/RxCard"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView
                style="@style/RxSectionTitle"
                android:text="LBS 操作" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="写操作"
                android:textColor="@color/rx_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/location_start" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="启动定位" />
                <Button android:id="@+id/location_stop" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="停止定位" />
                <Button android:id="@+id/location_del" style="@style/RxButton.Danger.Flow" android:onClick="onClick" android:text="删除位置" />
            </com.nex3z.flowlayout.FlowLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="查询操作"
                android:textColor="@color/rx_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/lbs_radius" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="附近用户" />
            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
