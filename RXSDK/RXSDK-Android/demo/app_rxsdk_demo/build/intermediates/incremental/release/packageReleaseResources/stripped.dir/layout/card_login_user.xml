<?xml version="1.0" encoding="utf-8"?>
<!-- 登录 · 用户 · 账号 功能卡片 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/RxCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:tag="collapsible">

        <TextView
            style="@style/RxSectionTitle"
            android:text="🔐 登录 · 账号" />

        <!-- ===== 登录 ===== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsible">

            <TextView style="@style/RxSectionTitle" android:text="🔐 登录" android:textSize="12sp" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/login_guest" style="@style/RxButton.Login.Flow" android:onClick="onClick" android:text="游客登录" />
                <Button android:id="@+id/login_guest_new" style="@style/RxButton.Login.Flow" android:onClick="onClick" android:text="新游客" />
                <Button android:id="@+id/wechatlogin" style="@style/RxButton.Login.Flow" android:onClick="onClick" android:text="微信登录" />
                <Button android:id="@+id/login_by_account" style="@style/RxButton.Login.Flow" android:onClick="onClick" android:text="账号登录" />
                <Button android:id="@+id/login_default" style="@style/RxButton.Login.Flow" android:onClick="onClick" android:text="渠道登录" />
                <Button android:id="@+id/login_by_token" style="@style/RxButton.Login.Flow" android:onClick="onClick" android:text="二次登录" />
                <Button android:id="@+id/check_quick_ap" style="@style/RxButton.Login.Flow" android:onClick="onClick" android:text="免密检查" />
                <Button android:id="@+id/sendcaptcha" style="@style/RxButton.Login.Flow" android:onClick="onClick" android:text="发送验证" />
                <Button android:id="@+id/logout" style="@style/RxButton.Login.Flow" android:onClick="onClick" android:text="退出登录" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

        <!-- ===== 用户信息 ===== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsible">

            <TextView style="@style/RxSectionTitle" android:text="👤 用户信息" android:textSize="12sp" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/getuserinfo" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="获取信息" />
                <Button android:id="@+id/updateuser" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="修改资料" />
                <Button android:id="@+id/get_logindata" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="登录数据" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

        <!-- ===== 账号管理 ===== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsible">

            <TextView style="@style/RxSectionTitle" android:text="📱 账号管理" android:textSize="12sp" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/change_phone" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="更换手机" />
                <Button android:id="@+id/deregister" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="账号注销" />
                <Button android:id="@+id/deregister_ui" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="注销UI" />
                <Button android:id="@+id/deregister_ui_config" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="注销UI(Config)" />
                <Button android:id="@+id/deregister_cancel" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="撤销注销(API)" />
                <Button android:id="@+id/destroy_account_recall" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="撤销注销(UI)" />
                <Button android:id="@+id/destroy_account_recall_text" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="撤销注销(自定)" />
                <Button android:id="@+id/deregister_h5" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="注销H5" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
