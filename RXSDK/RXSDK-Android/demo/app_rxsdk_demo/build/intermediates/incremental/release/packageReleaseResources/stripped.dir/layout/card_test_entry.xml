<?xml version="1.0" encoding="utf-8"?>
<!-- 测试入口 功能卡片 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/RxCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:tag="collapsed">

        <TextView
            style="@style/RxSectionTitle"
            android:text="🧪 测试入口" />

        <com.nex3z.flowlayout.FlowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flChildSpacing="4dp"
            app:flRowSpacing="4dp">

            <Button android:id="@+id/wechat_test" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="微信测试" />
            <Button android:id="@+id/google_test" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="海外测试" />
            <Button android:id="@+id/ysdk_test" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="YSDK" />
            <Button android:id="@+id/line_test" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="Line测试" />
            <Button android:id="@+id/push_test" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="推送测试" />
            <Button android:id="@+id/social_test" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="社交测试" />
            <Button android:id="@+id/game_area_test" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="区服测试" />
            <Button android:id="@+id/share_test" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="分享测试" />
            <Button android:id="@+id/permission_test" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="权限测试" />
            <Button android:id="@+id/demo_preview" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="功能演示" />
            <Button android:id="@+id/api_demo_v2" style="@style/RxButton.Primary.Flow" android:onClick="onClick" android:text="🚀 API V2" />
            <Button android:id="@+id/promo_display" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="福利码" />
            <Button android:id="@+id/demo_topon" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="TopOn" />
            <Button android:id="@+id/btn_open_login" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="登录页面" />

        </com.nex3z.flowlayout.FlowLayout>
    </LinearLayout>
</LinearLayout>
