<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.ruixue.demo.LoginActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="输入瑞雪sdk配置参数然后点击初始化" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="cpid:" />
                <!--                    <requestFocus/>-->
                <EditText
                    android:id="@+id/et_cpid"
                    style="@style/EditTextStyle.Alignment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:focusable="auto"
                    android:hint="cpid" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="product id:" />

                <EditText
                    android:id="@+id/et_appid"
                    style="@style/EditTextStyle.Alignment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:hint="product id" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="channelid:" />

                <EditText
                    android:id="@+id/et_channelid"
                    style="@style/EditTextStyle.Alignment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="channelid" />

                <!--                    <RadioGroup-->
                <!--                        android:id="@+id/rdgroup"-->
                <!--                        android:layout_width="wrap_content"-->
                <!--                        android:layout_height="match_parent"-->
                <!--                        android:orientation="horizontal">-->

                <!--                        <RadioButton-->
                <!--                            android:id="@+id/fbf"-->
                <!--                            android:layout_width="wrap_content"-->
                <!--                            android:layout_height="match_parent"-->
                <!--                            android:checked="true"-->
                <!--                            android:text="正式服" />-->

                <!--                        <RadioButton-->
                <!--                            android:id="@+id/fbh"-->
                <!--                            android:layout_width="wrap_content"-->
                <!--                            android:layout_height="match_parent"-->
                <!--                            android:text="测试服" />-->
                <!--                    </RadioGroup>-->


                <!--                <EditText
                            style="@style/EditTextStyle.Alignment"-->
                <!--                    android:id="@+id/et_base_url"-->
                <!--                    android:layout_width="match_parent"-->
                <!--                    android:layout_height="wrap_content"-->
                <!--                    android:hint="https://ruixue.weiletest.com/"-->
                <!--                    android:minHeight="48dp"-->
                <!--                    android:text="" />-->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="api地址:" />

                <EditText
                    android:id="@+id/et_domain"
                    style="@style/EditTextStyle.Alignment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="api地址" />

                <Spinner
                    android:id="@+id/sp_base_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

            </LinearLayout>

            <Button
                android:id="@+id/btn_save_config"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="初始化" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/username"
                        style="@style/EditTextStyle.Alignment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="20dp"
                        android:layout_weight="1"
                        android:hint="Username"
                        android:inputType="textEmailAddress"
                        android:selectAllOnFocus="true" />

                    <EditText
                        android:id="@+id/password"
                        style="@style/EditTextStyle.Alignment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="20dp"
                        android:layout_weight="1"
                        android:hint="Password"
                        android:imeActionLabel="@string/action_sign_in_short"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:selectAllOnFocus="true" />
                </LinearLayout>


                <com.nex3z.flowlayout.FlowLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="5dp">


                    <Button
                        android:id="@+id/regist_account"
                        android:layout_width="125dp"
                        android:layout_height="wrap_content"

                        android:onClick="onClick"
                        android:text="注册账号" />


                    <Button
                        android:id="@+id/login_account"

                        android:layout_width="125dp"
                        android:layout_height="wrap_content"
                        android:onClick="onClick"
                        android:text="账号登录" />


                    <Button
                        android:id="@+id/login_guest"
                        android:layout_width="125dp"
                        android:layout_height="wrap_content"
                        android:onClick="onClick"
                        android:text="游客登录" />


                    <Button
                        android:id="@+id/login_wechat"
                        android:layout_width="125dp"
                        android:layout_height="wrap_content"
                        android:onClick="onClick"
                        android:text="微信登录" />

                    <Button
                        android:id="@+id/login_alimobile"
                        android:layout_width="125dp"
                        android:layout_height="wrap_content"
                        android:onClick="onClick"
                        android:text="阿里一键登录" />


                    <Button
                        android:id="@+id/login_third"
                        android:layout_width="125dp"
                        android:layout_height="wrap_content"
                        android:onClick="onClick"
                        android:text="渠道登录" />


                </com.nex3z.flowlayout.FlowLayout>

                <Button
                    android:id="@+id/btn_open_next"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="打开主功能页面" />

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="登录UI功能区" />

            </LinearLayout>

            <TextView
                android:id="@+id/txv_log"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:text="log text" />

        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="64dp"
        android:layout_marginBottom="64dp"
        android:visibility="gone" />

</FrameLayout>