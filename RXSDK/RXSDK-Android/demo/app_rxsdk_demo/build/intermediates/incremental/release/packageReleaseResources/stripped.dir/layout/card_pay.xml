<?xml version="1.0" encoding="utf-8"?>
<!-- 支付 功能卡片（合并原 card_pay + PayTestActivity） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/RxCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:tag="collapsible">

        <TextView
            style="@style/RxSectionTitle"
            android:text="💰 支付" />

        <!-- ===== 计费点选择 ===== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/billing_spinner"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1" />

            <EditText
                android:id="@+id/billing_custom_input"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/rx_input_bg"
                android:hint="自定义 goods_tag"
                android:paddingHorizontal="8dp"
                android:singleLine="true"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/billing_tag_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textColor="@color/rx_text_tertiary"
            android:textSize="10sp" />

        <!-- ===== 常用支付 ===== -->

        <com.nex3z.flowlayout.FlowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flChildSpacing="4dp"
            app:flRowSpacing="4dp">

            <Button android:id="@+id/pay_wechat" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="微信支付" />
            <Button android:id="@+id/pay_alipay" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="支付宝" />
            <Button android:id="@+id/pay_yeepay" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="易宝支付" />
            <Button android:id="@+id/pay_xingyi" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="星驿App支付" />
            <Button android:id="@+id/payChannel" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="渠道支付" />
            <Button android:id="@+id/payExchange" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="兑换码" />

        </com.nex3z.flowlayout.FlowLayout>

        <!-- ===== H5 / Web ===== -->

        <TextView
            style="@style/RxSectionTitle"
            android:layout_marginTop="4dp"
            android:text="🌐 H5 / Web" />

        <com.nex3z.flowlayout.FlowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flChildSpacing="4dp"
            app:flRowSpacing="4dp">

            <Button android:id="@+id/pay_wechath5" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="微信H5" />
            <Button android:id="@+id/pay_alipayh5" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="支付宝H5" />
            <Button android:id="@+id/pay_xingyi_h5" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="星驿H5支付" />
            <Button android:id="@+id/pay_ruixueh5" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="收银台" />
            <Button android:id="@+id/web_pay" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="Web Pay" />
            <Button android:id="@+id/jdpay" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="京东支付" />
            <Button android:id="@+id/suning_wechat" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="苏宁微信" />
            <Button android:id="@+id/suning_alipay" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="苏宁支付宝" />

        </com.nex3z.flowlayout.FlowLayout>

        <!-- ===== 海外支付 ===== -->

        <TextView
            style="@style/RxSectionTitle"
            android:layout_marginTop="4dp"
            android:text="🌍 海外支付" />

        <com.nex3z.flowlayout.FlowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flChildSpacing="4dp"
            app:flRowSpacing="4dp">

            <Button android:id="@+id/google" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="Google" />
            <Button android:id="@+id/payermax_api" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="PayerMax" />
            <Button android:id="@+id/xsolla" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="Xsolla" />
            <Button android:id="@+id/pay_aptoide" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="Aptoide" />
            <Button android:id="@+id/checkout" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="Checkout" />
            <Button android:id="@+id/unipin" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="UniPin" />
            <Button android:id="@+id/utg" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="UTG" />
            <Button android:id="@+id/waffo" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="Waffo" />

        </com.nex3z.flowlayout.FlowLayout>

        <!-- ===== 银联支付 ===== -->

        <TextView
            style="@style/RxSectionTitle"
            android:layout_marginTop="4dp"
            android:text="🏦 银联" />

        <com.nex3z.flowlayout.FlowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flChildSpacing="4dp"
            app:flRowSpacing="4dp">

            <Button android:id="@+id/aums_wechat" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="银联微信" />
            <Button android:id="@+id/aums_minigame" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="银联小游戏" />
            <Button android:id="@+id/aums_alipay" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="银联支付宝" />
            <Button android:id="@+id/aums_uac" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="银联云闪付" />

        </com.nex3z.flowlayout.FlowLayout>

        <!-- ===== UPay ===== -->

        <TextView
            style="@style/RxSectionTitle"
            android:layout_marginTop="4dp"
            android:text="💳 UPay" />

        <com.nex3z.flowlayout.FlowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flChildSpacing="4dp"
            app:flRowSpacing="4dp">

            <Button android:id="@+id/upay_net" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="UPay Net" />
            <Button android:id="@+id/upay_www" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="UPay WWCard" />
            <Button android:id="@+id/upay_api" style="@style/RxButton.Pay.Flow" android:onClick="onClick" android:text="UPay API" />

        </com.nex3z.flowlayout.FlowLayout>

    </LinearLayout>
</LinearLayout>
