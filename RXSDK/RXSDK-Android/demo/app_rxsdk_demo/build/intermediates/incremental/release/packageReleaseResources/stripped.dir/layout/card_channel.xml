<?xml version="1.0" encoding="utf-8"?>
<!-- 渠道·海外 功能卡片 -->
<!-- 统一使用 Test 配色 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/RxCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:tag="collapsed">

        <TextView
            style="@style/RxSectionTitle"
            android:text="🌏 渠道 · 海外" />

        <com.nex3z.flowlayout.FlowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flChildSpacing="4dp"
            app:flRowSpacing="4dp">

            <Button android:id="@+id/btn_uc_game" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="九游" />
            <Button android:id="@+id/login_hw_os" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="华为" />
            <Button android:id="@+id/login_hw_google" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="HW谷歌" />
            <Button android:id="@+id/login_hw_facebook" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="HW FB" />
            <Button android:id="@+id/hw_replay" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="高光" />
            <Button android:id="@+id/hw_moment" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="社区" />
            <Button android:id="@+id/btn_leidan" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="雷电" />

        </com.nex3z.flowlayout.FlowLayout>
    </LinearLayout>
</LinearLayout>
