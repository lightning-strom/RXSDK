<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/textView5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="获取验证码"
            android:textAlignment="center"

            android:textSize="20sp" />

        <EditText
                            style="@style/EditTextStyle.Alignment"
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="start|top"
            android:hint="输入获取验证码得手机或邮箱" />

        <TextView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="获取意图"
            android:textAlignment="center"
            android:textSize="14sp" />

        <com.nex3z.flowlayout.FlowLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <Button
                android:id="@+id/purpose_register"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="注册" />

            <Button
                android:id="@+id/purpose_bindphone"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="绑定手机" />

            <Button
                android:id="@+id/purpose_unbindphone"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="解绑手机" />

            <Button
                android:id="@+id/purpose_resetpwd"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="重置密码" />

            <Button
                android:id="@+id/purpose_bindemail"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="bindemail" />

            <Button
                android:id="@+id/purpose_unbindemail"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="unbindemail" />

            <Button
                android:id="@+id/purpose_login"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="login" />

            <Button
                android:id="@+id/purpose_setpwd"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="setpwd" />
        </com.nex3z.flowlayout.FlowLayout>

        <Button
            android:id="@+id/close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onClick"
            android:text="close" />

    </LinearLayout>

</FrameLayout>