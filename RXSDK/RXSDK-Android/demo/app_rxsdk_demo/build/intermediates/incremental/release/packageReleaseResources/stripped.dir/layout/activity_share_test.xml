<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                style="@style/RxCard"
                android:orientation="vertical">

                <TextView
                    style="@style/RxSectionTitle"
                    android:text="分享测试台" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="在二级页内统一配置分享参数，完成通路 UI、标准分享、自定义分享、短链和调度链路测试。"
                    android:textColor="@color/rx_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                style="@style/RxCard"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:tag="collapsible">

                    <TextView
                        style="@style/RxSectionTitle"
                        android:text="测试参数" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="分享埋点和大部分素材信息建议优先走后台配置，平台和素材类型可直接点选。"
                        android:textColor="@color/rx_text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:tag="collapsible">

                        <TextView
                            style="@style/RxSectionTitle"
                            android:text="基础参数"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="分享埋点 / func" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/et_share_func"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="例如：default 或 bean_leaderboard_share"
                                android:text="default" />

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="1dp" />

                            <Button
                                android:id="@+id/btn_share_pick_func_inline"
                                style="@style/RxButton.Tools.Flow"
                                android:onClick="onClick"
                                android:text="埋点列表" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="平台" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/et_share_platform"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:clickable="true"
                                android:focusable="false"
                                android:focusableInTouchMode="false"
                                android:hint="点击选择平台"
                                android:text="wechat" />

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="1dp" />

                            <Button
                                android:id="@+id/btn_share_pick_platform"
                                style="@style/RxButton.Tools.Flow"
                                android:onClick="onClick"
                                android:text="选择平台" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_share_platform_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/rx_text_secondary"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="地区" />

                                <EditText
                                    android:id="@+id/et_share_region"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="220101" />
                            </LinearLayout>

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="1dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_label_share_scene"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="shareScene" />

                                <EditText
                                    android:id="@+id/et_share_scene"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="点击选择 shareScene"
                                    android:text="0" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="素材类型" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/et_share_material_type"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:clickable="true"
                                android:focusable="false"
                                android:focusableInTouchMode="false"
                                android:hint="点击选择素材类型"
                                android:text="link" />

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="1dp" />

                            <Button
                                android:id="@+id/btn_share_pick_material_type"
                                style="@style/RxButton.Tools.Flow"
                                android:onClick="onClick"
                                android:text="选择类型" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_share_material_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/rx_text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_share_compatibility_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/rx_text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_share_required_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/rx_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:tag="collapsed">

                        <TextView
                            style="@style/RxSectionTitle"
                            android:text="素材参数"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_label_share_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="标题" />

                        <EditText
                            android:id="@+id/et_share_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="测试分享标题" />

                        <TextView
                            android:id="@+id/tv_label_share_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="内容" />

                        <EditText
                            android:id="@+id/et_share_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minLines="2"
                            android:text="测试分享内容" />

                        <TextView
                            android:id="@+id/tv_label_share_image"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="图片 URL" />

                        <EditText
                            android:id="@+id/et_share_image"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="https://example.com/share.png" />

                        <TextView
                            android:id="@+id/tv_label_share_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="链接 URL" />

                        <EditText
                            android:id="@+id/et_share_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="https://www.example.com" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:tag="collapsed">

                        <TextView
                            style="@style/RxSectionTitle"
                            android:text="高级参数"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="transmits" />

                        <EditText
                            android:id="@+id/et_share_transmits"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="例如：a=dffd&amp;b=test"
                            android:text="a=dffd&amp;b=test" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="protocol_android" />

                        <EditText
                            android:id="@+id/et_share_protocol_android"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="jixiang433://" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="protocol_ios" />

                        <EditText
                            android:id="@+id/et_share_protocol_ios"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="jixiang433://" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_label_share_use_scheme"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="use_scheme" />

                                <EditText
                                    android:id="@+id/et_share_use_scheme"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="点击选择 0/1"
                                    android:text="1" />
                            </LinearLayout>

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="1dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_label_share_use_short_url"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="useShortUrl" />

                                <EditText
                                    android:id="@+id/et_share_use_short_url"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="点击选择 true/false"
                                    android:text="false" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_label_share_show_content_in_circle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="show_content_in_circle" />

                        <EditText
                            android:id="@+id/et_share_show_content_in_circle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="微信朋友圈是否用 content 展示，true/false"
                            android:text="false" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="调度策略 ID" />

                        <EditText
                            android:id="@+id/et_share_strategy_id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="调度上报时可直接使用，分享数据返回卡片也支持点击回填" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="properties JSON" />

                        <EditText
                            android:id="@+id/et_share_properties"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:minLines="3"
                            android:text="{&quot;source&quot;:&quot;demo_share_console&quot;}" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/RxCard"
                android:orientation="vertical">

                <TextView
                    style="@style/RxSectionTitle"
                    android:text="操作面板" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="后台配置"
                    android:textColor="@color/rx_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.nex3z.flowlayout.FlowLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:flChildSpacing="4dp"
                    app:flRowSpacing="4dp">

                    <Button
                        android:id="@+id/btn_share_show_platforms"
                        style="@style/RxButton.Tools.Flow"
                        android:onClick="onClick"
                        android:text="平台列表" />

                    <Button
                        android:id="@+id/btn_share_pick_func"
                        style="@style/RxButton.Tools.Flow"
                        android:onClick="onClick"
                        android:text="埋点列表" />
                </com.nex3z.flowlayout.FlowLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="快捷模板"
                    android:textColor="@color/rx_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.nex3z.flowlayout.FlowLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:flChildSpacing="4dp"
                    app:flRowSpacing="4dp">

                    <Button
                        android:id="@+id/btn_share_preset_system_text"
                        style="@style/RxButton.Tools.Flow"
                        android:onClick="onClick"
                        android:text="系统文本" />

                    <Button
                        android:id="@+id/btn_share_preset_wechat_link"
                        style="@style/RxButton.Tools.Flow"
                        android:onClick="onClick"
                        android:text="微信链接" />

                    <Button
                        android:id="@+id/btn_share_preset_line_text"
                        style="@style/RxButton.Tools.Flow"
                        android:onClick="onClick"
                        android:text="LINE文本" />

                    <Button
                        android:id="@+id/btn_share_preset_facebook_image"
                        style="@style/RxButton.Tools.Flow"
                        android:onClick="onClick"
                        android:text="FB图片" />

                    <Button
                        android:id="@+id/btn_share_preset_messenger_image"
                        style="@style/RxButton.Tools.Flow"
                        android:onClick="onClick"
                        android:text="MSG图片" />

                    <Button
                        android:id="@+id/btn_share_preset_zalo_link"
                        style="@style/RxButton.Tools.Flow"
                        android:onClick="onClick"
                        android:text="Zalo链接" />

                    <Button
                        android:id="@+id/btn_share_preset_snapchat_image"
                        style="@style/RxButton.Tools.Flow"
                        android:onClick="onClick"
                        android:text="Snap图片" />
                </com.nex3z.flowlayout.FlowLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="分享入口"
                    android:textColor="@color/rx_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.nex3z.flowlayout.FlowLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:flChildSpacing="4dp"
                    app:flRowSpacing="4dp">

                    <Button
                        android:id="@+id/btn_share_open_ui"
                        style="@style/RxButton.Primary.Flow"
                        android:onClick="onClick"
                        android:text="通路UI" />

                    <Button
                        android:id="@+id/btn_share_standard"
                        style="@style/RxButton.Pay.Flow"
                        android:onClick="onClick"
                        android:text="标准分享" />

                    <Button
                        android:id="@+id/btn_share_custom"
                        style="@style/RxButton.Share.Flow"
                        android:onClick="onClick"
                        android:text="自定义分享" />
                </com.nex3z.flowlayout.FlowLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="调度与工具"
                    android:textColor="@color/rx_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.nex3z.flowlayout.FlowLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:flChildSpacing="4dp"
                    app:flRowSpacing="4dp">

                    <Button
                        android:id="@+id/btn_share_schedule_init"
                        style="@style/RxButton.Share.Flow"
                        android:onClick="onClick"
                        android:text="调度初始化" />

                    <Button
                        android:id="@+id/btn_share_get_data"
                        style="@style/RxButton.Share.Flow"
                        android:onClick="onClick"
                        android:text="分享数据" />

                    <Button
                        android:id="@+id/btn_share_schedule_report"
                        style="@style/RxButton.Share.Flow"
                        android:onClick="onClick"
                        android:text="调度上报" />

                    <Button
                        android:id="@+id/btn_share_short_url"
                        style="@style/RxButton.Tools.Flow"
                        android:onClick="onClick"
                        android:text="短链" />
                </com.nex3z.flowlayout.FlowLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="快捷流"
                    android:textColor="@color/rx_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.nex3z.flowlayout.FlowLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:flChildSpacing="4dp"
                    app:flRowSpacing="4dp">

                    <Button
                        android:id="@+id/share_quick_share_flow"
                        style="@style/RxButton.Primary.Flow"
                        android:onClick="onClick"
                        android:text="调度分享流" />

                    <Button
                        android:id="@+id/share_quick_report_flow"
                        style="@style/RxButton.Test.Flow"
                        android:onClick="onClick"
                        android:text="上报快测" />
                </com.nex3z.flowlayout.FlowLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/RxCard"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/RxSectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="结果面板" />

                    <Button
                        android:id="@+id/btn_clear_share_result"
                        style="@style/RxButton.Tools.Flow"
                        android:onClick="onClick"
                        android:text="清空结果" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_share_result_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="最近结果"
                    android:textColor="@color/rx_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_share_result_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="尚未执行操作"
                    android:textColor="@color/rx_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="分享数据、短链和部分结果卡片支持点击回填参数。"
                    android:textColor="@color/rx_text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/ll_share_result_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                style="@style/RxCard"
                android:orientation="vertical">

                <TextView
                    style="@style/RxSectionTitle"
                    android:text="快捷流状态" />

                <TextView
                    android:id="@+id/tv_share_flow_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="快捷测试流状态会显示在这里"
                    android:textColor="@color/rx_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                style="@style/RxCard"
                android:orientation="vertical">

                <TextView
                    style="@style/RxSectionTitle"
                    android:text="原始日志" />

                <TextView
                    android:id="@+id/tv_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="尚未执行操作"
                    android:textColor="@color/rx_text_primary"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
