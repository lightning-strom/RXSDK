<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MissingDefaultResource">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/textView6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="line api test:" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_qr_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="url:" />

                <EditText
                            style="@style/EditTextStyle.Alignment"
                    android:id="@+id/et_link"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="请输入分享链接"
                    android:singleLine="true" />

            </LinearLayout>

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/line_login"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:onClick="onClick"
                    android:text="登录" />

                <Button
                    android:id="@+id/line_share_text"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:onClick="onClick"
                    android:text="分享文本" />

                <Button
                    android:id="@+id/line_share_image_local"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"

                    android:onClick="onClick"
                    android:text="分享本地图片" />

                <Button
                    android:id="@+id/line_share_image_net"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"

                    android:onClick="onClick"
                    android:text="分享网络图片" />


                <Button
                    android:id="@+id/line_share_link"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:onClick="onClick"
                    android:text="分享链接" />


            </com.nex3z.flowlayout.FlowLayout>

            <TextView
                android:id="@+id/tv_log"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:layout_weight="1"
                android:focusable="true"
                android:text="this is log text"
                android:textIsSelectable="true" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>