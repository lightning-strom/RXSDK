<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        style="@style/RxCard"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView
                style="@style/RxSectionTitle"
                android:text="区服操作" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="写操作"
                android:textColor="@color/rx_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/btn_create_game_area" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="创建区服" />
                <Button android:id="@+id/btn_update_game_area_info" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="修改区服" />
                <Button android:id="@+id/btn_delete_game_area" style="@style/RxButton.Danger.Flow" android:onClick="onClick" android:text="删除区服" />
            </com.nex3z.flowlayout.FlowLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="查询操作"
                android:textColor="@color/rx_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/btn_search_game_area_info" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="区服详情" />
                <Button android:id="@+id/btn_search_game_area_list_info" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="区服列表" />
            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/RxCard"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView
                style="@style/RxSectionTitle"
                android:text="角色操作" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="写操作"
                android:textColor="@color/rx_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/btn_create_game_character" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="创建角色" />
                <Button android:id="@+id/btn_update_game_character_info" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="修改角色" />
                <Button android:id="@+id/btn_delete_game_character" style="@style/RxButton.Danger.Flow" android:onClick="onClick" android:text="删除角色" />
            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/RxCard"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView
                style="@style/RxSectionTitle"
                android:text="角色查询" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="查询操作"
                android:textColor="@color/rx_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/btn_search_game_character_info" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="角色详情" />
                <Button android:id="@+id/btn_search_game_character_list_info" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="角色列表" />
                <Button android:id="@+id/btn_search_game_character_list_in_area" style="@style/RxButton.Test.Flow" android:onClick="onClick" android:text="区服角色" />
            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
