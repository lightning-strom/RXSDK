<?xml version="1.0" encoding="utf-8"?>
<!-- RXSdkUI 接口测试 功能卡片 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/RxCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:tag="collapsed">

        <TextView
            style="@style/RxSectionTitle"
            android:text="🖥️ RXSdkUI 接口" />

        <!-- ===== 登录 UI ===== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsible">

            <TextView style="@style/RxSectionTitle" android:text="🔐 登录 UI" android:textSize="12sp" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/login_view_rx" style="@style/RxButton.Login.Flow" android:onClick="onClick" android:text="SDK登录" />
                <Button android:id="@+id/login_quick_openid" style="@style/RxButton.Login.Flow" android:onClick="onClick" android:text="快速登录" />
                <Button android:id="@+id/login_openid_invalid" style="@style/RxButton.Login.Flow" android:onClick="onClick" android:text="过期登录" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

        <!-- ===== 用户中心 / 客服 ===== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsible">

            <TextView style="@style/RxSectionTitle" android:text="👤 用户中心 · 客服" android:textSize="12sp" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/user_center" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="个人中心" />
                <Button android:id="@+id/user_center_config" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="个人中心(Config)" />
                <Button android:id="@+id/user_helper_center" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="帮助中心(默认)" />
                <Button android:id="@+id/user_helper_center_config" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="帮助中心(Config)" />
                <Button android:id="@+id/user_service" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="在线客服" />
                <Button android:id="@+id/mail_view" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="站内信" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

        <!-- ===== 注册 ===== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView style="@style/RxSectionTitle" android:text="📝 注册" android:textSize="12sp" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/register_phone_ui" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="手机注册" />
                <Button android:id="@+id/register_username_ui" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="账号注册" />
                <Button android:id="@+id/register_email_ui" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="邮箱注册" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

        <!-- ===== 绑定 / 解绑 ===== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView style="@style/RxSectionTitle" android:text="🔗 绑定 · 解绑" android:textSize="12sp" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/bindphone" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="绑定手机" />
                <Button android:id="@+id/bindemail" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="绑定邮箱" />
                <Button android:id="@+id/unbindphone" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="解绑手机" />
                <Button android:id="@+id/unbindemail" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="解绑邮箱" />
                <Button android:id="@+id/bind_account_scene_bind" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="绑定三方账号" />
                <Button android:id="@+id/bind_account_scene_authorization" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="微信领红包" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

        <!-- ===== 密码 ===== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView style="@style/RxSectionTitle" android:text="🔑 密码" android:textSize="12sp" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/updatepassword" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="修改密码" />
                <Button android:id="@+id/forgot_password" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="忘记密码" />
                <Button android:id="@+id/forgot_password_simple" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="忘记密码(默认)" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

        <!-- ===== 实名认证 ===== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView style="@style/RxSectionTitle" android:text="🪪 实名认证" android:textSize="12sp" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/realnameui" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="实名认证" />
                <Button android:id="@+id/realnameh5ui" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="实名H5" />
                <Button android:id="@+id/iifaa_validate" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="IIFAA查询" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

        <!-- ===== 协议 / 法务 ===== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView style="@style/RxSectionTitle" android:text="📜 协议 · 法务" android:textSize="12sp" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/policy" style="@style/RxButton.Share.Flow" android:onClick="onClick" android:text="隐私协议" />
                <Button android:id="@+id/legal" style="@style/RxButton.Share.Flow" android:onClick="onClick" android:text="法务弹窗" />
                <Button android:id="@+id/permissionui" style="@style/RxButton.Share.Flow" android:onClick="onClick" android:text="权限说明" />
                <Button android:id="@+id/privacy_legal_data" style="@style/RxButton.Share.Flow" android:onClick="onClick" android:text="隐私(LegalData)" />
                <Button android:id="@+id/privacy_key_list" style="@style/RxButton.Share.Flow" android:onClick="onClick" android:text="隐私(多Key)" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

        <!-- ===== 提示弹窗 ===== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView style="@style/RxSectionTitle" android:text="⚠️ 提示弹窗" android:textSize="12sp" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/limit_ui" style="@style/RxButton.Share.Flow" android:onClick="onClick" android:text="通用限制" />
                <Button android:id="@+id/anti_addition_view" style="@style/RxButton.Share.Flow" android:onClick="onClick" android:text="防沉迷" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

        <!-- ===== 公告 ===== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView style="@style/RxSectionTitle" android:text="📢 公告" android:textSize="12sp" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/show_single_announce" style="@style/RxButton.Share.Flow" android:onClick="onClick" android:text="单条公告" />
                <Button android:id="@+id/show_multiple_announce" style="@style/RxButton.Share.Flow" android:onClick="onClick" android:text="多条公告" />
                <Button android:id="@+id/show_common_maintain_announce" style="@style/RxButton.Share.Flow" android:onClick="onClick" android:text="维护公告" />
                <Button android:id="@+id/show_custom_maintain_announce" style="@style/RxButton.Share.Flow" android:onClick="onClick" android:text="自定维护" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

        <!-- ===== 反馈 UI ===== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView style="@style/RxSectionTitle" android:text="💬 反馈 UI" android:textSize="12sp" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/feedback_list_view" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="反馈列表(UI)" />
                <Button android:id="@+id/feedback_create_view" style="@style/RxButton.User.Flow" android:onClick="onClick" android:text="创建反馈(UI)" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

        <!-- ===== 验证 / 其他 ===== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView style="@style/RxSectionTitle" android:text="🔒 验证 · 其他" android:textSize="12sp" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flChildSpacing="4dp"
                app:flRowSpacing="4dp">

                <Button android:id="@+id/verify_get_view" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="滑块验证" />
                <Button android:id="@+id/test_ui" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="验证码UI" />
                <Button android:id="@+id/forgotpwd_h5" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="忘密H5" />
                <Button android:id="@+id/test_idcard_input" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="身份证键盘" />
                <Button android:id="@+id/webview_test" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="Webview" />
                <Button android:id="@+id/scan_qrcode" style="@style/RxButton.Tools.Flow" android:onClick="onClick" android:text="扫码" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
