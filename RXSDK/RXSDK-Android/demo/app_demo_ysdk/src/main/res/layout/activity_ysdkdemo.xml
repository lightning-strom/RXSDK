<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_func"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ysdk api demo:" />

        <com.nex3z.flowlayout.FlowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/login_qq"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="QQ 登录" />

            <Button
                android:id="@+id/login_wx"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="WX 登录" />

            <Button
                android:id="@+id/login_guest"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="单机登录" />

            <Button
                android:id="@+id/login_ui"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="应用宝登录UI" />

            <Button
                android:id="@+id/logout"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="登出" />

            <Button
                android:id="@+id/pay_midas"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="游戏币支付" />

            <Button
                android:id="@+id/pay_ysdk"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="直购支付" />

            <Button
                android:id="@+id/strategy_get"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:onClick="onClick"
                android:text="启动特权" />
        </com.nex3z.flowlayout.FlowLayout>
    </LinearLayout>
</ScrollView>