<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/root_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <!-- ==================== 登录 ==================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:text="登录"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <Button android:id="@+id/os_login_ui" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="OS登录UI" />
                <Button android:id="@+id/login_google" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="Google登录" />
                <Button android:id="@+id/login_facebook" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="Facebook登录" />
                <Button android:id="@+id/login_line" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="Line登录" />
                <Button android:id="@+id/login_tiktok" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="TikTok登录" />
                <Button android:id="@+id/login_zalo" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="Zalo登录" />
                <Button android:id="@+id/login_snapchat" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="Snapchat登录" />
                <Button android:id="@+id/login_instagram" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="Instagram登录" />
                <Button android:id="@+id/login_reddit" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="Reddit登录" />
                <Button android:id="@+id/login_vk" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="VK登录(SDK)" />
                <Button android:id="@+id/logout" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="登出" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

        <!-- ==================== Google 支付 ==================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:text="Google 支付"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <Button android:id="@+id/pay_google" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="Google支付" />
                <Button android:id="@+id/pay_google_server" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="Google支付(服务器回调)" />
                <Button android:id="@+id/pay_google_subscribe" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="Google订阅(rxdy)" />
                <Button android:id="@+id/get_product" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="获取商品信息" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

        <!-- ==================== Ogood 支付 ==================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:text="Ogood 支付"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <Button android:id="@+id/pay_ogood" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="Ogood支付" />
                <Button android:id="@+id/pay_ogood_browser" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="Ogood(浏览器)" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

        <!-- ==================== RuStore 支付 ==================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:text="RuStore"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <Button android:id="@+id/pay_rustore" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="RuStore支付" />
                <Button android:id="@+id/rustore_review" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="RuStore评分" />
                <Button android:id="@+id/rustore_products" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="RuStore商品查询" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

        <!-- ==================== VGamePop (Apkpure) ==================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:text="VGamePop (Apkpure)"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <Button android:id="@+id/vgp_login" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="VGP登录" />
                <Button android:id="@+id/vgp_pay" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="VGP支付" />
                <Button android:id="@+id/vgp_products" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="VGP商品列表" />
                <Button android:id="@+id/vgp_game_circle" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="VGP游戏圈(TODO)" android:enabled="false" />
                <Button android:id="@+id/vgp_vip_service" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="VGP-VIP客服(TODO)" android:enabled="false" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

        <!-- ==================== 分享 ==================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:text="分享"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <Button android:id="@+id/share_tiktok" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="TikTok分享" />
                <Button android:id="@+id/share_zalo" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="Zalo分享" />
                <Button android:id="@+id/share_snapchat" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="Snapchat分享" />
                <Button android:id="@+id/share_instagram" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="Instagram分享" />
                <Button android:id="@+id/share_reddit" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="Reddit分享" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

        <!-- ==================== 渠道 ==================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:text="渠道"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <Button android:id="@+id/channel_qoo" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="Qoo渠道" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

        <!-- ==================== Facebook 分享测试 ==================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="collapsed">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:text="Facebook 分享测试"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="分享到: "
                    android:textColor="@color/black"
                    android:textStyle="bold" />

                <com.ruixue.demo.ui.FlowRadioGroup
                    android:id="@+id/rg_facebook_share"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton android:id="@+id/rb_facebook" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="facebook" />
                    <RadioButton android:id="@+id/rb_messenger" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="messenger" />
                    <RadioButton android:id="@+id/rb_instagram" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="instagram" />
                    <RadioButton android:id="@+id/rb_line" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="line" />
                    <RadioButton android:id="@+id/rb_whatsapp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="whatsapp" />
                    <RadioButton android:id="@+id/rb_tiktok" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="tiktok" />
                    <RadioButton android:id="@+id/rb_twitter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="twitter" />
                    <RadioButton android:id="@+id/rb_system" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="system" />

                </com.ruixue.demo.ui.FlowRadioGroup>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="分享链接:" />
                <EditText android:id="@+id/et_link" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="https://www.baidu.com" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="#话题:" />
                <EditText android:id="@+id/et_hashtag" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="#输入话题" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="引文:" />
                <EditText android:id="@+id/et_quote" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="输入引文" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="#cfcfcf"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="2dp">

                <TextView android:id="@+id/tv_share_file_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="分享文件地址" android:textSize="15sp" />

                <Button android:id="@+id/bt_choose_share_file" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:onClick="onClickChooseFile" android:text="选择分享文件" android:textAllCaps="false" android:textSize="15sp" />
            </LinearLayout>

            <com.nex3z.flowlayout.FlowLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <Button android:id="@+id/share_text" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="分享文本" />
                <Button android:id="@+id/share_link" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="分享链接" />
                <Button android:id="@+id/share_link_with_tag" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="分享链接#话题" />
                <Button android:id="@+id/share_link_with_quote" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="分享链接引文" />
                <Button android:id="@+id/share_image_local" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="分享本地图片" />
                <Button android:id="@+id/share_image" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="分享网络图片" />
                <Button android:id="@+id/share_image_qr" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="分享图片带二维码" />
                <Button android:id="@+id/share_video" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="分享视频" />
                <Button android:id="@+id/share_media" android:layout_width="160dp" android:layout_height="wrap_content" android:onClick="onClick" android:text="分享媒体" />

            </com.nex3z.flowlayout.FlowLayout>
        </LinearLayout>

        <!-- ==================== 日志 ==================== -->

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:focusable="true"
            android:text="this is log text"
            android:textIsSelectable="true" />

    </LinearLayout>

</ScrollView>
