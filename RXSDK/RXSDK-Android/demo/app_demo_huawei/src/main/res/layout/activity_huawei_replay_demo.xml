<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.ruixue.demo.huawei.MyTestSurfaceView android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.nex3z.flowlayout.FlowLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="150dp"
        android:layout_marginEnd="16dp">

        <Button
            android:id="@+id/initBtn"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:text="初始化" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="录制模式"
                android:layout_gravity="center_vertical"
                android:textSize="14sp"/>

            <RadioGroup
                android:id="@+id/recordModeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton android:id="@+id/appRecordModeBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="应用内录制" />

                <RadioButton  android:id="@+id/sysRecordModeBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="系统录制" />

            </RadioGroup>

        </LinearLayout>

        <Button
            android:id="@+id/startManualRecordBtn"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:text="开始手动录制" />

        <Button
            android:id="@+id/startAutoRecordBtn"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:text="开始自动录制" />

        <Button
            android:id="@+id/clipVideoBtn"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:text="生成高光视频" />

        <Button
            android:id="@+id/stopRecordBtn"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:text="停止录制" />

        <Button
            android:id="@+id/queryTemplatesBtn"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:text="查看可用模版" />

        <Button
            android:id="@+id/exportVideoBtn"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:text="使用模版导出视频" />

        <Button
            android:id="@+id/quickShareVideoBtn"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:text="一键分享视频" />

        <Button
            android:id="@+id/quickShareBtn"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:text="一键分享链接" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="操作日志"/>

        <ScrollView android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@color/white">
           <LinearLayout android:id="@+id/logContainer"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="vertical">

           </LinearLayout>
        </ScrollView>

    </com.nex3z.flowlayout.FlowLayout>


</FrameLayout>