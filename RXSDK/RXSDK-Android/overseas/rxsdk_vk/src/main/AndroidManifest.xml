<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ruixue.sdk.vk">

    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <meta-data
            android:name="RX_PLUGIN_VK"
            android:value="com.ruixue.sdk.vk.VkSdkWrapper" />

        <activity
            android:name=".VkAuthActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:exported="false" />

        <!-- VKID SDK 授权跳板页：宿主 Activity 非 LifecycleOwner 时由此页承接 VKID 生命周期 -->
        <activity
            android:name=".VkSdkAuthActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.VkSdkAuth.Translucent"
            android:exported="false" />
    </application>

</manifest>
