<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_root"
        android:layout_width="@dimen/dialog_width"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/card_common_margin_hor"
        android:layout_marginVertical="@dimen/dp_15"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/corner_radius">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_38"
                android:layout_marginTop="5dp">

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="@dimen/dp_50"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:scaleType="centerInside"
                     android:rotationY="@integer/rotation"
                    android:src="@drawable/ruixue_arrow_left" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_title"
                        android:layout_width="@dimen/dp_100"
                        android:layout_height="@dimen/dp_24"
                        android:layout_marginEnd="@dimen/dp_5"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="@dimen/dp_200"
                        android:maxLines="1"
                        android:text="@string/txt_login"
                        android:textColor="@color/black"
                        android:textSize="@dimen/sp_18"
                        android:textStyle="bold" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/close"
                    android:layout_width="@dimen/dp_50"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="5dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ruixue_close_dialog" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/ly_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_18"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_25">

                    <ImageView
                        android:id="@+id/iv_ico_method"
                        android:layout_width="@dimen/dp_18"
                        android:layout_height="@dimen/dp_18"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/dp_12"
                        android:background="@drawable/rx_ico_username" />

                    <TextView
                        android:id="@+id/tv_username"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/edit_height"
                        android:background="@drawable/bg_border_common"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/dp_40"
                        android:singleLine="true"
                        android:text="username"
                        android:textColor="@color/black"
                        android:textSize="@dimen/sp_14" />

                    <ImageView
                        android:id="@+id/btn_switch"
                        android:layout_width="@dimen/dp_16"
                        android:layout_height="@dimen/dp_16"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/dp_9"
                        android:src="@drawable/rx_account_switch" />
                </RelativeLayout>

                <EditText
                            style="@style/EditTextStyle.Alignment"
                    android:id="@+id/username"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_36"
                    android:layout_marginHorizontal="@dimen/dp_30"
                    android:autofillHints=""
                    android:background="@drawable/bg_edittext"
                    android:hint="@string/txt_enter_account"
                    android:inputType="text|textEmailAddress"
                    android:paddingHorizontal="@dimen/dp_15"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textColorHint="@color/color_a5caca"
                    android:textSize="@dimen/sp_17"
                    android:visibility="gone" />

                <EditText
                            style="@style/EditTextStyle.Alignment"
                    android:id="@+id/password"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_36"
                    android:layout_marginHorizontal="@dimen/dp_30"
                    android:layout_marginTop="@dimen/dp_8"
                    android:background="@drawable/bg_edittext"
                    android:hint="@string/txt_enter_pwd"
                    android:inputType="textPassword"
                    android:paddingHorizontal="@dimen/dp_15"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textColorHint="@color/color_a5caca"
                    android:textSize="@dimen/sp_17"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/ll_privacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_30"
                    android:layout_marginTop="@dimen/dp_16"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/ischeck"
                        style="@style/selec_login_checkbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical"
                        android:paddingStart="3dp"
                        android:singleLine="true"
                        android:text="@string/rx_agreement_accept"
                        android:textColor="@color/black"
                        android:textSize="@dimen/sp_13" />

                    <TextView
                        android:id="@+id/xieyi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:linksClickable="true"
                        android:singleLine="true"
                        android:text=""
                        android:textColor="@color/black"
                        android:textColorLink="#20C0B3"
                        android:textSize="@dimen/sp_13" />

                </LinearLayout>

                <Button
                    android:id="@+id/login_default"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginHorizontal="@dimen/dp_25"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginBottom="@dimen/dp_16"
                    android:background="@drawable/selec_btn_bg"
                    android:gravity="center"
                    android:stateListAnimator="@null"
                    android:text="@string/rx_txt_start_game"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_16"
                    tools:ignore="TouchTargetSizeCheck" />

                <LinearLayout
                    android:id="@+id/login_other_method"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="@dimen/dp_22"
                    android:background="@drawable/bg_quick_btn"
                    android:paddingVertical="6dp"
                    android:paddingLeft="11dp"
                    android:paddingRight="12dp">

                    <ImageView
                        android:layout_width="@dimen/dp_18"
                        android:layout_height="@dimen/dp_18"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/rx_ico_more_2" />

                    <TextView
                        android:id="@+id/tv_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="4dp"
                        android:singleLine="true"
                        android:text="@string/rx_txt_more_login_method1"
                        android:textColor="@color/black"
                        android:textSize="@dimen/sp_12" />
                </LinearLayout>

                <!--                <TextView-->

                <!--                    android:layout_width="wrap_content"-->
                <!--                    android:layout_height="wrap_content"-->
                <!--                    android:layout_gravity="center_horizontal"-->
                <!--                    android:layout_marginBottom="@dimen/dp_22"-->
                <!--                    android:singleLine="true"-->
                <!--                    android:text="更多登录方式"-->
                <!--                    android:textColor="#20C0B3"-->
                <!--                    android:textColorLink="#20C0B3"-->
                <!--                    android:textSize="@dimen/sp_14" />-->

                <com.ruixue.widget.LoginButtonGroup
                    android:id="@+id/login_btn_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="@dimen/dp_25"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
