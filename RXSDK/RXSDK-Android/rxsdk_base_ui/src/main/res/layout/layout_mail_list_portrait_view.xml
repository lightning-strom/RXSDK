<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    
    <LinearLayout
        android:layout_width="@dimen/dp_303"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:gravity="center"
        android:background="@drawable/bg_mail_border_common">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_15"
            android:layout_marginBottom="@dimen/dp_10">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:textColor="#ff3D3D3D"
                android:textSize="@dimen/sp_16"
                android:text="@string/mail_title"
                android:textStyle="bold"
                android:layout_centerInParent="true"/>

            <FrameLayout
                android:id="@+id/close"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_20"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:src="@drawable/ruixue_close_dialog"
                    android:layout_marginEnd="@dimen/dp_17"
                    android:rotationY="@integer/rotation"/>
            </FrameLayout>

        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mail_list"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_370"
            android:layout_marginTop="@dimen/dp_5"
            android:background="@drawable/bg_mail_recycle_border"
            android:paddingStart="@dimen/dp_14"
            android:paddingEnd="@dimen/dp_24"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_12"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_12">

            <ImageView
                android:id="@+id/delete_icon"
                android:layout_width="@dimen/dp_27"
                android:layout_height="@dimen/dp_27"
                android:src="@drawable/ic_mail_enable_delete"
                android:layout_alignParentStart="true"
                android:layout_centerInParent="true"
                android:rotationY="@integer/rotation"/>

            <Button
                android:id="@+id/sure_btn"
                android:layout_width="wrap_content"
                android:minWidth="@dimen/dp_92"
                android:paddingStart="@dimen/dp_3"
                android:paddingEnd="@dimen/dp_3"
                android:layout_height="@dimen/dp_27"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:background="@drawable/shape_btn_1_normal"
                android:stateListAnimator="@null"
                android:text="@string/mail_one_click_collection"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_12"
                android:layout_centerHorizontal="true"/>

        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#ff797979"
            android:layout_toEndOf="@id/delete_icon"
            android:text="@string/mail_auto_dele"
            android:layout_centerInParent="true"
            android:textSize="@dimen/dp_10"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_7"/>

    </LinearLayout>

</FrameLayout>