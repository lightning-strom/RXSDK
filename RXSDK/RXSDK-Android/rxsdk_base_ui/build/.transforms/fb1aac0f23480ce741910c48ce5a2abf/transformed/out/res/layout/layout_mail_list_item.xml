<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_40"
    android:background="#ffF7F7F7">

    <ImageView
        android:id="@+id/mail_icon"
        android:layout_width="@dimen/dp_14"
        android:layout_height="@dimen/dp_11"
        android:src="@drawable/ic_mail_close"
        android:layout_alignParentStart="true"
        android:layout_centerInParent="true"
        android:layout_centerVertical="true"
        android:layout_marginTop="@dimen/dp_9"
        android:layout_marginBottom="@dimen/dp_10"
        android:rotationY="@integer/rotation"/>

    <TextView
        android:id="@+id/mail_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_22"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="04-10 13:20:10"
        android:textColor="#ff444444"
        android:textSize="12sp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/mail_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:ellipsize="end"
        android:textColor="#ff444444"
        android:textSize="12sp"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_toEndOf="@id/mail_icon"
        android:layout_toStartOf="@id/mail_time"
        android:layout_centerVertical="true"
        android:textStyle="bold"/>

    <View
        android:id="@+id/devided_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:background="#ffEEEEEE"
        android:layout_alignParentBottom="true"/>

</RelativeLayout>