<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/dialog_width"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/card_common_margin_hor"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/corner_radius">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_30"
                android:layout_marginTop="@dimen/dp_15">

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="@dimen/dp_50"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:scaleType="centerInside"
                     android:rotationY="@integer/rotation"
                    android:src="@drawable/ruixue_arrow_left" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/txt_modify_pwd"
                    android:textColor="#000000"
                    android:textSize="@dimen/sp_18"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/close"
                    android:layout_width="@dimen/dp_50"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="5dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ruixue_close_dialog" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_5"
                android:orientation="vertical"
                android:paddingHorizontal="28dp">

                <!--                <EditText
                            style="@style/EditTextStyle.Alignment"-->
                <!--                    android:id="@+id/oldpwd"-->
                <!--                    android:layout_width="match_parent"-->
                <!--                    android:layout_height="@dimen/dp_36"-->
                <!--                    android:layout_centerVertical="true"-->
                <!--                    android:layout_marginTop="@dimen/dp_10"-->
                <!--                    android:background="@drawable/bg_edittext"-->
                <!--                    android:hint="@string/txt_modify_enter_old_pwd"-->
                <!--                    android:inputType="textPassword"-->
                <!--                    android:paddingStart="@dimen/dp_15"-->
                <!--                    android:paddingEnd="35dp"-->
                <!--                    android:singleLine="true"-->
                <!--                    android:textColor="@color/black"-->
                <!--                    android:textColorHint="@color/color_8daaaa"-->
                <!--                    android:textSize="@dimen/sp_14" />-->
                <com.ruixue.widget.PwdEditText
                    android:id="@+id/oldpwd"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/edit_height"
                    android:layout_marginTop="@dimen/dp_10"
                    app:hint="@string/txt_modify_enter_old_pwd" />

                <TextView
                    android:id="@+id/tv_setpwd_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/dp_15"
                    android:layout_marginBottom="@dimen/dp_10"
                    android:text="@string/txt_enter_pwd"
                    android:visibility="gone" />

                <com.ruixue.widget.PwdEditText
                    android:id="@+id/et_newpwd"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/edit_height"
                    android:layout_marginTop="@dimen/dp_12"
                    app:hint="@string/txt_enter_pwd" />

                <com.ruixue.widget.PwdEditText
                    android:id="@+id/nextnewpwd"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/edit_height"
                    android:layout_marginTop="@dimen/dp_12"
                    app:hint="@string/txt_sure_new_pwd" />
                <!--                <EditText
                            style="@style/EditTextStyle.Alignment"-->
                <!--                    android:id="@+id/nextnewpwd"-->
                <!--                    android:layout_width="match_parent"-->
                <!--                    android:layout_height="@dimen/dp_36"-->
                <!--                    android:layout_centerVertical="true"-->
                <!--                    android:layout_marginTop="@dimen/dp_10"-->
                <!--                    android:background="@drawable/bg_edittext"-->
                <!--                    android:hint="@string/txt_sure_new_pwd"-->
                <!--                    android:inputType="textPassword"-->
                <!--                    android:paddingStart="@dimen/dp_15"-->
                <!--                    android:paddingEnd="@dimen/dp_10"-->
                <!--                    android:singleLine="true"-->
                <!--                    android:textColor="@color/black"-->
                <!--                    android:textColorHint="@color/color_8daaaa"-->
                <!--                    android:textSize="@dimen/sp_14" />-->


                <Button
                    android:id="@+id/updatebtn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/dp_20"
                    android:layout_marginBottom="@dimen/dp_23"
                    android:background="@drawable/selec_btn_bg"
                    android:enabled="false"
                    android:gravity="center"
                    android:stateListAnimator="@null"
                    android:text="@string/txt_sure"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_16"
                    tools:ignore="TouchTargetSizeCheck" />


            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
