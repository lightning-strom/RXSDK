<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    
    <LinearLayout
        android:layout_width="@dimen/dp_303"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:gravity="center"
        android:background="@drawable/bg_mail_border_common">

        <RelativeLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10">

            <FrameLayout
                android:id="@+id/back"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_20"
                android:layout_centerVertical="true"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:src="@drawable/ruixue_arrow_left"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_alignParentStart="true"
                    android:rotationY="@integer/rotation"/>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:textColor="#ff3D3D3D"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:text="@string/mail_title"
                android:layout_centerInParent="true"/>

            <FrameLayout
                android:id="@+id/close"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_20"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:src="@drawable/ruixue_close_dialog"
                    android:layout_marginEnd="@dimen/dp_17"
                    android:rotationY="@integer/rotation"/>
            </FrameLayout>

        </RelativeLayout>

<!--        <ScrollView
            android:id="@+id/mail_detail"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_327"
            android:layout_marginTop="@dimen/dp_5"
            android:background="@drawable/bg_mail_recycle_border"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_12">-->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_272"
                android:layout_marginTop="@dimen/dp_5"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/dp_18"
                android:layout_marginEnd="@dimen/dp_18"
                android:paddingStart="@dimen/dp_10"
                android:paddingEnd="@dimen/dp_6"
                android:background="@drawable/bg_mail_recycle_border">

                <TextView
                    android:id="@+id/mail_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:ellipsize="end"
                    android:textColor="#ff323232"
                    android:textSize="14sp"
                    android:maxLines="2"
                    android:layout_marginTop="@dimen/dp_14"/>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/dp_14"
                    android:layout_marginBottom="@dimen/dp_14">

                    <TextView
                        android:id="@+id/mail_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#ff767676"
                        android:textSize="11sp"
                        android:text=""/>

                </ScrollView>

            </LinearLayout>

<!--        </ScrollView>-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/dp_13"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/ic_left_arror"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:src="@drawable/ic_left_arrow"
                android:scaleType="center"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="@dimen/dp_8"
                android:visibility="invisible"
                android:rotationY="@integer/rotation"/>

            <RelativeLayout
                android:layout_width="@dimen/dp_196"
                android:layout_height="wrap_content">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mail_attach_recycler"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:minWidth="0dp" />
            </RelativeLayout>


            <ImageView
                android:id="@+id/ic_right_arror"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:src="@drawable/ic_right_arrow"
                android:scaleType="center"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/dp_8"
                android:visibility="invisible"
                android:rotationY="@integer/rotation"/>

        </LinearLayout>

        <Button
            android:id="@+id/sure_btn"
            android:layout_width="@dimen/dp_207"
            android:layout_height="@dimen/dp_38"
            android:layout_weight="1"
            android:background="@drawable/shape_btn_attach_abtain"
            android:stateListAnimator="@null"
            android:text="@string/mail_claim_the_item"
            android:clickable="true"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:textSize="@dimen/sp_16"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/dp_13"
            android:layout_marginBottom="@dimen/dp_13"/>

    </LinearLayout>

</FrameLayout>