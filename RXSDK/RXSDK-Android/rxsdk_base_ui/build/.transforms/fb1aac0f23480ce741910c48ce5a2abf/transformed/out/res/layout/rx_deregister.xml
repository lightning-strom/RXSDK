<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/dialog_width"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/card_common_margin_hor"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/corner_radius">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_30"
                android:layout_marginTop="@dimen/dp_15">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:text="@string/txt_deregister"
                    android:textColor="#000000"
                    android:textSize="@dimen/sp_18"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/close"
                    android:layout_width="@dimen/dp_50"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="5dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ruixue_close_dialog" />
            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="@dimen/dp_30"
                android:layout_marginTop="@dimen/dp_10"
                android:text="@string/rx_tips_deregister_desc"
                android:textColor="#ff626262"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_30"
                android:layout_marginTop="@dimen/dp_12"
                android:orientation="vertical">

                <EditText
                            style="@style/EditTextStyle.Alignment"
                    android:id="@+id/realname"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_36"
                    android:background="@drawable/bg_edittext"
                    android:hint="@string/txt_enter_real_name"
                    android:paddingHorizontal="@dimen/dp_15"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textColorHint="@color/color_a5caca"
                    android:textSize="@dimen/sp_16" />

                <EditText
                            style="@style/EditTextStyle.Alignment"
                    android:id="@+id/idcard"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_36"
                    android:layout_marginTop="@dimen/dp_10"
                    android:background="@drawable/bg_edittext"
                    android:digits="0123456789Xx"
                    android:hint="@string/txt_enter_id_card"
                    android:inputType="numberSigned"
                    android:paddingStart="@dimen/dp_15"
                    android:paddingEnd="35dp"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textColorHint="@color/color_a5caca"
                    android:textSize="@dimen/sp_16" />


                <Button
                    android:id="@+id/sure"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_38"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginBottom="@dimen/dp_20"
                    android:background="@drawable/selec_btn_bg"
                    android:stateListAnimator="@null"
                    android:enabled="false"
                    android:gravity="center"
                    android:text="@string/txt_commit_confirm"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_16" />


            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
