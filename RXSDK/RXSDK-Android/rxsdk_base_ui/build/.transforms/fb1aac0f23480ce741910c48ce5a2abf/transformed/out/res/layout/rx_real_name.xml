<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <androidx.cardview.widget.CardView
        android:id="@+id/mainContainer"
        android:layout_width="@dimen/dialog_width"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/card_common_margin_hor"
        android:layout_marginVertical="@dimen/dp_25"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/corner_radius">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_30"
                    android:layout_marginTop="@dimen/dp_12">

                    <ImageView
                        android:id="@+id/manual_auth_back"
                        android:layout_width="@dimen/dp_50"
                        android:layout_height="match_parent"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="5dp"
                        android:rotationY="@integer/rotation"
                        android:scaleType="centerInside"
                        android:src="@drawable/ruixue_arrow_left"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:text="@string/txt_real_name"
                        android:textColor="#000000"
                        android:textSize="@dimen/dp_18"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/close"
                        android:layout_width="@dimen/dp_50"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="5dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ruixue_close_dialog" />
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/dp_23"
                    android:layout_marginTop="@dimen/dp_12"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.3"
                    android:maxLines="3"
                    android:text="@string/txt_real_name_tips"
                    android:textColor="@color/black"
                    android:textSize="@dimen/dp_13" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_25"
                    android:layout_marginTop="@dimen/dp_10"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/real_auth_choice_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <LinearLayout
                            android:id="@+id/alipay_auth_button"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/button_height"
                            android:layout_marginTop="@dimen/dp_10"
                            android:background="@drawable/rx_bg_alipay_auth_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/dp_20"
                            tools:ignore="UseCompoundDrawables">

                            <ImageView
                                android:layout_width="@dimen/dp_28"
                                android:layout_height="@dimen/dp_28"
                                android:layout_gravity="center_vertical"
                                android:src="@drawable/rx_logo_alipay" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dp_10"
                                android:layout_gravity="center_vertical"
                                android:text="@string/rx_txt_alipay_real_auth"
                                android:textColor="@color/white"
                                android:textSize="@dimen/sp_18" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/manual_auth_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/dp_24"
                            android:layout_marginBottom="@dimen/dp_28"
                            android:padding="@dimen/dp_6"
                            android:text="@string/rx_txt_manual_real_auth"
                            android:textColor="@color/color_a3a3a3"
                            android:textSize="@dimen/sp_16" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/manual_real_auth_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:orientation="vertical">

                        <com.ruixue.realauth.DeleteAwareEditText
                            android:id="@+id/realname"
                            style="@style/EditTextStyle.Alignment"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_34"
                            android:background="@drawable/bg_edittext"
                            android:hint="@string/txt_enter_real_name"
                            android:imeOptions="actionNext"
                            android:paddingHorizontal="@dimen/dp_15"
                            android:singleLine="true"
                            android:textColor="@color/black"
                            android:textColorHint="@color/color_a5caca"
                            android:textSize="@dimen/dp_14" />

                        <com.ruixue.realauth.IdCardEditText
                            android:id="@+id/idcard"
                            style="@style/EditTextStyle.Alignment"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_34"
                            android:layout_marginTop="@dimen/dp_10"
                            android:background="@drawable/bg_edittext"
                            android:digits="0123456789Xx"
                            android:hint="@string/txt_enter_id_card"
                            android:imeOptions="actionDone"
                            android:inputType="textCapCharacters"
                            android:paddingStart="@dimen/dp_15"
                            android:paddingEnd="35dp"
                            android:singleLine="true"
                            android:textColor="@color/black"
                            android:textColorHint="@color/color_a5caca"
                            android:textSize="@dimen/dp_14" />

                        <FrameLayout
                            android:id="@+id/reward_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_15"
                            android:visibility="gone">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/reward_recycler_list"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center" />

                        </FrameLayout>

                        <Button
                            android:id="@+id/sure"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/button_height"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/dp_15"
                            android:layout_marginBottom="@dimen/dp_18"
                            android:background="@drawable/selec_btn_bg"
                            android:enabled="false"
                            android:gravity="center"
                            android:stateListAnimator="@null"
                            android:text="@string/txt_confirm_and_reward"
                            android:textColor="@color/white"
                            android:textSize="@dimen/dp_16" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </androidx.cardview.widget.CardView>
</RelativeLayout>
