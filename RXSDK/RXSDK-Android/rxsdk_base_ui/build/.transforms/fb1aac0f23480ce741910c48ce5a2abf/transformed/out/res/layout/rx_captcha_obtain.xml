<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/dialog_width"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/card_common_margin_hor"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/corner_radius">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_30"
                android:layout_marginTop="@dimen/dp_13"
                android:layout_marginBottom="@dimen/dp_12">

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="@dimen/dp_50"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:scaleType="centerInside"
                    android:rotationY="@integer/rotation"
                    android:src="@drawable/ruixue_arrow_left"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/txt_bind_phone"
                    android:textColor="#000000"
                    android:textSize="@dimen/sp_18"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/close"
                    android:layout_width="@dimen/dp_50"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="5dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ruixue_close_dialog" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_5"
                android:orientation="vertical"
                android:paddingHorizontal="28dp">

                <EditText
                    android:id="@+id/phone"
                    style="@style/EditTextStyle.Alignment"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/edit_height"
                    android:background="@drawable/bg_edittext"
                    android:hint="@string/txt_enter_phone"
                    android:imeOptions="actionDone"
                    android:paddingStart="@dimen/dp_15"
                    android:paddingEnd="@dimen/dp_12"
                    android:singleLine="true"

                    android:textColor="@color/black"

                    android:textColorHint="@color/color_a5caca"
                    android:textSize="@dimen/sp_14" />


                <EditText
                    android:id="@+id/password"
                    style="@style/EditTextStyle.Alignment"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/edit_height"
                    android:layout_marginTop="@dimen/dp_12"
                    android:background="@drawable/bg_edittext"
                    android:hint="@string/txt_enter_login_pwd"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingStart="@dimen/dp_15"
                    android:paddingEnd="@dimen/dp_10"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textColorHint="@color/color_a5caca"
                    android:textSize="@dimen/sp_14" />


                <RelativeLayout
                    android:id="@+id/rl_captcha"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/edit_height"
                    android:layout_marginTop="@dimen/dp_12">

                    <EditText
                        android:id="@+id/et_captcha"
                        style="@style/EditTextStyle.Alignment"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_42"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_edittext"
                        android:hint="@string/txt_enter_captcha"
                        android:inputType="number"
                        android:maxLength="6"
                        android:paddingStart="@dimen/dp_15"
                        android:paddingEnd="100dp"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textColorHint="@color/color_a5caca"
                        android:textSize="@dimen/sp_14" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true">

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/dp_14"
                            android:layout_gravity="center_vertical"
                            android:background="#ffe2f2f1"
                            android:visibility="visible" />

                        <TextView
                            android:id="@+id/tv_get_code"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/edit_height"
                            android:layout_marginHorizontal="12dp"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/rx_txt_get_captcha"
                            android:textColor="@color/color_74d2cb"
                            android:textSize="@dimen/sp_14" />
                    </LinearLayout>
                </RelativeLayout>


                <Button
                    android:id="@+id/btn_finish"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/dp_20"
                    android:layout_marginBottom="@dimen/dp_23"
                    android:background="@drawable/selec_btn_bg"
                    android:enabled="false"
                    android:gravity="center"
                    android:text="@string/txt_sure"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_16" />


            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
