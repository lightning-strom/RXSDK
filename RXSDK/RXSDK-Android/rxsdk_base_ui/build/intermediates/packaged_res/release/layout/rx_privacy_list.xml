<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_root"
        android:layout_width="@dimen/dialog_width"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/card_common_margin_hor"
        android:layout_marginVertical="@dimen/dp_15"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/corner_radius">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_38"
                android:layout_marginTop="@dimen/dp_5">

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="@dimen/dp_50"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:rotationY="@integer/rotation"
                    android:scaleType="centerInside"
                    android:src="@drawable/ruixue_arrow_left"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="3dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_title"
                        android:layout_width="@dimen/dp_100"
                        android:layout_height="@dimen/dp_24"
                        android:layout_marginEnd="@dimen/dp_5"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:maxWidth="@dimen/dp_200"
                        android:maxLines="1"
                        android:text="@string/rx_txt_game_privacy"
                        android:textColor="@color/black"
                        android:textSize="@dimen/sp_18"
                        android:textStyle="bold" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/close"
                    android:layout_width="@dimen/dp_50"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="5dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ruixue_close_dialog" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/dp_4"
                android:maxLines="1"
                android:text="@string/rx_txt_please_agree_all_privacy"
                android:textColor="#ffbbbbbb"
                android:textSize="@dimen/sp_10" />

            <RelativeLayout

                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_94"
                android:layout_marginTop="@dimen/dp_4"
                android:layout_marginBottom="@dimen/dp_12">

                <ListView
                    android:id="@+id/lv_privacy"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/dp_25"
                    android:background="#F0FFFD"
                    android:cacheColorHint="@color/transparent"
                    android:divider="@color/transparent"
                    android:listSelector="@color/transparent"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="4dp"
                    android:scrollbars="none" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/btn_ll_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_25"
                android:layout_marginBottom="@dimen/dp_23"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_ok_agreeall"
                    android:layout_width="143dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="1"
                    android:background="@drawable/shape_btn_2_normal"
                    android:gravity="center"
                    android:stateListAnimator="@null"

                    android:text="@string/rx_txt_agree_start"
                    android:textAllCaps="false"

                    android:textColor="@color/color_20c0b3"
                    android:textSize="@dimen/sp_15" />

                <Button
                    android:id="@+id/btn_ok"
                    android:layout_width="143dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginStart="@dimen/dp_10"
                    android:layout_weight="1"
                    android:background="@drawable/selec_btn_bg"
                    android:enabled="false"

                    android:gravity="center"
                    android:stateListAnimator="@null"
                    android:text="@string/rx_txt_start_game"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_15" />

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
