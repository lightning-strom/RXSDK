<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/transparent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/dp_160"
        android:layout_height="@dimen/dp_158"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="@dimen/dp_143"
            android:layout_height="@dimen/dp_150"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/dp_5"
            android:layout_marginEnd="@dimen/dp_5"
            android:background="@drawable/bg_mail_attach_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/dp_11">

                <RelativeLayout
                    android:layout_width="@dimen/dp_46"
                    android:layout_height="@dimen/dp_46"
                    android:background="@drawable/bg_mail_recycle_attach_border">

                    <ImageView
                        android:id="@+id/attch_icon"
                        android:layout_width="@dimen/dp_42"
                        android:layout_height="@dimen/dp_42"
                        android:src="@drawable/et_cursor"
                        android:layout_centerInParent="true"
                        android:rotationY="@integer/rotation"/>

                </RelativeLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/dp_6">

                    <TextView
                        android:id="@+id/attach_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#ff3D3D3D"
                        android:textStyle="bold"
                        android:textSize="13sp" />


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/dp_1">

<!--                        <TextView
                            android:id="@+id/limit_first"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mail_limit_first"
                            android:textColor="#3D3D3D"
                            android:textStyle="normal"
                            android:textSize="10sp" />-->

                        <TextView
                            android:id="@+id/attach_limit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textStyle="normal"
                            android:textSize="10sp" />

<!--                        <TextView
                            android:id="@+id/limit_end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mail_limit_end"
                            android:textColor="#3D3D3D"
                            android:textStyle="normal"
                            android:textSize="10sp" />-->

                    </LinearLayout>

                    <TextView
                        android:id="@+id/attach_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="x10000个"
                        android:textColor="#ff3D3D3D"
                        android:textSize="10sp"
                        android:layout_marginTop="@dimen/dp_1"/>

                </LinearLayout>

            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_5">

                <TextView
                    android:id="@+id/attach_describe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/dp_5"
                    android:textSize="9sp"
                    android:text="这里是邮箱的正文，这里支持富文本，可以加粗，描红、斜体，感谢您在过去24小时诶内通过邮箱与我们练习，相关的邮件领取这里是邮箱的正文，这里支持富文本，可以加粗，描红、斜体，,感谢您在过去24小时诶内通过邮箱与我们练习，相关的邮件领取,，感谢您在过去24小时诶内通过邮箱与我们练习，相关的邮件领取感谢您在过去24小时诶内通过邮箱与我们练习，相关的邮件领取,，感谢您在过去24小时诶内通过邮箱与我们练习，相关的邮件领取"/>


            </ScrollView>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>