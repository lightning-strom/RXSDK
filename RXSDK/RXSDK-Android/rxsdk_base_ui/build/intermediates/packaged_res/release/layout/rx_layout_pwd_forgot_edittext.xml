<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <EditText
        android:id="@+id/newpwd"
        style="@style/EditTextStyle.Alignment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_edittext"
        android:hint="@string/txt_password_rule"
        android:inputType="textPassword"
        android:maxLength="32"
        android:paddingStart="@dimen/dp_15"
        android:paddingEnd="@dimen/dp_105"
        android:singleLine="true"
        android:textColor="@color/black"
        android:textColorHint="@color/color_a5caca"
        android:textSize="@dimen/sp_14" />

    <LinearLayout
        android:id="@+id/ll_endlayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true">

        <ImageView
            android:id="@+id/iv_newpwd_eye"
            android:layout_width="@dimen/dp_34"
            android:layout_height="@dimen/dp_34"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/dp_2"
            android:background="@drawable/rx_pwd_eye_close"
            android:visibility="invisible" />

        <View
            android:layout_width="1dp"
            android:layout_height="@dimen/dp_14"
            android:layout_gravity="center_vertical"
            android:background="#ffe2f2f1" />

        <TextView
            android:id="@+id/findpass"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/edit_height"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="12dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/txt_retrieve_password"
            android:textColor="@color/color_74d2cb"
            android:textSize="@dimen/sp_14" />
    </LinearLayout>
</RelativeLayout>