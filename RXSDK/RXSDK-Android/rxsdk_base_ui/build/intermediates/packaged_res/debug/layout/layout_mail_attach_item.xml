<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="#ffF7F7F7">

    <RelativeLayout
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:background="@drawable/bg_mail_recycle_attach_border">

        <ImageView
            android:id="@+id/attch_icon"
            android:layout_width="@dimen/dp_30"
            android:layout_height="@dimen/dp_30"
            android:src="@drawable/et_cursor"
            android:layout_centerInParent="true"
            android:rotationY="@integer/rotation"/>


        <TextView
            android:id="@+id/attach_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9999.99亿"
            android:textColor="#ff20C0B3"
            android:textSize="7sp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/dp_3"
            android:layout_marginBottom="@dimen/dp_2"/>

        <TextView
            android:id="@+id/abtain_status"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_14"
            android:text="已领"
            android:textColor="#ff3D3D3D"
            android:textSize="7sp"
            android:background="@drawable/bg_attach_abtained"
            android:gravity="center"
            android:layout_alignParentEnd="true"
            android:visibility="gone"/>


    </RelativeLayout>


</RelativeLayout>