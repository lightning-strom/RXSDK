<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inputContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F1F1F1"
    android:clickable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_54"
        android:background="#E4E4E4"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="550dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp">

            <EditText
                android:id="@+id/edit_input"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/bg_idcard_top_input"
                android:gravity="center_vertical"
                android:hint="请输入..."
                android:inputType="none"
                android:singleLine="true"
                android:paddingStart="10dp"
                android:paddingEnd="47dp"
                android:textColor="#131313"
                android:textColorHint="#ADADAD"
                android:textSize="16dp"
                tools:ignore="RtlSymmetry" />

            <TextView
                android:id="@+id/btn_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:paddingEnd="10dp"
                android:text="清空"
                android:textColor="#ADADAD"
                android:textSize="16dp"
                android:visibility="gone" />
        </FrameLayout>

        <ImageView
            android:id="@+id/btnDone"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ruixue_id_card_keyboard_finish_disable" />

    </LinearLayout>

    <GridLayout
        android:id="@+id/grid_keyboard"
        android:layout_width="596dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="26dp"
        android:alignmentMode="alignMargins"
        android:columnCount="3"
        android:padding="0dp"
        android:rowCount="4">

        <!-- 数字键 1-9 -->
        <TextView
            android:id="@+id/btn_1"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_32"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="0.5dp"
            android:background="@drawable/bg_ruixue_idcard_keyboard_top_left_radius_btn_selector"
            android:gravity="center"
            android:text="1"
            android:textColor="#131313"
            android:textSize="18dp" />

        <TextView
            android:id="@+id/btn_2"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_32"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="0.5dp"
            android:background="@drawable/bg_ruixue_idcard_keyboard_btn_selector"
            android:gravity="center"
            android:text="2"
            android:textColor="#131313"
            android:textSize="18dp" />

        <TextView
            android:id="@+id/btn_3"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_32"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="0.5dp"
            android:background="@drawable/bg_ruixue_idcard_keyboard_top_right_radius_btn_selector"
            android:gravity="center"
            android:text="3"
            android:textColor="#131313"
            android:textSize="18dp" />

        <TextView
            android:id="@+id/btn_4"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_32"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="0.5dp"
            android:background="@drawable/bg_ruixue_idcard_keyboard_btn_selector"
            android:gravity="center"
            android:text="4"
            android:textColor="#131313"
            android:textSize="18dp" />

        <TextView
            android:id="@+id/btn_5"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_32"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="0.5dp"
            android:background="@drawable/bg_ruixue_idcard_keyboard_btn_selector"
            android:gravity="center"
            android:text="5"
            android:textColor="#131313"
            android:textSize="18dp" />

        <TextView
            android:id="@+id/btn_6"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_32"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="0.5dp"
            android:background="@drawable/bg_ruixue_idcard_keyboard_btn_selector"
            android:gravity="center"
            android:text="6"
            android:textColor="#131313"
            android:textSize="18dp" />

        <TextView
            android:id="@+id/btn_7"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_32"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="0.5dp"
            android:background="@drawable/bg_ruixue_idcard_keyboard_btn_selector"
            android:gravity="center"
            android:text="7"
            android:textColor="#131313"
            android:textSize="18dp" />

        <TextView
            android:id="@+id/btn_8"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_32"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="0.5dp"
            android:background="@drawable/bg_ruixue_idcard_keyboard_btn_selector"
            android:gravity="center"
            android:text="8"
            android:textColor="#131313"
            android:textSize="18dp" />

        <TextView
            android:id="@+id/btn_9"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_32"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="0.5dp"
            android:background="@drawable/bg_ruixue_idcard_keyboard_btn_selector"
            android:gravity="center"
            android:text="9"
            android:textColor="#131313"
            android:textSize="18dp" />

        <!-- 特殊键 X -->
        <TextView
            android:id="@+id/btn_x"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_32"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="0.5dp"
            android:background="@drawable/bg_ruixue_idcard_keyboard_bottom_left_radius_btn_selector"
            android:gravity="center"
            android:text="X"
            android:textColor="#131313"
            android:textSize="18dp" />
        <!-- 数字 0 -->
        <TextView
            android:id="@+id/btn_0"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_32"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="0.5dp"
            android:background="@drawable/bg_ruixue_idcard_keyboard_btn_selector"
            android:gravity="center"
            android:text="0"
            android:textColor="#131313"
            android:textSize="18dp" />
        <!-- 删除键 -->
        <ImageView
            android:id="@+id/btn_del"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_32"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="0.5dp"
            android:background="@drawable/bg_ruixue_idcard_keyboard_bottom_right_radius_btn_selector"
            android:scaleType="center"
            android:src="@drawable/ruixue_id_card_keyboard_delete" />
    </GridLayout>
</LinearLayout>
