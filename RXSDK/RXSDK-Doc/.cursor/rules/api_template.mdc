## 4. iOS 模板

### 4.1 Swift Protocol

```swift
import Foundation

/// <模块名> 对外 API
public protocol RXExampleAPI {
    func example(request: RXExampleRequest,
                 completion: @escaping (Result<RXExampleResponse, RXSDKError>) -> Void)
}

/// 统一错误结构
public struct RXSDKError: Error {
    public let code: Int
    public let msg: String
    public let traceId: String?
    public let thirdCode: String?
    public let thirdMsg: String?
    public let raw: String?
    public let data: [String: Any]?
}

/// 请求参数
public struct RXExampleRequest {
    public let username: String
    public let password: String
    public let captchaCode: String?
    public let ext: [String: Any]?
}
```

### 4.2 Swift 实现

```swift
final class RXExampleAPIImpl: RXExampleAPI {
    func example(request: RXExampleRequest,
                 completion: @escaping (Result<RXExampleResponse, RXSDKError>) -> Void) {
        guard !request.username.isEmpty else {
            completion(.failure(RXSDKError(code: 2000, msg: "参数错误")))
            return
        }
        // TODO: 调用业务层
    }
}
```

### 4.3 Objective-C Header

```objective-c
#import <Foundation/Foundation.h>

NS_ASSUME_NONNULL_BEGIN

FOUNDATION_EXPORT NSString * const RXSDKErrorUserInfoKeyMessage;   // @"msg"
FOUNDATION_EXPORT NSString * const RXSDKErrorUserInfoKeyTraceId;   // @"trace_id"
FOUNDATION_EXPORT NSString * const RXSDKErrorUserInfoKeyThirdCode; // @"thirdcode"
FOUNDATION_EXPORT NSString * const RXSDKErrorUserInfoKeyThirdMsg;  // @"thirdmsg"

