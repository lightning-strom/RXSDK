## 5. Unity 模板

```csharp
using System;
using UnityEngine;

[Serializable]
public class RXSDKError {
    public int code;
    public string msg;
    public string trace_id;
    public string thirdcode;
    public string thirdmsg;
    public string data;
    public string raw;
}

public sealed class UnityRXRequestCallbackProxy : AndroidJavaProxy {
    private readonly Action<string> _onSuccess;
    private readonly Action<string> _onError;

    public UnityRXRequestCallbackProxy(Action<string> onSuccess, Action<string> onError)
        : base("com.ruixue.unity.UnityRXRequestCallback") {
        _onSuccess = onSuccess;
        _onError = onError;
    }

    public void onResponse(string json) => _onSuccess?.Invoke(json);
    public void onError(string e) => _onError?.Invoke(e);
}
```

