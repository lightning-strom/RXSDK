## 6. 微信小游戏模板

```typescript
export interface RXSDKError {
  code: number;
  msg: string;
  trace_id?: string;
  thirdcode?: any;
  thirdmsg?: string;
  data?: Record<string, any>;
}

export type RXResult<T> =
  | { ok: true; data: T }
  | { ok: false; error: RXSDKError };

export class RXMiniGameSDK {
  private static _inited = false;

  static async init(cfg: { productId: string; channelId: string }): Promise<RXResult<void>> {
    if (!cfg?.productId || !cfg?.channelId) {
      return { ok: false, error: { code: 2000, msg: "参数错误" } };
    }
    RXMiniGameSDK._inited = true;
    return { ok: true, data: undefined };
  }

  static async login(req: { method: string }): Promise<RXResult<object>> {
    if (!RXMiniGameSDK._inited) {
      return { ok: false, error: { code: 2001, msg: "SDK 未初始化" } };
    }
    // TODO: 调用 wx.login 等
    return { ok: false, error: { code: 9000, msg: "未实现" } };
  }
}
