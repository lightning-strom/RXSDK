# 文本文件，提交时转换为 LF，检出时不转换
* text=auto eol=lf

# 指定文件类型
*.cs text eol=lf
*.ets text eol=lf
*.json text eol=lf
*.json5 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# 二进制文件，不进行换行符转换
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.unity binary
*.prefab binary
*.asset binary
*.meta binary
*.dll binary
*.pdb binary
*.so binary
*.dylib binary
